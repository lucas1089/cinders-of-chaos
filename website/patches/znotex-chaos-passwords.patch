diff --git a/engine/function/login_guard.php b/engine/function/login_guard.php
index 5b02b93..791fd78 100644
--- a/engine/function/login_guard.php
+++ b/engine/function/login_guard.php
@@ -9,9 +9,34 @@ function znote_login_guard_config(): array {
 		'threshold'       => max(1, (int)($cfg['threshold'] ?? 5)),
 		'window_seconds'  => max(60, (int)($cfg['window_minutes'] ?? 15) * 60),
 		'lockout_seconds' => max(60, (int)($cfg['lockout_minutes'] ?? 15) * 60),
+		// Cinders of Chaos: failed attempts on one account name (from any IP) before that name is locked out
+		'account_threshold' => max(1, (int)($cfg['account_threshold'] ?? 10)),
 	);
 }
 
+// Cinders of Chaos: per-account throttling next to ZnoteX's per-IP one (same window and lockout length), so a
+// password guesser spread over many addresses is slowed down too. Locks the website login only, never the game.
+function znote_login_guard_account_lockout_remaining(string $username): int {
+	$cfg = znote_login_guard_config();
+	$username = substr(trim($username), 0, 32);
+	if (!$cfg['enabled'] || $username === '' || !function_exists('znote_table_exists') || !znote_table_exists('znote_login_attempts')) {
+		return 0;
+	}
+
+	$now = time();
+	$row = db()->fetchOne("
+		SELECT COUNT(*) AS `failures`, MAX(`created_at`) AS `last_failure`
+		FROM `znote_login_attempts`
+		WHERE `username` = ? AND `success` = 0 AND `created_at` >= ?;
+	", [$username, $now - $cfg['window_seconds']]);
+
+	if (!is_array($row) || (int)$row['failures'] < $cfg['account_threshold']) {
+		return 0;
+	}
+
+	return max(0, (int)$row['last_failure'] + $cfg['lockout_seconds'] - $now);
+}
+
 function znote_login_guard_ip(): string {
 	$ip = (string)(function_exists('getIP') ? getIP() : ($_SERVER['REMOTE_ADDR'] ?? ''));
 	return substr(trim($ip), 0, 45);
