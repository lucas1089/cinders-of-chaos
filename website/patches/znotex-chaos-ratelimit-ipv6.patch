+// Cinders of Chaos: the address a login attempt counts under. An IPv6 address counts by its /64 network (one household
+// owns all of it), as the account creation limit does; otherwise one machine walks through its addresses and is never
+// locked out. IPv4 stays as it is.
+function chaos_login_guard_ip_key(string $ip): string {
+	$bin = @inet_pton(trim($ip));
+	if ($bin !== false && strlen($bin) === 16) {
+		return inet_ntop(substr($bin, 0, 8) . str_repeat("\0", 8)) . '/64';
+	}
+	return substr(trim($ip), 0, 45);
+}
