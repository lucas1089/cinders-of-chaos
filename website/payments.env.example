# Settings of the donation flow (website/README.md "Donations"): Pix through Mercado Pago (BRL) and PayPal (USD).
# Copy this file OUTSIDE the repository and the web root, fill it in, protect it:
#   sudo cp website/payments.env.example /etc/chaos/payments.env
#   sudo chown root:www-data /etc/chaos/payments.env && sudo chmod 640 /etc/chaos/payments.env
# The webhook (web server) and the worker (server/deploy/chaos-payworker.service) read it; another path goes in
# CHAOS_PAY_ENV. A variable set in the real environment wins over this file. NEVER commit a filled-in copy
# (payments.env is in .gitignore).

# Which provider serves each method: mercadopago | mock | off (Pix), paypal | mock | off (PayPal).
# mock = no money, a charge approves itself after CHAOS_PAY_MOCK_APPROVE_AFTER seconds: tests and demos only.
# mock only runs when the site address is localhost / 127.0.0.1 / ::1, or with CHAOS_PAY_ALLOW_MOCK=1 (never on a live
# server: a mock charge approves itself and the game server credits real Chaos Coins).
CHAOS_PAY_PIX_PROVIDER=off
CHAOS_PAY_PAYPAL_PROVIDER=off
# The site's public address (return links from PayPal); empty = CHAOS_SITE_URL of the site settings
CHAOS_PAY_SITE_URL=
# Mercado Pago needs a payer e-mail for Pix. The account's e-mail is used (passed through, not stored again); for an
# account without one this pattern is used ({account} = the account id), e.g. donor+{account}@your-domain. Empty =
# such an order fails with "no payer e-mail".
CHAOS_PAY_PAYER_EMAIL=
# How often the worker asks the provider about an open order (the webhook is the fast path), in seconds
CHAOS_PAY_RECONCILE_SECONDS=60
# Log file of the flow (order ids and amounts only); empty = PHP's error log
CHAOS_PAY_LOG=

# Mercado Pago (Your integrations > your application > Production credentials > Access Token; Webhooks > secret)
CHAOS_MP_ACCESS_TOKEN=
CHAOS_MP_WEBHOOK_SECRET=
# optional: also send this URL as each payment's notification_url (normally the URL set in the panel is enough)
CHAOS_MP_NOTIFICATION_URL=
# refuse webhook calls whose signature timestamp is older than this many seconds (empty = 600, 0 = off)
CHAOS_MP_SIGNATURE_TOLERANCE=600

# PayPal (developer dashboard > Apps & Credentials > your app: Client ID and Secret; its webhook's ID)
CHAOS_PAYPAL_CLIENT_ID=
CHAOS_PAYPAL_CLIENT_SECRET=
CHAOS_PAYPAL_WEBHOOK_ID=
CHAOS_PAYPAL_ENV=sandbox
# DONATION (PayPal's donation category; may need a registered charity / nonprofit in some countries) or DIGITAL_GOODS
CHAOS_PAYPAL_CATEGORY=DONATION
CHAOS_PAYPAL_BRAND=Cinders of Chaos

# mock provider only
CHAOS_PAY_MOCK_APPROVE_AFTER=20
CHAOS_PAY_MOCK_STATE=
CHAOS_PAY_MOCK_SECRET=
CHAOS_PAY_MOCK_URL=
# 1 = allow the mock on a site that is not localhost (a demo server only; never live)
CHAOS_PAY_ALLOW_MOCK=
