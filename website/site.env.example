# Settings of website/install_site.sh. Copy it OUTSIDE the repository (e.g. /etc/chaos/site.env, chmod 600), fill it
# in and run:   website/install_site.sh /etc/chaos/chaos.env /etc/chaos/site.env
# /etc/chaos/chaos.env (server/deploy/chaos.env.example) already gives CHAOS_DB_HOST/PORT/USER/PASS/NAME; set them
# here only when the website uses another database user. NEVER commit a filled-in copy.

CHAOS_SITE_DIR=/var/www/chaos                     # where ZnoteX is installed (outside the repository)
CHAOS_SITE_URL=https://www.example.org            # PLACEHOLDER: the site's public address
# https:// above: the session cookie is Secure and HSTS is sent (README "Web server"; PHP must see HTTPS, also behind a proxy)
# CHAOS_SITE_GIT_DIR=/var/www/.chaos.znotex.git   # ZnoteX's git data, outside the web root (this is the default)
CHAOS_ADMIN_ACCOUNTS=                             # account names with the admin panel, comma separated
CHAOS_SERVER_DATA=/opt/chaos/server/data          # the game server's data/ (patch notes, season and leaderboard settings)
CHAOS_START_TOWNS=1,2,4,5                         # town ids offered as home town (towns table); 1 = default
CHAOS_GAME_HOST=play.example.org                  # PLACEHOLDER: shown on the downloads page
CHAOS_GAME_PORT=7171
CHAOS_DISCORD_URL=                                # PLACEHOLDER: the Discord invite (empty = no Discord button)
CHAOS_CLIENT_WINDOWS_URL=                         # PLACEHOLDER: client download links (empty = "Coming soon")
CHAOS_CLIENT_LINUX_URL=
CHAOS_WEB_USER=www-data                           # owner of the cache folders and config.local.php (optional)
# CHAOS_LAYOUT=chaos                              # "void" shows the original purple layout
# CHAOS_DEPOT_BOXES=0                             # 1: starter depot boxes (blocks !season join: it needs an empty depot)
# CHAOS_PASSWORD_ITERATIONS=120000                # PBKDF2 iterations of new password hashes = passwordHashIterations in config.lua
# CHAOS_DB_USER=chaos_web  CHAOS_DB_PASSWORD=...  CHAOS_DB_HOST=127.0.0.1  CHAOS_DB_NAME=chaos
# reCAPTCHA (v2 checkbox) on the account creation form: on when both are set (https://www.google.com/recaptcha/admin)
CHAOS_RECAPTCHA_SITE_KEY=
CHAOS_RECAPTCHA_SECRET=
# CHAOS_REGISTER_PER_IP_HOUR=3                    # accounts per IP address (IPv6: per /64) per hour; 0 = no limit
# CHAOS_CLIENT_API=1                              # 0 turns off the client's account API (character looks and creation in the client)
# Mail (README "Mail"): account recovery links and the 2FA e-mail codes. Empty CHAOS_SMTP_HOST = no mail (the recovery
# page then says recovery by e-mail is not available). Any SMTP relay with TLS works; the From domain needs SPF, DKIM
# and DMARC records (README "Mail"). PLACEHOLDERS below: never commit a filled-in copy.
CHAOS_SMTP_HOST=                                  # e.g. smtp.your-mail-provider.example
CHAOS_SMTP_PORT=587                               # 587 with starttls, 465 with tls
CHAOS_SMTP_TLS=starttls                           # starttls | tls | none (none: a relay on this machine only)
CHAOS_SMTP_USER=                                  # the SMTP login of the relay
CHAOS_SMTP_PASSWORD=                              # its password or API key, in 'single quotes' (the file is read by bash)
CHAOS_MAIL_FROM=                                  # e.g. no-reply@your-domain (a domain you own, with SPF/DKIM)
CHAOS_MAIL_FROM_NAME="Cinders of Chaos"
