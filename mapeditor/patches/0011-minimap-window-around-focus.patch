-    const int width = std::min(maxX - minX + 1, 8192);
-    const int height = std::min(maxY - minY + 1, 8192);
-    m_originX = minX;
-    m_originY = minY;
+    const int width = std::min(maxX - minX + 1, kMaxSide);
+    const int height = std::min(maxY - minY + 1, kMaxSide);
+    // A floor wider than the bitmap (our map: the base world near x 32000 and
+    // hunt areas near x 14400 on the same floor) is cut as a window around the
+    // focus tile. Without a focus the window starts at the first tile.
+    int originX = minX, originY = minY;
+    if (focusX != kNoFocus && maxX - minX + 1 > width)
+        originX = std::clamp(focusX - width / 2, minX, maxX - width + 1);
+    if (focusY != kNoFocus && maxY - minY + 1 > height)
+        originY = std::clamp(focusY - height / 2, minY, maxY - height + 1);
+    m_originX = originX;
+    m_originY = originY;
     m_image = QImage(width, height, QImage::Format_Indexed8);
     if (m_image.isNull()) return;
     m_image.setColorTable(runtimeMinimapColorTable());
