+bool MapMinimapService::windowMissesFocus(int focusX, int focusY) const
+{
+    if (m_image.isNull()) return false;
+    // True when the bitmap is a cut of the floor on that axis and the focus is
+    // outside it or within the edge margin of a side that has more map behind it.
+    const auto misses = [](int focus, int origin, int size, int lo, int hi) {
+        const int margin = std::min(kEdgeMargin, size / 4);
+        if (focus < origin + margin && origin > lo) return true;
+        if (focus >= origin + size - margin && origin + size <= hi) return true;
+        return false;
+    };
+    return misses(focusX, m_originX, m_image.width(), m_fullMinX, m_fullMaxX)
+        || misses(focusY, m_originY, m_image.height(), m_fullMinY, m_fullMaxY);
+}
+
 const QImage &MapMinimapService::image(int floor, const MapFloorTileIndex &tiles,
-                                       const OtbReader *otb, const DatReader *dat)
+                                       const OtbReader *otb, const DatReader *dat,
+                                       int focusX, int focusY)
 {
-    if (m_floor != floor) rebuild(floor, tiles, otb, dat);
+    if (m_floor != floor
+        || (focusX != kNoFocus && focusY != kNoFocus && windowMissesFocus(focusX, focusY)))
+        rebuild(floor, tiles, otb, dat, focusX, focusY);
     return m_image;
 }
 
@@ -602,6 +633,8 @@
     const int px = x - m_originX;
     const int py = y - m_originY;
     if (px < 0 || px >= m_image.width() || py < 0 || py >= m_image.height()) {
+        // Inside the bounds of the floor: only outside the bitmap window, nothing to draw.
+        if (x >= m_fullMinX && x <= m_fullMaxX && y >= m_fullMinY && y <= m_fullMaxY) return;
         invalidate();
         return;
     }
