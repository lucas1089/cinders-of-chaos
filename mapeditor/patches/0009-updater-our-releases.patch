+// Files the installation owns: update-keep.txt in the target folder, one path per line relative to it ('#' starts
+// a comment). An update never overwrites them. The Cinders of Chaos package lists the game's data/1098 files there.
+QStringList keptFiles(const fs::path &target)
+{
+    QStringList kept;
+    QFile file(QString::fromStdWString((target / L"update-keep.txt").wstring()));
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text))
+        return kept;
+    while (!file.atEnd()) {
+        QString line = QString::fromUtf8(file.readLine()).trimmed();
+        if (line.isEmpty() || line.startsWith(QLatin1Char('#')))
+            continue;
+        line.replace(QLatin1Char('\\'), QLatin1Char('/'));
+        while (line.startsWith(QLatin1Char('/')))
+            line.remove(0, 1);
+        kept << line.toLower();
+    }
+    return kept;
+}
