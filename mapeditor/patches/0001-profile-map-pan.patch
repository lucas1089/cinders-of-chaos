+// Automated map panning (--profile-pan SECONDS). The camera moves east for the
+// first half and south for the second half at a fixed speed in tiles per
+// second. Every presented frame of the window is timed on the render thread;
+// the record reports the distribution of frame intervals while panning.
+struct PanOptions {
+    int seconds = 6;
+    double speed = 60.0;
+    int tileSize = 0;
+    int floor = -1;
+    int lighting = -1;
+    int animations = -1;
+    int lowerFloors = -1;
+};
+
+void profileMapPan(QObject *root, MapView *view, const PanOptions &options,
+                   std::function<void(int)> done)
+{
+    auto *window = qobject_cast<QQuickWindow *>(root);
+    if (!window || !view) { done(3); return; }
+    // Measure the renderer, not the FPS limit of the settings (default 60).
+    for (MapRhiView *rhiView : root->findChildren<MapRhiView *>())
+        if (!rhiView->previewWindow()) rhiView->setMaxFps(0);
+    if (options.tileSize > 0) view->setTileSize(options.tileSize);
+    if (options.floor >= 0 && options.floor <= 15) view->setFloor(options.floor);
+    if (options.lighting >= 0) view->setTorchOn(options.lighting != 0);
+    if (options.animations >= 0) view->setShowAnimations(options.animations != 0);
+    if (options.lowerFloors >= 0) view->setShowLowerFloors(options.lowerFloors != 0);
+
+    struct PanMeasurement {
+        QElapsedTimer clock;
+        std::mutex mutex;
+        std::vector<qint64> swaps;
+        double x0 = 0, y0 = 0;
+        bool finished = false;
+    };
+    auto measurement = std::make_shared<PanMeasurement>();
+    measurement->x0 = view->renderOriginX();
+    measurement->y0 = view->renderOriginY();
+    measurement->swaps.reserve(16384);
+    const qint64 durationMs = qint64(std::max(1, options.seconds)) * 1000;
+    const QString setup = QStringLiteral("tile_size=%1 floor=%2 lighting=%3 animations=%4 lower_floors=%5 speed=%6")
+        .arg(view->tileSize()).arg(view->floor()).arg(view->torchOn() ? 1 : 0)
+        .arg(view->showAnimations() ? 1 : 0).arg(view->showLowerFloors() ? 1 : 0)
+        .arg(options.speed);
+    LoadProfile::record(QStringLiteral("map_pan_begin"), -1, setup);
+    measurement->clock.start();
+    auto connection = std::make_shared<QMetaObject::Connection>();
+    *connection = QObject::connect(window, &QQuickWindow::frameSwapped, window, [measurement] {
+        const qint64 now = measurement->clock.nsecsElapsed();
+        std::lock_guard<std::mutex> lock(measurement->mutex);
+        if (!measurement->finished) measurement->swaps.push_back(now);
+    }, Qt::DirectConnection);
+
+    auto *timer = new QTimer(root);
+    timer->setTimerType(Qt::PreciseTimer);
+    timer->setInterval(4);
+    QObject::connect(timer, &QTimer::timeout, root, [=] {
+        const qint64 elapsed = measurement->clock.elapsed();
+        if (elapsed < durationMs) {
+            const double half = durationMs / 2000.0;
+            const double t = elapsed / 1000.0;
+            const double east = options.speed * std::min(t, half);
+            const double south = options.speed * std::max(0.0, t - half);
+            view->profileSetOrigin(measurement->x0 + east, measurement->y0 + south);
+            return;
+        }
+        timer->stop();
+        QObject::disconnect(*connection);
+        std::vector<qint64> swaps;
+        {
+            std::lock_guard<std::mutex> lock(measurement->mutex);
+            measurement->finished = true;
+            swaps.swap(measurement->swaps);
+        }
+        std::vector<double> intervals;
+        for (size_t i = 1; i < swaps.size(); ++i)
+            intervals.push_back((swaps[i] - swaps[i - 1]) / 1.0e6);
+        std::sort(intervals.begin(), intervals.end());
+        double sum = 0;
+        for (double value : intervals) sum += value;
+        const auto percentile = [&intervals](double p) {
+            if (intervals.empty()) return 0.0;
+            const size_t index = std::min(intervals.size() - 1,
+                size_t(p * double(intervals.size() - 1) + 0.5));
+            return intervals[index];
+        };
+        const double average = intervals.empty() ? 0.0 : sum / double(intervals.size());
+        LoadProfile::record(QStringLiteral("map_pan_complete"), elapsed,
+            QStringLiteral("frames=%1 fps=%2 avg_ms=%3 p50_ms=%4 p95_ms=%5 p99_ms=%6 worst_ms=%7 %8")
+                .arg(swaps.size())
+                .arg(QString::number(swaps.size() * 1000.0 / double(elapsed), 'f', 1))
+                .arg(QString::number(average, 'f', 2))
+                .arg(QString::number(percentile(0.50), 'f', 2))
+                .arg(QString::number(percentile(0.95), 'f', 2))
+                .arg(QString::number(percentile(0.99), 'f', 2))
+                .arg(QString::number(intervals.empty() ? 0.0 : intervals.back(), 'f', 2))
+                .arg(setup));
+        timer->deleteLater();
+        done(swaps.size() > 10 ? 0 : 3);
+    });
+    timer->start();
+}
 }
 
