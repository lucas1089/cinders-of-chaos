{
    "name": "cinders-client-android",
    "version-string": "1.0.0",
    "dependencies": [
        "boost-iostreams",
        "boost-asio",
        "boost-beast",
        "boost-system",
        "boost-variant",
        "boost-lockfree",
        "boost-program-options",
        "boost-filesystem",
        "boost-uuid",
        "physfs",
        "libogg",
        "libvorbis",
        "zlib",
        "libzip",
        "openssl",
        "openal-soft",
        "luajit"
    ],
    "features": {
        "rmlui": {
            "description": "RmlUi documents next to the OTUI windows (CMake option CHAOS_RMLUI, spike); FreeType without its png, brotli, bzip2 and zlib defaults, whose libraries the engine does not link (first Android RmlUi build, 2026-11-04)",
            "dependencies": [
                {
                    "name": "rmlui",
                    "default-features": true
                },
                {
                    "name": "freetype",
                    "default-features": false
                }
            ]
        }
    },
    "overrides": [
        {
            "name": "openal-soft",
            "version": "1.23.1#2"
        }
    ],
    "builtin-baseline": "389e18e8380daab3884e7dc0710ad7f4a264def6"
}
