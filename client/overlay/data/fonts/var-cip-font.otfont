// Cinders of Chaos: this stock font is not used, and its sheet would take font atlas room the Chaos fonts need
// (data/fonts/chaos/, client/MANIFEST.md "OFL fonts"). This file replaces it with a copy of Icon-VBold-11px:
// the client loads a font name once (FontManager::importFont), so the copy takes no atlas slot.
Font
  name: Icon-VBold-11px
  texture: Icon-VBold-11px
  height: 15
  glyph-size: 22 15
  space-width: 4
