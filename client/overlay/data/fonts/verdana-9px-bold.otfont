// Cinders of Chaos: replaces the stock font of this name (its sheet lacks the pt-BR letters) with a sheet made
// from PT Sans (SIL OFL 1.1, data/fonts/chaos/OFL-PTSans.txt) by tools/make_ofl_fonts.sh, same name and geometry.
Font
  name: verdana-9px-bold
  texture: chaos/chaos-ui-bold-9px
  height: 12
  glyph-size: 13 13
  first-glyph: 32
  y-offset: 0
  spacing: 0 0
  space-width: 4
