// Nemesis window (game_nemesis). Styles from client_chaos_theme (styles.otui).

NemesisRow < UIWidget
  height: 20
  background-color: #1a151a
  phantom: true

  ChaosLabelDim
    id: label
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 90
    text-align: left

  ChaosLabel
    id: value
    anchors.left: label.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    text-align: right

NemesisTrait < UIWidget
  height: 32
  phantom: true

  ChaosLabel
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    height: 14
    text-align: left

  ChaosLabelDim
    id: desc
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 14
    height: 14
    text-align: left

ChaosMainWindow
  id: nemesisWindow
  size: 380 400
  !text: tr('Nemesis')
  @onEscape: modules.game_nemesis.hide()

  ChaosBloodLabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center

  ChaosLabelDim
    id: sub
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center

  UIWidget
    id: rows
    anchors.top: sub.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 100
    phantom: true
    layout:
      type: verticalBox

  ChaosLabel
    id: traitsTitle
    anchors.top: rows.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 16
    color: #e8b84a
    text-align: left
    !text: tr('Traits')

  UIWidget
    id: traits
    anchors.top: traitsTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 70
    phantom: true
    layout:
      type: verticalBox

  ChaosLabelDim
    id: empty
    anchors.top: sub.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    height: 90
    text-wrap: true
    text-align: topLeft

  ChaosLabelDim
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8
    height: 16
    text-align: center

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    !text: tr('Close')
    @onClick: modules.game_nemesis.hide()
