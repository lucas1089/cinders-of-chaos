Module
  name: game_guildwar
  description: Guild Wars window (declare, answer, running wars with score and kill log, surrender, the war board) and the weekly guild boss (Summoning Stone fuel, summon, banner, board); extended opcode 197
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ guildwarview, guildwar ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1005
  @onLoad: init()
  @onUnload: terminate()
