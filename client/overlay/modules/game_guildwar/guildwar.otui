// Guild Wars window (game_guildwar): tabs Wars / Declare / War Board / Guild Boss. Rows are created by guildwar.lua.
// Styles: client_chaos_theme.
GuildWarTab < ChaosTabButton
  size: 112 24
  margin-right: 4

GuildWarSection < UILabel
  font: verdana-11px-rounded
  color: #f6cf72
  text-align: left
  text-auto-resize: true
  margin-top: 8
  phantom: true

GuildWarText < UILabel
  font: verdana-11px-antialised
  color: #d6c9ae
  text-align: left
  text-wrap: true
  text-auto-resize: true
  margin-top: 3
  phantom: true

// a war: title and status on the left, up to two buttons on the right
GuildWarRow < ChaosPanelDark
  height: 56
  margin-top: 3

  UILabel
    id: title
    font: verdana-11px-rounded
    color: #e8b84a
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: button2.left
    margin: 4 6 0 6
    text-align: left
    phantom: true

  UILabel
    id: sub
    font: verdana-11px-antialised
    color: #d6c9ae
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: button2.left
    margin: 2 6 0 6
    text-align: left
    phantom: true

  UILabel
    id: terms
    font: verdana-11px-antialised
    color: #8c8070
    anchors.top: sub.bottom
    anchors.left: parent.left
    anchors.right: button2.left
    margin: 2 6 0 6
    text-align: left
    phantom: true

  ChaosButton
    id: button1
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 78

  ChaosButton
    id: button2
    anchors.right: button1.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 78

// a label and an input (text edit or combo box) of the declaration form
GuildWarFormRow < UIWidget
  height: 26
  margin-top: 4

  UILabel
    id: label
    font: verdana-11px-antialised
    color: #d6c9ae
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 150
    text-align: left
    phantom: true

GuildWarFormEdit < GuildWarFormRow
  ChaosTextEdit
    id: edit
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    width: 220
    max-length: 30

GuildWarFormCombo < GuildWarFormRow
  ChaosComboBox
    id: combo
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    size: 220 22

GuildWarButtonRow < UIWidget
  height: 28
  margin-top: 6

  ChaosButton
    id: button
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 150

  UILabel
    id: label
    font: verdana-11px-antialised
    color: #8c8070
    anchors.left: button.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-align: left
    phantom: true

GuildWarFuelBar < ChaosProgressBar
  height: 20
  margin-top: 4
  background-color: #c0601c

// gold for the stone: amount, button, the embers it buys
GuildWarGoldRow < UIWidget
  height: 28
  margin-top: 4

  ChaosTextEdit
    id: amount
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 140
    max-length: 14

  ChaosButton
    id: button
    anchors.left: amount.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-horizontal-auto-resize: true
    !text: tr('Feed gold')

  UILabel
    id: label
    font: verdana-11px-antialised
    color: #8c8070
    anchors.left: button.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-align: left
    phantom: true

// a material for the stone: its picture, what it gives, the button
GuildWarItemRow < UIWidget
  height: 36
  margin-top: 2

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  UILabel
    id: label
    font: verdana-11px-antialised
    color: #d6c9ae
    anchors.left: item.right
    anchors.right: button.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-align: left
    phantom: true

  ChaosButton
    id: button
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 110

ChaosMainWindow
  id: guildWarWindow
  size: 660 620
  // phone interface is 540 high: the lists anchored to the bottom shrink
  $mobile:
    height: 536
  !text: tr('Guild Wars')
  @onEscape: modules.game_guildwar.hide()

  ChaosLabel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    color: #f6cf72

  ChaosLabelDim
    id: subLine
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-align: left

  UIWidget
    id: tabs
    anchors.top: subLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 24
    layout:
      type: horizontalBox

  ChaosPanelDark
    id: listFrame
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 4
    margin-bottom: 6
    padding: 3

  UIScrollArea
    id: rowList
    anchors.top: listFrame.top
    anchors.left: listFrame.left
    anchors.right: listScroll.left
    anchors.bottom: listFrame.bottom
    margin: 6
    layout:
      type: verticalBox
      fit-children: false
    vertical-scrollbar: listScroll
    auto-focus: none

  ChaosScrollBar
    id: listScroll
    anchors.top: listFrame.top
    anchors.right: listFrame.right
    anchors.bottom: listFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 26
    pixels-scroll: true

  ChaosLabel
    id: statusLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    margin-bottom: 4
    text-align: left
    text-wrap: true
    height: 28

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_guildwar.hide()
