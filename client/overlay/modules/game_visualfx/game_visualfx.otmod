Module
  name: game_visualfx
  description: Dark-fantasy look for the map with a switch per effect in Options > Graphics - a short flash on a creature that takes damage, a small screen shake on big hits taken, a soft shadow under creatures (base patch 0126) and a vignette with a light colour grade over the map
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ visualfx_logic, visualfx ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1005
  @onLoad: init()
  @onUnload: terminate()
