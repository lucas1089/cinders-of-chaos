// Rich item tooltip (game_itemtooltip): a dark gold-rimmed plate of the Chaos skin, laid out by item_tooltip.lua.

ItemTooltipLine < UILabel
  font: verdana-11px-rounded
  color: #d6c9ae
  text-auto-resize: true
  phantom: true
  focusable: false

ItemTooltipTitle < ItemTooltipLine
  font: verdana-11px-rounded

ItemTooltipRule < UIWidget
  height: 1
  background-color: #3a3339
  phantom: true
  focusable: false

ItemTooltipPanel < UIWidget
  image-source: /images/chaos/skin/tooltip
  image-border: 4
  phantom: true
  focusable: false
  size: 200 60

  UIWidget
    id: band
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    margin: 3 4 0 4
    phantom: true

  UIItem
    id: icon
    anchors.top: parent.top
    anchors.left: parent.left
    size: 32 32
    margin-top: 9
    margin-left: 8
    virtual: true
    phantom: true

  ItemTooltipLine
    id: header
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 8
    color: #8c8070
    visible: false
