Module
  name: game_howitworks
  description: "How it works" cards - a short, plain explanation of each feature (who it is for, monster levels, what drops, what a death costs, how often) shown by a ? button in the feature windows, the Next Goals list and the "New" unlock window; static data, no opcode
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ howitworks_data, howcore, howitworks ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 900
  @onLoad: init()
  @onUnload: terminate()
