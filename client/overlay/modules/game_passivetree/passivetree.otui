DecorationCircle < Panel
  anchors.centerIn: parent

TreeButton < UIButton
  font: verdana-11px-rounded
  color: #dfdfdfff
  size: 106 30
  text-offset: 0 1
  image-source: /images/passivetree/button_tree
  image-border: 6
  image-color: #ffffff
  image-clip: 0 0 75 30
  padding: 5 10 5 10

  $hover !disabled:
    image-clip: 0 30 75 30

  $pressed:
    image-clip: 0 60 75 30
    text-offset: 1 1

  $disabled:
    color: #aaaaaa
    image-color: #888888

PresetItem < TreeButton
  anchors.top: parent.top
  anchors.right: parent.right
  anchors.left: parent.left
  margin: 5 5 0 5
  font: verdana-11px-rounded
  height: 25
  text-offset: 0 2

TreeComboBoxPopupScrollMenuButton < UIButton
  height: 25
  font: verdana-11px-antialised
  text-align: left
  text-offset: 4 0
  color: #BFBFBF
  image-color: #ffffff
  margin: 0
  image-source: /images/passivetree/dropdown_menu
  image-clip: 0 75 179 25
  image-border: 2
  image-border-left: 7
  image-border-right: 7

  $hover !disabled:
    image-color: #afafaf

TreeComboBoxPopupScrollMenu < UIPopupScrollMenu

TreeComboBoxPopupMenuButton < UIButton
  height: 25
  font: verdana-11px-antialised
  text-align: left
  text-offset: 5 2
  color: #dfdfdf
  image-color: #ffffff
  margin: 0
  image-source: /images/passivetree/dropdown_menu
  image-clip: 0 75 179 25
  image-border: 2
  image-border-left: 7
  image-border-right: 7

  $hover !disabled:
    image-color: #dfdfdf

TreeComboBoxPopupMenu < UIPopupMenu
  image-source: /images/passivetree/dropdown_menu
  image-clip: 0 75 179 25
  image-border: 3

TreeComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #dfdfdf
  size: 179 25
  text-offset: 5 2
  text-align: left
  image-source: /images/passivetree/dropdown_menu
  image-border: 4
  image-border-right: 34
  image-clip: 0 0 179 25
  menu-scroll-step: 25

  $hover !disabled:
    image-clip: 0 25 179 25

  $on:
    image-clip: 0 50 179 25

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

CalcSeparator < UIWidget
  margin: 5 0

UIWindow
  @onEscape: modules.game_passivetree.hide()
  anchors.fill: parent
  image-source: /images/passivetree/background_tree
  
  FlatPanel
    id: view
    anchors.fill: parent
    phantom: false
    draggable: true
    image-color: #ffffffaa

    Panel
      id: background
      anchors.centerIn: parent
      image-source: /images/passivetree/background_tree
      image-repeated: false
      image-color: #ffffffaa
      image-border: 0

    Panel
      id: decoView
      anchors.centerIn: parent
      opacity: 1

    Panel
      id: nodesView
      anchors.centerIn: parent
      opacity: 1
      
  Panel
    id: stats
    anchors.top: parent.top
    anchors.left: parent.left
    width: 300
    height: 300
    margin-left: 20

    Panel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: next.top
      background: #000000dd
      padding: 4 2

      ScrollablePanel
        id: labels
        anchors.fill: parent
        margin-top: 5
        vertical-scrollbar: statsScrollBar
        layout:
          type: verticalBox
          spacing: 2

      VerticalScrollBar
        id: statsScrollBar
        anchors.top: labels.top
        anchors.right: labels.right
        anchors.bottom: labels.bottom
        margin: 0 0 0 0
        step: 30
        margin-left: 2
        pixels-scroll: true

    TreeButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      !text: tr('Info & Bonuses')
      @onClick: modules.game_passivetree.toggleStats()

  TreeButton
    id: applyPoints
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 40
    margin-right: 3
    !text: tr('Apply Plan')
    width: 110
    !tooltip: tr('Allocate every planned node in one go (left-click a node to plan the path to it)')
    enabled: true
    @onClick: modules.game_passivetree.applyPoints()

  TreeButton
    id: resetPresetButton
    anchors.top: applyPoints.top
    anchors.left: applyPoints.right
    margin-left: 5
    !text: tr('Reset')
    width: 110
    enabled: true
    @onClick: modules.game_passivetree.reset()

  TreeButton
    id: paragonButton
    anchors.top: applyPoints.top
    anchors.left: resetPresetButton.right
    margin-left: 5
    !text: tr('Paragon')
    width: 110
    enabled: true
    @onClick: modules.game_passivetree.toggleParagon()

  TreeButton
    id: buildShareButton
    anchors.top: applyPoints.top
    anchors.left: paragonButton.right
    margin-left: 5
    !text: tr('Build Code')
    width: 110
    enabled: true
    !tooltip: tr('Export your build as a code, or import a code (preview first)')
    @onClick: modules.game_passivetree.toggleBuildShare()

  TreeButton
    id: trialsButton
    anchors.top: applyPoints.top
    anchors.left: buildShareButton.right
    margin-left: 5
    !text: tr('Trials')
    width: 110
    enabled: true
    !tooltip: tr('Vocation Trials: clear your vocation trial to open pairs of special nodes (choose one of each pair)')
    @onClick: modules.game_passivetree.toggleTrials()

  UIWidget
    id: presets
    anchors.top: presetsButton.bottom
    anchors.horizontalCenter: applyPoints.horizontalCenter
    margin-top: 40
    size: 200 340
    image-source: /images/ui/miniwindow
    image-border: 20
    !text: tr('Reset')
    font: verdana-11px-rounded
    text-align: top
    text-offset: 0 4

    Panel
      id: presetsSave
      image-source: /images/ui/tooltip
      image-border: 20
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 75
      margin: 20 5 0 5
      Label
        !text: tr('Preset Name:')
        anchors.top: parent.top
        font: verdana-11px-rounded
        margin-top: 4
        anchors.horizontalCenter: parent.horizontalCenter
      TextEdit
        id: presetName
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.left: parent.left
        margin-right: 6
        margin-left: 6
        margin-top: 20
        shift-navigation: true
        max-length: 24
        focusable: false
        text-align: center
        text-auto-submit: true
      Button
        id: savePresetButton
        anchors.top: presetName.bottom
        anchors.right: presetName.left
        !text: tr('Save')
        width: 50
        enabled: false
        margin: 5 5 0 0
      Button
        id: resetPresetButton
        anchors.top: presetName.bottom
        anchors.left: presetName.right
        !text: tr('Reset')
        width: 50
        margin: 5 0 0 5
        @onClick: modules.game_passivetree.reset()
    
    Label
      id: presetSlots
      !text: tr('Slots: 1/1')
      anchors.top: presetsSave.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      font: verdana-11px-rounded

    Panel
      id: slots
      image-source: /images/ui/tooltip
      image-border: 20
      anchors.top: presetSlots.bottom
      anchors.right: parent.right
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin: 5 5 35 5

      PresetItem
        id: preset1
        !text: tr('Default')
    
    Button
      width: 40
      !text: tr('Close')
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 0 7 7 0
      @onClick: modules.game_passivetree.presets()

  
  Panel
    id: pWindow
    anchors.top: applyPoints.top
    anchors.right: applyPoints.left
    margin-right: 6
    image-source: /images/passivetree/PSPointsFrame
    size: 110 30
    padding: 7 15
    
    Label
      id: points
      font: verdana-11px-rounded
      anchors.centerIn: parent
      text-auto-resize: true
      !text: tr('10 Passive Points')

  Label
    id: bossPoints
    anchors.top: pWindow.bottom
    anchors.horizontalCenter: pWindow.horizontalCenter
    margin-top: 3
    font: verdana-11px-rounded
    color: #d8a03a
    text-auto-resize: true
    background-color: #000000a0
    padding: 1 4
    phantom: false
    visible: false




    
  // the planner (planner.lua): cost against the free points, undo / redo / clear
  Panel
    id: planBar
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 5
    margin-right: 20
    size: 380 64
    background: #000000b0
    padding: 4

    Label
      id: planCost
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      font: verdana-11px-rounded
      text-align: center
      text-auto-resize: false
      !text: tr('No plan: click a node to plan the path to it.')

    TreeButton
      id: planUndo
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 118
      !text: tr('Undo')
      enabled: false
      !tooltip: tr('Undo the last plan change (Ctrl+Z)')
      @onClick: modules.game_passivetree.plannerUndo()

    TreeButton
      id: planRedo
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      width: 118
      !text: tr('Redo')
      enabled: false
      !tooltip: tr('Redo (Ctrl+Y)')
      @onClick: modules.game_passivetree.plannerRedo()

    TreeButton
      id: planClear
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      width: 118
      !text: tr('Clear Plan')
      enabled: false
      @onClick: modules.game_passivetree.plannerClear()

  // search (search.lua): name or bonus text, every match framed, Next / Prev centre the view on it
  Panel
    id: searchBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 5
    margin-left: 20
    size: 380 34
    background: #000000b0
    padding: 4

    TextEdit
      id: searchEdit
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 150
      height: 22
      max-length: 40
      !placeholder: tr('Search nodes')
      !tooltip: tr('Find nodes by name or bonus (Ctrl+F). Enter: next match.')
      @onTextChange: modules.game_passivetree.onTreeSearchChange()

    TreeButton
      id: searchPrev
      anchors.left: searchEdit.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      width: 52
      height: 26
      !text: tr('Prev')
      @onClick: modules.game_passivetree.treeSearchPrev()

    TreeButton
      id: searchNext
      anchors.left: searchPrev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      width: 52
      height: 26
      !text: tr('Next')
      @onClick: modules.game_passivetree.treeSearchNext()

    Label
      id: searchCount
      anchors.left: searchNext.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-rounded
      text-align: center
      text-auto-resize: false

  // another character's tree (viewother.lua, from Inspect Player)
  Panel
    id: viewBanner
    anchors.top: applyPoints.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 30
    size: 460 34
    background: #301c0cd8
    padding: 4
    visible: false

    Label
      id: viewText
      anchors.left: parent.left
      anchors.right: viewBack.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      font: verdana-11px-rounded
      color: #f0d79a
      text-align: center
      text-auto-resize: false

    TreeButton
      id: viewBack
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 130
      height: 26
      !text: tr('Back to my tree')
      @onClick: modules.game_passivetree.closeOtherTree()

  TreeButton
    id: zoomLess
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-bottom: 5
    margin-right: 5
    !text: tr('Zoom -')
    width: 110
    enabled: true
    @onClick: modules.game_passivetree.zoomLess()

  TreeButton
    id: zoomPlus
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 5
    !text: tr('Zoom +')
    width: 110
    enabled: true
    @onClick: modules.game_passivetree.zoomPlus()
  TreeButton
    anchors.bottom: zoomLess.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    !text: tr('Close')
    width: 110
    @onClick: modules.game_passivetree.hide()

  TreeButton
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 10
    !text: tr('Cancel')
    width: 110
    enabled: false
    visible: false