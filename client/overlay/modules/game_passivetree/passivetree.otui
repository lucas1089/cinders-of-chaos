CommonNode < Panel
  anchors.centerIn: parent
  image-source: /images/passivetree/skills
  image-color: #6f6f6f
  size: 27 27
  phantom: false
  icon-source: /images/passivetree/common_notallocated
  icon-size: 56 56
  icon-offset: -15 -15
  icon-color: #ffffff

  $hover !$on:
    icon-source: /images/passivetree/commont_canallocate
    image-color: #ffffff

  $on:
    icon-source: /images/passivetree/common_active
    image-color: #ffffff

  // planned (planner.lua): the can-allocate frame, tinted
  $checked !$on:
    icon-source: /images/passivetree/commont_canallocate
    icon-color: #7fd8ff
    image-color: #cfefff

InfoLabel < Label
  id: infoLabel
  text-auto-resize: false
  text-wrap: true

UncommonNode < Panel
  anchors.centerIn: parent
  image-source: /images/passivetree/skills
  image-color: #6f6f6f
  size: 38 38
  phantom: false
  icon-source: /images/passivetree/uncommon_notallocated
  icon-size: 95 95
  icon-offset: -27 -27
  icon-color: #ffffff

  $hover !$on:
    icon-source: /images/passivetree/uncommon_canallocate
    image-color: #ffffff

  $on:
    icon-source: /images/passivetree/uncommon_activated
    image-color: #ffffff

  // planned (planner.lua): the can-allocate frame, tinted
  $checked !$on:
    icon-source: /images/passivetree/uncommon_canallocate
    icon-color: #7fd8ff
    image-color: #cfefff

