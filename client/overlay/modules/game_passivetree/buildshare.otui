// Build code panel of the passive tree window (buildshare.lua). Ornate skin styles from client_chaos_theme.
ChaosWindow
  id: buildShareWindow
  !text: tr('Build Code')
  size: 400 392
  anchors.top: parent.top
  anchors.right: parent.right
  margin-top: 80
  margin-right: 20
  @onEscape: modules.game_passivetree.closeBuildShare()

  ChaosLabelDim
    id: hint
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 42
    text-wrap: true
    text-auto-resize: false
    text-align: center
    !text: tr('Export copies your tree code, Copy Full Build also your class, spells and gear (for Discord and the website). Paste a code and press Import to preview it.')

  ChaosTextEdit
    id: codeEdit
    anchors.top: hint.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 24
    max-length: 1000

  ChaosButton
    id: exportButton
    anchors.top: codeEdit.bottom
    anchors.left: parent.left
    margin-top: 6
    width: 110
    !text: tr('Export')
    @onClick: modules.game_passivetree.exportBuild()

  ChaosButton
    id: importButton
    anchors.top: codeEdit.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    width: 110
    !text: tr('Import')
    @onClick: modules.game_passivetree.importBuild()

  ChaosButton
    id: pasteButton
    anchors.top: codeEdit.bottom
    anchors.right: parent.right
    margin-top: 6
    width: 110
    !text: tr('Paste')
    @onClick: modules.game_passivetree.pasteBuild()

  ChaosButton
    id: exportFullButton
    anchors.top: exportButton.bottom
    anchors.left: parent.left
    margin-top: 6
    width: 182
    !text: tr('Copy Full Build')
    !tooltip: tr('Copies one code with your passive tree, class, level, spell rotation and gear. The website draws it.')
    @onClick: modules.game_passivetree.exportFullBuild()

  ChaosButton
    id: trendsButton
    anchors.top: exportButton.bottom
    anchors.right: parent.right
    margin-top: 6
    width: 182
    !text: tr('Trending Builds')
    !tooltip: tr('The most played builds of every class this week (no names). Import one from the list.')
    @onClick: modules.game_passivetree.toggleTrends()

  ChaosSeparator
    id: sep
    anchors.top: exportFullButton.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  ChaosLabel
    id: previewText
    anchors.top: sep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: applyButton.top
    margin-top: 8
    margin-bottom: 8
    text-wrap: true
    text-auto-resize: false
    text-align: topLeft

  ChaosButton
    id: applyButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 110
    !text: tr('Apply Build')
    enabled: false
    @onClick: modules.game_passivetree.applyBuild()

  ChaosButton
    id: cancelButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 110
    !text: tr('Cancel Preview')
    enabled: false
    @onClick: modules.game_passivetree.cancelBuildPreview()

  ChaosButton
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 110
    !text: tr('Close')
    @onClick: modules.game_passivetree.closeBuildShare()
