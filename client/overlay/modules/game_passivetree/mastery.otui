// The effect choice of a mastery node (planner.lua openMasteryChoice). Ornate skin styles from client_chaos_theme.
MasteryEffectButton < ChaosButton
  height: 46
  text-wrap: true
  text-align: center

  $on:
    color: #ffd98a

// F46: with 8 long effects the window grew to about 580 px, over the 540 px phone interface. planner.lua caps its
// height to the screen (TreePlan.choiceFit) and the effect list scrolls when it is cut; the phone rule narrows it.
ChaosWindow
  id: masteryWindow
  size: 460 250
  $mobile:
    width: 440
  anchors.centerIn: parent
  @onEscape: modules.game_passivetree.closeMasteryChoice()

  ChaosLabelDim
    id: hint
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    text-wrap: true
    text-auto-resize: false
    text-align: center

  ScrollablePanel
    id: effects
    anchors.top: hint.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: cancelButton.top
    margin-top: 6
    margin-bottom: 8
    vertical-scrollbar: effectsScrollBar
    layout:
      type: verticalBox
      spacing: 6

  // shown by planner.lua only while the list is cut (the list then leaves it 16 px on the right)
  VerticalScrollBar
    id: effectsScrollBar
    anchors.top: effects.top
    anchors.bottom: effects.bottom
    anchors.right: parent.right
    step: 40
    pixels-scroll: true
    visible: false

  ChaosButton
    id: removeButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 140
    !text: tr('Remove from plan')

  ChaosButton
    id: cancelButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 90
    !text: tr('Cancel')
    @onClick: modules.game_passivetree.closeMasteryChoice()
