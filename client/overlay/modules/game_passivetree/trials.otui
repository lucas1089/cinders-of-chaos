// Vocation Trials panel of the passive tree window (trials.lua). Ornate skin styles from client_chaos_theme.
// Every box has an explicit size and non-resizing text; trials.lua shortens the texts to fit (TrialsMath.fit).

TrialLine < ChaosLabel
  height: 13
  text-auto-resize: false
  text-wrap: false
  anchors.left: parent.left
  anchors.right: parent.right

TrialCard < ChaosPanelDark
  size: 327 136
  padding: 6
  phantom: false

  ChaosTitle
    id: cardName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: left
    text-auto-resize: false

  TrialLine
    id: line1
    anchors.top: cardName.bottom
    margin-top: 2

  TrialLine
    id: line2
    anchors.top: line1.bottom

  TrialLine
    id: line3
    anchors.top: line2.bottom

  TrialLine
    id: line4
    anchors.top: line3.bottom

  TrialLine
    id: line5
    anchors.top: line4.bottom

  ChaosLabelDim
    id: lore
    anchors.top: line5.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 13
    text-auto-resize: false
    text-wrap: false

  ChaosLabel
    id: status
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 190
    height: 16
    text-auto-resize: false
    text-wrap: false

  ChaosButton
    id: action
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 104 22
    !text: tr('Choose')

TrialPairRow < UIWidget
  height: 136
  phantom: false

  ChaosLabel
    id: rowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    width: 72
    height: 48
    margin-top: 8
    text-wrap: true
    text-auto-resize: false
    text-align: topLeft

  ChaosButton
    id: clearButton
    anchors.top: rowTitle.bottom
    anchors.left: parent.left
    margin-top: 6
    size: 72 22
    !text: tr('Clear')

  TrialCard
    id: cardA
    anchors.top: parent.top
    anchors.left: rowTitle.right
    margin-left: 4

  TrialCard
    id: cardB
    anchors.top: parent.top
    anchors.right: parent.right

ChaosWindow
  id: trialsWindow
  !text: tr('Vocation Trials')
  size: 780 650
  // phone interface is 540 high: the lists anchored to the bottom shrink
  $mobile:
    height: 536
  anchors.centerIn: parent
  @onEscape: modules.game_passivetree.closeTrials()

  ChaosTitle
    id: trialName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    text-auto-resize: false

  ChaosLabelDim
    id: story
    anchors.top: trialName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 30
    text-wrap: true
    text-auto-resize: false
    text-align: center

  ChaosSeparator
    id: sep
    anchors.top: story.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: content
    anchors.top: sep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 4
    margin-bottom: 6

    Panel
      id: tiers
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      ChaosButton
        id: tier1
        anchors.top: parent.top
        anchors.left: parent.left
        size: 238 26
        !text: tr('Enter Normal')

      ChaosButton
        id: tier2
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        size: 238 26
        !text: tr('Enter Cruel')

      ChaosButton
        id: tier3
        anchors.top: parent.top
        anchors.right: parent.right
        size: 238 26
        !text: tr('Enter Merciless')

    ChaosLabel
      id: tokens
      anchors.top: tiers.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 16
      text-align: center
      text-auto-resize: false
      color: #f6cf72

    Panel
      id: pairsPanel
      anchors.top: tokens.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      layout:
        type: verticalBox
        spacing: 6

      TrialPairRow
        id: row1

      TrialPairRow
        id: row2

      TrialPairRow
        id: row3

  ChaosButton
    id: leaveButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 150
    !text: tr('Leave the trial')
    visible: false
    @onClick: modules.game_passivetree.leaveTrial()

  ChaosButton
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 130
    !text: tr('Close')
    @onClick: modules.game_passivetree.closeTrials()
