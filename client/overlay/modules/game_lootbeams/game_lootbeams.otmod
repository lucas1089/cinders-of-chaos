Module
  name: game_lootbeams
  description: Loot beams - a light pillar over corpses and ground items with loot the loot filter makes glow, coloured by the best tier; drawn by the engine (base patch 0069); server data on the loot filter's opcode 238
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ lootbeamslogic, lootbeams ]
  dependencies:
    - game_interface
    - game_lootfilter
  autoload: true
  autoload-priority: 1002
  @onLoad: init()
  @onUnload: terminate()
