Module
  name: game_combatdecals
  description: Stains on the ground after combat (O231): blood where a creature dies, a scorch under fire, frost cracks under ice, a green stain under poison and earth; they fade out in 20-30 s; switch in Options > Graphics
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ combatdecals_logic, combatdecals ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1003
  @onLoad: init()
  @onUnload: terminate()
