Module
  name: game_craftingtable
  description: Crafting Table window - the base server's crafting tables (recipes, materials, gold, skill, Craft; extended opcode 91)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ craftingtableview, craftingtable ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1002
  @onLoad: init()
  @onUnload: terminate()
