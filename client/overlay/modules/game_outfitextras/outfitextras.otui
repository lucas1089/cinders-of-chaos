// Customise Character (game_outfitextras, O421): one window. Left: the large look preview (game_lookpreview) with the
// layer checkboxes, the colour palette with its tabs and the addon boxes. Right: a search box over the card grid of the
// category picked. Across the bottom: the Equipped now strip, one card per slot; a click on a card shows its category.
// The cards, the palette cells and the strip cards are made by outfitextras.lua.

CustomiseLayerCheck < ChaosCheckBox
  size: 80 20
  text-offset: 21 2

// a card of the grid: the look or an icon over the name
CustomiseCard < UIWidget
  size: 116 94
  background-color: #00000066
  border-width: 1
  border-color: #3a3339
  clipping: true
  change-cursor-image: true
  cursor: pointer
  $hover:
    background-color: #ffffff18
    border-color: #7d7176

  UICreature
    id: creature
    anchors.left: parent.left
    anchors.top: parent.top
    size: 116 64
    phantom: true
    visible: false

  UIWidget
    id: icon
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 8
    size: 48 48
    phantom: true
    visible: false

  UILabel
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 3 3 3
    height: 28
    text-align: center
    text-wrap: true
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

// a card of the Equipped now strip: slot name and the current choice on the left, its picture on the right
CustomiseStripCard < UIWidget
  size: 116 52
  background-color: #00000066
  border-width: 1
  border-color: #3a3339
  clipping: true
  change-cursor-image: true
  cursor: pointer
  $hover:
    background-color: #ffffff18
    border-color: #7d7176

  UILabel
    id: slot
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 4 4 0 5
    height: 12
    text-align: left
    font: verdana-11px-antialised
    color: #8c8070
    phantom: true

  UILabel
    id: name
    anchors.left: parent.left
    anchors.top: slot.bottom
    anchors.right: pic.left
    margin: 2 2 0 5
    height: 28
    text-align: topLeft
    text-wrap: true
    font: verdana-11px-antialised
    color: #f6cf72
    phantom: true

  // the picture box: the look is fitted inside it (game_lookpreview.fitCard anchors to the box), so it never covers the text
  UIWidget
    id: pic
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 2 2 0
    size: 44 40
    clipping: true
    phantom: true

    UICreature
      id: creature
      anchors.left: parent.left
      anchors.top: parent.top
      size: 44 40
      phantom: true
      visible: false

    UIWidget
      id: icon
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      size: 36 36
      phantom: true
      visible: false

CustomiseColorCell < UIWidget
  size: 14 14
  border-width: 1
  border-color: #00000080
  change-cursor-image: true
  cursor: pointer
  $hover:
    border-color: #d6c9ae

ChaosMainWindow
  id: customiseWindow
  size: 880 690
  // the phone interface is 960 x 540: the strip and the palette are shorter, the cards keep their size
  $mobile:
    width: 940
    height: 520
  !text: tr('Customise Character')
  @onEscape: modules.game_outfitextras.cancel()

  ChaosButton
    id: cancelButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 90
    !text: tr('Cancel')
    @onClick: modules.game_outfitextras.cancel()

  ChaosPrimaryButton
    id: okButton
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    width: 90
    !text: tr('Ok')
    @onClick: modules.game_outfitextras.accept()

  ChaosLabelDim
    id: hintLabel
    anchors.left: parent.left
    anchors.right: okButton.left
    anchors.verticalCenter: okButton.verticalCenter
    margin-right: 8
    text-align: left
    !text: tr('Point at a card to preview it, click to pick it. A greyed card is not unlocked yet.')

  ChaosPanelDark
    id: strip
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: okButton.top
    margin-bottom: 8
    height: 128
    padding: 6
    $mobile:
      height: 90

    ChaosLabel
      id: stripTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 14
      text-align: center
      color: #e8b84a
      !text: tr('Equipped now')

    UIWidget
      id: slots
      anchors.top: stripTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      layout:
        type: grid
        cell-size: 116 52
        cell-spacing: 4
        flow: true

  UIWidget
    id: left
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: strip.top
    margin-bottom: 8
    width: 330

    UIWidget
      id: previewHost
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: layers.top
      margin-bottom: 6

    // the pet stands in the lower left corner of the preview stage (the shared panel draws the character only)
    UICreature
      id: petView
      anchors.left: previewHost.left
      anchors.bottom: previewHost.bottom
      margin-left: 14
      margin-bottom: 124
      size: 56 56
      phantom: true
      visible: false

    UIWidget
      id: layers
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: colors.top
      margin-bottom: 6
      height: 42
      layout:
        type: grid
        cell-size: 82 20
        cell-spacing: 0
        flow: true

    ChaosPanelDark
      id: colors
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 160
      padding: 6
      $mobile:
        height: 134

      UIWidget
        id: tabs
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 22
        layout:
          type: horizontalBox
          spacing: 2

      UIWidget
        id: palette
        anchors.top: tabs.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
        width: 266
        height: 98
        layout:
          type: grid
          cell-size: 14 14
          cell-spacing: 0
          flow: true

      UIWidget
        id: addons
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 18

        ChaosCheckBox
          id: addon1
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 90
          !text: tr('Addon 1')

        ChaosCheckBox
          id: addon2
          anchors.left: addon1.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 12
          width: 90
          !text: tr('Addon 2')

  UIWidget
    id: right
    anchors.top: parent.top
    anchors.left: left.right
    anchors.right: parent.right
    anchors.bottom: strip.top
    margin-left: 10
    margin-bottom: 8

    ChaosTextEdit
      id: searchEdit
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: clearButton.left
      margin-right: 4
      height: 24
      !placeholder: tr('Search')

    ChaosButton
      id: clearButton
      anchors.top: parent.top
      anchors.right: parent.right
      size: 28 24
      text: x
      !tooltip: tr('Clear the search')
      @onClick: modules.game_outfitextras.clearSearch()

    ChaosCheckBox
      id: onlyMineBox
      anchors.top: searchEdit.bottom
      anchors.right: parent.right
      margin-top: 6
      margin-right: 4
      width: 100
      !text: tr('Only mine')
      !tooltip: tr('Show only what you have unlocked')

    ChaosLabel
      id: titleLabel
      anchors.top: searchEdit.bottom
      anchors.left: parent.left
      anchors.right: onlyMineBox.left
      margin-top: 6
      height: 18
      text-align: left
      font: verdana-11px-rounded
      color: #f6cf72

    ChaosPanelDark
      id: gridFrame
      anchors.top: titleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      padding: 3

      ScrollablePanel
        id: grid
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: gridScroll.left
        anchors.bottom: parent.bottom
        margin-right: 3
        vertical-scrollbar: gridScroll
        layout:
          type: grid
          cell-size: 116 94
          cell-spacing: 4
          flow: true

      ChaosScrollBar
        id: gridScroll
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        step: 48
        pixels-scroll: true
