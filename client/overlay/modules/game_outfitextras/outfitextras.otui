// Customise Character extras (game_outfitextras): the cosmetic rows of Change Appearance (base patch 0090) and the list
// of a row's choices in the right-hand area. The row widgets copy the window's Aura / Preset rows.

OutfitExtrasCheck < CheckBoxCircle
  size: 12 12
  font: Verdana Bold-11px
  text-offset: 16 -3
  text-auto-resize: true
  color: #c0c0c0
  image-source: /images/ui/checkboxcircle
  image-clip: 0 0 12 12
  anchors.top: parent.top
  anchors.left: parent.left
  margin-left: 7
  change-cursor-image: false
  $hover !disabled:
    color: $var-text-cip-color
  $disabled:
    color: #707070

OutfitExtrasValue < FlatPanel
  size: 230 20
  image-source: /game_cyclopedia/images/ui/panel-background
  padding: 1 1 1 1
  anchors.top: parent.top
  anchors.left: parent.left
  margin-left: 130
  font: $var-cip-font
  color: $var-text-cip-color

OutfitExtrasOption < UIWidget
  height: 24
  font: Verdana Bold-11px
  color: #c0c0c0
  text-align: left
  text-offset: 8 0
  background-color: #00000040
  focusable: true
  $hover:
    background-color: #ffffff18
  $focus:
    background-color: #5a4a3a
    color: #f0f0f0

OutfitExtrasList < UIWidget
  id: extrasList
  anchors.fill: parent
  visible: false

  ScrollablePanel
    id: list
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: extrasScrollBar.left
    padding: 3
    vertical-scrollbar: extrasScrollBar
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: extrasScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 24
    pixels-scroll: true
