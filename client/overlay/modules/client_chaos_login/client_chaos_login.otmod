Module
  name: client_chaos_login
  description: Cinders of Chaos login screen (full-screen gothic scene, logo, framed sign-in panel with rune medallions, press-any-key splash, status and version corners)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ loginscene_core, loginscene, loginbar, login ]
  dependencies:
    - client_chaos_theme
    - client_entergame
    - client_background
  autoload: true
  autoload-priority: 1100
  @onLoad: init()
  @onUnload: terminate()
