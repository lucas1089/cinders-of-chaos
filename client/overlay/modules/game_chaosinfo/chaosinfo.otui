// Info & Services window (game_chaosinfo). Styles from client_chaos_theme (styles.otui).

ChaosInfoPageButton < ChaosTabButton
  height: 26
  margin-bottom: 3
  text-align: left
  text-offset: 8 1

ChaosInfoRow < UIWidget
  height: 26
  margin-bottom: 4
  layout:
    type: horizontalBox
    spacing: 6

ChaosInfoRowLabel < ChaosLabel
  width: 84
  height: 24
  text-align: left
  text-offset: 0 5

ChaosInfoRowButton < ChaosButton
  height: 24

// one Ancestral Store entry: icon, name, what it gives, price, Buy
ChaosStoreRow < UIWidget
  height: 40
  margin-bottom: 2
  image-source: /images/chaos/panel_dark
  image-border: 6

  ChaosItemSlot
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true
    phantom: true

  ChaosButton
    id: buy
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 70
    height: 24

  ChaosLabel
    id: price
    anchors.right: buy.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    width: 90
    text-align: right
    color: #e8b84a

  ChaosLabel
    id: name
    anchors.left: item.right
    anchors.right: price.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 5
    text-align: left
    height: 14

  ChaosLabelDim
    id: kind
    anchors.left: name.left
    anchors.right: name.right
    anchors.top: name.bottom
    margin-top: 2
    text-align: left
    height: 14

ChaosMainWindow
  id: chaosInfoWindow
  size: 690 450
  !text: tr('Info & Services')
  @onEscape: modules.game_chaosinfo.hide()

  ChaosPanelDark
    id: pageList
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-bottom: 8
    width: 140
    padding: 5
    layout:
      type: verticalBox

  ChaosLabel
    id: pageTitle
    anchors.top: parent.top
    anchors.left: pageList.right
    anchors.right: parent.right
    margin-left: 10
    text-align: left
    font: verdana-11px-rounded
    color: #e8b84a
    height: 16

  ChaosLabelDim
    id: pageText
    anchors.top: pageTitle.bottom
    anchors.left: pageTitle.left
    anchors.right: parent.right
    margin-top: 2
    text-align: left
    text-wrap: true
    height: 28

  UIWidget
    id: rows
    anchors.top: pageText.bottom
    anchors.left: pageTitle.left
    anchors.right: parent.right
    margin-top: 4
    height: 0
    layout:
      type: verticalBox
      fit-children: true

  ChaosPanelDark
    id: outputFrame
    anchors.top: rows.bottom
    anchors.left: pageTitle.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8

  ChaosMultilineTextEdit
    id: output
    anchors.top: outputFrame.top
    anchors.left: outputFrame.left
    anchors.right: outputScroll.left
    anchors.bottom: outputFrame.bottom
    margin: 4
    text-wrap: true
    editable: false
    vertical-scrollbar: outputScroll
    color: #d6c9ae

  ChaosScrollBar
    id: outputScroll
    anchors.top: outputFrame.top
    anchors.right: outputFrame.right
    anchors.bottom: outputFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 14
    pixels-scroll: true

  // the Ancestral Store page: shown instead of the text box
  UIWidget
    id: storePanel
    anchors.top: rows.bottom
    anchors.left: pageTitle.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8
    visible: false

    ChaosLabel
      id: storePoints
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text-align: left
      font: verdana-11px-rounded
      color: #e8b84a
      height: 16

    ChaosLabelDim
      id: storeMessage
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      text-align: left
      height: 16

    ChaosPanelDark
      id: storeFrame
      anchors.top: storePoints.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: storeMessage.top
      margin-top: 4
      margin-bottom: 4

    ScrollablePanel
      id: storeList
      anchors.top: storeFrame.top
      anchors.left: storeFrame.left
      anchors.right: storeScroll.left
      anchors.bottom: storeFrame.bottom
      margin: 4
      vertical-scrollbar: storeScroll
      layout:
        type: verticalBox

    ChaosScrollBar
      id: storeScroll
      anchors.top: storeFrame.top
      anchors.right: storeFrame.right
      anchors.bottom: storeFrame.bottom
      margin-top: 3
      margin-bottom: 3
      margin-right: 3
      step: 42
      pixels-scroll: true

  ChaosButton
    id: refreshButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    !text: tr('Refresh')
    @onClick: modules.game_chaosinfo.refresh()

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_chaosinfo.hide()
