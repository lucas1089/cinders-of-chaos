Module
  name: game_chaosinfo
  description: Info & Services window (character info, services, auto seller, house, rift keys, events, server info; extended opcode 237)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ chaosinfoview, chaosinfo ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
