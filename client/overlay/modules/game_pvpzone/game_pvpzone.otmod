Module
  name: game_pvpzone
  description: The Scorched Marches, the open-world PvP zone - window (rules, pledge, embers vendor), entry confirmation and HUD (extended opcode 193)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ pvpzoneview, pvpzone ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1006
  @onLoad: init()
  @onUnload: terminate()
