GetItems < MiniPanel
  @onClick: modules.game_daily.selectItem(self:getId())

  $hover !disabled:
    image-color: #dfdfdf

  $pressed:
    image-clip: 0 46 22 23

  $on:
    image-color: #ffffff

  $disabled:
    color: #dfdfdf88
    opacity: 0.8

  UIItem
    id: Item
    anchors.horizontalCenter: parent.horizontalCenter 
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -13
    size: 50 50
    padding: 1
    virtual: true

  UIWidget
    id: Status
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter 
    margin-bottom: -40
    margin-left: 1
    image-source: des
    image-size: 64 20

  ProgressBar
    id: Timer
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter 
    background-color: #8a2a18
    size: 64 18

  Button
    id: claim
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter 
    // ember instead of the stock green, to match the Chaos palette
    image-color: #d8762a
    color: #fff1d6
    text: Claim
    size: 64 18

MainWindow
  !text: tr('Daily Reward')
  size: 549 466
  @onEscape: toggle()

  Panel
    id: itemsPanel
    image-source: /images/ui/panel_flat
    image-border: 1
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: streakPanel.top
    margin-bottom: 6
    padding: 8

    GetItems
      id: daily1
      size: 120 140
      anchors.top: parent.top
      anchors.left: parent.left
      text: Day 1

    GetItems
      id: daily2
      size: 120 140
      anchors.top: parent.top
      anchors.left: daily1.right
      margin-left: 8
      text: Day 2

    GetItems
      id: daily3
      size: 120 140
      anchors.top: parent.top
      anchors.left: daily2.right
      margin-left: 8
      text: Day 3

    GetItems
      id: daily4
      size: 120 140
      anchors.top: daily1.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Day 4

    GetItems
      id: daily5
      size: 120 140
      anchors.top: daily2.bottom
      anchors.left: daily4.right
      margin-left: 8
      margin-top: 8
      text: Day 5

    GetItems
      id: daily6
      size: 120 140
      anchors.top: daily3.bottom
      anchors.left: daily5.right
      margin-left: 8
      margin-top: 8
      text: Day 6

    GetItems
      id: daily7
      width: 120
      anchors.top: daily3.top
      anchors.right: parent.right
      anchors.bottom: daily6.bottom
      margin-left: 8
      text: Day 7

  // login streak (server daily.lua: Streak, Best, Grace, Next, Title); hidden when the server sends none
  Panel
    id: streakPanel
    image-source: /images/ui/panel_flat
    image-border: 1
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 10
    height: 84
    padding: 6

    Label
      id: streakLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: bestLabel.left
      text-align: left
      font: verdana-11px-rounded
      color: #f6cf72

    Label
      id: bestLabel
      anchors.top: parent.top
      anchors.right: parent.right
      text-auto-resize: true
      color: #d6c9ae

    Label
      id: graceLabel
      anchors.top: streakLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      text-auto-resize: true
      color: #d6c9ae
      phantom: false

    Label
      id: titleLabel
      anchors.top: streakLabel.bottom
      anchors.right: parent.right
      margin-top: 4
      text-auto-resize: true
      color: #b070ff

    Label
      id: milestoneLabel
      anchors.top: graceLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 28
      text-align: left
      text-wrap: true
      color: #e8b84a

  Button
    id: closeButton
    !text: tr('Close')
    margin-bottom: -5
    width: 100
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    @onClick: toggle()