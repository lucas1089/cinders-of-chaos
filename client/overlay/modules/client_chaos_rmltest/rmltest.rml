<rml>
<head>
	<title>RmlUi test</title>
	<link type="text/rcss" href="rmltest.rcss"/>
</head>
<body>
	<div id="window">
		<div id="titlebar">
			<span id="title"></span>
			<button id="x" class="icon">X</button>
		</div>
		<div id="subtitle"></div>
		<div id="list"></div>
		<div id="footer">
			<button id="refresh" class="primary"></button>
			<button id="done"></button>
		</div>
	</div>
</body>
</rml>
