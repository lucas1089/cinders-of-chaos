// Trainer DPS panel (client game_trainerdps; server trainer_meter.lua, extended opcode 147). Styles from client_chaos_theme;
// the bar rows, the mini buttons and the icons are the DPS meter's (game_dpsmeter dpsmeter.otui: DpsBarRow, DpsMiniButton,
// DpsTabButton, DpsIcon), imported by that module before this one loads (dependency).

TrainerStat < UIWidget
  height: 26
  phantom: true

  UILabel
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    font: Verdana-9px-antialiased
    color: #8c8070
    text-auto-resize: true
    phantom: true

  UILabel
    id: value
    anchors.top: caption.bottom
    anchors.left: parent.left
    margin-top: 1
    font: verdana-11px-rounded
    color: #f6cf72
    text-auto-resize: true
    phantom: true

TrainerLine < UILabel
  height: 12
  font: Verdana-9px-antialiased
  color: #d6c9ae
  text-align: left
  phantom: true

TrainerDpsPanel < UIWidget
  id: trainerDps
  size: 260 330
  image-source: /images/chaos/panel_dark
  image-border: 6
  anchors.top: parent.top
  anchors.right: parent.right
  margin-top: 120
  margin-right: 12
  focusable: false
  phantom: false
  // the phone interface is 540 high and narrow: a smaller panel higher up
  $mobile:
    size: 230 290
    margin-top: 40
    margin-right: 6

  UIWidget
    id: header
    height: 14
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 3 0 3
    background-color: #1a1418cc
    cursor: pointer

    UILabel
      id: title
      !text: tr('Trainer DPS')
      font: Verdana-9px-antialiased
      color: #e8b84a
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      text-auto-resize: true
      phantom: true

    UIWidget
      id: liveDot
      size: 6 6
      anchors.left: title.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      background-color: #e03a1e
      visible: false
      phantom: true

    DpsMiniButton
      id: closeButton
      text: x
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      !tooltip: tr('Close (it opens again at the next session)')
      @onClick: modules.game_trainerdps.hide()

    DpsMiniButton
      id: menuButton
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 2
      text: ...
      !tooltip: tr('Settings, export and position')
      @onClick: modules.game_trainerdps.showMenu()

  UILabel
    id: trainerName
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 8 0 8
    height: 12
    font: Verdana-9px-antialiased
    color: #f2e8d0
    text-align: left
    phantom: true

  TrainerStat
    id: statCur
    anchors.top: trainerName.bottom
    anchors.left: parent.left
    margin-top: 3
    margin-left: 8
    width: 118

  TrainerStat
    id: statAvg
    anchors.top: statCur.top
    anchors.left: parent.horizontalCenter
    margin-left: 4
    width: 118

  TrainerStat
    id: statTotal
    anchors.top: statCur.bottom
    anchors.left: parent.left
    margin-top: 3
    margin-left: 8
    width: 118

  TrainerStat
    id: statTime
    anchors.top: statTotal.top
    anchors.left: parent.horizontalCenter
    margin-left: 4
    width: 118

  TrainerLine
    id: bigLine
    anchors.top: statTotal.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 8 0 8

  TrainerLine
    id: hitsLine
    anchors.top: bigLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 1 8 0 8

  TrainerLine
    id: profileLine
    anchors.top: hitsLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 1 8 0 8
    color: #8c8070

  UIWidget
    id: tabs
    height: 14
    anchors.top: profileLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4 8 0 8
    phantom: true
    layout:
      type: horizontalBox

  TrainerLine
    id: status
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3 8 0 8
    color: #b8923a

  UIScrollArea
    id: rows
    anchors.top: status.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: keepRow.top
    margin: 2 6 4 6
    layout:
      type: verticalBox
    auto-focus: none

  UILabel
    id: emptyText
    anchors.centerIn: rows
    text-auto-resize: true
    font: Verdana-9px-antialiased
    color: #8c8070
    phantom: true

  UIWidget
    id: keepRow
    height: 16
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonRow.top
    margin: 0 8 3 8
    phantom: false

    ChaosCheckBox
      id: keepBox
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 110
      !text: tr('Keep open')
      !tooltip: tr('Do not hide the panel when the session ends')
      @onCheckChange: modules.game_trainerdps.setKeep(self:isChecked())

    ChaosCheckBox
      id: autoBox
      anchors.left: keepBox.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 120
      !text: tr('Open by itself')
      !tooltip: tr('Open the panel when you hit a trainer')
      @onCheckChange: modules.game_trainerdps.setAuto(self:isChecked())

  UIWidget
    id: buttonRow
    height: 16
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 8 6 8
    phantom: false

    DpsMiniButton
      id: resetButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      !text: tr('Reset')
      !tooltip: tr('Start the session over (nothing counts until the next hit)')
      @onClick: modules.game_trainerdps.resetMeter()

    DpsMiniButton
      id: copyButton
      anchors.left: resetButton.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      !text: tr('Copy')
      !tooltip: tr('Copy the result to the clipboard')
      @onClick: modules.game_trainerdps.exportClipboard()

    DpsMiniButton
      id: chatButton
      anchors.left: copyButton.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      !text: tr('To chat')
      !tooltip: tr('Put a one-line result into the chat input (you decide whether to send it)')
      @onClick: modules.game_trainerdps.exportChat()
