// The grips beside the bottom area (action bars + console). Width: the right edge. Move: the left edge.
// The height keeps the base splitter above the action bars (bottomSplitter).
ChaosChatGrip < UIWidget
  width: 6
  focusable: false
  background-color: #5a3a2960
  border-width: 1
  border-color: #8a5a3a80
  $hover:
    background-color: #c8782eaa
  $pressed:
    background-color: #e0a050cc

ChaosChatWidthGrip < ChaosChatGrip
  !tooltip: tr('Drag to change the width of the chat. Double-click: default width.')

ChaosChatMoveGrip < ChaosChatGrip
  !tooltip: tr('Drag to move the chat sideways. Double-click: back to the centre.')
