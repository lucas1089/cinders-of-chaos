Module
  name: game_battleground
  description: Battleground "Ember Wells" and the PvP seasons - queue window, season tiers and rewards, honor vendor, match HUD, scoreboard and summary (extended opcode 200)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ bgview, battleground ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1006
  @onLoad: init()
  @onUnload: terminate()
