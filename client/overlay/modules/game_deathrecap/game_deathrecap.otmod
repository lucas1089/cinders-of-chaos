Module
  name: game_deathrecap
  description: Death recap - who killed the character, with what and how fast, and its last 5 deaths (server deathrecap.lua, extended opcode 154)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ deathrecaplogic, deathrecap ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1002
  @onLoad: init()
  @onUnload: terminate()
