// Ember Cache window (game_embercache). Styles from client_chaos_theme (styles.otui).

EmberTierRow < UIWidget
  height: 34
  phantom: true

  ChaosLabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 6
    width: 200
    height: 16
    text-align: left

  ChaosLabel
    id: status
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 6
    width: 120
    height: 16
    text-align: right

  ChaosLabelDim
    id: reward
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 14
    height: 16
    text-align: left

EmberBookRow < UIWidget
  height: 18
  background-color: #1a151a
  phantom: true

  ChaosLabelDim
    id: label
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 200
    text-align: left

  ChaosLabel
    id: value
    anchors.left: label.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    text-align: right

ChaosMainWindow
  id: emberCacheWindow
  size: 400 560
  !text: tr('Ember Cache')
  @onEscape: modules.game_embercache.hide()

  ChaosBloodLabel
    id: week
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 18
    text-align: center

  ChaosLabelDim
    id: weekEnds
    anchors.top: week.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: center

  UIWidget
    id: tiers
    anchors.top: weekEnds.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 102
    phantom: true
    layout:
      type: verticalBox

  ChaosLabelDim
    id: sparks
    anchors.top: tiers.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: left
    margin-left: 6

  ChaosSeparator
    id: sep1
    anchors.top: sparks.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  ChaosLabel
    id: today
    anchors.top: sep1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    color: #e8b84a
    text-align: left
    margin-left: 6

  ChaosLabel
    id: spark
    anchors.top: today.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: left
    margin-left: 6

  ChaosLabelDim
    id: sparkReward
    anchors.top: spark.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: left
    margin-left: 14

  ChaosLabelDim
    id: bonus
    anchors.top: sparkReward.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: left
    margin-left: 6

  ChaosSeparator
    id: sep2
    anchors.top: bonus.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  ChaosLabel
    id: bookTitle
    anchors.top: sep2.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 16
    color: #e8b84a
    text-align: left
    margin-left: 6
    !text: tr('Day book: what you did today')

  UIWidget
    id: book
    anchors.top: bookTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 162
    phantom: true
    layout:
      type: verticalBox

  ChaosLabel
    id: howTo
    phantom: false
    anchors.left: parent.left
    anchors.right: offerButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-left: 6
    margin-right: 8
    height: 16
    color: #70c8f0
    text-align: left
    !text: tr('How to earn points (hover)')

  ChaosButton
    id: offerButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    width: 120
    !text: tr('Offer junk orbs')
    !tooltip: tr('Trade the common orbs you do not need (Upheaval, Awakening, Whetstone, Erasure) for Ember points: 10 orbs a point, at most 60 points a day.')
    @onClick: modules.game_embercache.offerOrbs()

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    !text: tr('Close')
    @onClick: modules.game_embercache.hide()
