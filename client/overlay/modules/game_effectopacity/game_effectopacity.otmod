Module
  name: game_effectopacity
  description: Effect opacity (Options > Effects, base patches 0049 and 0202): my effects and the others, moves old values over once, asks the server which effects are mine (extended opcode 164), warnings never fade
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ effectopacitylogic, effectopacity ]
  dependencies:
    - client_settings
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
