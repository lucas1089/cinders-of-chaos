Module
  name: game_leaderboard
  description: Leaderboards (weekly boards with titles, class ladder, records and realm firsts; extended opcode 229)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ tabrows, recordsview, leaderboard ]
