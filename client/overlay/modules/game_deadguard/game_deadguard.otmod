Module
  name: game_deadguard
  description: Safety net for a dead monster that stays on the map at 0 percent health (removal packet lost): removed locally after 3 seconds
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ deadguard_logic, deadguard ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1004
  @onLoad: init()
  @onUnload: terminate()
