// Store pouches (game_pouches): the Loot Bag rules window. Styles from client_chaos_theme.

PouchCheck < ChaosCheckBox
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 6

PouchesWindow < ChaosMainWindow
  id: pouchesWindow
  size: 420 452
  !text: tr('Loot Bag')
  @onEscape: modules.game_pouches.hideSettings()

  ChaosLabelDim
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 58
    text-wrap: true
    text-align: topLeft
    !text: tr('While you carry your Loot Bag it takes these items from the monsters you kill. Orbs, gems and keys always go to the Orbs and Rift Key Pouch first. A full pouch passes the item on (below), then to your backpack.')

  PouchCheck
    id: list
    anchors.top: intro.bottom
    !text: tr('Items on my autoloot list')

  PouchCheck
    id: gold
    anchors.top: list.bottom
    !text: tr('Gold, platinum and crystal coins')

  PouchCheck
    id: uniques
    anchors.top: gold.bottom
    !text: tr('Unique items')

  PouchCheck
    id: gear
    anchors.top: uniques.bottom
    anchors.right: none
    width: 250
    margin-top: 9
    !text: tr('Gear with a rarity of at least')

  ChaosComboBox
    id: rarityCombo
    anchors.top: uniques.bottom
    anchors.right: parent.right
    margin-top: 4
    size: 130 22

  PouchCheck
    id: supplies
    anchors.top: gear.bottom
    margin-top: 8
    !text: tr('Supplies (potions, runes, ammunition, food)')

  PouchCheck
    id: gems
    anchors.top: supplies.bottom
    !text: tr('Gems (when you carry no Orbs Pouch)')

  PouchCheck
    id: other
    anchors.top: gems.bottom
    !text: tr('Everything else (creature products, valuables)')

  PouchCheck
    id: overflow
    anchors.top: other.bottom
    !text: tr('Overflow: what a full Orbs or Rift Key Pouch passes on')

  // the note on the Loot Bag: the full width, as many lines as it needs (pt-BR is longer); Open Store under it
  ChaosLabel
    id: status
    anchors.top: overflow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    text-wrap: true
    text-auto-resize: true
    text-align: topLeft
    color: #e8b84a

  ChaosButton
    id: storeButton
    anchors.top: status.bottom
    anchors.right: parent.right
    margin-top: 6
    size: 92 24
    !text: tr('Open Store')
    @onClick: modules.game_pouches.openStore()

  ChaosButton
    id: sellButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 100 24
    !text: tr('Auto Seller')
    !tooltip: tr('Opens the Auto Seller: sell everything in your Loot Bag at NPC prices (every 30 seconds) and pick the rarities it sells.')
    @onClick: modules.game_pouches.showAutoSeller()

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_pouches.hideSettings()

  // its own line above the buttons (it ran under Auto Seller / Close: live test winpkg-35)
  ChaosLabelDim
    id: savedLabel
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    text-wrap: true
    text-auto-resize: true
    text-align: left
    !text: tr('Saved on your character at once.')
