Module
  name: game_pouches
  description: Store pouches - the Loot Bag rules window (right-click the bag > Pouch settings, or Loot Filter > Loot Bag) and the Auto Seller window (Economy > Auto Seller); extended opcode 226
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ pouchesview, autosellerview, pouches ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1002
  @onLoad: init()
  @onUnload: terminate()
