Module
  name: game_waystone
  description: The waystone device window (the base server's waystone maps, extended opcode 202): pick a Waystone Tier, open the portals, choose the portal look
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ waystonelogic, waystone ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
