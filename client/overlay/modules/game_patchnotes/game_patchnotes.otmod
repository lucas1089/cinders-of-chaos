Module
  name: game_patchnotes
  description: Patch notes window (weekly notes sent by the server; extended opcode 244)
  author: project-chaos
  sandboxed: true
  scripts: [ patchnotesview, patchnotes ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
