// Patch notes window (game_patchnotes). Styles from client_chaos_theme (styles.otui).

PatchWeekEntry < UIWidget
  height: 50
  margin-bottom: 2
  padding: 4 6 4 8
  phantom: false
  focusable: true
  background-color: #1a151a

  $hover !checked:
    background-color: #241c22

  $checked:
    background-color: #3a2410

  UILabel
    id: date
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: newBadge.left
    height: 15
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    phantom: true

  UILabel
    id: newBadge
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #7cd35a
    phantom: true

  UILabel
    id: title
    anchors.top: date.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 28
    font: verdana-11px-antialised
    color: #d6c9ae
    text-align: topleft
    text-wrap: true
    phantom: true

PatchTitle < UILabel
  font: Verdana Bold-13px
  color: #f6cf72
  text-wrap: true
  text-auto-resize: true
  text-align: topleft
  phantom: true

PatchDate < UILabel
  font: verdana-11px-antialised
  color: #8c8070
  text-auto-resize: true
  text-align: left
  margin-top: 2
  phantom: true

PatchIntro < UILabel
  font: verdana-11px-antialised
  color: #d6c9ae
  text-wrap: true
  text-auto-resize: true
  text-align: topleft
  margin-top: 8
  phantom: true

PatchSection < UILabel
  font: Verdana Bold-13px
  color: #e8b84a
  height: 20
  text-align: bottomleft
  margin-top: 14
  margin-bottom: 4
  phantom: true

  UIWidget
    id: rule
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: -3
    height: 1
    background-color: #3a3339
    phantom: true

PatchParagraph < UILabel
  font: verdana-11px-antialised
  color: #d6c9ae
  text-wrap: true
  text-auto-resize: true
  text-align: topleft
  margin-top: 4
  phantom: true

// a bullet: the dot and the wrapped text side by side; patchnotes.lua keeps the row as tall as its text
PatchBullet < UIWidget
  height: 14
  margin-top: 4
  phantom: true

  UIWidget
    id: dot
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    margin-left: 5
    size: 5 5
    background-color: #e8b84a
    phantom: true

  UILabel
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 16
    font: verdana-11px-antialised
    color: #d6c9ae
    text-wrap: true
    text-auto-resize: true
    text-align: topleft
    phantom: true

// a sub-bullet: dot and text further in (patchnotes.lua)
PatchSubBullet < PatchBullet
  margin-top: 2

// the Changelog tab: a date line, then one row per change (dot in the first tag's colour, coloured tags, the text)
ChangelogDate < PatchSection
  margin-top: 10

ChangelogEntry < PatchBullet

// a tag filter of the Changelog tab
ChangelogFilter < ChaosTabButton
  size: 86 22
  margin-left: 4
  !tooltip: tr('Show only the changes with this tag.')

ChaosMainWindow
  id: patchNotesWindow
  size: 780 560
  !text: tr('Patch Notes')
  @onEscape: modules.game_patchnotes.hide()

  ChaosTabButton
    id: tabNotes
    anchors.top: parent.top
    anchors.left: parent.left
    width: 150
    !text: tr('Patch Notes')
    @onClick: modules.game_patchnotes.setTab('notes')

  ChaosTabButton
    id: tabChangelog
    anchors.top: parent.top
    anchors.left: tabNotes.right
    margin-left: 4
    width: 170
    !text: tr('Changelog')
    !tooltip: tr('Every change that reached the server or the client, newest first, from the project history. The entries are written in English.')
    @onClick: modules.game_patchnotes.setTab('changelog')

  ChaosLabelDim
    id: weeksLabel
    anchors.top: tabNotes.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 210
    text-align: left
    !text: tr('Weeks')

  ChaosPanelDark
    id: weekFrame
    anchors.top: weeksLabel.bottom
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-top: 4
    margin-bottom: 8
    width: 210

  UIScrollArea
    id: weekList
    anchors.top: weekFrame.top
    anchors.left: weekFrame.left
    anchors.right: weekScroll.left
    anchors.bottom: weekFrame.bottom
    margin: 4
    layout:
      type: verticalBox
    vertical-scrollbar: weekScroll
    auto-focus: none

  ChaosScrollBar
    id: weekScroll
    anchors.top: weekFrame.top
    anchors.right: weekFrame.right
    anchors.bottom: weekFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 52
    pixels-scroll: true

  ChaosPanelDark
    id: noteFrame
    anchors.top: tabNotes.bottom
    margin-top: 8
    anchors.left: weekFrame.right
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-left: 8
    margin-bottom: 8

  UIScrollArea
    id: noteArea
    anchors.top: noteFrame.top
    anchors.left: noteFrame.left
    anchors.right: noteScroll.left
    anchors.bottom: noteFrame.bottom
    margin: 10 8 10 14
    layout:
      type: verticalBox
    vertical-scrollbar: noteScroll
    auto-focus: none

  ChaosScrollBar
    id: noteScroll
    anchors.top: noteFrame.top
    anchors.right: noteFrame.right
    anchors.bottom: noteFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 36
    pixels-scroll: true

  ChaosLabelDim
    id: emptyText
    anchors.centerIn: noteFrame
    text-auto-resize: true
    visible: false

  ChaosLabel
    id: changelogInfo
    anchors.top: tabNotes.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 16
    text-align: left
    visible: false

  ChangelogFilter
    id: filter_all
    anchors.top: changelogInfo.bottom
    anchors.left: parent.left
    margin-top: 6
    margin-left: 0
    visible: false
    !text: tr('All')
    @onClick: modules.game_patchnotes.setFilter('all')

  ChangelogFilter
    id: filter_server
    anchors.top: filter_all.top
    anchors.left: filter_all.right
    visible: false
    !text: tr('Server')
    @onClick: modules.game_patchnotes.setFilter('server')

  ChangelogFilter
    id: filter_client
    anchors.top: filter_all.top
    anchors.left: filter_server.right
    visible: false
    !text: tr('Client')
    @onClick: modules.game_patchnotes.setFilter('client')

  ChangelogFilter
    id: filter_content
    anchors.top: filter_all.top
    anchors.left: filter_client.right
    visible: false
    !text: tr('Content')
    @onClick: modules.game_patchnotes.setFilter('content')

  ChangelogFilter
    id: filter_website
    anchors.top: filter_all.top
    anchors.left: filter_content.right
    visible: false
    !text: tr('Website')
    @onClick: modules.game_patchnotes.setFilter('website')

  ChaosPanelDark
    id: changelogFrame
    anchors.top: filter_all.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 6
    margin-bottom: 8
    visible: false

  UIScrollArea
    id: changelogList
    anchors.top: changelogFrame.top
    anchors.left: changelogFrame.left
    anchors.right: changelogScroll.left
    anchors.bottom: changelogFrame.bottom
    margin: 4 8 10 14
    layout:
      type: verticalBox
    vertical-scrollbar: changelogScroll
    auto-focus: none
    visible: false

  ChaosScrollBar
    id: changelogScroll
    anchors.top: changelogFrame.top
    anchors.right: changelogFrame.right
    anchors.bottom: changelogFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 36
    pixels-scroll: true
    visible: false

  ChaosLabelDim
    id: changelogEmpty
    anchors.centerIn: changelogFrame
    text-auto-resize: true
    visible: false

  ChaosCheckBox
    id: autoCheck
    anchors.left: parent.left
    anchors.verticalCenter: closeButton.verticalCenter
    width: 240
    !text: tr("Don't show automatically")
    !tooltip: tr('When checked, new patch notes no longer open by themselves at login. Social > Patch Notes still opens them.')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_patchnotes.hide()
