Module
  name: game_siege
  description: Guild siege HUD (scores, time left, obelisk holder) and sign-up window (extended opcode 233)
  author: project-chaos
  sandboxed: true
  scripts: [ siegemath, siege ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
