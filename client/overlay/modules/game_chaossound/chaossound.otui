// Game sound (game_chaossound): the settings window. Styles from client_chaos_theme.

ChaosSoundCheck < ChaosCheckBox
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 8

ChaosSoundWindow < ChaosMainWindow
  id: chaosSoundWindow
  size: 420 452
  !text: tr('Game Sound')
  @onEscape: modules.game_chaossound.hide()

  ChaosLabelDim
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 42
    text-wrap: true
    text-align: topLeft
    !text: tr('Short sounds for your fights, spells and rewards. They follow the sound switch and the effect volume of the client.')

  ChaosSoundCheck
    id: enabled
    anchors.top: intro.bottom
    !text: tr('Game sounds')

  ChaosSoundCheck
    id: combat
    anchors.top: enabled.bottom
    !text: tr('Hits, kills and damage taken')
    !tooltip: tr('Your hits, critical hits and kills, the hits you take, your dodges and blocks.')

  ChaosSoundCheck
    id: spells
    anchors.top: combat.bottom
    !text: tr('Spells by element')
    !tooltip: tr('A sound for fire, ice, energy, holy, death, earth, physical and healing spell effects near you.')

  ChaosSoundCheck
    id: events
    anchors.top: spells.bottom
    !text: tr('Level up, rare loot and goals')
    !tooltip: tr('Rare and better drops sound unless your loot filter already plays an alert for them.')

  ChaosSoundCheck
    id: ui
    anchors.top: events.bottom
    !text: tr('Windows and buttons')
    !tooltip: tr('A very quiet click when a window opens or closes or a button is pressed.')

  ChaosLabel
    id: volumeLabel
    anchors.top: ui.bottom
    anchors.left: parent.left
    margin-top: 16
    width: 80
    !text: tr('Volume')

  ChaosComboBox
    id: volumeCombo
    anchors.verticalCenter: volumeLabel.verticalCenter
    anchors.left: volumeLabel.right
    margin-left: 8
    size: 110 22

  // region music (game_chaosmusic, O408): chaossound.lua reads and writes its settings
  ChaosSoundCheck
    id: musicEnabled
    anchors.top: volumeLabel.bottom
    margin-top: 22
    !text: tr('Region music')
    !tooltip: tr('A music track for where you are: town, hunting grounds, dungeons and rifts, boss fights, arenas and the login screen. It changes with a soft cross-fade.')

  ChaosLabel
    id: musicVolumeLabel
    anchors.top: musicEnabled.bottom
    anchors.left: parent.left
    margin-top: 14
    width: 120
    !text: tr('Music volume')

  ChaosLabel
    id: musicVolumeValue
    anchors.verticalCenter: musicVolumeLabel.verticalCenter
    anchors.right: parent.right
    width: 44
    text-align: right

  HorizontalScrollBar
    id: musicVolume
    anchors.verticalCenter: musicVolumeLabel.verticalCenter
    anchors.left: musicVolumeLabel.right
    anchors.right: musicVolumeValue.left
    margin-left: 8
    margin-right: 8
    minimum: 0
    maximum: 100
    step: 5

  ChaosSoundCheck
    id: musicBackground
    anchors.top: musicVolumeLabel.bottom
    margin-top: 14
    !text: tr('Mute the music when the client is not in front')
    !tooltip: tr('The music fades out while another window has the focus. A minimized client is always silent.')

  ChaosLabelDim
    id: savedLabel
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.left: parent.left
    anchors.right: closeButton.left
    text-align: left
    !text: tr('Saved on this computer.')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_chaossound.hide()
