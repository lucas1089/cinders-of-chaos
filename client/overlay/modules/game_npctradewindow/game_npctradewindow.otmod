Module
  name: game_npctradewindow
  description: The NPC trade window (O571): Buy and Sell tabs, search, category chips, item cards, an amount panel with the total, and a Sell all window with a preview
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ tradewindowlogic, trademodel, tradeview, tradewindow ]
  dependencies:
    - game_interface
    - game_npctrade
  autoload: true
  autoload-priority: 1001
  @onLoad: init()
  @onUnload: terminate()
