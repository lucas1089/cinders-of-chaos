Module
  name: game_npctradewindow
  description: The NPC trade (buy / sell) list as a proper window in the middle of the game view instead of a small widget in the side panel
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ tradewindowlogic, tradewindow ]
  dependencies:
    - game_interface
    - game_npctrade
  autoload: true
  autoload-priority: 1001
  @onLoad: init()
  @onUnload: terminate()
