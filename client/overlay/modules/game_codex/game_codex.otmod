Module
  name: game_codex
  description: Codex (encyclopedia of modifiers, powers, orbs, gems, uniques, rift modifiers and supports; static data, no opcode)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ codex_data, codexview, codex ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
