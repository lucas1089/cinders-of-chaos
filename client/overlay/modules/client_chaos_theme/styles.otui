// =============================================================================
//  Chaos theme styles  (OTClient 10.98 / classic OTUI syntax)
//
//  PALETTE (OTUI has no variables: these are the only hex values used below,
//  and the same set is mirrored in chaos_theme.lua -> ChaosTheme.palette)
//
//    bg / near-black ............ #0d0b0e
//    iron ....................... #3a3339   iron light #7d7176
//    text (parchment) ........... #d6c9ae   dim #8c8070   disabled #6b6258
//    ember gold ................. #e8b84a   bright #f6cf72
//    blood ...................... #b8160f   bright #e03a1e   dark #5a0a0a
//    health fill ................ #8a1010
//    mana fill .................. #1f3f8f
//
//  All images live in /images/chaos/ (generated by client/tools/gen_theme_art.py)
// =============================================================================

// ---------------------------------------------------------------- windows
ChaosWindow < UIWindow
  font: verdana-11px-antialised
  size: 236 207
  opacity: 1
  color: #e8b84a
  text-align: top
  text-offset: 0 9
  image-source: /images/chaos/window
  image-border: 18
  image-border-top: 34
  padding-top: 38
  padding-left: 16
  padding-right: 16
  padding-bottom: 16
  draggable: true
  &chaosOrnate: true
  &chaosTitleY: 15

  $disabled:
    color: #8c8070

ChaosMainWindow < ChaosWindow
  anchors.centerIn: parent

ChaosStaticWindow < ChaosWindow
  &static: true

ChaosStaticMainWindow < ChaosStaticWindow
  anchors.centerIn: parent

// ---------------------------------------------------------------- panels
ChaosPanel < UIWidget
  image-source: /images/chaos/panel
  image-border: 8
  padding: 8
  phantom: false

ChaosPanelDark < UIWidget
  image-source: /images/chaos/panel_dark
  image-border: 6
  padding: 6

ChaosPanelHighlight < UIWidget
  image-source: /images/chaos/panel_highlight
  image-border: 8
  padding: 8

// Title banner (header strip inside a window or panel)
ChaosTitlePlate < UIWidget
  image-source: /images/chaos/title_plate
  image-border: 8
  image-border-left: 12
  image-border-right: 12
  height: 24
  phantom: true

// ---------------------------------------------------------------- labels
ChaosLabel < UILabel
  font: verdana-11px-antialised
  color: #d6c9ae
  $disabled:
    color: #6b6258

ChaosLabelDim < ChaosLabel
  color: #8c8070

ChaosTitle < UILabel
  font: verdana-11px-rounded
  color: #e8b84a
  text-align: center
  height: 20

ChaosBloodLabel < ChaosLabel
  color: #e03a1e

// ---------------------------------------------------------------- buttons
ChaosButton < UIButton
  font: verdana-11px-antialised
  color: #d6c9ae
  size: 106 24
  text-offset: 0 1
  image-source: /images/chaos/button_normal
  image-border: 6
  padding: 5 10 5 10
  opacity: 1.0
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-source: /images/chaos/button_hover
    color: #f6cf72

  $pressed:
    image-source: /images/chaos/button_pressed
    color: #e03a1e
    text-offset: 1 2

  $disabled:
    image-source: /images/chaos/button_disabled
    color: #6b6258
    change-cursor-image: false

// ---------------------------------------------------------------- text edit
ChaosTextEdit < UITextEdit
  // base values of what a state below changes: a state style is not undone when the state ends (only the base
  // style's own values come back)
  opacity: 1
  font: verdana-11px-antialised
  color: #d6c9ae
  size: 86 22
  text-offset: 0 4
  padding: 4
  image-source: /images/chaos/textedit
  image-border: 4
  selection-color: #0d0b0e
  selection-background-color: #e8b84a
  change-cursor-image: true

  $focus:
    image-source: /images/chaos/textedit_focus
    color: #f6cf72

  $disabled:
    color: #6b6258
    opacity: 0.6
    change-cursor-image: false

ChaosPasswordTextEdit < ChaosTextEdit
  text-hidden: true

ChaosMultilineTextEdit < ChaosTextEdit
  multiline: true

// ---------------------------------------------------------------- tabs
ChaosTabButton < UIButton
  font: verdana-11px-antialised
  size: 96 24
  color: #8c8070
  text-offset: 0 1
  image-source: /images/chaos/tab_normal
  image-border: 6
  padding: 3 8 3 8
  change-cursor-image: true
  cursor: pointer

  $hover !checked:
    image-source: /images/chaos/tab_hover
    color: #d6c9ae

  $checked:
    image-source: /images/chaos/tab_active
    color: #f6cf72

  $disabled:
    color: #6b6258

// ---------------------------------------------------------------- progress bars
// The fill is the widget's background-color (clipped to the percent by the
// engine); /images/chaos/progress_frame is an iron frame with a translucent
// dark track.  Blood red = health (default), dark blue = mana.
ChaosProgressBar < UIProgressBar
  height: 16
  background-color: #8a1010
  image-source: /images/chaos/progress_frame
  image-border: 3
  font: verdana-11px-rounded
  color: #d6c9ae
  text-offset: 0 2

ChaosHealthBar < ChaosProgressBar
  background-color: #8a1010

ChaosManaBar < ChaosProgressBar
  background-color: #1f3f8f

// ---------------------------------------------------------------- scrollbar
ChaosScrollBarSlider < UIButton
  // base values of what a state below changes: a state style is not undone when the state ends (only the base
  // style's own values come back)
  image-color: #ffffff
  id: sliderButton
  anchors.centerIn: parent
  size: 13 17
  image-source: /images/chaos/scroll_slider
  image-border: 3

  $hover:
    image-source: /images/chaos/scroll_slider_hover

  $pressed:
    image-source: /images/chaos/scroll_slider_pressed

  $disabled:
    image-color: #ffffff66

ChaosScrollBar < UIScrollBar
  orientation: vertical
  width: 13
  height: 39
  image-source: /images/chaos/scroll_track
  image-border: 1
  pixels-scroll: true

  UIButton
    id: decrementButton
    anchors.top: parent.top
    anchors.left: parent.left
    size: 13 13
    image-source: /images/chaos/scroll_up
    $hover:
      image-source: /images/chaos/scroll_up_hover
    $pressed:
      image-source: /images/chaos/scroll_up_pressed
    $disabled:
      image-color: #ffffff66

  UIButton
    id: incrementButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 13 13
    image-source: /images/chaos/scroll_down
    $hover:
      image-source: /images/chaos/scroll_down_hover
    $pressed:
      image-source: /images/chaos/scroll_down_pressed
    $disabled:
      image-color: #ffffff66

  ChaosScrollBarSlider

// ---------------------------------------------------------------- checkbox
// checkbox.png is a 16x32 sheet: top = unchecked, bottom = checked
ChaosCheckBox < UICheckBox
  // base values of what a state below changes: a state style is not undone when the state ends (only the base
  // style's own values come back)
  image-color: #ffffff
  size: 16 16
  font: verdana-11px-antialised
  text-align: left
  text-offset: 22 1
  color: #d6c9ae
  image-source: /images/chaos/checkbox
  image-rect: 0 0 16 16
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    color: #f6cf72

  $!checked:
    image-clip: 0 0 16 16

  $checked:
    image-clip: 0 16 16 16

  $disabled:
    image-color: #ffffff88
    color: #6b6258
    change-cursor-image: false

// ---------------------------------------------------------------- combobox
ChaosComboBox < UIComboBox
  // base values of what a state below changes: a state style is not undone when the state ends (only the base
  // style's own values come back)
  opacity: 1
  font: verdana-11px-antialised
  color: #d6c9ae
  size: 91 22
  text-offset: 5 2
  text-align: left
  image-source: /images/chaos/combobox
  image-border: 4
  image-border-right: 18

  $hover !disabled:
    color: #f6cf72

  $on:
    color: #e03a1e

  $disabled:
    color: #6b6258
    opacity: 0.8

// The drop-down list of a ChaosComboBox: UIComboBox creates "<its style>PopupMenu" (or "PopupScrollMenu") and
// UIPopupMenu "<that style>Button" per option, so these four must exist or the list never opens
// ("'ChaosComboBoxPopupMenu' is not a defined style", found with the character select's season box).
ChaosComboBoxPopupMenu < ComboBoxPopupMenu
  image-source: /images/chaos/panel_dark
  image-clip: 0 0 0 0
  image-border: 6
  padding: 3

ChaosComboBoxPopupMenuButton < ComboBoxPopupMenuButton
  height: 18
  font: verdana-11px-antialised
  color: #d6c9ae
  $hover !disabled:
    color: #f6cf72
    background-color: #5a0a0a88
  $disabled:
    color: #6b6258

ChaosComboBoxPopupScrollMenu < ComboBoxPopupScrollMenu
  image-source: /images/chaos/panel_dark
  image-clip: 0 0 0 0
  image-border: 6

ChaosComboBoxPopupScrollMenuButton < ComboBoxPopupScrollMenuButton
  height: 18
  font: verdana-11px-antialised
  color: #d6c9ae
  $hover !disabled:
    color: #f6cf72
    background-color: #5a0a0a88
  $disabled:
    color: #6b6258

// ---------------------------------------------------------------- separator
ChaosSeparator < UIWidget
  image-source: /images/chaos/separator
  image-border-left: 28
  image-border-right: 28
  height: 8
  phantom: true
  focusable: false

// ---------------------------------------------------------------- item slot
ChaosItemSlot < UIItem
  size: 34 34
  padding: 1
  image-source: /images/chaos/itemslot
  image-border: 4
  font: verdana-11px-rounded
  color: #d6c9ae
  border-color: #e8b84a

  $disabled:
    color: #6b6258
