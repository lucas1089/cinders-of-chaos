// Character plate (art: client/tools/import_hud_kit.py; the procedural version is gen_skin.py, group "hud").
// Positions match the plate image: portrait centre 47,48 (opening radius 24), fills at x 107, width 166 (BAR_W in
// chaoshud.lua), each in a track 14 wider at both ends that spans the trough (x 93 to 287); name line y 17 to 32, tracks
// y 34-51, 53-68, 70-79 (2 px apart); level badge centred under the ring (x 27 to 67, y 79 to 96).
ChaosHudText < UILabel
  font: verdana-11px-rounded
  color: #f4ead6
  text-align: center
  phantom: true

ChaosHudFill < UIWidget
  phantom: true
  anchors.left: parent.left
  anchors.top: parent.top
  margin-left: 107

UIWidget
  id: chaosHud
  size: 300 96
  anchors.top: parent.top
  anchors.left: gameMapPanel.left
  margin-top: 40
  margin-left: 34
  image-source: /images/chaos/skin/hud_plate
  phantom: true
  focusable: false

  UIWidget
    id: portraitClip
    size: 48 48
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 23
    margin-top: 24
    clipping: true
    phantom: true

    UICreature
      id: portrait
      size: 88 88
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: -31
      margin-top: -33
      phantom: true

  UIWidget
    id: portraitCover
    size: 96 96
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/chaos/skin/hud_portrait_cover
    phantom: true

  UILabel
    id: level
    size: 40 17
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 27
    margin-top: 79
    image-source: /images/chaos/skin/hud_level
    font: verdana-11px-rounded
    color: #ffe7a6
    text-align: center
    text-offset: 0 2
    phantom: false
    focusable: false

  UILabel
    id: name
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 109
    margin-top: 17
    size: 160 15
    font: verdana-11px-rounded
    color: #e8c477
    text-align: left
    phantom: true

  ChaosHudFill
    id: hpFill
    margin-top: 35
    size: 166 15
    image-source: /images/chaos/skin/hud_hp_fill

  ChaosHudText
    id: hpText
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 107
    margin-top: 35
    size: 166 15
    text-offset: 0 1

  ChaosHudFill
    id: mpFill
    margin-top: 54
    size: 166 13
    image-source: /images/chaos/skin/hud_mp_fill

  ChaosHudText
    id: mpText
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 107
    margin-top: 54
    size: 166 13

  ChaosHudFill
    id: xpFill
    margin-top: 71
    size: 166 7
    image-source: /images/chaos/skin/hud_xp_fill

  UIWidget
    id: xpHover
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 105
    margin-top: 69
    size: 170 11

  UIWidget
    id: barsHover
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 105
    margin-top: 33
    size: 170 36
    focusable: false
