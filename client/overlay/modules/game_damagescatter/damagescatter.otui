// Damage numbers settings (client game_damagescatter; Character > Damage Numbers). Styles from client_chaos_theme.
DamageScatterWindow < ChaosMainWindow
  id: damageScatterWindow
  !text: tr('Damage Numbers')
  size: 320 190

  ChaosLabel
    id: info
    !text: tr('The numbers above the map spread out a little, each hit with its own shift and speed, so an area hit or a group hunt stays readable. Saved for this character.')
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-wrap: true
    text-auto-resize: true

  ChaosCheckBox
    id: enabledBox
    !text: tr('Spread the damage numbers')
    anchors.top: info.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    @onCheckChange: modules.game_damagescatter.setEnabled(self:isChecked())

  ChaosLabel
    id: levelLabel
    !text: tr('Spread')
    anchors.top: enabledBox.bottom
    anchors.left: parent.left
    margin-top: 10
    width: 70

  ChaosComboBox
    id: levelCombo
    anchors.top: enabledBox.bottom
    anchors.left: levelLabel.right
    anchors.right: parent.right
    margin-top: 6
    height: 22
    !tooltip: tr('How far the numbers move away from the creature and how much their speed differs')

  ChaosButton
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_damagescatter.toggle()
