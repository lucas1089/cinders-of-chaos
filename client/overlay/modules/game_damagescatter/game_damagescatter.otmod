Module
  name: game_damagescatter
  description: Damage numbers spread out and typed - a random shift, speed and drift for the numbers above the map (base patches 0081, 0100), a font per number type, numbers that follow their creature; on/off and strength per character
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ scatterlogic, damagescatter ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1004
  @onLoad: init()
  @onUnload: terminate()
