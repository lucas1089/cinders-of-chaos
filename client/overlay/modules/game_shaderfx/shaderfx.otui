ChaosOrb < UIWidget
  size: 76 76
  phantom: true
  focusable: false

  UIWidget
    id: liquid
    size: 64 64
    anchors.centerIn: parent
    phantom: true
    image-source: /modules/game_shaderfx/images/orb_mask
    image-smooth: true

  UIWidget
    id: ring
    anchors.fill: parent
    phantom: true
    image-source: /modules/game_shaderfx/images/orb_ring

  Label
    id: value
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #f0e8dc
    phantom: true

// The two orbs are created in the game root panel (shaderfx.lua) and anchored to the chat panel's edges
// (bottomSplitter), beside the chat and its grips (game_chatpanel's ChaosChatLogic.orbMargins).
