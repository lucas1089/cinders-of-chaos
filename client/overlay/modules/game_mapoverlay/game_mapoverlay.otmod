Module
  name: game_mapoverlay
  description: Map overlay - the explored map drawn see-through over the game view, with points of interest (Tab; extended opcode 245, server map_marks.lua)
  author: project-chaos
  sandboxed: true
  scripts: [ mapmath, mapoverlay ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
