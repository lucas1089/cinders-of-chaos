// game_chaosdock (O732): the side dock, one right panel column wide under the minimap (O755). The client_chaos_theme skin only: the window frame, the tab buttons, the close X,
// the separator; the tab glyphs are the hub menu's (client_chaos_topbar/images/glyphs_bar, tinted in chaosdock.lua).

// an icon tab: the glyph (its name in the tooltip; the five share the column's width, chaosdock.lua sizeTabs). A phone sheet
// is wide: the name shows under the glyph there
ChaosDockTab < ChaosTabButton
  size: 32 30
  padding: 0
  text: ''

  $mobile:
    height: 54

  UIWidget
    id: glyph
    size: 24 24
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    phantom: true

    $mobile:
      size: 32 32
      margin-top: 1

  UILabel
    id: label
    font: Verdana-9px-antialiased
    color: #d6c9ae
    text-align: center
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 3
    height: 11
    phantom: true
    visible: false

    $mobile:
      font: verdana-11px-antialised
      height: 14
      visible: true

// one window of a tab that holds two or more: two a row (chaosdock.lua sizeTabs sets the cell width)
ChaosDockSub < ChaosTabButton
  size: 84 20
  padding: 1 1 1 1
  font: Verdana-8px-antialiased

// the dock: the right panel column under the minimap (chaosdock.lua relayout: its width and top margin), down to the
// bottom (it stops above the hotbar when the two would meet)
ChaosDockPanel < UIWidget
  id: chaosDock
  width: 178
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.right: parent.right
  image-source: /images/chaos/window
  image-border: 18
  image-border-top: 34
  padding: 6 4 4 4
  focusable: false
  phantom: false
  @onEscape: modules.game_chaosdock.closeDock()

  $mobile:
    padding: 8 8 8 8

  ChaosTitle
    id: title
    font: verdana-11px-rounded
    text-align: left
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: closeX.left
    margin-top: 1
    margin-left: 4
    margin-right: 6
    height: 20

  ChaosCloseX
    id: closeX
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 0
    margin-right: 0
    !tooltip: tr('Close')

  UIWidget
    id: tabs
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 30
    focusable: false
    layout:
      type: horizontalBox
      spacing: 2

    $mobile:
      height: 54

  UIWidget
    id: subs
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 20
    focusable: false
    layout:
      type: grid
      cell-size: 84 20
      cell-spacing: 2
      flow: true

  ChaosSeparator
    id: rule
    anchors.top: subs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  // the hosted window fills this area; one taller than it scrolls (the bar shows then, chaosdock.lua fit)
  UIWidget
    id: content
    anchors.top: rule.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    clipping: true
    focusable: false

    UIScrollArea
      id: scroller
      anchors.fill: parent
      vertical-scrollbar: scrollBar
      clipping: true
      focusable: false
      auto-focus: none

    ChaosScrollBar
      id: scrollBar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      step: 24
      pixels-scroll: true
      visible: false

  ChaosLabelDim
    id: note
    anchors.top: content.top
    anchors.left: content.left
    anchors.right: content.right
    margin-top: 16
    margin-left: 6
    margin-right: 6
    text-align: center
    text-wrap: true
    text-auto-resize: true
    visible: false
