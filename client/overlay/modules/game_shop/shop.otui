ShopCategory < Panel
  height: 56
  focusable: true
  background: alpha

  $focus:
    background: #99999999

  // the cosmetic itself as the icon where it is no item or creature: a print, a plate, an effect, a colour sample
  // (shopicon.lua draws into it; hidden until then)
  UIWidget
    id: art
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    size: 32 32
    phantom: true
    visible: false
    image-fixed-ratio: true
    text-align: center
    font: verdana-11px-rounded

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 40
    text-align: left
    color: white
    font: verdana-11px-rounded    
    
ShopCategoryItem < ShopCategory
  UIItem
    id: item
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    virtual: true
    size: 32 32
    
ShopCategoryCreature < ShopCategory
  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    size: 32 32
    
ShopCategoryImage < ShopCategory
  Label
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    size: 32 32

// the category tree (shoptree.lua): a subcategory row, indented and lower, under its open parent
ShopSubCategoryItem < ShopCategoryItem
  height: 40
  margin-left: 14

ShopSubCategoryCreature < ShopCategoryCreature
  height: 40
  margin-left: 14

ShopSubCategoryImage < ShopCategoryImage
  height: 40
  margin-left: 14

// a parent row (Cosmetics, Consumables ...): no focus of its own, a click opens or closes it (+ / -)
ShopGroupArrow < Label
  id: arrow
  anchors.right: parent.right
  anchors.verticalCenter: parent.verticalCenter
  margin-right: 8
  text-auto-resize: true
  color: #f0c050
  font: verdana-11px-rounded
  phantom: true

ShopGroupItem < ShopCategoryItem
  focusable: false
  $hover:
    background: #55555555
  ShopGroupArrow

ShopGroupCreature < ShopCategoryCreature
  focusable: false
  $hover:
    background: #55555555
  ShopGroupArrow

ShopGroupImage < ShopCategoryImage
  focusable: false
  $hover:
    background: #55555555
  ShopGroupArrow

    
    
ShopOffer < Panel
  height: 60
  background: alpha
  focusable: true
  
  $focus:
    background: #99999999

  // as ShopCategory's art, 48 px
  UIWidget
    id: art
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48
    phantom: true
    visible: false
    image-fixed-ratio: true
    text-align: center
    font: verdana-11px-rounded

  Label
    id: title
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 55
    text-align: topleft
    text-auto-resize: true
    color: white
    font: verdana-11px-rounded

  // the price before a sale or a bundle discount, struck through (shop.lua sends oldCost)
  Label
    id: oldPrice
    anchors.left: title.right
    anchors.top: title.top
    margin-left: 6
    text-auto-resize: true
    color: #9a9a9a
    font: verdana-11px-rounded
    visible: false

    UIWidget
      id: strike
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      height: 1
      background-color: #d24a3a
      phantom: true

  // Sale / New / Featured / Bundle tags
  Label
    id: tags
    anchors.left: oldPrice.right
    anchors.top: title.top
    margin-left: 6
    text-auto-resize: true
    color: #f0c050
    font: verdana-11px-rounded

  Label
    id: description
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 55
    margin-right: 104
    text-align: topleft
    text-auto-resize: true
    text-wrap: true
    color: white
    font: verdana-11px-rounded

  Button
    id: buyButton
    !text: tr('BUY')
    width: 40
    height: 25
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 15
    text-align: center

  // buy it for another character (shown when the server says the offer can be gifted)
  Button
    id: giftButton
    !text: tr('GIFT')
    width: 40
    height: 25
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: buyButton.left
    margin-right: 4
    text-align: center
    visible: false

  // a cosmetic's preview (server cosmetics.lua): its effects around you, only you see them; cosmetics are not gifts,
  // so it takes the gift button's place
  Button
    id: previewButton
    !text: tr('SHOW')
    width: 40
    height: 25
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: buyButton.left
    margin-right: 4
    text-align: center
    visible: false
    
ShopOfferItem < ShopOffer
  UIItem
    id: item
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    virtual: true
    size: 48 48
    
ShopOfferCreature < ShopOffer
  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48
    
ShopOfferImage < ShopOffer
  Label
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48    
  
MainWindow
  id: shopWindow
  !text: tr('Shop')
  size: 960 530
  @onEscape: modules.game_shop.hide()
  $mobile:
    size: 500 380

  Panel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 230
    height: 60

    Label
      id: points
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 10
      text: -
      text-auto-resize: true
    
    // voluntary donations for Chaos Coins (pay.lua, pay.otui)
    Button
      id: donate
      anchors.left: parent.left
      anchors.top: points.bottom
      margin-top: 10
      margin-left: 4
      width: 110
      !text: tr("Donate")
      !tooltip: tr("Voluntary donation: Chaos Coins as a thank-you. The game is fully playable for free.")
      @onClick: modules.game_shop.showPay()

    Button
      id: buy
      anchors.right: parent.right
      width: 106
      anchors.top: points.bottom
      margin-top: 10
      margin-right: 4
      visible: false
      !text: tr("Website")

  // the shared look preview (game_lookpreview): the offer under the mouse or picked, on the own character
  UIWidget
    id: lookPreview
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: transactionHistory.top
    margin-bottom: 10
    width: 200

  Panel
    id: adPanel
    anchors.top: parent.top
    anchors.left: infoPanel.right
    anchors.right: lookPreview.left
    margin-left: 10
    margin-right: 10
    height: 0
    
    Label
      id: ad
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      text-auto-resize: true
      text-wrap: true
      text-align: center
      font: sans-bold-16px
  
  // the store search (the server looks through every offer: name, category, parent)
  TextEdit
    id: searchText
    anchors.left: infoPanel.left
    anchors.right: infoPanel.right
    anchors.bottom: transactionHistory.top
    margin-bottom: 10
    !placeholder: tr('Search the store...')
    placeholder-color: #808080
    @onTextChange: modules.game_shop.onSearchChange()

  TextList
    id: categories
    vertical-scrollbar: categoriesScrollBar
    anchors.top: infoPanel.bottom
    anchors.left: infoPanel.left
    anchors.right: infoPanel.right
    anchors.bottom: searchText.top
    margin-top: 10
    margin-bottom: 6
    padding: 1
    focusable: false

  VerticalScrollBar
    id: categoriesScrollBar
    anchors.top: categories.top
    anchors.bottom: categories.bottom
    anchors.right: categories.right
    step: 50
    pixels-scroll: true

  // the path of the shown category ("Cosmetics > Wings"), the search or the history
  Label
    id: pathLabel
    anchors.top: adPanel.bottom
    anchors.left: adPanel.left
    anchors.right: adPanel.right
    margin-top: 8
    height: 16
    color: #f0c050
    font: verdana-11px-rounded
    text-align: left

  TextList
    id: offers
    vertical-scrollbar: offersScrollBar
    anchors.top: pathLabel.bottom
    anchors.left: adPanel.left
    anchors.right: adPanel.right
    anchors.bottom: transactionHistory.top
    margin-top: 10
    margin-bottom: 10
    padding: 1
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 50
    pixels-scroll: true

  Panel
    id: pageControls
    visible: true
    size: 80 30
    margin-top: 240
    anchors.horizontalCenter: offers.horizontalCenter
    anchors.verticalCenter: offers.verticalCenter

    Button
      id: prevPage
      text: "<"
      width: 30
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    Button
      id: nextPage
      text: ">"
      width: 30
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter

  Button
    id: transactionHistory
    !text: tr('Transaction history')
    text-horizontal-auto-resize: true
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onClick: modules.game_shop.showHistory()

  Button
    id: transferOpen
    !text: tr('Transfer Coins')
    width: 128
    anchors.left: prev. right
    margin-left: 10
    anchors.verticalCenter: prev.verticalCenter
    @onClick: modules.game_shop.showTransfer()

  Button
    id: buttonCancel
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_shop.hide()