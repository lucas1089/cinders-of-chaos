ShopCategory < Panel
  height: 56
  focusable: true
  background: alpha

  $focus:
    background: #99999999
  
  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 40
    text-align: left
    color: white
    font: verdana-11px-rounded    
    
ShopCategoryItem < ShopCategory
  UIItem
    id: item
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    virtual: true
    size: 32 32
    
ShopCategoryCreature < ShopCategory
  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    size: 32 32
    
ShopCategoryImage < ShopCategory
  Label
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 2
    margin-bottom: 2
    margin-left: 2
    size: 32 32    
    
    
    
ShopOffer < Panel
  height: 60
  background: alpha
  
  $focus:
    background: #99999999

  Label
    id: title
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 55
    text-align: topleft
    text-auto-resize: true
    color: white
    font: verdana-11px-rounded

  // the price before a sale or a bundle discount, struck through (shop.lua sends oldCost)
  Label
    id: oldPrice
    anchors.left: title.right
    anchors.top: title.top
    margin-left: 6
    text-auto-resize: true
    color: #9a9a9a
    font: verdana-11px-rounded
    visible: false

    UIWidget
      id: strike
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      height: 1
      background-color: #d24a3a
      phantom: true

  // Sale / New / Featured / Bundle tags
  Label
    id: tags
    anchors.left: oldPrice.right
    anchors.top: title.top
    margin-left: 6
    text-auto-resize: true
    color: #f0c050
    font: verdana-11px-rounded

  Label
    id: description
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 55
    margin-right: 104
    text-align: topleft
    text-auto-resize: true
    text-wrap: true
    color: white
    font: verdana-11px-rounded

  Button
    id: buyButton
    text: BUY
    width: 40
    height: 25
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 15
    text-align: center

  // buy it for another character (shown when the server says the offer can be gifted)
  Button
    id: giftButton
    text: GIFT
    width: 40
    height: 25
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: buyButton.left
    margin-right: 4
    text-align: center
    visible: false
    
ShopOfferItem < ShopOffer
  UIItem
    id: item
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    virtual: true
    size: 48 48
    
ShopOfferCreature < ShopOffer
  UICreature
    id: creature
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48
    
ShopOfferImage < ShopOffer
  Label
    id: image
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48    
  
MainWindow
  id: shopWindow
  !text: tr('Shop')
  size: 750 530
  @onEscape: modules.game_shop.hide()
  $mobile:
    size: 500 380

  Panel
    id: infoPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 230
    height: 60

    Label
      id: points
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 10
      text: -
      text-auto-resize: true
    
    // voluntary donations for Chaos Coins (pay.lua, pay.otui)
    Button
      id: donate
      anchors.left: parent.left
      anchors.top: points.bottom
      margin-top: 10
      margin-left: 4
      width: 110
      !text: tr("Donate")
      !tooltip: tr("Voluntary donation: Chaos Coins as a thank-you. The game is fully playable for free.")
      @onClick: modules.game_shop.showPay()

    Button
      id: buy
      anchors.right: parent.right
      width: 106
      anchors.top: points.bottom
      margin-top: 10
      margin-right: 4
      visible: false
      !text: tr("Website")

  Panel
    id: adPanel
    anchors.top: parent.top
    anchors.left: infoPanel.right
    anchors.right: parent.right
    margin-left: 10
    height: 0
    
    Label
      id: ad
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      text-auto-resize: true
      text-wrap: true
      text-align: center
      font: sans-bold-16px
  
  TextList    
    id: categories
    vertical-scrollbar: categoriesScrollBar
    anchors.top: infoPanel.bottom
    anchors.left: infoPanel.left
    anchors.right: infoPanel.right
    anchors.bottom: transactionHistory.top
    margin-top: 10
    margin-bottom: 10
    padding: 1
    focusable: false

  VerticalScrollBar
    id: categoriesScrollBar
    anchors.top: categories.top
    anchors.bottom: categories.bottom
    anchors.right: categories.right
    step: 50
    pixels-scroll: true

  TextList
    id: offers
    vertical-scrollbar: offersScrollBar
    anchors.top: adPanel.bottom
    anchors.left: adPanel.left
    anchors.right: adPanel.right
    anchors.bottom: transactionHistory.top
    margin-top: 10
    margin-bottom: 10
    padding: 1
    focusable: false

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offers.top
    anchors.bottom: offers.bottom
    anchors.right: offers.right
    step: 50
    pixels-scroll: true

  Panel
    id: pageControls
    visible: true
    size: 80 30
    margin-top: 240
    anchors.horizontalCenter: offers.horizontalCenter
    anchors.verticalCenter: offers.verticalCenter

    Button
      id: prevPage
      text: "<"
      width: 30
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    Button
      id: nextPage
      text: ">"
      width: 30
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter

  Button
    id: transactionHistory
    !text: tr('Transaction history')
    width: 128
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onClick: modules.game_shop.showHistory()

  Button
    id: transferOpen
    !text: tr('Transfer Coins')
    width: 128
    anchors.left: prev. right
    margin-left: 10
    anchors.verticalCenter: prev.verticalCenter
    @onClick: modules.game_shop.showTransfer()

  Button
    id: buttonCancel
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_shop.hide()