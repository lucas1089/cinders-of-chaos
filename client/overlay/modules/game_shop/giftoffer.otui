MainWindow
  id: giftOfferWindow
  !text: tr('Gift an Offer')
  size: 300 170
  @onEscape: modules.game_shop.hideGiftOffer()

  Label
    id: info
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    height: 44
    text: ''

  Label
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 12
    !text: tr('Character:')

  TextEdit
    id: recipient
    anchors.verticalCenter: prev.verticalCenter
    anchors.right: parent.right
    width: 170
    text-align: left
    max-length: 29

  HorizontalSeparator
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: cancelButton.top
    margin-bottom: 8

  Button
    id: cancelButton
    !text: tr('Cancel')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 56 21
    @onClick: modules.game_shop.hideGiftOffer()

  Button
    id: okButton
    !text: tr('Gift')
    size: 56 21
    anchors.verticalCenter: prev.verticalCenter
    anchors.right: prev.left
    margin-right: 5
    @onClick: modules.game_shop.confirmGiftOffer()
