Module
  name: game_npctalk
  description: NPC dialogue window (O571): Talk from the NPC's menu, the whole conversation as a log next to the NPC, with its portrait, keyword chips in groups and an input
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ npctalk_logic, npctalkview, npctalk ]
  dependencies:
    - client_chaos_theme
    - game_interface
    - game_console
    - game_npctrade
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
