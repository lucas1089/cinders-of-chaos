// The floating chat of the action bar layout (game_floatchat, client/MANIFEST.md "Floating chat and central hotbar (O414)").
// A dark see-through body (its alpha is set from the opacity option in floatchat.lua), the nine-slice border drawn by
// tools/gen_hotbar_art.py, a compact header and the base console panel below it.

ChaosFloatIcon < UIWidget
  size: 14 14
  phantom: true
  image-smooth: true

ChaosFloatBadge < Label
  size: 16 14
  text-align: center
  font: verdana-11px-rounded
  color: #ffffff
  background-color: #e2622cff
  phantom: true
  visible: false

// A header menu button: icon, label, unread badge (only when there is news) and caret in one row. The row is a box
// layout that fits its children, so the button is as wide as what it holds and nothing can sit over the label (the old
// button drew its text itself and anchored the icon, badge and caret over it, which covered the label in a client,
// owner screenshot 2026-11-09). Children are phantom: a click anywhere is the button's.
ChaosFloatTabLabel < Label
  height: 20
  font: verdana-11px-rounded
  color: #e8c89a
  text-align: left
  text-auto-resize: true
  phantom: true

ChaosFloatTab < UIButton
  height: 20
  focusable: false
  background-color: #00000000
  padding: 0 3 0 3
  layout:
    type: horizontalBox
    spacing: 3
    fit-children: true
  $hover:
    background-color: #5a3a2960
  $pressed:
    background-color: #c8782e80

  ChaosFloatIcon
    id: icon
    margin-top: 3

  ChaosFloatTabLabel
    id: label

  ChaosFloatBadge
    id: badge
    margin-top: 3

  ChaosFloatIcon
    id: caret
    margin-top: 3
    image-source: /modules/game_floatchat/images/chat_caret

ChaosFloatChat < UIWidget
  id: chaosFloatChat
  size: 380 150
  // not focusable until floatchat.lua has put the console in it, then focusable (O498: keys reach the input along the
  // focus chain). The header and the grip never take the focus: a click on them keeps it in the chat input.
  focusable: false
  image-source: /modules/game_floatchat/images/chat_border
  image-border: 10
  background-color: #0e0a0cbf
  clipping: true

  UIWidget
    id: header
    focusable: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 5 0 5
    height: 24
    !tooltip: tr('Drag to move the chat. Double-click: back to the bottom left.')

    ChaosFloatTab
      id: channels
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      !tooltip: tr('Open channels')

    ChaosFloatTab
      id: private
      anchors.left: channels.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      !tooltip: tr('Private chats')

    UIButton
      id: close
      size: 16 16
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 2
      image-source: /modules/game_floatchat/images/chat_close
      image-smooth: true
      !tooltip: tr('Hide the chat (Ctrl+Shift+C shows it again)')
      opacity: 0.8
      $hover:
        opacity: 1

    UIButton
      id: options
      size: 16 16
      anchors.right: prev.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      image-source: /modules/game_floatchat/images/chat_gear
      image-smooth: true
      !tooltip: tr('Layout options')
      opacity: 0.8
      $hover:
        opacity: 1

  UIWidget
    id: content
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 2 5 5 5

  UIWidget
    id: grip
    focusable: false
    size: 14 14
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 3 3 0
    image-source: /modules/game_floatchat/images/chat_grip
    image-smooth: true
    !tooltip: tr('Drag to resize the chat')
