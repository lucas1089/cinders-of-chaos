Module
  name: game_buffbar
  description: Buff / debuff bar (small icons with countdown and stacks; extended opcode 234, server buffbar.lua / data/lib/chaos_buffs.lua)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ buffmath, buffbar ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
