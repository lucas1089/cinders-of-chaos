// Buff / debuff bar (client game_buffbar; server buffbar.lua, extended opcode 234). Styles from client_chaos_theme.
// Icons: our own 26 x 26 pixel art, /images/game/buffs/<name>.png (client/tools/gen_buff_icons.py), drawn 1:1 and unsmoothed.

BuffBarIcon < UIWidget
  size: 26 26
  border-width: 1
  border-color: #b8923a
  image-smooth: false
  focusable: false
  anchors.top: parent.top
  anchors.left: parent.left

  UILabel
    id: time
    font: Verdana-9px-antialiased
    color: #f2e8d0
    background-color: #000000b4
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 10
    text-align: center
    phantom: true

  UILabel
    id: count
    font: Verdana-9px-antialiased
    color: #ffd966
    background-color: #000000b4
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    padding-left: 2
    padding-right: 2
    phantom: true

// fixed under the character plate (anchored by buffbar.lua); phantom, so the space between icons lets clicks through
BuffBar < UIWidget
  id: buffBar
  size: 290 26
  phantom: true
  focusable: false

BuffBarSettings < ChaosMainWindow
  id: buffBarSettings
  !text: tr('Buff Bar')
  size: 270 160

  ChaosLabel
    id: info
    !text: tr('The bar sits under the character plate and moves with it.')
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-wrap: true
    text-auto-resize: true

  ChaosCheckBox
    id: shownBox
    !text: tr('Show the buff bar')
    anchors.top: info.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    @onCheckChange: modules.game_buffbar.setOption('shown', self:isChecked())
  ChaosCheckBox
    id: timersBox
    !text: tr('Show the countdown')
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    @onCheckChange: modules.game_buffbar.setOption('timers', self:isChecked())
  ChaosButton
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_buffbar.toggleSettings()
