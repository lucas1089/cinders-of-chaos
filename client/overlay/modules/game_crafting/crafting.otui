// Crafting bench window (game_crafting). Styles from client_chaos_theme (styles.otui).

CraftOrbRow < ChaosPanelDark
  height: 44
  margin-bottom: 3
  phantom: false

  UIItem
    id: icon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.right: use.left
    anchors.top: parent.top
    margin-left: 8
    margin-right: 6
    margin-top: 1
    text-align: left
    font: verdana-11px-rounded
    color: #e8b84a
    phantom: true

  UILabel
    id: count
    anchors.left: icon.right
    anchors.right: use.left
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 6
    margin-bottom: 1
    text-align: left
    font: verdana-11px-antialised
    color: #8c8070
    phantom: true

  ChaosButton
    id: use
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 64
    !text: tr('Use')

CraftGearSlot < ChaosItemSlot
  size: 36 36
  virtual: true

CraftModLabel < UILabel
  height: 16
  text-align: left
  font: verdana-11px-antialised
  color: #7fa8ff
  phantom: true

// one socket of the item on the bench: the gem (or "empty"), its effect, take it out for gold or shatter it
CraftSocketRow < UIWidget
  height: 30
  margin-top: 2
  phantom: false

  UIItem
    id: icon
    size: 28 28
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.right: removeButton.left
    anchors.top: parent.top
    margin-left: 5
    margin-right: 4
    text-align: left
    font: verdana-11px-rounded
    color: #d6c9ae
    phantom: true

  UILabel
    id: text
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-right: 4
    text-align: left
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

  ChaosButton
    id: removeButton
    anchors.right: shatterButton.left
    anchors.top: parent.top
    margin-right: 3
    width: 46
    height: 15
    font: verdana-11px-antialised

  ChaosButton
    id: shatterButton
    anchors.right: parent.right
    anchors.top: parent.top
    width: 50
    height: 15
    font: verdana-11px-antialised
    !text: tr('Shatter')

// one recipe of the Salvage tab: shards -> an orb
CraftRecipeRow < ChaosPanelDark
  size: 166 32
  padding: 1
  phantom: false

  UIItem
    id: icon
    size: 28 28
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    virtual: true
    phantom: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.right: make.left
    anchors.top: parent.top
    height: 14
    margin-left: 4
    margin-right: 2
    margin-top: 2
    text-align: topLeft
    font: verdana-11px-antialised
    color: #e8b84a
    phantom: true

  UILabel
    id: cost
    anchors.left: icon.right
    anchors.right: make.left
    anchors.bottom: parent.bottom
    height: 14
    margin-left: 4
    margin-bottom: 2
    text-align: bottomLeft
    font: verdana-11px-antialised
    color: #c0a0ff
    phantom: true

  ChaosButton
    id: make
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    width: 36
    height: 22
    !text: tr('Make')

CraftHistoryLabel < UILabel
  height: 14
  text-align: left
  font: verdana-11px-antialised
  color: #d6c9ae
  text-auto-resize: false
  phantom: false

ChaosMainWindow
  id: craftingWindow
  size: 700 664
  !text: tr('Crafting Bench')
  @onEscape: modules.game_crafting.hide()

  // ------------------------------------------------------------ the item on the bench
  ChaosPanelDark
    id: itemPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 320
    height: 340

  ChaosItemSlot
    id: itemSlot
    size: 52 52
    anchors.top: itemPanel.top
    anchors.left: itemPanel.left
    margin: 8
    virtual: true
    !tooltip: tr('Drag an item from your backpack here.')

  ChaosButton
    id: lockButton
    anchors.top: itemPanel.top
    anchors.right: itemPanel.right
    margin-top: 8
    margin-right: 8
    width: 58
    height: 20
    !text: tr('Lock')
    visible: false
    @onClick: modules.game_crafting.toggleLock()

  UILabel
    id: itemName
    anchors.top: itemSlot.top
    anchors.left: itemSlot.right
    anchors.right: lockButton.left
    margin-left: 10
    margin-right: 8
    text-align: left
    font: verdana-11px-rounded
    color: #e8b84a
    !text: tr('Empty bench')

  ChaosLabel
    id: itemRarity
    anchors.top: itemName.bottom
    anchors.left: itemName.left
    anchors.right: itemName.right
    margin-top: 4
    text-align: left

  ChaosLabelDim
    id: itemSlots
    anchors.top: itemRarity.bottom
    anchors.left: itemName.left
    anchors.right: itemName.right
    margin-top: 3
    text-align: left

  ChaosSeparator
    id: itemSep
    anchors.top: itemSlot.bottom
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    margin: 6 8 0 8

  UIWidget
    id: modList
    anchors.top: itemSep.bottom
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    anchors.bottom: itemPanel.bottom
    margin: 4 12 6 12
    phantom: true
    layout:
      type: verticalBox

  ChaosLabelDim
    id: emptyHint
    anchors.top: itemSep.bottom
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    margin: 18 14 0 14
    text-wrap: true
    text-align: center
    height: 72
    !text: tr('Drag an item or a Rift Key from your backpack onto the slot, or click one below. Orbs and gems also work without the bench: Use with on the orb or the gem, then click the item.')

  // ------------------------------------------------------------ gear in the backpack
  ChaosLabel
    id: gearLabel
    anchors.top: itemPanel.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    !text: tr('Gear and Rift Keys in your backpack')

  ChaosPanelDark
    id: gearFrame
    anchors.top: gearLabel.bottom
    anchors.left: parent.left
    anchors.bottom: resultLabel.top
    width: 320
    margin-top: 4
    margin-bottom: 8

  UIScrollArea
    id: gearList
    anchors.top: gearFrame.top
    anchors.left: gearFrame.left
    anchors.right: gearScroll.left
    anchors.bottom: gearFrame.bottom
    margin: 5
    vertical-scrollbar: gearScroll
    auto-focus: none
    layout:
      type: grid
      cell-size: 36 36
      cell-spacing: 3
      flow: true

  ChaosScrollBar
    id: gearScroll
    anchors.top: gearFrame.top
    anchors.right: gearFrame.right
    anchors.bottom: gearFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 39
    pixels-scroll: true

  ChaosLabelDim
    id: gearEmpty
    anchors.centerIn: gearFrame
    text-auto-resize: true
    !text: tr('No gear or Rift Key in your backpack.')
    visible: false

  // ------------------------------------------------------------ orbs
  UIWidget
    id: orbLabel
    anchors.top: parent.top
    anchors.left: itemPanel.right
    anchors.right: parent.right
    margin-left: 12
    height: 24
    phantom: true

  ChaosTabButton
    id: orbsTab
    anchors.top: orbLabel.top
    anchors.left: orbLabel.left
    !text: tr('Orbs')
    @onClick: modules.game_crafting.setMode('orbs')

  ChaosTabButton
    id: salvageTab
    anchors.top: orbLabel.top
    anchors.left: orbsTab.right
    margin-left: 4
    !text: tr('Salvage')
    !tooltip: tr('Break rolled gear down into rune shards and combine the shards into orbs.')
    @onClick: modules.game_crafting.setMode('salvage')

  UIWidget
    id: orbList
    anchors.top: orbLabel.bottom
    anchors.left: orbLabel.left
    anchors.right: parent.right
    margin-top: 4
    height: 378
    phantom: true
    layout:
      type: verticalBox

  // ------------------------------------------------------------ salvage (the Salvage tab, in the place of the orbs)
  UIWidget
    id: salvagePanel
    anchors.top: orbLabel.bottom
    anchors.left: orbLabel.left
    anchors.right: parent.right
    margin-top: 4
    height: 378
    visible: false
    phantom: true

    ChaosPanelDark
      id: shardRow
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 36
      padding: 1

      UIItem
        id: shardIcon
        size: 32 32
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        virtual: true
        phantom: true

      UILabel
        id: shardCount
        anchors.left: shardIcon.right
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 8
        margin-top: 3
        height: 15
        text-align: topLeft
        font: verdana-11px-rounded
        color: #c0a0ff

      UILabel
        id: shardHint
        anchors.left: shardIcon.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8
        margin-bottom: 3
        height: 14
        text-align: bottomLeft
        font: verdana-11px-antialised
        color: #8c8070
        !text: tr('Salvage gear into shards, shards into orbs.')

    ChaosPanelDark
      id: itemBox
      anchors.top: shardRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 50
      padding: 1

      UILabel
        id: itemText
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: salvageButton.left
        anchors.bottom: parent.bottom
        margin: 4 6 4 6
        text-align: topLeft
        text-wrap: true
        font: verdana-11px-antialised
        color: #d6c9ae

      ChaosButton
        id: salvageButton
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 70
        !text: tr('Salvage')
        @onClick: modules.game_crafting.salvageItem()

    ChaosPanelDark
      id: batchBox
      anchors.top: itemBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 112
      padding: 1

      UILabel
        id: batchInLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin: 8 0 0 6
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #d6c9ae
        !text: tr('Salvage all in')

      ChaosComboBox
        id: bagCombo
        anchors.top: parent.top
        anchors.left: batchInLabel.right
        margin: 4 0 0 6
        width: 106

      UILabel
        id: batchUpLabel
        anchors.top: parent.top
        anchors.left: bagCombo.right
        margin: 8 0 0 6
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #d6c9ae
        !text: tr('up to')

      ChaosComboBox
        id: rarityCombo
        anchors.top: parent.top
        anchors.left: batchUpLabel.right
        anchors.right: parent.right
        margin: 4 6 0 6

      UILabel
        id: batchText
        anchors.top: bagCombo.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: batchButton.top
        margin: 4 6 2 6
        text-align: topLeft
        text-wrap: true
        font: verdana-11px-antialised
        color: #d6c9ae

      ChaosButton
        id: batchButton
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 0 6 5 0
        width: 150
        height: 22
        !text: tr('Salvage all')
        @onClick: modules.game_crafting.salvageAll()

    ChaosLabel
      id: combineTitle
      anchors.top: batchBox.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      !text: tr('Combine shards into orbs (Ctrl: up to 10)')

    UIWidget
      id: recipeList
      anchors.top: combineTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      phantom: true
      layout:
        type: grid
        cell-size: 166 32
        cell-spacing: 2
        flow: true

  // ------------------------------------------------------------ history
  ChaosLabel
    id: historyTitle
    anchors.top: orbList.bottom
    anchors.left: orbLabel.left
    margin-top: 6
    text-auto-resize: true
    !text: tr('Recent crafts')

  ChaosPanelDark
    id: historyPanel
    anchors.top: historyTitle.bottom
    anchors.left: orbLabel.left
    anchors.right: parent.right
    anchors.bottom: resultLabel.top
    margin-top: 4
    margin-bottom: 8
    padding: 5
    layout:
      type: verticalBox

  // ------------------------------------------------------------ bottom
  ChaosLabel
    id: resultLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 8
    text-align: left
    text-wrap: true
    height: 30

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_crafting.hide()
