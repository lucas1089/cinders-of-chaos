// Crafting bench window (game_crafting). Styles from client_chaos_theme (styles.otui).
// Every text that can be long (orb previews and reasons, modifier lines, the item header, recent crafts, the status
// line, the salvage texts) is a wrapping label that takes the height it needs; crafting.lua (followHeight) grows the row
// or box around it, and the lists scroll. Nothing is cut at the window edge.

// a label that breaks its text into lines and takes the height they need (the width comes from its anchors or layout)
CraftWrapLabel < UILabel
  height: 14
  text-align: topLeft
  text-wrap: true
  text-vertical-auto-resize: true
  font: verdana-11px-antialised
  color: #d6c9ae
  phantom: true

// one orb: icon, name and count, what it would do to the item on the bench (or why it cannot be used), wrapped over as
// many lines as it needs (crafting.lua sets the row's height from `body`); a click on the row shows the orb's full
// description under it
CraftOrbRow < ChaosPanelDark
  height: 44
  margin-bottom: 3
  phantom: false

  UIItem
    id: icon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  UIWidget
    id: body
    anchors.left: icon.right
    anchors.right: use.left
    anchors.top: parent.top
    margin-left: 8
    margin-right: 6
    height: 30
    phantom: true
    layout:
      type: verticalBox
      fit-children: true

    CraftWrapLabel
      id: name
      font: verdana-11px-rounded
      color: #e8b84a

    CraftWrapLabel
      id: text
      margin-top: 1
      color: #8c8070

    CraftWrapLabel
      id: desc
      margin-top: 3
      color: #b8ab92
      visible: false

  ChaosButton
    id: use
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 64
    !text: tr('Use')

CraftGearSlot < ChaosItemSlot
  size: 36 36
  virtual: true

// a heading or a note in the modifier list
CraftModLabel < CraftWrapLabel
  height: 16
  margin-top: 1
  color: #7fa8ff

// one modifier of the item on the bench: click it to aim an orb at it (Binding, Excision, Reforging); "bound" modifiers
// are marked on the right
CraftModRow < UIWidget
  height: 17
  margin-bottom: 1
  phantom: false
  focusable: false

  CraftWrapLabel
    id: text
    anchors.left: parent.left
    anchors.right: mark.left
    anchors.top: parent.top
    margin-left: 3
    margin-top: 2
    color: #7fa8ff

  UILabel
    id: mark
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 4
    margin-top: 2
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e8b84a
    phantom: true

// one socket of the item on the bench: the gem (or "empty"), its effect, take it out for gold or shatter it
CraftSocketRow < UIWidget
  height: 30
  margin-top: 2
  phantom: false

  UIItem
    id: icon
    size: 28 28
    anchors.left: parent.left
    anchors.top: parent.top
    virtual: true
    phantom: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.right: removeButton.left
    anchors.top: parent.top
    height: 15
    margin-left: 5
    margin-right: 4
    text-align: left
    font: verdana-11px-rounded
    color: #d6c9ae
    phantom: true

  CraftWrapLabel
    id: text
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-left: 5
    margin-right: 4
    margin-top: 1

  ChaosButton
    id: removeButton
    anchors.right: shatterButton.left
    anchors.top: parent.top
    margin-right: 3
    width: 46
    height: 15
    font: verdana-11px-antialised

  ChaosButton
    id: shatterButton
    anchors.right: parent.right
    anchors.top: parent.top
    width: 50
    height: 15
    font: verdana-11px-antialised
    !text: tr('Shatter')

// one recipe of the Salvage tab: shards -> an orb (a name that does not fit is shortened, the tooltip has it whole)
CraftRecipeRow < ChaosPanelDark
  size: 156 32
  padding: 1
  phantom: false

  UIItem
    id: icon
    size: 28 28
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    virtual: true
    phantom: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.right: make.left
    anchors.top: parent.top
    height: 14
    margin-left: 4
    margin-right: 2
    margin-top: 2
    text-align: topLeft
    font: verdana-11px-antialised
    color: #e8b84a
    phantom: true

  UILabel
    id: cost
    anchors.left: icon.right
    anchors.right: make.left
    anchors.bottom: parent.bottom
    height: 14
    margin-left: 4
    margin-right: 2
    margin-bottom: 2
    text-align: bottomLeft
    font: verdana-11px-antialised
    color: #c0a0ff
    phantom: true

  ChaosButton
    id: make
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    width: 36
    height: 22
    !text: tr('Make')

CraftHistoryLabel < CraftWrapLabel
  margin-bottom: 2
  phantom: false

ChaosMainWindow
  id: craftingWindow
  size: 700 664
  // phone interface is 540 high and 960 wide: 950 wide, so the right side keeps its texts in few lines. Inside the
  // frame (536 - 54 = 482). Left: item panel 270, gear title 22, gear frame 156 (3 rows of gear) with 4 + 8 around
  // it, status line 22. Right: tabs 24, orb list or salvage panel 4 + 290 (the salvage boxes need 215, the recipes
  // keep 75), recent crafts title 20, its panel 4 + 110 + 8, status line 22 (crafting.lua grows the boxes and the
  // status line from their texts, the lists scroll)
  $mobile:
    width: 950
    height: 536
  !text: tr('Crafting Bench')
  @onEscape: modules.game_crafting.hide()

  // ------------------------------------------------------------ the item on the bench
  ChaosPanelDark
    id: itemPanel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 320
    height: 340

    $mobile:
      height: 270

  ChaosItemSlot
    id: itemSlot
    size: 52 52
    anchors.top: itemPanel.top
    anchors.left: itemPanel.left
    margin: 8
    virtual: true
    !tooltip: tr('Drag an item from your backpack here.')

  ChaosButton
    id: lockButton
    anchors.top: itemPanel.top
    anchors.right: itemPanel.right
    margin-top: 8
    margin-right: 8
    width: 58
    height: 20
    !text: tr('Lock')
    visible: false
    @onClick: modules.game_crafting.toggleLock()

  // name, rarity line and modifier counts, each wrapped; the name stays left of the Lock button, the lines below it use
  // the full width (crafting.lua puts the separator below them or the slot, whichever ends lower)
  CraftWrapLabel
    id: itemName
    anchors.top: itemSlot.top
    anchors.left: itemSlot.right
    anchors.right: lockButton.left
    margin-left: 10
    margin-right: 6
    font: verdana-11px-rounded
    color: #e8b84a
    !text: tr('Empty bench')

  CraftWrapLabel
    id: itemRarity
    anchors.top: itemName.bottom
    anchors.left: itemName.left
    anchors.right: itemPanel.right
    margin-top: 6
    margin-right: 8
    phantom: false

  CraftWrapLabel
    id: itemSlots
    anchors.top: itemRarity.bottom
    anchors.left: itemName.left
    anchors.right: itemPanel.right
    margin-top: 2
    margin-right: 8
    color: #8c8070
    phantom: false

  ChaosSeparator
    id: itemSep
    anchors.top: itemPanel.top
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    margin: 66 8 0 8

  ChaosProgressBar
    id: qualityBar
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    anchors.bottom: itemPanel.bottom
    margin: 0 12 7 12
    height: 15
    background-color: #2f8f5a
    visible: false

  UIScrollArea
    id: modList
    anchors.top: itemSep.bottom
    anchors.left: itemPanel.left
    anchors.right: modScroll.left
    anchors.bottom: qualityBar.top
    margin: 4 2 4 12
    vertical-scrollbar: modScroll
    auto-focus: none
    layout:
      type: verticalBox

  ChaosScrollBar
    id: modScroll
    anchors.top: itemSep.bottom
    anchors.right: itemPanel.right
    anchors.bottom: qualityBar.top
    margin: 4 5 4 0
    step: 18
    pixels-scroll: true

  ChaosLabelDim
    id: emptyHint
    anchors.top: itemSep.bottom
    anchors.left: itemPanel.left
    anchors.right: itemPanel.right
    margin: 18 14 0 14
    text-wrap: true
    text-align: center
    height: 72
    !text: tr('Drag an item or a Rift Key from your backpack onto the slot, or click one below. Orbs and gems also work without the bench: Use with on the orb or the gem, then click the item.')

  // ------------------------------------------------------------ gear in the backpack
  ChaosLabel
    id: gearLabel
    anchors.top: itemPanel.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    !text: tr('Gear and Rift Keys in your backpack')

  ChaosPanelDark
    id: gearFrame
    anchors.top: gearLabel.bottom
    anchors.left: parent.left
    anchors.bottom: resultLabel.top
    width: 320
    margin-top: 4
    margin-bottom: 8

  UIScrollArea
    id: gearList
    anchors.top: gearFrame.top
    anchors.left: gearFrame.left
    anchors.right: gearScroll.left
    anchors.bottom: gearFrame.bottom
    margin: 5
    vertical-scrollbar: gearScroll
    auto-focus: none
    layout:
      type: grid
      cell-size: 36 36
      cell-spacing: 3
      flow: true

  ChaosScrollBar
    id: gearScroll
    anchors.top: gearFrame.top
    anchors.right: gearFrame.right
    anchors.bottom: gearFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 39
    pixels-scroll: true

  ChaosLabelDim
    id: gearEmpty
    anchors.centerIn: gearFrame
    text-auto-resize: true
    !text: tr('No gear or Rift Key in your backpack.')
    visible: false

  // ------------------------------------------------------------ orbs
  UIWidget
    id: orbLabel
    anchors.top: parent.top
    anchors.left: itemPanel.right
    anchors.right: parent.right
    margin-left: 12
    height: 24
    phantom: true

  ChaosTabButton
    id: orbsTab
    anchors.top: orbLabel.top
    anchors.left: orbLabel.left
    !text: tr('Orbs')
    @onClick: modules.game_crafting.setMode('orbs')

  ChaosTabButton
    id: salvageTab
    anchors.top: orbLabel.top
    anchors.left: orbsTab.right
    margin-left: 4
    !text: tr('Salvage')
    !tooltip: tr('Break rolled gear down into rune shards and combine the shards into orbs.')
    @onClick: modules.game_crafting.setMode('salvage')

  UIScrollArea
    id: orbList
    anchors.top: orbLabel.bottom
    anchors.left: orbLabel.left
    anchors.right: orbScroll.left
    margin-top: 4
    margin-right: 3
    height: 378
    vertical-scrollbar: orbScroll
    auto-focus: none
    layout:
      type: verticalBox

    $mobile:
      height: 290

  ChaosScrollBar
    id: orbScroll
    anchors.top: orbLabel.bottom
    anchors.right: parent.right
    margin-top: 4
    height: 378
    step: 47
    pixels-scroll: true

    $mobile:
      height: 290

  // ------------------------------------------------------------ salvage (the Salvage tab, in the place of the orbs)
  // the boxes take the height their wrapped texts need (crafting.lua); the recipe grid gets the rest and scrolls
  UIWidget
    id: salvagePanel
    anchors.top: orbLabel.bottom
    anchors.left: orbLabel.left
    anchors.right: parent.right
    margin-top: 4
    height: 378
    visible: false
    phantom: true

    $mobile:
      height: 290

    ChaosPanelDark
      id: shardRow
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 36
      padding: 1

      UIItem
        id: shardIcon
        size: 32 32
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 4
        margin-top: 1
        virtual: true
        phantom: true

      UILabel
        id: shardCount
        anchors.left: shardIcon.right
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 8
        margin-top: 3
        height: 15
        text-align: topLeft
        font: verdana-11px-rounded
        color: #c0a0ff

      CraftWrapLabel
        id: shardHint
        anchors.left: shardIcon.right
        anchors.right: parent.right
        anchors.top: shardCount.bottom
        margin-left: 8
        margin-right: 6
        color: #8c8070
        !text: tr('Salvage gear into shards, shards into orbs.')

    ChaosPanelDark
      id: itemBox
      anchors.top: shardRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 50
      padding: 1

      CraftWrapLabel
        id: itemText
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: salvageButton.left
        margin: 5 6 0 6

      ChaosButton
        id: salvageButton
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        width: 70
        !text: tr('Salvage')
        @onClick: modules.game_crafting.salvageItem()

    ChaosPanelDark
      id: batchBox
      anchors.top: itemBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 112
      padding: 1

      UILabel
        id: batchInLabel
        anchors.verticalCenter: bagCombo.verticalCenter
        anchors.right: bagCombo.left
        margin-right: 6
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #d6c9ae
        !text: tr('Salvage all in')

      ChaosComboBox
        id: bagCombo
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 4 6 0 100

      UILabel
        id: batchUpLabel
        anchors.verticalCenter: rarityCombo.verticalCenter
        anchors.right: rarityCombo.left
        margin-right: 6
        text-auto-resize: true
        font: verdana-11px-antialised
        color: #d6c9ae
        !text: tr('up to')

      ChaosComboBox
        id: rarityCombo
        anchors.top: bagCombo.bottom
        anchors.left: bagCombo.left
        anchors.right: parent.right
        margin: 3 6 0 0

      CraftWrapLabel
        id: batchText
        anchors.top: rarityCombo.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 5 6 0 6

      ChaosButton
        id: batchButton
        anchors.right: parent.right
        anchors.top: batchText.bottom
        margin: 4 6 0 0
        width: 150
        height: 22
        !text: tr('Salvage all')
        @onClick: modules.game_crafting.salvageAll()

    ChaosLabel
      id: combineTitle
      anchors.top: batchBox.bottom
      anchors.left: parent.left
      margin-top: 5
      text-auto-resize: true
      !text: tr('Combine shards into orbs (Ctrl: up to 10)')

    UIScrollArea
      id: recipeList
      anchors.top: combineTitle.bottom
      anchors.left: parent.left
      anchors.right: recipeScroll.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 3
      vertical-scrollbar: recipeScroll
      auto-focus: none
      layout:
        type: grid
        cell-size: 156 32
        cell-spacing: 2
        flow: true

    ChaosScrollBar
      id: recipeScroll
      anchors.top: combineTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      step: 34
      pixels-scroll: true

  // ------------------------------------------------------------ history
  ChaosLabel
    id: historyTitle
    anchors.top: orbList.bottom
    anchors.left: orbLabel.left
    margin-top: 6
    text-auto-resize: true
    !text: tr('Recent crafts')

  ChaosPanelDark
    id: historyPanel
    anchors.top: historyTitle.bottom
    anchors.left: orbLabel.left
    anchors.right: parent.right
    anchors.bottom: resultLabel.top
    margin-top: 4
    margin-bottom: 8

  UIScrollArea
    id: historyList
    anchors.top: historyPanel.top
    anchors.left: historyPanel.left
    anchors.right: historyScroll.left
    anchors.bottom: historyPanel.bottom
    margin: 5 3 5 6
    vertical-scrollbar: historyScroll
    auto-focus: none
    layout:
      type: verticalBox

  ChaosScrollBar
    id: historyScroll
    anchors.top: historyPanel.top
    anchors.right: historyPanel.right
    anchors.bottom: historyPanel.bottom
    margin: 3 3 3 0
    step: 16
    pixels-scroll: true

  // ------------------------------------------------------------ bottom
  // the status line: wrapped over as many lines as it needs (at most RESULT_LINES, crafting.lua), the gear grid and the
  // recent crafts above it give up the room
  CraftWrapLabel
    id: resultLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 10
    text-vertical-auto-resize: false
    text-align: left
    phantom: false
    height: 22

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_crafting.hide()
