// Inventory panel (game_bagpanel, O420): tab row, equipment with the fight controls, gold and coins, the backpack as
// one grid, one page button per bag and for the purse (O492) and the bags in it, Sort, Purse. Styles from client_chaos_theme. Drawn from bagpanel.lua; sizes in bagpanel_core.lua.

BagPanelTab < ChaosTabButton
  size: 34 20
  font: Verdana-8px-antialiased
  padding: 0
  margin-right: 0
  text-offset: 0 0

// an equipment slot or an item cell: a UIItem, so the base drag and drop (g_game.move to its position) and the
// right-click menu and the rich tooltip work as in the classic windows
// the stack count is drawn in the widget's font and colour (UIItem::drawSelf): bright and the theme's 11 px,
// the dim #6b6258 9 px made counts unreadable (owner 2026-11-09)
BagPanelCell < ChaosItemSlot
  size: 34 34
  font: verdana-11px-rounded
  color: #f2e8d5
  text-align: center
  text-wrap: true

// a page button: the icon of the bag, virtual so it only draws
BagPanelPage < ChaosItemSlot
  size: 26 26
  virtual: true
  border-width: 1
  border-color: #00000000
  change-cursor-image: true
  cursor: pointer

BagPanelButton < ChaosButton
  size: 64 20
  font: verdana-11px-antialised

// the arrows and the hide button of the Loot Bag section (O516)
BagPanelMini < ChaosButton
  size: 20 18
  padding: 0
  font: verdana-11px-antialised
  text-offset: 0 0

MiniWindow
  id: bagPanelWindow
  !text: tr('Inventory')
  height: 520
  // the phone interface is 960 x 540: shorter, the grid scrolls by page
  $mobile:
    height: 420
  &save: true

  MiniWindowContents
    padding: 2

    Panel
      id: tabRow
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      layout:
        type: horizontalBox

    Panel
      id: equipPanel
      anchors.top: tabRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 144

      Panel
        id: slots
        anchors.top: parent.top
        anchors.left: parent.left
        width: 108
        height: 144
        layout:
          type: grid
          cell-size: 34 34
          cell-spacing: 3
          flow: true
          num-columns: 3

      // the stock inventory window's fight modes, chase, PvP, safe fight, Stop and conditions (moved by bagpanel.lua)
      Panel
        id: controls
        anchors.top: parent.top
        anchors.left: slots.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8

    ChaosLabelDim
      id: goldLabel
      anchors.top: equipPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      text-auto-resize: false
      height: 14
      color: #f6cf72
      font: verdana-11px-antialised

    ChaosLabelDim
      id: coinsLabel
      anchors.top: goldLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 14
      color: #d6c9ae
      font: verdana-11px-antialised

    ChaosSeparator
      id: separator
      anchors.top: coinsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3

    Panel
      id: grid
      anchors.top: separator.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 36
      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 2
        flow: true

    ChaosLabelDim
      id: emptyLabel
      anchors.top: grid.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      height: 14
      text-auto-resize: false
      font: verdana-11px-antialised
      !text: tr('Nothing here.')
      visible: false

    // the Loot Bag (O516): its own section under the grid of the page shown, 20 slots at a time (bagpanel.lua drawLoot)
    Panel
      id: lootSection
      anchors.top: emptyLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 0
      height: 0
      visible: false

      Panel
        id: lootHeader
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 18

        BagPanelMini
          id: lootHide
          anchors.top: parent.top
          anchors.right: parent.right
          text: x
          !tooltip: tr('Hides the Loot Bag. It stays open: its button shows it again.')
          @onClick: modules.game_bagpanel.toggleLoot()

        BagPanelMini
          id: lootNext
          anchors.top: parent.top
          anchors.right: lootHide.left
          margin-right: 2
          text: >
          !tooltip: tr('Next 20 slots of the Loot Bag')
          @onClick: modules.game_bagpanel.lootArrow(1)

        ChaosLabelDim
          id: lootPage
          anchors.top: parent.top
          anchors.right: lootNext.left
          margin-right: 3
          width: 62
          height: 18
          text-auto-resize: false
          text-align: center
          color: #d6c9ae
          font: verdana-11px-antialised

        BagPanelMini
          id: lootPrev
          anchors.top: parent.top
          anchors.right: lootPage.left
          margin-right: 3
          text: <
          !tooltip: tr('Previous 20 slots of the Loot Bag')
          @onClick: modules.game_bagpanel.lootArrow(-1)

        ChaosLabelDim
          id: lootTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: lootPrev.left
          margin-right: 3
          height: 18
          text-auto-resize: false
          color: #f6cf72
          font: verdana-11px-antialised

      Panel
        id: lootGrid
        anchors.top: lootHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        height: 36
        layout:
          type: grid
          cell-size: 34 34
          cell-spacing: 2
          flow: true

    Panel
      id: pages
      anchors.top: lootSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 26
      layout:
        type: grid
        cell-size: 26 26
        cell-spacing: 2
        flow: true

    Panel
      id: buttons
      anchors.top: pages.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 20

      BagPanelButton
        id: sortButton
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Sort')
        !tooltip: tr('Puts the items of this page in order: by item, then the bigger stack first.')
        @onClick: modules.game_bagpanel.sort()

      BagPanelButton
        id: purseButton
        anchors.top: parent.top
        anchors.left: sortButton.right
        margin-left: 6
        width: 72
        !text: tr('Purse')
        !tooltip: tr('Shows your purse in this panel. What you buy in the store is delivered there.')
        @onClick: modules.game_bagpanel.openPurse()
