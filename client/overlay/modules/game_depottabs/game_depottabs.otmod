Module
  name: game_depottabs
  description: Depot window - the depot's tabs in one window, with counts, names and colours (extended opcode 111)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ depottabsview, depottabs ]
  dependencies:
    - client_chaos_theme
    - game_interface
    - game_containers
  autoload: true
  autoload-priority: 1002
  @onLoad: init()
  @onUnload: terminate()
