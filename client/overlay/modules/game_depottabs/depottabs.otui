// The depot window (game_depottabs): the tab buttons along the top, the active tab's 10x10 item grid, the footer with
// the counts, Inbox, Market and Store; and the rename / colour dialog of a tab. Styles from client_chaos_theme.
// Sizes follow DepotTabsView (depottabsview.lua): tab buttons 60x22 in rows of 6, item slots 34x34 with 2 px between.

DepotTabButton < ChaosTabButton
  size: 60 22
  padding: 2 4 2 4
  text-offset: 0 0

  UIWidget
    id: accent
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 4 2 4
    height: 3
    phantom: true
    visible: false

  UIWidget
    id: lock
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 2
    size: 10 12
    image-source: /images/game/depot/lock
    phantom: true
    visible: false

DepotStoreButton < ChaosTabButton
  size: 60 22
  padding: 2 4 2 4
  color: #e8b84a
  !text: tr('+ Tabs')

DepotSwatch < UIButton
  size: 26 26
  border-width: 1
  border-color: #3a3339
  change-cursor-image: true
  cursor: pointer

  $hover:
    border-color: #d6c9ae

  $checked:
    border-width: 2
    border-color: #f6cf72

DepotWindow < ChaosMainWindow
  id: depotWindow
  size: 404 594
  !text: tr('Depot')
  @onEscape: modules.game_depottabs.closeWindow()

  UIWidget
    id: tabsPanel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 370 70
    phantom: true

  ChaosLabel
    id: header
    anchors.top: tabsPanel.bottom
    anchors.left: parent.left
    anchors.right: editButton.left
    margin-top: 6
    margin-right: 4
    height: 18
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left

  UIButton
    id: editButton
    anchors.top: tabsPanel.bottom
    anchors.right: parent.right
    size: 12 12
    margin-top: 9
    margin-right: 2
    image-source: /images/game/depot/edit
    change-cursor-image: true
    cursor: pointer
    !tooltip: tr('Rename this tab or change its colour (or right-click a tab).')
    @onClick: modules.game_depottabs.editActiveTab()

  ChaosPanelDark
    id: gridFrame
    anchors.top: header.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 370 370
    phantom: false

    UIWidget
      id: grid
      anchors.fill: parent
      phantom: false
      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 2
        num-columns: 10
        flow: true

  ChaosLabel
    id: itemsLabel
    anchors.top: gridFrame.bottom
    anchors.left: parent.left
    margin-top: 6
    width: 150
    height: 16
    text-align: left

  ChaosLabelDim
    id: tabsLabel
    anchors.top: itemsLabel.top
    anchors.right: parent.right
    width: 150
    height: 16
    text-align: right

  ChaosLabel
    id: status
    anchors.top: itemsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    color: #e03a1e
    text-align: center

  ChaosButton
    id: inboxButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 84 24
    !text: tr('Inbox')
    !tooltip: tr('Open the inbox: mail, market and store deliveries.')
    @onClick: modules.game_depottabs.openInbox()

  ChaosButton
    id: marketButton
    anchors.left: inboxButton.right
    anchors.bottom: parent.bottom
    margin-left: 6
    size: 84 24
    !text: tr('Market')
    @onClick: modules.game_depottabs.openMarket()

  ChaosButton
    id: storeButton
    anchors.left: marketButton.right
    anchors.bottom: parent.bottom
    margin-left: 6
    size: 98 24
    !text: tr('Buy Tabs')
    !tooltip: tr('Open the Store at Depot Tabs.')
    @onClick: modules.game_depottabs.openStore()

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 72 24
    !text: tr('Close')
    @onClick: modules.game_depottabs.closeWindow()

DepotStyleWindow < ChaosMainWindow
  id: depotStyleWindow
  size: 300 250
  !text: tr('Depot Tab')
  @onEscape: modules.game_depottabs.closeStyle()
  @onEnter: modules.game_depottabs.saveStyle()

  ChaosLabel
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16
    text-align: left
    !text: tr('Name (empty: the tab number)')

  ChaosTextEdit
    id: nameEdit
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 22
    max-length: 16

  ChaosLabel
    id: colorLabel
    anchors.top: nameEdit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 16
    text-align: left
    !text: tr('Colour')

  UIWidget
    id: swatches
    anchors.top: colorLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 58
    layout:
      type: grid
      cell-size: 26 26
      cell-spacing: 4
      num-columns: 7
      flow: true

  ChaosLabel
    id: error
    anchors.top: swatches.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 16
    color: #e03a1e
    text-align: center

  ChaosButton
    id: saveButton
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    margin-right: 6
    size: 80 24
    !text: tr('Save')
    @onClick: modules.game_depottabs.saveStyle()

  ChaosButton
    id: cancelButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 80 24
    !text: tr('Cancel')
    @onClick: modules.game_depottabs.closeStyle()
