// Monk chi HUD: five pips over the bottom of the map (server: monk_combat.lua / monk_chi_core.lua, extended opcode 247)
ChiPip < UIWidget
  size: 18 18
  margin-left: 4
  border-width: 1
  border-color: #6b5a3c
  background-color: #1a1418cc
  phantom: true

ChaosPanelDark
  id: monkChiHud
  height: 40
  width: 150
  anchors.bottom: parent.bottom
  anchors.horizontalCenter: parent.horizontalCenter
  margin-bottom: 64
  padding: 4
  phantom: true
  focusable: false

  UILabel
    id: title
    text: Chi
    font: verdana-11px-rounded
    color: #d6c9ae
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true
    phantom: true

  Panel
    id: pips
    height: 18
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    phantom: true
    layout:
      type: horizontalBox
