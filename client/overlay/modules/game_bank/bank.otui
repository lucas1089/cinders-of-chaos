// The amount dialog of Deposit, Withdraw and Transfer: a numeric input next to the slider, quick buttons and OK /
// Cancel. bank.lua sets the title and the height (bank_core.lua B.HEIGHT; the recipient row only shows for Transfer).
// HorizontalScrollBar, not OptionScrollbar: the theme maps that one to a vertical bar (client_chaos_theme/compat.otui),
// which stretched across the old dialog and pushed its buttons out of it.
BankAmountWindow < MainWindow
  id: bankAmountWindow
  !text: tr('Bank')
  size: 290 186

  Label
    id: balance
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 16

  Panel
    id: recipientRow
    anchors.top: balance.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 22

    Label
      id: recipientLabel
      !text: tr('Recipient:')
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 70
      text-align: left

    TextEdit
      id: recipientEdit
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: recipientLabel.right
      anchors.right: parent.right
      max-length: 29

  Panel
    id: amountRow
    anchors.top: recipientRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 22

    Label
      id: amountLabel
      !text: tr('Amount:')
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 70
      text-align: left

    TextEdit
      id: amountEdit
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: amountLabel.right
      anchors.right: parent.right
      max-length: 10

  HorizontalScrollBar
    id: value
    anchors.top: amountRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    minimum: 0
    maximum: 0
    step: 1

  Button
    id: quick25
    text: 25%
    anchors.top: value.bottom
    anchors.left: parent.left
    margin-top: 8
    size: 80 20

  Button
    id: quick50
    text: 50%
    anchors.top: value.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    size: 80 20

  Button
    id: quickAll
    !text: tr('All')
    anchors.top: value.bottom
    anchors.right: parent.right
    margin-top: 8
    size: 80 20

  HorizontalSeparator
    id: buttonsSeparator
    anchors.top: quick25.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  Button
    id: buttonCancel
    !text: tr('Cancel')
    anchors.top: buttonsSeparator.bottom
    anchors.right: parent.right
    margin-top: 8
    size: 80 20

  Button
    id: buttonOk
    !text: tr('Ok')
    anchors.top: buttonsSeparator.bottom
    anchors.right: buttonCancel.left
    margin-top: 8
    margin-right: 6
    size: 80 20

MainWindow
  id: amountWindow
  !text: tr('Bank')
  size: 330 215
  @onEscape: modules.game_bank.bankWindowtoggle()

  CustomTabButton
    id: gold
    size: 145 25
    anchors.top: parent.top
    anchors.left: parent.left
    !text: tr('Gold Coins')
    text-offset: 0 -1

  // stars came with the imported client and are no currency of this game (server Chaos.bank.starItemId = 0)
  CustomTabButton
    id: star
    size: 145 25
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 10
    !text: tr('Star Coins')
    text-offset: 0 -1
    visible: false

  HorizontalSeparator
    id: sharta1
    anchors.top: gold.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  VerticalSeparator
    id: sharta2
    anchors.top: sharta1.bottom
    anchors.bottom: parent.bottom
    anchors.left: parent.horizontalCenter
    margin-top: 5
    margin-bottom: 30

  UIWidget
    id: balance
    anchors.top: sharta1.bottom
    anchors.left: parent.left
    margin-top: 10
    !text: tr('Inventory Balance:')

  Item
    id: item
    size: 22 22
    anchors.left: parent.left
    anchors.top: balance.bottom
    margin-top: 8
    focusable: false
    virtual: true
    !tooltip: tr('Gold Coin')

  Panel
    id: textEdit2
    image-source: /images/ui/panel_flat
    image-border: 6
    padding: 3
    image-color: #cccccc
    size: 109 22
    anchors.left: item.right
    anchors.top: balance.bottom
    font: verdana-11px-rounded
    text-align: center
    margin-top: 8
    margin-left: 5
    color: yellow

  Button
    id: depositButton
    !text: tr('Deposit')
    size: 136 20
    anchors.left: parent.left
    anchors.top: item.bottom
    margin-top: 7
    focusable: false

  Button
    id: depositAllButton
    !text: tr('Deposit all')
    !tooltip: tr('Deposit every gold, platinum and crystal coin you carry.')
    size: 136 20
    anchors.left: parent.left
    anchors.top: depositButton.bottom
    margin-top: 4
    focusable: false

  UIWidget
    id: balance2
    anchors.top: sharta1.bottom
    anchors.left: sharta2.right
    margin-left: 15
    margin-top: 10
    !text: tr('Bank Balance:')

  Item
    id: item2
    size: 22 22
    anchors.left: sharta2.right
    anchors.top: balance2.bottom
    margin-top: 8
    margin-left: 15
    focusable: false
    virtual: true
    !tooltip: tr('Gold Coin')

  Panel
    id: textEdit3
    image-source: /images/ui/panel_flat
    image-border: 6
    padding: 3
    image-color: #cccccc
    size: 109 22
    anchors.left: item2.right
    anchors.top: balance2.bottom
    font: verdana-11px-rounded
    text-align: center
    margin-top: 8
    margin-left: 5
    editable: false
    color: yellow

  Button
    id: WithdrawButton
    !text: tr('Withdraw')
    size: 65 20
    anchors.left: sharta2.right
    anchors.top: item2.bottom
    margin-top: 7
    margin-left: 15
    focusable: false

  Button
    id: TransferButton
    !text: tr('Transfer')
    size: 65 20
    anchors.left: WithdrawButton.right
    anchors.top: item2.bottom
    margin-top: 7
    margin-left: 6
    focusable: false

  Button
    id: withdrawAllButton
    !text: tr('Withdraw all')
    !tooltip: tr('Withdraw your whole balance. What does not fit (capacity or free slots) stays in the bank.')
    size: 136 20
    anchors.left: WithdrawButton.left
    anchors.top: WithdrawButton.bottom
    margin-top: 4
    focusable: false

  HorizontalSeparator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 26

  Button
    id: close
    !text: tr('Close')
    size: 100 20
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    focusable: false
