// Next Goals tracker HUD (game_goals): the first open goals of the character, at the left edge of the visible map,
// half way down (the other HUDs: top left character plate, rift and invasion; top centre siege, arena and monster bar;
// top right toasts; bottom right the task tracker; bottom centre monk chi). Drag the title to move it (saved per character), click it to fold it, a row to open
// the Next Goals window; while a new character walks its welcome path (O370, server welcomepath.lua) its current step
// comes first, with "Skip welcome path" under it (two clicks), and the goals get their own "Next Goals" head; below the goals the Ascension section (the steps of the ascension quest, same rows) shows
// while the character can ascend, then the Spell Quest section (the line spell quest the character is on); the window's "Tracker on screen" box (or Adventure > Goal Tracker) hides it.
GoalTrackerRow < UIWidget
  height: 26
  phantom: false
  focusable: false

  UILabel
    id: label
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 14
    text-align: topLeft
    font: verdana-11px-antialised
    color: #e8dcc2
    phantom: true

  ChaosProgressBar
    id: bar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: label.bottom
    margin-top: 1
    height: 6
    background-color: #a3844b
    phantom: true

ChaosPanelDark
  id: goalsTracker
  width: 220
  padding: 6
  focusable: false
  visible: false
  opacity: 0.92
  layout:
    type: verticalBox
    fit-children: true

  UILabel
    id: title
    height: 16
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    !text: tr('Next Goals')
    phantom: false

  UIWidget
    id: welcomeRows
    phantom: true
    layout:
      type: verticalBox
      fit-children: true

  UILabel
    id: welcomeSkip
    height: 14
    font: verdana-11px-antialised
    color: #8c8070
    text-align: right
    visible: false
    phantom: false
    !text: tr('Skip welcome path')

  UILabel
    id: goalsTitle
    height: 16
    margin-top: 4
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    visible: false
    !text: tr('Next Goals')
    phantom: true

  UIWidget
    id: rows
    phantom: true
    layout:
      type: verticalBox
      fit-children: true

  UILabel
    id: ascTitle
    height: 16
    margin-top: 4
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    visible: false
    !text: tr('Ascension')
    phantom: true

  UIWidget
    id: ascRows
    phantom: true
    layout:
      type: verticalBox
      fit-children: true

  UILabel
    id: sqTitle
    height: 16
    margin-top: 4
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    visible: false
    !text: tr('Spell Quest')
    phantom: true

  UIWidget
    id: sqRows
    phantom: true
    layout:
      type: verticalBox
      fit-children: true
