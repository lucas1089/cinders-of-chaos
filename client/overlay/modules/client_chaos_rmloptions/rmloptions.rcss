/* Options window in RmlUi. Dark theme of the client (client_chaos_theme): bg #0d0b0e, iron #3a3339, parchment #d6c9ae,
   ember gold #e8b84a, blood #8a1010. RmlUi draws form controls only through this sheet: every part is styled here. */
body {
	/* the document fills the screen but lets clicks through to the OTUI windows below */
	width: 100%;
	height: 100%;
	pointer-events: none;
	font-family: "Alegreya Sans";
	font-size: 15dp;
	color: #d6c9ae;
	display: flex;
	justify-content: center;
	align-items: center;
}

#window {
	pointer-events: auto;
	display: flex;
	flex-direction: column;
	/* 960x540: 92% = 883 wide, 90% high. 1920x1080: capped at 860 x 640. */
	width: 92%;
	max-width: 860dp;
	height: 90%;
	max-height: 640dp;
	box-sizing: border-box;
	padding: 8dp 10dp;
	background-color: #14111a;
	border: 2dp #3a3339;
	border-radius: 4dp;
}

#titlebar {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-bottom: 6dp;
	border-bottom: 1dp #3a3339;
}

#title {
	font-family: "Alegreya SC";
	font-weight: bold;
	font-size: 20dp;
	color: #e8b84a;
}

#main {
	flex: 1 1 0dp;
	min-height: 0dp;
	display: flex;
	flex-direction: row;
	margin-top: 6dp;
}

#nav {
	width: 170dp;
	flex: 0 0 170dp;
	overflow-y: auto;
	padding-right: 6dp;
}

#content {
	flex: 1 1 0dp;
	min-width: 0dp;
	overflow-y: auto;
	padding: 4dp 6dp;
	background-color: #0d0b0e;
	border: 1dp #3a3339;
}

/* menu */
button.nav {
	display: block;
	width: 100%;
	min-width: 0dp;
	margin: 0dp 0dp 3dp 0dp;
	padding: 5dp 8dp;
	text-align: left;
}
button.nav.sub { padding-left: 22dp; font-size: 14dp; }
button.nav.on { color: #f6cf72; border-color: #e8b84a; background-color: #3a2a1c; }
button.nav.classic { color: #8c8070; }

/* one FlatPanel of the classic page */
.group {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	padding: 5dp 8dp;
	margin-bottom: 5dp;
	background-color: #171319;
	border: 1dp #3a3339;
	border-radius: 2dp;
}
.group.loose { background-color: transparent; border-width: 0dp; }

.pair {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
}
.pair .lbl { flex: 1 1 auto; }
.lbl { flex: 1 1 auto; margin: 3dp 10dp 3dp 0dp; }
.lbl.off, .check.off, .off { color: #6a6058; }

label.check {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	margin: 3dp 10dp 3dp 0dp;
}
label.check:hover { color: #f6cf72; }

input.checkbox {
	width: 14dp;
	height: 14dp;
	flex: 0 0 14dp;
	margin-right: 8dp;
	background-color: #0d0b0e;
	border: 1dp #7d7176;
	border-radius: 2dp;
}
input.checkbox:hover { border-color: #e8b84a; }
input.checkbox:checked { background-color: #e8b84a; border-color: #f6cf72; }
input.checkbox:disabled { border-color: #3a3339; background-color: #1d181d; }
input.checkbox:checked:disabled { background-color: #6a5a30; }

/* slider */
input.range {
	width: 200dp;
	height: 16dp;
	margin: 3dp 4dp;
}
input.range slidertrack {
	margin-top: 6dp;
	height: 4dp;
	background-color: #3a3339;
	border-radius: 2dp;
}
input.range sliderbar {
	width: 12dp;
	height: 16dp;
	background-color: #e8b84a;
	border-radius: 3dp;
}
input.range sliderbar:hover, input.range sliderbar:active { background-color: #f6cf72; }
input.range:disabled sliderbar { background-color: #6a6058; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0dp; height: 0dp; }

/* combo box */
select {
	width: 220dp;
	height: 24dp;
	margin: 3dp 4dp;
	padding: 0dp;
	background-color: #0d0b0e;
	border: 1dp #7d7176;
	border-radius: 2dp;
}
select:hover { border-color: #e8b84a; }
select:disabled { border-color: #3a3339; color: #6a6058; }
select selectvalue {
	height: 22dp;
	padding: 2dp 26dp 0dp 8dp;
}
select selectarrow {
	width: 20dp;
	height: 22dp;
	background-color: #2a2128;
}
select selectbox {
	margin-top: 1dp;
	background-color: #14111a;
	border: 1dp #7d7176;
	padding: 2dp 0dp;
}
select selectbox option { padding: 3dp 8dp; }
select selectbox option:hover { background-color: #3a2a1c; color: #f6cf72; }
select selectbox option:checked { color: #e8b84a; }

/* help icons of the classic page: "?" opens the tooltip text below the panel */
.help {
	width: 18dp;
	height: 18dp;
	margin-left: 6dp;
	text-align: center;
	color: #0d0b0e;
	background-color: #7d7176;
	border-radius: 9dp;
	font-size: 13dp;
}
.help:hover { background-color: #e8b84a; }
.helptext {
	display: none;
	margin: -3dp 0dp 6dp 0dp;
	padding: 5dp 10dp;
	font-size: 14dp;
	color: #b0a488;
	background-color: #1d181d;
	border-left: 2dp #e8b84a;
}
.helptext.open { display: block; }

.classicnote { padding: 12dp 6dp; color: #b0a488; }

#footer {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	padding-top: 8dp;
}

button {
	display: block;
	box-sizing: border-box;
	min-width: 96dp;
	padding: 5dp 14dp;
	margin-left: 8dp;
	text-align: center;
	color: #d6c9ae;
	background-color: #2a2128;
	border: 1dp #7d7176;
	border-radius: 2dp;
}
button:hover { color: #f6cf72; border-color: #e8b84a; }
button:active { background-color: #5a0a0a; color: #f4ead6; }
button:disabled { color: #6a6058; border-color: #3a3339; }
button.primary { background-color: #8a1010; border-color: #e03a1e; }
button.primary:hover { background-color: #b8160f; }
button.icon { min-width: 28dp; padding: 2dp 6dp; margin-left: 0dp; }
button.act { margin: 3dp 8dp 3dp 0dp; }

scrollbarvertical { width: 12dp; background-color: #14111a; }
scrollbarvertical sliderbar { width: 12dp; min-height: 24dp; background-color: #3a3339; border-radius: 3dp; }
scrollbarvertical sliderbar:hover { background-color: #7d7176; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }
