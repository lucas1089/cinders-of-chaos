Module
  name: client_chaos_wingfit
  description: Wings centred on the body they are drawn with: hands the tables of wing_centres.lua (from the pair) to the engine (base patches 0193 and 0200: wings and head accessories) and the anchors of the code-drawn wings (wing_anchors.lua, base patch 0204) and the purchased pieces of pair 83 (wear_pieces.lua, base patch 0209)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ wing_centres, head_centres, wing_anchors, wear_pieces, wingfit_core, wingfit ]
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
