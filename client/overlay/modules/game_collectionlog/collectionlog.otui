// Collection log window (game_collectionlog, O753). Styles from client_chaos_theme (styles.otui).

CollectionHeader < UIWidget
  height: 22
  background-color: #2a2018
  phantom: true

  ChaosLabel
    id: label
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    color: #e8b84a
    text-align: left

  ChaosLabelDim
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 90
    text-align: right

CollectionRow < UIWidget
  height: 36
  phantom: true

  ChaosItemSlot
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 34 34
    virtual: true
    phantom: true

  ChaosLabel
    id: name
    anchors.left: icon.right
    anchors.right: detail.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-align: left

  ChaosLabelDim
    id: detail
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 170
    text-align: right

CollectionPityRow < UIWidget
  height: 34
  phantom: true

  ChaosLabel
    id: label
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: value.left
    height: 16
    text-align: left

  ChaosLabelDim
    id: value
    anchors.top: parent.top
    anchors.right: parent.right
    width: 70
    height: 16
    text-align: right

  ChaosProgressBar
    id: bar
    anchors.top: label.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 8

ChaosMainWindow
  id: collectionLogWindow
  size: 760 500
  $mobile:
    size: 640 400
  !text: tr('Collection Log')
  @onEscape: modules.game_collectionlog.hide()

  ChaosCloseX
    @onClick: modules.game_collectionlog.hide()

  ChaosTextEdit
    id: searchEdit
    anchors.top: parent.top
    anchors.left: parent.left
    width: 180
    height: 22
    max-length: 32
    !tooltip: tr('Search by name')

  ChaosComboBox
    id: statusCombo
    anchors.left: searchEdit.right
    anchors.verticalCenter: searchEdit.verticalCenter
    margin-left: 6
    size: 110 22
    !tooltip: tr('Owned, seen or not yet')

  ChaosLabelDim
    id: summaryLabel
    anchors.left: statusCombo.right
    anchors.right: parent.right
    anchors.verticalCenter: searchEdit.verticalCenter
    margin-left: 8
    text-align: right

  ChaosPanelDark
    id: listPanel
    anchors.top: searchEdit.bottom
    anchors.left: parent.left
    anchors.right: pityPanel.left
    anchors.bottom: closeButton.top
    margin-top: 8
    margin-right: 8
    margin-bottom: 8
    padding: 3

    UIScrollArea
      id: itemList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin: 2
      vertical-scrollbar: listScroll
      auto-focus: none
      layout:
        type: verticalBox

    ChaosScrollBar
      id: listScroll
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 3
      margin-bottom: 3
      margin-right: 3
      step: 36
      pixels-scroll: true

    ChaosLabelDim
      id: emptyLabel
      anchors.centerIn: parent
      width: 300
      height: 40
      text-wrap: true
      text-align: center
      visible: false
      !text: tr('Nothing matches the filter.')

  ChaosPanelDark
    id: pityPanel
    anchors.top: searchEdit.bottom
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 8
    margin-bottom: 8
    width: 230
    $mobile:
      width: 200
    padding: 8

    ChaosLabel
      id: pityTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      color: #e8b84a
      text-align: left
      !text: tr('Pity')

    ChaosLabelDim
      id: pityHint
      anchors.top: pityTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 44
      text-wrap: true
      text-align: topLeft
      !text: tr('Every try without the drop raises its chance. The last one is sure.')

    UIWidget
      id: pityList
      anchors.top: pityHint.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      phantom: true
      layout:
        type: verticalBox
        spacing: 4

    ChaosLabelDim
      id: emptyPity
      anchors.top: pityHint.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 16
      visible: false
      !text: tr('Loading...')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    !text: tr('Close')
    @onClick: modules.game_collectionlog.hide()
