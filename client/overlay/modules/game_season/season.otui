// Seasons window (game_season). Styles from client_chaos_theme (styles.otui).

SeasonTrackRow < ChaosPanelDark
  height: 44
  margin-bottom: 3
  phantom: false

  UILabel
    id: mark
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 18
    text-align: center
    font: verdana-11px-rounded
    color: #6b6258
    phantom: true

  UILabel
    id: name
    anchors.left: mark.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 4
    margin-right: 8
    text-align: left
    font: verdana-11px-rounded
    color: #d6c9ae
    phantom: true

  UILabel
    id: reward
    anchors.left: name.left
    anchors.right: progress.left
    anchors.bottom: parent.bottom
    margin-bottom: 5
    margin-right: 8
    text-align: left
    font: verdana-11px-antialised
    color: #b070ff
    phantom: true

  ChaosProgressBar
    id: progress
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 8
    margin-bottom: 4
    width: 150
    height: 14
    text-offset: 0 1
    font: verdana-11px-antialised

// ---------------------------------------------------------------- Journey tab (journey.lua)
JourneyChapterRow < ChaosTabButton
  height: 38
  margin-bottom: 3

  UILabel
    id: title
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 4
    margin-right: 2
    height: 14
    text-align: left
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

  UILabel
    id: status
    anchors.left: title.left
    anchors.top: title.bottom
    margin-top: 2
    text-auto-resize: true
    font: verdana-11px-antialised
    phantom: true

JourneyRewardCell < ChaosPanelDark
  phantom: true

  ChaosItemSlot
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true
    visible: false

  UICreature
    id: look
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    phantom: true
    visible: false

  UILabel
    id: badge
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    text-align: center
    font: verdana-11px-rounded
    color: #f6cf72
    image-source: /images/chaos/itemslot
    image-border: 4
    phantom: true
    visible: false

  UILabel
    id: text
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 44
    margin-right: 4
    height: 40
    text-wrap: true
    text-align: left
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

ChaosMainWindow
  id: seasonWindow
  size: 660 540
  !text: tr('Season')
  @onEscape: modules.game_season.hide()

  ChaosTabButton
    id: overviewTab
    anchors.top: parent.top
    anchors.left: parent.left
    width: 110
    !text: tr('Season')
    @onClick: modules.game_season.showTab('season')

  ChaosTabButton
    id: journeyTab
    anchors.top: overviewTab.top
    anchors.left: overviewTab.right
    margin-left: 4
    width: 110
    !text: tr('Journey')
    @onClick: modules.game_season.showTab('journey')

  ChaosLabel
    id: nameLabel
    anchors.top: overviewTab.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e8b84a

  ChaosLabel
    id: timerLabel
    anchors.verticalCenter: overviewTab.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    color: #f6cf72

  ChaosLabel
    id: modifierLabel
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    text-align: left
    text-wrap: true
    height: 28

  ChaosPanelHighlight
    id: minePanel
    anchors.top: modifierLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 46

    ChaosLabel
      id: mineLabel
      anchors.left: parent.left
      anchors.right: joinButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-right: 8
      text-align: left
      text-wrap: true
      height: 40
      color: #f6cf72

    ChaosButton
      id: joinButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      !text: tr('Join season')
      visible: false
      @onClick: modules.game_season.join()

  ChaosLabel
    id: trackTitle
    anchors.top: minePanel.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    color: #e8b84a
    !text: tr('Reward track (unlocked for your whole account, kept forever)')

  ChaosPanelDark
    id: listFrame
    anchors.top: trackTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: titlesLabel.top
    margin-top: 4
    margin-bottom: 6
    padding: 3

  UIScrollArea
    id: trackList
    anchors.top: listFrame.top
    anchors.left: listFrame.left
    anchors.right: listScroll.left
    anchors.bottom: listFrame.bottom
    margin: 4
    layout:
      type: verticalBox
    vertical-scrollbar: listScroll
    auto-focus: none

  ChaosScrollBar
    id: listScroll
    anchors.top: listFrame.top
    anchors.right: listFrame.right
    anchors.bottom: listFrame.bottom
    margin-top: 3
    margin-bottom: 3
    margin-right: 3
    step: 47
    pixels-scroll: true

  ChaosLabelDim
    id: emptyText
    anchors.centerIn: listFrame
    !text: tr('No season is configured.')
    text-auto-resize: true
    visible: false

  ChaosLabel
    id: titlesLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8
    text-align: left
    color: #b070ff

  ChaosLabelDim
    id: hintLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 8
    text-align: left
    text-wrap: true
    height: 28
    !text: tr('Season characters trade, mail and party only within their season.')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_season.hide()

  UIWidget
    id: journeyPanel
    anchors.top: overviewTab.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 8
    margin-bottom: 8
    visible: false

    ChaosLabel
      id: journeyTitle
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #e8b84a

    ChaosLabel
      id: journeySummary
      anchors.top: parent.top
      anchors.right: parent.right
      text-auto-resize: true
      color: #b070ff

    ChaosLabel
      id: previewLabel
      anchors.top: journeyTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 16
      text-align: left
      text-wrap: true
      color: #ff9a3c
      visible: false

    ChaosPanelDark
      id: chapterFrame
      anchors.top: previewLabel.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 4
      width: 214
      padding: 3

    UIScrollArea
      id: chapterList
      anchors.fill: chapterFrame
      margin: 5
      layout:
        type: verticalBox
      auto-focus: none

    ChaosPanelHighlight
      id: detailFrame
      anchors.top: chapterFrame.top
      anchors.left: chapterFrame.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 6

    ChaosLabel
      id: chapterName
      anchors.top: detailFrame.top
      anchors.left: detailFrame.left
      margin-top: 6
      margin-left: 8
      text-auto-resize: true
      font: verdana-11px-rounded

    ChaosLabel
      id: doneBanner
      anchors.top: detailFrame.top
      anchors.right: detailFrame.right
      margin-top: 6
      margin-right: 8
      text-auto-resize: true
      color: #7fc86a
      visible: false

    ChaosLabelDim
      id: chapterNote
      anchors.top: chapterName.bottom
      anchors.left: detailFrame.left
      anchors.right: detailFrame.right
      margin-top: 3
      margin-left: 8
      margin-right: 8
      height: 28
      text-align: left
      text-wrap: true

    ChaosPanelDark
      id: objectiveFrame
      anchors.top: chapterNote.bottom
      anchors.left: detailFrame.left
      anchors.right: detailFrame.right
      anchors.bottom: rewardsTitle.top
      margin: 4 6 4 6
      padding: 3

    UIScrollArea
      id: objectiveList
      anchors.top: objectiveFrame.top
      anchors.left: objectiveFrame.left
      anchors.right: objectiveScroll.left
      anchors.bottom: objectiveFrame.bottom
      margin: 4
      layout:
        type: verticalBox
      vertical-scrollbar: objectiveScroll
      auto-focus: none

    ChaosScrollBar
      id: objectiveScroll
      anchors.top: objectiveFrame.top
      anchors.right: objectiveFrame.right
      anchors.bottom: objectiveFrame.bottom
      margin-top: 3
      margin-bottom: 3
      margin-right: 3
      step: 47
      pixels-scroll: true

    ChaosLabel
      id: rewardsTitle
      anchors.left: detailFrame.left
      anchors.bottom: rewardsRow.top
      margin-left: 8
      margin-bottom: 3
      text-auto-resize: true
      color: #e8b84a
      !text: tr('Chapter rewards')

    UIWidget
      id: rewardsRow
      anchors.left: detailFrame.left
      anchors.right: detailFrame.right
      anchors.bottom: detailFrame.bottom
      margin: 0 6 6 6
      height: 92
      layout:
        type: grid
        cell-size: 196 44
        cell-spacing: 4
        flow: true

    ChaosLabelDim
      id: waitLabel
      anchors.centerIn: detailFrame
      text-auto-resize: true
      !text: tr('Loading the journey...')
