Module
  name: game_season
  description: Seasons window (season, time left, account reward track, join, Journey tab; extended opcode 246)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ seasonjoin, journeyview, journey, season ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
