Module
  name: game_groundlabels
  description: Ground loot labels - item names over the ground in rarity colours by the loot filter's rules, Alt shows all, corpse labels, despawn timers, click to pick up; extended opcode 230
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ groundlabelslogic, groundlabels ]
  dependencies:
    - game_interface
    - game_lootfilter
    - game_itemtooltip
  autoload: true
  autoload-priority: 1001
  @onLoad: init()
  @onUnload: terminate()
