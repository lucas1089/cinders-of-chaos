Module
  name: game_monsterinspect
  description: Inspect Monster window (extended opcode 166): everything the player may know about a monster in view, from the server. Opened from the right-click menu (Inspect) and by Shift + left click.
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ monsterinspect_logic, monsterinspect ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
