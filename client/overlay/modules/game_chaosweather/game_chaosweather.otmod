Module
  name: game_chaosweather
  description: Rain over the game window, drawn by the client from one small message of the server (extended opcode 114, weather.lua); switch in Options > Graphics (O208)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ chaosweather_logic, chaosweather ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1010
  @onLoad: init()
  @onUnload: terminate()
