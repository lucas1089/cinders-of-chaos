Module
  name: game_chaosweather
  description: Rain and ambient particles over the game window, drawn by the client from one small message of the server (extended opcode 114, weather.lua); switches in Options > Graphics (O208, O226)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ chaosweather_logic, chaosambient_logic, chaosambient, chaosweather ]
  dependencies:
    - game_interface
  autoload: true
  autoload-priority: 1010
  @onLoad: init()
  @onUnload: terminate()
