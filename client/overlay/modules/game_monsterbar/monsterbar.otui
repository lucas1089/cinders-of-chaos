// The bar of the monster you attack. Art: client/tools/gen_monsterbar_art.py (its docstring has the layout):
// the frame is 420x58 at y 8 with its socket window at 38,30 (344x16), so the socket is at 38,38 here.
MonsterBarFill < UIWidget
  anchors.left: parent.left
  anchors.top: parent.top
  margin-left: 38
  margin-top: 38
  size: 344 16
  phantom: true

MonsterBarPlate < UIWidget
  height: 22
  image-border-left: 10
  image-border-right: 10
  image-border-top: 6
  image-border-bottom: 6
  image-source: /images/chaos/monsterbar/plaque_normal
  phantom: true

MonsterBarModChip < UIWidget
  size: 26 26
  phantom: false

Panel
  id: monsterBar
  size: 420 90
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  // margin-top and margin-left are set by place() (monsterbar.lua): the map panel can start above the window
  margin-top: 44
  phantom: true
  visible: false

  // the socket's dark well, then the damage trail and the health fill (widths set by monsterbar.lua)
  MonsterBarFill
    id: barBack
    background-color: #0e0a0c

  MonsterBarFill
    id: trail
    image-source: /images/chaos/monsterbar/trail

  MonsterBarFill
    id: fill
    image-source: /images/chaos/monsterbar/fill_normal

  // fixed size: stretching the frame would move its socket away from the fill
  UIWidget
    id: frame
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 8
    size: 420 58
    image-source: /images/chaos/monsterbar/frame_normal
    phantom: true

  Label
    id: percent
    anchors.horizontalCenter: barBack.horizontalCenter
    anchors.verticalCenter: barBack.verticalCenter
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #f4ead2
    // a dark backing keeps it legible over the pale damage trail
    background-color: #0c080ab4
    padding: 0 3
    phantom: true

  MonsterBarPlate
    id: namePlate
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    width: 160

  Label
    id: name
    anchors.horizontalCenter: namePlate.horizontalCenter
    anchors.verticalCenter: namePlate.verticalCenter
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #d6c9ae
    phantom: true

  MonsterBarPlate
    id: levelPlate
    anchors.right: namePlate.left
    anchors.verticalCenter: namePlate.verticalCenter
    margin-right: 2
    width: 54
    visible: false

  Label
    id: level
    anchors.horizontalCenter: levelPlate.horizontalCenter
    anchors.verticalCenter: levelPlate.verticalCenter
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #d6c9ae
    phantom: true

  // modifier chips under the bar, centred (tooltips: monsterbarstyle.lua S.MODS)
  UIWidget
    id: mods
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 63
    height: 26
    phantom: true
    layout:
      type: horizontalBox
      spacing: 3
      fit-children: true
