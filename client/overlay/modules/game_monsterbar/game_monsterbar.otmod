Module
  name: game_monsterbar
  description: Tiered monster health bar (normal, magic, rare, legendary, boss, rift and Omen guardians) and the boss cast bar
  author: Cinders of Chaos
  sandboxed: true
  autoload: true
  autoload-priority: 900
  dependencies: [ game_interface ]
  scripts: [ monsterbarmath, monsterbarstyle, monsterbarmech, monsterbar ]
  @onLoad: init()
  @onUnload: terminate()
