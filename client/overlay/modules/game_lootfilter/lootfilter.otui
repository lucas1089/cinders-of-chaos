// Loot Filter window and loot channel styles (game_lootfilter). Styles from client_chaos_theme (styles.otui).

LootFilterLabel < ChaosLabel
  text-align: left
  text-auto-resize: true

LootFilterHeader < UILabel
  font: verdana-11px-rounded
  color: #e8b84a
  text-auto-resize: true
  phantom: true

LootFilterCombo < ChaosComboBox
  size: 132 22

LootFilterPreset < ChaosButton
  size: 104 22
  margin-right: 6

LootFilterPreview < ChaosItemSlot
  size: 34 34
  margin-right: 2
  margin-bottom: 2
  virtual: true

// one rule of the Rule counters and sounds panel: name, counters, sound, play, reset
LootFilterRuleRow < UIWidget
  height: 44
  margin-bottom: 4
  phantom: true

  UILabel
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #d6c9ae
    phantom: true

  ChaosLabelDim
    id: count
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: sound.left
    margin-top: 4
    margin-right: 6
    height: 14
    text-align: left

  ChaosButton
    id: reset
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 24 22
    padding: 0
    text: x
    !tooltip: tr('Reset this rule: session and total')

  ChaosButton
    id: play
    anchors.right: reset.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 40 22
    padding: 0
    !text: tr('Play')
    !tooltip: tr('Play the sound at the chosen volume')

  ChaosComboBox
    id: sound
    anchors.right: play.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 92 22
    !tooltip: tr('The sound when a drop of your kill matches this rule')

// one loot feed row: the monster's icon, then the item icons (wrapping to more lines); no text
LootChannelRow < UIWidget
  margin-bottom: 3
  phantom: true
  layout:
    type: grid
    cell-size: 32 32
    cell-spacing: 2
    flow: true
    fit-children: true

// the killed monster, drawn from its look (server kill.look) facing south, scaled into the cell
LootChannelMonster < UICreature
  size: 32 32
  fixed-creature-size: true
  padding: 1
  background-color: #120c0a
  border-width: 1
  border-color: #4a3426
  phantom: false

LootChannelItem < Item
  size: 32 32
  virtual: true
  phantom: false

// covers the console text while the Loot tab is selected
LootChannelPanel < UIWidget
  image-source: /images/ui/console
  image-clip: 0 50 184 124
  image-border: 4
  anchors.fill: parent
  phantom: false
  focusable: false

  ScrollablePanel
    id: list
    anchors.fill: parent
    margin-right: 12
    vertical-scrollbar: listScroll
    padding: 4
    padding-left: 4
    layout:
      type: verticalBox
      align-bottom: true
    inverted-scroll: true

  VerticalScrollBar
    id: listScroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 3
    margin-right: 3
    margin-bottom: 3
    step: 35
    pixels-scroll: true

  UILabel
    id: hint
    anchors.top: parent.top
    anchors.right: listScroll.left
    margin-top: 3
    margin-right: 6
    text-auto-resize: true
    font: verdana-11px-antialised
    color: #8c8070
    !text: tr('Loot: click an icon to loot (shift: one)')

ChaosMainWindow
  id: lootFilterWindow
  size: 1000 526
  // phone interface is 960 wide: the rules panel is 20 narrower so the two checkbox columns (2 x 290) fit
  $mobile:
    width: 950
  !text: tr('Loot Filter')
  @onEscape: modules.game_lootfilter.hide()

  LootFilterHeader
    id: presetHeader
    anchors.top: parent.top
    anchors.left: parent.left
    !text: tr('Presets')

  UIWidget
    id: presets
    anchors.top: presetHeader.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 4
    height: 22
    phantom: true
    layout:
      type: horizontalBox

  ChaosLabelDim
    id: presetInfo
    anchors.top: presets.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 4
    height: 14
    text-align: left

  ChaosSeparator
    id: sep1
    anchors.top: presetInfo.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 6

  LootFilterHeader
    id: corpseHeader
    anchors.top: sep1.bottom
    anchors.left: parent.left
    margin-top: 4
    !text: tr('Corpses and the loot channel (free)')

  LootFilterLabel
    id: highlightLabel
    anchors.top: corpseHeader.bottom
    anchors.left: parent.left
    margin-top: 10
    !text: tr('Glow on gear from')

  LootFilterCombo
    id: highlightCombo
    anchors.verticalCenter: highlightLabel.verticalCenter
    anchors.left: parent.left
    margin-left: 130

  LootFilterLabel
    id: dimLabel
    anchors.verticalCenter: highlightLabel.verticalCenter
    anchors.left: highlightCombo.right
    margin-left: 24
    !text: tr('Dim gear below')

  LootFilterCombo
    id: dimCombo
    anchors.verticalCenter: highlightLabel.verticalCenter
    anchors.left: dimLabel.right
    margin-left: 10

  LootFilterLabel
    id: tierLabel
    anchors.top: highlightLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    !text: tr('Glow on a modifier of')

  LootFilterCombo
    id: tierCombo
    anchors.verticalCenter: tierLabel.verticalCenter
    anchors.left: parent.left
    margin-left: 130

  ChaosCheckBox
    id: show_equipment
    anchors.top: tierLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    width: 290
    !text: tr('Show equipment')

  ChaosCheckBox
    id: show_currency
    anchors.top: show_equipment.top
    anchors.left: show_equipment.right
    width: 290
    !text: tr('Show currency (orbs, coins)')

  ChaosCheckBox
    id: show_supplies
    anchors.top: show_equipment.bottom
    anchors.left: parent.left
    margin-top: 6
    width: 290
    !text: tr('Show supplies (potions, runes)')

  ChaosCheckBox
    id: show_other
    anchors.top: show_supplies.top
    anchors.left: show_supplies.right
    width: 290
    !text: tr('Show other items')

  ChaosLabelDim
    id: categoryHint
    anchors.top: show_supplies.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 6
    height: 14
    text-align: left
    !text: tr('Unchecked categories are dimmed (still lootable). Uniques and orbs always glow.')

  ChaosCheckBox
    id: icons
    anchors.top: categoryHint.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 290
    !text: tr('Loot tab shows item icons')
    !tooltip: tr('The Loot console tab shows a row of icons per kill instead of the text. Click an icon to loot it.')

  ChaosCheckBox
    id: notify
    anchors.top: icons.top
    anchors.left: icons.right
    width: 290
    !text: tr('Rare-drop message')
    !tooltip: tr('A coloured "Rare drop: [Legendary] ..." line for every item that glows.')

  ChaosSeparator
    id: sep2
    anchors.top: icons.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 8

  ChaosPanelDark
    id: autolootPanel
    anchors.top: sep2.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 4
    height: 96

    LootFilterHeader
      id: autolootHeader
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Rarity Autoloot (store unlock)')

    LootFilterLabel
      id: lootMinLabel
      anchors.top: autolootHeader.bottom
      anchors.left: parent.left
      margin-top: 10
      !text: tr('Leave list gear below')

    LootFilterCombo
      id: lootMinCombo
      anchors.verticalCenter: lootMinLabel.verticalCenter
      anchors.left: parent.left
      margin-left: 150
      !tooltip: tr('Gear on your autoloot list with a lower rarity stays in the corpse.')

    LootFilterLabel
      id: lootFromLabel
      anchors.top: lootMinLabel.bottom
      anchors.left: parent.left
      margin-top: 14
      !text: tr('Also pick up gear from')

    LootFilterCombo
      id: lootFromCombo
      anchors.verticalCenter: lootFromLabel.verticalCenter
      anchors.left: parent.left
      margin-left: 150
      !tooltip: tr('Gear of this rarity or better (and uniques) is autolooted even when it is not on your autoloot list.')

    ChaosLabel
      id: lockLabel
      anchors.top: autolootHeader.bottom
      anchors.left: lootMinCombo.right
      anchors.right: storeButton.left
      margin-left: 16
      margin-right: 8
      margin-top: 8
      height: 56
      text-wrap: true
      text-align: topLeft
      color: #e03a1e

    ChaosButton
      id: storeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      size: 92 24
      !text: tr('Open Store')
      @onClick: modules.game_lootfilter.openStore()

  LootFilterHeader
    id: previewHeader
    anchors.top: autolootPanel.bottom
    anchors.left: parent.left
    margin-top: 8
    !text: tr('Preview (as a corpse shows them with these settings)')

  UIWidget
    id: preview
    anchors.top: previewHeader.bottom
    anchors.left: parent.left
    anchors.right: rulesPanel.left
    margin-right: 12
    margin-top: 4
    height: 74
    phantom: true
    layout:
      type: grid
      cell-size: 34 34
      cell-spacing: 2
      flow: true

  // ---------------------------------------------------------- rule counters and sounds
  ChaosPanelDark
    id: rulesPanel
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8
    width: 340
    $mobile:
      width: 320
    padding: 8

    LootFilterHeader
      id: rulesHeader
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Rule counters and sounds')

    ChaosLabelDim
      id: rulesHint
      anchors.top: rulesHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 42
      text-wrap: true
      text-align: topLeft
      !text: tr('Items your kills drop that match a rule. Session: since you logged in. The first rule with a sound plays.')

    UIWidget
      id: ruleRows
      anchors.top: rulesHint.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 240
      phantom: true
      layout:
        type: verticalBox

    LootFilterLabel
      id: volumeLabel
      anchors.top: ruleRows.bottom
      anchors.left: parent.left
      margin-top: 12
      !text: tr('Volume')

    ChaosComboBox
      id: volumeCombo
      anchors.verticalCenter: volumeLabel.verticalCenter
      anchors.left: parent.left
      margin-left: 70
      size: 80 22

    ChaosCheckBox
      id: muteCheck
      anchors.verticalCenter: volumeLabel.verticalCenter
      anchors.left: volumeCombo.right
      margin-left: 16
      width: 140
      !text: tr('Mute all')

    ChaosCheckBox
      id: huntCheck
      anchors.top: volumeLabel.bottom
      anchors.left: parent.left
      margin-top: 14
      width: 300
      !text: tr('Show the counters in the Hunt Tracker')
      !tooltip: tr('Hunt Tracker > Chaos Drops lists every rule with its counters.')

    ChaosButton
      id: resetSessionButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      size: 120 24
      !text: tr('Reset session')
      @onClick: modules.game_lootfilter.resetCounters('session')

    ChaosButton
      id: resetTotalButton
      anchors.bottom: parent.bottom
      anchors.left: resetSessionButton.right
      margin-left: 8
      size: 120 24
      !text: tr('Reset totals')
      @onClick: modules.game_lootfilter.resetCounters('total')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_lootfilter.hide()

  ChaosButton
    id: groundLabelsButton
    anchors.right: closeButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    size: 110 24
    !text: tr('Ground Labels')
    !tooltip: tr('Names over the items on the ground, by these rules')
    @onClick: if modules.game_groundlabels then modules.game_groundlabels.toggleSettings() end

  ChaosButton
    id: pouchButton
    anchors.right: groundLabelsButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    size: 96 24
    !text: tr('Loot Bag')
    !tooltip: tr('What your Loot Bag (a store item) collects from your kills')
    @onClick: if modules.game_pouches then modules.game_pouches.toggleSettings() end

  ChaosButton
    id: lootBeamsButton
    anchors.right: pouchButton.left
    anchors.bottom: parent.bottom
    margin-right: 8
    size: 96 24
    !text: tr('Loot Beams')
    !tooltip: tr('Light pillars over corpses with loot these rules make glow: on or off, height, intensity')
    @onClick: if modules.game_lootbeams then modules.game_lootbeams.toggleSettings() end

  ChaosLabelDim
    id: savedLabel
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.left: parent.left
    anchors.right: lootBeamsButton.left
    text-align: left
    !text: tr('Changes are saved on your character at once.')
