Module
  name: client_chaos_topbar
  description: Cinders of Chaos menu bar at the top of the game map (category drop-downs with sub-menus and hotkeys, systems shown as the character unlocks them; replaces the side button icons)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ topbarlogic, topbarunlockslogic, topbar_unlocks, chaos_topbar ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1050
  @onLoad: init()
  @onUnload: terminate()
