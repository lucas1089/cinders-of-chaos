Module
  name: client_chaos_topbar
  description: Chaos-styled icon bar at the top of the game window (toggles the custom game_* windows when present)
  author: project-chaos
  sandboxed: true
  scripts: [ chaos_topbar ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1050
  @onLoad: init()
  @onUnload: terminate()
