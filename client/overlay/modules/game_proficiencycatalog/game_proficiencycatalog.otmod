Module
  name: game_proficiencycatalog
  description: The weapon list of the Weapon Proficiency window, made on the client (the server sends no proficiency catalogue)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ catalogcore, proficiencycatalog ]
  dependencies:
    - game_interface
    - game_proficiency
  autoload: true
  autoload-priority: 1001
  @onLoad: init()
  @onUnload: terminate()
