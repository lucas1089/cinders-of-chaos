// The tower panel (O274), created by infinity_tower.lua inside a run: floor, floors cleared, monsters left, the countdown, the run's countdown (O484),
// the Leave button (bottom left) and the Next floor now button. Hidden outside a run. The player drags it by its background (the labels are phantom);
// a double-click puts it back here. The spot is saved per character (towerpanelpos.lua). The width grows in Lua when
// the button or the Automatic text needs it.
TowerPanel < UIWidget
  width: 290
  height: 124
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 54
  background-color: #0d0b0ee0
  border-width: 1
  border-color: #7d7176
  focusable: false
  !tooltip: tr('Drag to move. Double-click to put it back.')

  Label
    id: floorLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 6 0 6
    text-align: center
    phantom: true
    font: verdana-11px-rounded
    color: #f0e4c8
  Label
    id: clearedLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 6 0 6
    text-align: center
    phantom: true
    color: #c9bfae
  Label
    id: monstersLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 6 0 6
    text-align: center
    phantom: true
    color: #e8b4a0
  Label
    id: timerLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 6 0 6
    text-align: center
    phantom: true
    color: #f0e4c8
  Label
    id: runTimerLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 6 0 6
    text-align: center
    phantom: true
    color: #f0e4c8
  Button
    id: leaveButton
    width: 48
    height: 22
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin: 0 0 6 6
    !text: tr('Leave')
    !tooltip: tr('Leave the tower. Your cleared floors count. During a fight you leave after a short countdown.')
    focusable: false
  CheckBox
    id: autoSkipBox
    width: 100
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin: 0 6 9 0
    !text: tr('Automatic')
    !tooltip: tr('Start each next floor by itself as soon as the server allows it. In a group, Automatic only works for the run leader.')
    focusable: false
  Button
    id: skipButton
    anchors.bottom: parent.bottom
    anchors.left: leaveButton.right
    anchors.right: prev.left
    margin: 0 6 6 6
    height: 22
    focusable: false

