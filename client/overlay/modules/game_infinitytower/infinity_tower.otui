TowerRewardItem < UIWidget
  size: 34 34
  image-source: /images/ui/item
  image-border: 1

  UIItem
    id: item
    anchors.fill: parent
    virtual: true
    phantom: true
    animate: true

TowerRankRow < UIWidget
  height: 16
  Panel
    id: rank
    width: 25
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    text-align: center
    font: $var-cip-font
    color: $var-text-cip-color
  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical
    margin-bottom: -1
  Panel
    id: name
    width: 120
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    text-align: left
    text-offset: 5 0
    font: $var-cip-font
    color: $var-text-cip-color
  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical
    margin-bottom: -1
  Panel
    id: floor
    width: 40
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    text-align: center
    font: $var-cip-font
    color: $var-text-cip-color
  UIWidget
    anchors.left: prev.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    image-source: /images/ui/separator_vertical
    margin-bottom: -1
  Panel
    id: time
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    anchors.right: parent.right
    text-align: center
    font: $var-cip-font
    color: $var-text-cip-color

InfinityTowerWindow < NewHeadlessWindow
  size: 1000 572
  anchors.centerIn: parent
  draggable: false
  &static: true
  @onEscape: modules.game_infinitytower.hide()

  UIWidget
    size: 145 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -33
    image-source: /images/game/tutorial/backdrop_crest
    phantom: true

  NewWindow
    id: rankPanel
    size: 310 225
    draggable: false
    &static: true
    !text: tr('Rank')
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 29
    margin-left: 16

    UIWidget
      id: rankTable
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      size: 298 196
      margin-top: 4
      margin-left: 4
      margin-right: 4
      border-width: 1
      border-color: #171817
      background-color: #363636

      UIWidget
        id: headerRank
        size: 25 14
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('#')
        color: $var-text-cip-color
        font: $var-cip-font
        text-align: center
        margin-top: 1
      UIWidget
        anchors.left: prev.right
        anchors.top: parent.top
        height: 16
        image-source: /images/ui/separator_vertical
      UIWidget
        id: headerName
        size: 120 14
        anchors.top: parent.top
        anchors.left: prev.right
        !text: tr('Name')
        color: $var-text-cip-color
        font: $var-cip-font
        text-align: left
        text-offset: 5 0
        margin-top: 1
      UIWidget
        anchors.left: prev.right
        anchors.top: parent.top
        height: 16
        image-source: /images/ui/separator_vertical
      UIWidget
        id: headerFloor
        size: 40 14
        anchors.top: parent.top
        anchors.left: prev.right
        !text: tr('Floor')
        color: $var-text-cip-color
        font: $var-cip-font
        text-align: center
        margin-top: 1
      UIWidget
        anchors.left: prev.right
        anchors.top: parent.top
        height: 16
        image-source: /images/ui/separator_vertical
      UIWidget
        id: headerTime
        anchors.top: parent.top
        anchors.left: prev.right
        anchors.right: parent.right
        !text: tr('Time')
        color: $var-text-cip-color
        font: $var-cip-font
        text-align: center
        margin-top: 1

      TextList
        id: rankList
        anchors.top: headerTime.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 4
        margin-bottom: 4

  NewWindow
    id: ownInfos
    size: 310 256
    draggable: false
    &static: true
    !text: tr('Season Informations')
    anchors.top: rankPanel.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 16
    
    Label
      id: seasonLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 10
      !text: tr('Current Season: Loading...')
      font: $var-cip-font
      color: $var-text-cip-color
      text-align: left

    Label
      id: seasonEndLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 10
      !text: tr('Season Ends In: --')
      font: $var-cip-font
      color: $var-text-cip-color-light-red
      text-align: left

    Label
      id: nextTryLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 25
      margin-left: 10
      !text: tr('Next Try Available: --')
      font: $var-cip-font
      color: $var-text-cip-color
      text-align: left

    Label
      id: towerPointsLabel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 20
      margin-left: 10
      !text: tr('Your Tower Points: 0')
      font: $var-cip-font
      color: $var-text-cip-color-highlight
      text-align: left

  NewWindow
    id: towerInformation
    size: 641 225
    draggable: false
    &static: true
    !text: tr('Tower Information')
    anchors.top: parent.top
    anchors.left: rankPanel.right
    margin-top: 29
    margin-left: 16

    ScrollablePanel
      id: descriptionScroll
      anchors.fill: parent
      image-source: /images/ui/panel-1-pixel
      image-border: 1
      margin-top: 5
      margin-left: 5
      margin-right: 5
      margin-bottom: 5
      vertical-scrollbar: descriptionScrollBar

      Label
        id: descriptionLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        margin-left: 2
        margin-right: 2
        text-wrap: true
        text-auto-resize: true
        font: $var-cip-font
        color: $var-text-cip-color-light-red

    VerticalScrollBar
      id: descriptionScrollBar
      anchors.top: descriptionScroll.top
      anchors.right: descriptionScroll.right
      anchors.bottom: descriptionScroll.bottom
      margin-right: 1
      margin-top: 1
      margin-bottom: 1
      step: 14
      pixels-scroll: true

  NewWindow
    id: rewardPanel
    size: 641 256
    draggable: false
    &static: true
    !text: tr('Rewards')
    anchors.top: towerInformation.bottom
    anchors.left: rankPanel.right
    margin-top: 10
    margin-left: 16

    Label
      id: topRankLabel
      !text: tr('Top Rank Rewards')
      anchors.top: parent.top
      anchors.horizontalCenter: rewardSlot1.horizontalCenter
      margin-top: 10
      font: $var-cip-font
      color: #FFD700
      text-auto-resize: true
      text-align: center

    UIWidget
      id: rewardSlot2
      size: 66 66
      image-source: /images/ui/item66
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-top: 30
      tooltip: Silver Tower Chest

      UIItem
        id: podiumItem2
        anchors.centerIn: parent
        size: 64 64
        virtual: true
        phantom: true
        animate: true

    UIWidget
      id: rewardSlot1
      size: 66 66
      image-source: /images/ui/item66
      anchors.left: rewardSlot2.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-top: -40
      tooltip: Gold Tower Chest

      UIItem
        id: podiumItem1
        anchors.centerIn: parent
        size: 64 64
        virtual: true
        phantom: true
        animate: true

    UIWidget
      id: rewardSlot3
      size: 66 66
      image-source: /images/ui/item66
      anchors.left: rewardSlot1.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-top: 30
      tooltip: Copper Tower Chest

      UIItem
        id: podiumItem3
        anchors.centerIn: parent
        size: 64 64
        virtual: true
        phantom: true
        animate: true

    VerticalSeparator
      id: rewardSeparator
      anchors.left: rewardSlot3.right
      anchors.verticalCenter: parent.verticalCenter
      size: 2 220
      margin-left: 10

    Panel
      id: milestoneTrack
      anchors.top: parent.top
      anchors.left: rewardSeparator.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-left: 10
      margin-right: 10
      margin-bottom: 4

      Panel
        id: pointsProgress
        anchors.left: parent.left
        anchors.right: parent.right
        margin-right: 18
        anchors.verticalCenter: parent.verticalCenter
        height: 20
        image-source: /images/ui/infoPanel
        image-border: 1
        image-clip: 0 0 108 13

        ProgressBar
          id: progressBar
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 0
          margin: 3
          image-source: /images/bars/horizontal_health_progressbar_large_100
          image-border: 0
          image-clip: 0 0 1 25
          background-color: alpha

        Label
          id: progressLabel
          !text: tr('')
          font: $var-cip-font
          color: $var-text-color
          anchors.centerIn: parent
          text-auto-resize: true

  HorizontalSeparator
    id: bottomSeparator
    anchors.left: ownInfos.left
    anchors.right: rewardPanel.right
    anchors.top: rewardPanel.bottom
    margin-top: 10

  Button
    id: enterButton
    !text: tr('Enter Tower')
    anchors.top: bottomSeparator.bottom
    anchors.right: closeButton.left
    margin-top: 10
    margin-right: 8
    @onClick: modules.game_infinitytower.enterTower()

  Button
    id: leaveButton
    !text: tr('Leave Tower')
    !tooltip: tr('Leave the tower run you are in (your progress so far counts).')
    anchors.top: bottomSeparator.bottom
    anchors.right: enterButton.left
    margin-top: 10
    margin-right: 8
    @onClick: modules.game_infinitytower.leaveTower()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.top: bottomSeparator.bottom
    anchors.right: parent.right
    margin-top: 10
    margin-right: 18
    @onClick: modules.game_infinitytower.hide()

InfinityTowerWindow
  id: infinityTowerWindow
