// Season pass window (game_battlepass). Styles from client_chaos_theme (styles.otui).

// one reward of a tier: icon (item or creature), text, claim button
PassCell < UIWidget
  phantom: true

  ChaosItemSlot
    id: item
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true
    visible: false

  UICreature
    id: look
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: -3
    phantom: true
    visible: false

  UILabel
    id: badge
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/chaos/itemslot
    image-border: 4
    text-align: center
    font: verdana-11px-rounded
    color: #b070ff
    phantom: true
    visible: false

  UILabel
    id: text
    anchors.left: parent.left
    anchors.right: claim.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 40
    margin-right: 6
    text-align: left
    text-wrap: true
    height: 32
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

  ChaosButton
    id: claim
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 62
    !text: tr('Claim')

PassTierRow < ChaosPanelDark
  height: 46
  margin-bottom: 3
  phantom: false

  UILabel
    id: tier
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 36
    text-align: center
    font: verdana-11px-rounded
    color: #8c8070
    phantom: true

  PassCell
    id: free
    anchors.left: tier.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 4
    width: 290

  PassCell
    id: premium
    anchors.left: free.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 14

PassChallengeRow < ChaosPanelDark
  height: 34
  margin-bottom: 3
  phantom: false

  UILabel
    id: text
    anchors.left: parent.left
    anchors.right: progress.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    margin-right: 8
    text-align: left
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

  ChaosProgressBar
    id: progress
    anchors.right: reward.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 150
    height: 14
    text-offset: 0 1
    font: verdana-11px-antialised

  UILabel
    id: reward
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 70
    text-align: right
    font: verdana-11px-rounded
    color: #f6cf72
    phantom: true

PassOfferRow < ChaosPanelDark
  height: 84
  margin-bottom: 4
  phantom: false

  UICreature
    id: look
    size: 64 64
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    visible: false

  ChaosItemSlot
    id: item
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 14
    virtual: true
    phantom: true
    visible: false

  UILabel
    id: name
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.right: buy.left
    margin-left: 72
    margin-top: 2
    margin-right: 8
    text-align: left
    font: verdana-11px-rounded
    color: #e8b84a
    phantom: true

  UILabel
    id: contents
    anchors.left: name.left
    anchors.right: buy.left
    anchors.top: name.bottom
    anchors.bottom: parent.bottom
    margin-top: 3
    margin-right: 8
    text-align: topLeft
    text-wrap: true
    font: verdana-11px-antialised
    color: #d6c9ae
    phantom: true

  ChaosButton
    id: buy
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 10
    width: 104

  ChaosButton
    id: gift
    anchors.right: parent.right
    anchors.top: buy.bottom
    margin-top: 6
    width: 104
    !text: tr('Gift')

PassTab < ChaosTabButton
  width: 118
  margin-right: 4

PassPage < UIWidget
  anchors.top: tabs.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: hintLabel.top
  margin-top: 4
  margin-bottom: 6
  phantom: true
  visible: false

ChaosMainWindow
  id: seasonPassWindow
  size: 760 560
  !text: tr('Season Pass')
  @onEscape: modules.game_battlepass.hide()

  ChaosLabel
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #e8b84a

  ChaosLabel
    id: timerLabel
    anchors.top: parent.top
    anchors.right: parent.right
    text-auto-resize: true
    color: #f6cf72

  ChaosPanelHighlight
    id: tierPanel
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 58

    UILabel
      id: tierLabel
      anchors.left: parent.left
      anchors.top: parent.top
      width: 110
      text-align: left
      font: verdana-11px-rounded
      color: #f6cf72

    UILabel
      id: trackLabel
      anchors.left: parent.left
      anchors.top: tierLabel.bottom
      margin-top: 6
      width: 110
      text-align: left
      font: verdana-11px-antialised
      color: #8c8070

    ChaosProgressBar
      id: xpBar
      anchors.left: tierLabel.right
      anchors.right: claimAllButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-right: 12
      height: 18
      background-color: #b4561a

    ChaosButton
      id: claimAllButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 120
      !text: tr('Claim all')
      @onClick: modules.game_battlepass.claimAll()

  UIWidget
    id: tabs
    anchors.top: tierPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 24
    phantom: true
    layout:
      type: horizontalBox

  PassPage
    id: rewardsPage

    UILabel
      id: freeHead
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 50
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #c9b8a0
      !text: tr('Free track')

    UILabel
      id: premiumHead
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 360
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #ff9a3c
      !text: tr('Premium track')

    ChaosPanelDark
      id: listFrame
      anchors.top: freeHead.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      padding: 3

    UIScrollArea
      id: tierList
      anchors.top: listFrame.top
      anchors.left: listFrame.left
      anchors.right: tierScroll.left
      anchors.bottom: listFrame.bottom
      margin: 4
      layout:
        type: verticalBox
      vertical-scrollbar: tierScroll
      auto-focus: none

    ChaosScrollBar
      id: tierScroll
      anchors.top: listFrame.top
      anchors.right: listFrame.right
      anchors.bottom: listFrame.bottom
      margin-top: 3
      margin-bottom: 3
      margin-right: 3
      step: 49
      pixels-scroll: true

    ChaosLabelDim
      id: loadingText
      anchors.centerIn: listFrame
      !text: tr('Loading the tiers...')
      text-auto-resize: true

  PassPage
    id: challengesPage

    ChaosLabel
      id: dailyTitle
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: #e8b84a

    UIWidget
      id: dailyList
      anchors.top: dailyTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 111
      layout:
        type: verticalBox

    ChaosLabel
      id: weeklyTitle
      anchors.top: dailyList.bottom
      anchors.left: parent.left
      margin-top: 8
      text-auto-resize: true
      color: #e8b84a

    UIWidget
      id: weeklyList
      anchors.top: weeklyTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 111
      layout:
        type: verticalBox

    ChaosLabel
      id: sourcesTitle
      anchors.top: weeklyList.bottom
      anchors.left: parent.left
      margin-top: 8
      text-auto-resize: true
      color: #e8b84a
      !text: tr('Pass XP from play today (daily caps)')

    ChaosLabel
      id: sourcesLabel
      anchors.top: sourcesTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 36
      text-align: topLeft
      text-wrap: true

    ChaosLabelDim
      id: closedText
      anchors.centerIn: parent
      !text: tr('Challenges run while the season runs.')
      text-auto-resize: true
      visible: false

  PassPage
    id: packsPage

    ChaosLabel
      id: coinsLabel
      anchors.top: parent.top
      anchors.left: parent.left
      text-auto-resize: true
      color: #f6cf72

    ChaosCheckBox
      id: frameBox
      anchors.top: parent.top
      anchors.right: parent.right
      width: 220
      visible: false

    ChaosPanelDark
      id: offerFrame
      anchors.top: coinsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      padding: 3

    UIScrollArea
      id: offerList
      anchors.top: offerFrame.top
      anchors.left: offerFrame.left
      anchors.right: offerScroll.left
      anchors.bottom: offerFrame.bottom
      margin: 4
      layout:
        type: verticalBox
      vertical-scrollbar: offerScroll
      auto-focus: none

    ChaosScrollBar
      id: offerScroll
      anchors.top: offerFrame.top
      anchors.right: offerFrame.right
      anchors.bottom: offerFrame.bottom
      margin-top: 3
      margin-bottom: 3
      margin-right: 3
      step: 44
      pixels-scroll: true

  ChaosLabelDim
    id: hintLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 8
    text-align: left
    text-wrap: true
    height: 28
    !text: tr('Account-wide. Pass XP comes from play: experience, bosses, bounties, rifts and the challenges. Premium rewards are cosmetics and convenience only.')

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_battlepass.hide()
