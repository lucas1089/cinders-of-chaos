Module
  name: game_mapmarkers
  description: Map markers - party members, points of interest and the hunt teleports on the minimap and the full map, and the quest marks over NPC heads (extended opcode 153, server partymarkers.lua and poi.lua)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ markermath, npcmarkmath, npcmarks, huntportmath, huntports, mapmarkers ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
