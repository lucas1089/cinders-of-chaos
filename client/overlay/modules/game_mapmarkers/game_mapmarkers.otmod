Module
  name: game_mapmarkers
  description: Map markers - party members and points of interest on the minimap and the full map (extended opcode 153, server partymarkers.lua and poi.lua)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ markermath, mapmarkers ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
