Module
  name: game_raid
  description: The Ashen Sepulchre - weekly raid window (lockouts, saved raids, boss journal, vendor), in-raid HUD and mechanic call-outs (extended opcode 213)
  author: Cinders of Chaos
  sandboxed: true
  scripts: [ raidview, raid ]
  dependencies:
    - client_chaos_theme
    - game_interface
  autoload: true
  autoload-priority: 1004
  @onLoad: init()
  @onUnload: terminate()
