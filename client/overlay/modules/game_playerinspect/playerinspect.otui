// Inspect Player window (game_playerinspect). Styles from client_chaos_theme (styles.otui).

InspectSlot < ChaosItemSlot
  size: 44 44
  virtual: true
  anchors.top: parent.top
  anchors.left: parent.left

  UIWidget
    id: frame
    anchors.fill: parent
    phantom: true
    border-width: 0

// a stat row of statsPanel.list, a verticalBox (the layout places it and gives it the full width: no anchors on a child of a box
// layout, the client logs an error for each one) and a row of the Records panel (recordsPanel.list): the name left, the value right
InspectRecord < UIWidget
  height: 16
  phantom: true

  UILabel
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #d6c9ae
    text-align: left
    phantom: true

  UILabel
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #f6cf72
    text-align: right
    phantom: true

// a section heading of the stats list: gold text over a thin rule
InspectSection < UIWidget
  height: 20
  phantom: true

  UILabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-rounded
    color: #e8b84a
    text-align: left
    height: 14
    phantom: true

  ChaosSeparator
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

// one line of the header band beside the character
InspectHeadLine < UILabel
  font: verdana-11px-antialised
  color: #d6c9ae
  text-align: left
  text-auto-resize: false
  height: 16
  phantom: true

ChaosMainWindow
  id: playerInspectWindow
  size: 660 530
  !text: tr('Inspect Player')
  @onEscape: modules.game_playerinspect.hide()

  ChaosLabel
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    !text: tr('Player')

  ChaosTextEdit
    id: nameEdit
    anchors.top: parent.top
    anchors.left: nameLabel.right
    anchors.right: goButton.left
    margin-left: 8
    margin-right: 6
    height: 22
    max-length: 29

  ChaosButton
    id: goButton
    anchors.top: parent.top
    anchors.right: parent.right
    width: 80
    !text: tr('Inspect')
    @onClick: modules.game_playerinspect.inspectTyped()

  // the header band: the character at 128 px, the name, class, title and guild beside it
  ChaosPanelHighlight
    id: headPanel
    anchors.top: nameEdit.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 356
    height: 148
    padding: 10

    UICreature
      id: creature
      anchors.top: parent.top
      anchors.left: parent.left
      size: 128 128
      phantom: true

    ChaosTitle
      id: charName
      anchors.top: parent.top
      anchors.left: creature.right
      anchors.right: parent.right
      margin-left: 12
      margin-top: 6
      text-align: left
      text-auto-resize: false
      height: 20

    InspectHeadLine
      id: classLine
      anchors.top: charName.bottom
      anchors.left: charName.left
      anchors.right: parent.right
      margin-top: 6

    InspectHeadLine
      id: badgeLine
      anchors.top: classLine.bottom
      anchors.left: charName.left
      anchors.right: parent.right
      margin-top: 4

    InspectHeadLine
      id: titleLine
      anchors.top: badgeLine.bottom
      anchors.left: charName.left
      anchors.right: parent.right
      margin-top: 4

    InspectHeadLine
      id: guildLine
      anchors.top: titleLine.bottom
      anchors.left: charName.left
      anchors.right: parent.right
      margin-top: 4

  ChaosPanelDark
    id: statsPanel
    anchors.top: headPanel.bottom
    anchors.left: parent.left
    anchors.bottom: statusLabel.top
    margin-top: 8
    margin-bottom: 6
    width: 356
    padding: 10

    UIWidget
      id: list
      anchors.fill: parent
      phantom: true
      layout:
        type: verticalBox
        spacing: 1

  ChaosPanelDark
    id: gearPanel
    anchors.top: nameEdit.bottom
    anchors.left: headPanel.right
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 8
    margin-left: 8
    margin-bottom: 6

    ChaosTitle
      id: gearTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      !text: tr('Equipment')

    ChaosLabelDim
      id: gearHint
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 6
      text-align: center
      !text: tr('Hover an item for its tooltip.')

  ChaosPanelDark
    id: recordsPanel
    anchors.top: nameEdit.bottom
    anchors.left: headPanel.right
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 8
    margin-left: 8
    margin-bottom: 6
    padding: 8
    visible: false

    UIWidget
      id: list
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      phantom: true
      layout:
        type: verticalBox
        spacing: 2

    ChaosLabelDim
      id: emptyLabel
      anchors.centerIn: parent
      text-align: center
      !text: tr('Nothing to show.')

  ChaosLabelDim
    id: statusLabel
    anchors.bottom: privacyBox.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 4
    height: 16
    text-align: left

  // the privacy setting has a row of its own above the buttons, so nothing is clipped
  ChaosCheckBox
    id: privacyBox
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6
    height: 20
    !text: tr('Allow others to inspect me')
    @onCheckChange: modules.game_playerinspect.onPrivacyToggle()

  ChaosButton
    id: recordsButton
    anchors.bottom: parent.bottom
    anchors.right: treeButton.left
    margin-right: 6
    width: 110
    enabled: false
    !text: tr('Records')
    !tooltip: tr("Show this character's personal records")
    @onClick: modules.game_playerinspect.toggleRecords()

  ChaosButton
    id: treeButton
    anchors.bottom: parent.bottom
    anchors.right: closeButton.left
    margin-right: 6
    width: 130
    enabled: false
    !text: tr('Passive Tree')
    !tooltip: tr("Show this character's passive tree (read-only)")
    @onClick: modules.game_playerinspect.openInspectedTree()

  ChaosButton
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 80
    !text: tr('Close')
    @onClick: modules.game_playerinspect.hide()
