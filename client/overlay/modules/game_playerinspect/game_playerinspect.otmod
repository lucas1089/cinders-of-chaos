Module
  name: game_playerinspect
  description: Inspect Player window (extended opcode 240): outfit, level, class, guild, achievement points, records and the equipped items with their tooltips
  author: project-chaos
  sandboxed: true
  scripts: [ playerinspect_logic, playerinspect ]
  dependencies:
    - client_chaos_theme
    - game_interface
    - game_itemtooltip
  autoload: true
  autoload-priority: 1000
  @onLoad: init()
  @onUnload: terminate()
