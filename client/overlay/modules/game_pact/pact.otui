// Chaos Pact window (game_pact): Pact status, daily Pact Marks and their shelf, account limits, saved builds. Styles from client_chaos_theme.

PactCell < ChaosLabel
  height: 18
  text-align: center
  text-auto-resize: false

  $mobile:
    height: 16

PactLimitRow < UIWidget
  height: 20
  layout:
    type: horizontalBox
    spacing: 4

  $mobile:
    height: 16

PactBuildRow < ChaosPanelDark
  height: 40
  margin-bottom: 3

  $mobile:
    height: 36
    margin-bottom: 2

  ChaosLabel
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: loadButton.left
    margin-right: 6
    height: 15
    color: #e8b84a

  ChaosLabelDim
    id: sub
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: loadButton.left
    margin-right: 6
    height: 14

  ChaosButton
    id: deleteButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 54 22
    padding: 3 4 3 4
    !text: tr('Delete')

  ChaosButton
    id: saveButton
    anchors.right: deleteButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 74 22
    padding: 3 4 3 4
    !text: tr('Save here')

  ChaosButton
    id: loadButton
    anchors.right: saveButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 50 22
    padding: 3 4 3 4
    !text: tr('Load')

// one cosmetic of the Pact Marks shelf: name, price in Marks, Buy
PactShelfRow < ChaosPanelDark
  height: 24
  margin-bottom: 2

  ChaosLabel
    id: name
    anchors.left: parent.left
    anchors.right: price.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 6
    height: 15

  ChaosLabelDim
    id: price
    anchors.right: buyButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 76
    height: 15
    text-align: right

  ChaosButton
    id: buyButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 56 20
    padding: 3 4 3 4
    !text: tr('Buy')

PactWindow < ChaosMainWindow
  id: pactWindow
  size: 560 670
  // phone interface is 540 high and 960 wide: 950 wide keeps the long lines to one or two lines,
  // inside the frame (536 - 54 = 482): header 62, wallet 17, 3 plates 18 each, limits head 18 and
  // list 102, special 28, marks line 17, month line 16, shelf 54, builds 84 (2 rows of 38), name row 30
  $mobile:
    width: 950
    height: 536
  !text: tr('Chaos Pact')
  @onEscape: modules.game_pact.hide()

  ChaosPanelHighlight
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 62

    ChaosTitle
      id: headline
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: claimButton.left
      text-align: left
      height: 18

    ChaosLabel
      id: statusLine
      anchors.top: headline.bottom
      anchors.left: parent.left
      anchors.right: claimButton.left
      margin-top: 2
      margin-right: 6
      height: 28
      text-wrap: true
      text-align: topLeft

    ChaosButton
      id: claimButton
      anchors.top: parent.top
      anchors.right: parent.right
      size: 150 24
      !text: tr('Daily Pact Marks')
      @onClick: modules.game_pact.claim()

    ChaosButton
      id: storeButton
      anchors.top: claimButton.bottom
      anchors.right: parent.right
      margin-top: 4
      size: 120 22
      !text: tr('Store')
      @onClick: modules.game_pact.openStore()

  ChaosLabelDim
    id: wallet
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 15

    $mobile:
      margin-top: 2

  ChaosTitlePlate
    id: limitsPlate
    anchors.top: wallet.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

    $mobile:
      height: 16
      margin-top: 2

    ChaosTitle
      anchors.fill: parent
      !text: tr('Your account limits')

  UIWidget
    id: limitsHead
    anchors.top: limitsPlate.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 18
    layout:
      type: horizontalBox
      spacing: 4

    $mobile:
      height: 16
      margin-top: 2

  UIWidget
    id: limits
    anchors.top: limitsHead.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 124
    layout:
      type: verticalBox
      spacing: 1

    $mobile:
      height: 102

  ChaosLabelDim
    id: special
    anchors.top: limits.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 28
    text-wrap: true
    text-align: topLeft

    $mobile:
      margin-top: 0

  ChaosTitlePlate
    id: marksPlate
    anchors.top: special.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

    $mobile:
      height: 16
      margin-top: 2

    ChaosTitle
      anchors.fill: parent
      !text: tr('Pact Marks')

  ChaosLabel
    id: marksLine
    anchors.top: marksPlate.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 15

    $mobile:
      margin-top: 2

  ChaosLabelDim
    id: monthLine
    anchors.top: marksLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 28
    text-wrap: true
    text-align: topLeft

    $mobile:
      margin-top: 0
      height: 16

  ScrollablePanel
    id: shelf
    anchors.top: monthLine.bottom
    anchors.left: parent.left
    anchors.right: shelfScroll.left
    margin-top: 4
    margin-right: 2
    height: 78
    vertical-scrollbar: shelfScroll
    layout:
      type: verticalBox

    $mobile:
      margin-top: 2
      height: 52

  ChaosScrollBar
    id: shelfScroll
    anchors.top: monthLine.bottom
    anchors.right: parent.right
    margin-top: 4
    height: 78
    step: 20
    pixels-scroll: true

    $mobile:
      margin-top: 2
      height: 52

  ChaosTitlePlate
    id: buildsPlate
    anchors.top: shelf.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

    $mobile:
      height: 16
      margin-top: 2

    ChaosTitle
      id: buildsTitle
      anchors.fill: parent

  ScrollablePanel
    id: builds
    anchors.top: buildsPlate.bottom
    anchors.left: parent.left
    anchors.right: buildsScroll.left
    anchors.bottom: buildName.top
    margin-top: 4
    margin-bottom: 6
    margin-right: 2
    vertical-scrollbar: buildsScroll
    layout:
      type: verticalBox

    $mobile:
      margin-top: 2
      margin-bottom: 4

  ChaosScrollBar
    id: buildsScroll
    anchors.top: buildsPlate.bottom
    anchors.bottom: buildName.top
    anchors.right: parent.right
    margin-top: 4
    margin-bottom: 6
    step: 20
    pixels-scroll: true

    $mobile:
      margin-top: 2
      margin-bottom: 4

  ChaosTextEdit
    id: buildName
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 180 24
    max-length: 24
    !placeholder: tr('Name of the build')

  ChaosButton
    id: saveNewButton
    anchors.left: buildName.right
    anchors.bottom: parent.bottom
    margin-left: 6
    size: 150 24
    !text: tr('Save current build')
    @onClick: modules.game_pact.saveBuild()

  ChaosButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_pact.hide()
