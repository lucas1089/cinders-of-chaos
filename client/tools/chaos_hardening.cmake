# Release build flags of the Windows client (client/BASE.md "Release build flags").
# Passed by windows-package.yml as -DCMAKE_PROJECT_INCLUDE=<this file>; CMake includes it right after the project() call,
# so the compiler is known and every flag is only added when that compiler/linker takes it. Nothing here changes the
# source, the C++ or the Lua; -DCHAOS_HARDEN=OFF skips the whole file. No -march / /arch: players' PCs differ.
#   MSVC: link time code generation (/GL + /LTCG through CMAKE_INTERPROCEDURAL_OPTIMIZATION), control flow guard
#         (/guard:cf compile + /GUARD:CF link), /DYNAMICBASE /HIGHENTROPYVA /NXCOMPAT /CETCOMPAT (some are the linker's
#         default for x64; set outright so the exe does not depend on that), /GS (the default, set outright).
#   MinGW (not used by the package, for a local build): -fstack-protector-strong, -D_FORTIFY_SOURCE=2 (needs -O),
#         --dynamicbase --nxcompat --high-entropy-va, LTO through the same IPO switch.
# The optimisation level is the build type's own (Release: /O2 on MSVC, -O2 on GCC); it is not set here.
if(NOT DEFINED CHAOS_HARDEN)
    set(CHAOS_HARDEN ON)
endif()
if(NOT CHAOS_HARDEN)
    message(STATUS "Chaos: release flags off (CHAOS_HARDEN=OFF)")
    return()
endif()
if(NOT CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
    return() # a project() of a subdirectory or a dependency: only the client's own
endif()

include(CheckCXXCompilerFlag)
set(_chaos_cxx "")
set(_chaos_link "")
set(_chaos_on "")

# --- link time optimisation (Release only) ---
if(NOT CMAKE_VERSION VERSION_LESS 3.9)
    cmake_policy(SET CMP0069 NEW)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT _chaos_ipo OUTPUT _chaos_ipo_out LANGUAGES CXX)
    if(_chaos_ipo)
        set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
        list(APPEND _chaos_on "LTO")
    else()
        message(WARNING "Chaos: no link time optimisation (${_chaos_ipo_out})")
    endif()
endif()

# a flag is added only when a test compile takes it
function(_chaos_try_cxx flag var)
    string(MAKE_C_IDENTIFIER "CHAOS_HAS_${flag}" _id)
    check_cxx_compiler_flag("${flag}" ${_id})
    if(${_id})
        set(${var} "${${var}} ${flag}" PARENT_SCOPE)
        list(APPEND _chaos_on "${flag}")
        set(_chaos_on "${_chaos_on}" PARENT_SCOPE)
    endif()
endfunction()

if(MSVC)
    _chaos_try_cxx("/GS" _chaos_cxx)
    _chaos_try_cxx("/guard:cf" _chaos_cxx)
    set(_chaos_guard FALSE)
    if(_chaos_cxx MATCHES "/guard:cf")
        set(_chaos_guard TRUE)
    endif()
    if(NOT CMAKE_VERSION VERSION_LESS 3.18)
        include(CheckLinkerFlag)
        foreach(_f /DYNAMICBASE /HIGHENTROPYVA /NXCOMPAT /CETCOMPAT)
            string(MAKE_C_IDENTIFIER "CHAOS_LINK_${_f}" _id)
            check_linker_flag(CXX "${_f}" ${_id})
            if(${_id})
                set(_chaos_link "${_chaos_link} ${_f}")
                list(APPEND _chaos_on "${_f}")
            endif()
        endforeach()
        if(_chaos_guard)
            check_linker_flag(CXX "/GUARD:CF" CHAOS_LINK_GUARD_CF)
            if(CHAOS_LINK_GUARD_CF)
                set(_chaos_link "${_chaos_link} /GUARD:CF")
                list(APPEND _chaos_on "/GUARD:CF")
            endif()
        endif()
    else()
        message(WARNING "Chaos: CMake ${CMAKE_VERSION} is older than 3.18, linker hardening flags not added")
    endif()
elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND WIN32)
    _chaos_try_cxx("-fstack-protector-strong" _chaos_cxx)
    if(CMAKE_BUILD_TYPE MATCHES "Rel")
        _chaos_try_cxx("-D_FORTIFY_SOURCE=2" _chaos_cxx)
    endif()
    if(NOT CMAKE_VERSION VERSION_LESS 3.18)
        include(CheckLinkerFlag)
        foreach(_f -Wl,--dynamicbase -Wl,--nxcompat -Wl,--high-entropy-va)
            string(MAKE_C_IDENTIFIER "CHAOS_LINK_${_f}" _id)
            check_linker_flag(CXX "${_f}" ${_id})
            if(${_id})
                set(_chaos_link "${_chaos_link} ${_f}")
                list(APPEND _chaos_on "${_f}")
            endif()
        endforeach()
    endif()
endif()

# appended, never replacing what the toolchain or the base set (/EHsc, /O2, the runtime library)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}${_chaos_cxx}")
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS}${_chaos_cxx}")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS}${_chaos_link}")
string(REPLACE ";" " " _chaos_on_text "${_chaos_on}")
message(STATUS "Chaos: release flags on: ${_chaos_on_text}")
