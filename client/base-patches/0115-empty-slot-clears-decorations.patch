@@ -1109,6 +1109,8 @@ void Client::registerLuaFunctions()
     g_lua.bindClassMemberFunction<UIItem>("setVirtualCount", &UIItem::setVirtualCount);
     g_lua.bindClassMemberFunction<UIItem>("setItemVisible", &UIItem::setItemVisible);
     g_lua.bindClassMemberFunction<UIItem>("setItem", &UIItem::setItem);
+    // Chaos (0115): setItem(nil) calls onItemChange; Lua that also runs on an older client checks this before it does
+    g_lua.bindClassStaticFunction<UIItem>("notifiesItemRemoval", []{ return true; });
     g_lua.bindClassMemberFunction<UIItem>("setVirtual", &UIItem::setVirtual);
     g_lua.bindClassMemberFunction<UIItem>("setShowCount", &UIItem::setShowCount);
     g_lua.bindClassMemberFunction<UIItem>("setShowCountAlways", &UIItem::setShowCountAlways);
