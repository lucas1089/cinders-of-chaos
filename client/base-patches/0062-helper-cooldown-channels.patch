+        -- attack channel waits, and each channel has its own cast guard
+        local castChannel = ChaosHelperTimers and ChaosHelperTimers.castChannel(spell.group) or "attack"
+        if castChannel == "attack" and ((rotation and ChaosHelperRotation.channeling(rotation, castAt)) or
