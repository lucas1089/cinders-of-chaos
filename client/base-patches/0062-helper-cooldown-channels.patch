+-- Chaos (base-patch 0062): object uses on the server's cooldown channels (server src-patch 0042): potions, healing
+-- runes, attack runes, support runes and special foods each have a timer of their own (ChaosHelperTimers). Before, one
+-- shared 1 s timer and a potion "turn" after every rune made a rune hold the potion and a potion hold the runes.
+local function objectUseReady(channel, now)
+  if ChaosHelperTimers and ChaosHelperTimers.new then
+    helperTimers = helperTimers or ChaosHelperTimers.new()
+    return ChaosHelperTimers.useReady(helperTimers, channel, now)
+  end
+  return multiUseExDelay <= now and (spellsCooldown[potionConfig.id] or 0) <= now
+end
+
+local function markObjectUse(channel, now, ms)
+  if ChaosHelperTimers and ChaosHelperTimers.new then
+    helperTimers = helperTimers or ChaosHelperTimers.new()
+    ChaosHelperTimers.used(helperTimers, channel, now, ms)
+    return
+  end
+  multiUseExDelay = now + ms
+  spellsCooldown[potionConfig.id] = now + ms
+end
