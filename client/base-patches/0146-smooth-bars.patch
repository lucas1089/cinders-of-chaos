+// Cinders of Chaos (base patch 0146): the eased health and mana bars over creatures, pure and header-only so
+// client/tools/chaosbars_test.cpp can run it without the engine. A bar keeps the value it was last shown at, the value it
+// is going to and two start times. Everything the bar draws is computed from the clock at draw time (no timer, no event):
+//  * the bar eases to a new value in kEaseMs (ease-out);
+//  * a hit leaves a pale "chip" segment between the new value and where the bar stood. It holds for kHoldMs, then slides
+//    down to the bar in kSlideMs. A second hit while it shows starts from the chip level that is on screen;
+//  * a heal eases up and has no chip (an open chip is dropped);
+//  * a bar that was not drawn for kStaleMs, or that has no value yet, takes the value at once: a creature that appears or
+//    returns into view never slides in from 100.
+#ifndef CHAOSBARS_H
+#define CHAOSBARS_H
+
+#include <algorithm>
+#include <cstdint>
+
+namespace chaos {
+namespace bars {
+
+constexpr int kEaseMs = 150;    // a bar reaches a new value
+constexpr int kHoldMs = 250;    // the chip stands still after the hit
+constexpr int kSlideMs = 300;   // then it slides down to the bar
+constexpr int kStaleMs = 1000;  // not drawn for this long: the next value is taken at once
+
+// the pixel width of a bar of `span` pixels at `percent`; the same truncation the stock bars use (the health bar does it
+// in double, the mana bar in float), so a bar at rest is exactly as wide as it was without the option
+inline int widthPx(double percent, int span)
+{
+    return static_cast<int>((percent / 100.0) * span);
+}
+
+inline int widthPxF(float percent, int span)
+{
+    return static_cast<int>((percent / 100.f) * static_cast<float>(span));
+}
+
+// 0..1 in, 0..1 out; fast first, slow end
+inline float easeOut(float u)
+{
+    u = std::max(0.0f, std::min(1.0f, u));
+    const float r = 1.0f - u;
+    return 1.0f - r * r;
+}
+
+// 0..1 in, 0..1 out; soft start and end
+inline float smoothStep(float u)
+{
+    u = std::max(0.0f, std::min(1.0f, u));
+    return u * u * (3.0f - 2.0f * u);
+}
+
+class Track
+{
+public:
+    // forget everything: the next observe() takes its value as it is (a creature that appears or returns into view)
+    void reset() { m_valid = false; }
+
+    // call with the real value (a percent, 0..100) every time the bar is drawn
+    void observe(float value, int64_t now)
+    {
+        if (!m_valid || now < m_lastSeen || now - m_lastSeen > kStaleMs) {
+            m_valid = true;
+            m_from = m_target = m_chip = value;
+            m_easeStart = m_chipStart = now;
+            m_lastSeen = now;
+            return;
+        }
+        m_lastSeen = now;
+        if (value == m_target)
+            return;
+        const float cur = shown(now);
+        const float chip = chipAt(now);
+        m_from = cur;
+        m_target = value;
+        m_easeStart = now;
+        if (value < cur) {
+            m_chip = std::max(chip, cur); // the chip starts where the bar (or the chip still on screen) stood
+            m_chipStart = now;
+        } else {
+            m_chip = cur; // a heal has no chip: the top of the chip never rises above the bar
+            m_chipStart = now;
+        }
+    }
+
+    // the value the bar is drawn at; exactly the real value once the ease is over
+    float shown(int64_t now) const
+    {
+        if (!m_valid)
+            return m_target;
+        const int64_t el = now - m_easeStart;
+        if (el >= kEaseMs)
+            return m_target;
+        if (el <= 0)
+            return m_from;
+        return m_from + (m_target - m_from) * easeOut(static_cast<float>(el) / static_cast<float>(kEaseMs));
+    }
+
+    // the top of the chip; never below the bar, equal to it when there is no chip
+    float chipAt(int64_t now) const
+    {
+        const float s = shown(now);
+        if (!m_valid)
+            return s;
+        const int64_t el = now - m_chipStart;
+        float c;
+        if (el <= kHoldMs)
+            c = m_chip;
+        else if (el >= kHoldMs + kSlideMs)
+            c = m_target;
+        else
+            c = m_chip + (m_target - m_chip) * smoothStep(static_cast<float>(el - kHoldMs) / static_cast<float>(kSlideMs));
+        return std::max(c, s);
+    }
+
+    // true when the bar is at its value and no chip shows (nothing more to draw than the plain bar)
+    bool settled(int64_t now) const { return shown(now) == m_target && chipAt(now) == m_target; }
+
+    bool valid() const { return m_valid; }
+    float target() const { return m_target; }
+
+private:
+    bool m_valid = false;
+    float m_from = 0.0f;
+    float m_target = 0.0f;
+    float m_chip = 0.0f;
+    int64_t m_easeStart = 0;
+    int64_t m_chipStart = 0;
+    int64_t m_lastSeen = 0;
+};
+
+} // namespace bars
+} // namespace chaos
+
+#endif
