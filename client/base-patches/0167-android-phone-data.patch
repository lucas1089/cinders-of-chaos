+// ---- Cinders of Chaos phone data (base patch 0167, client/BASE.md "Phone data") ----
+// An Android phone cannot hold chaos.pack in RAM, so the first-start screen (modules/client_chaos_firststart) downloads
+// the signed update files like the desktop updater, but unpacks them: every verified blob is decrypted, in 1 MB
+// blocks, into a plain file of chaos_update/android/ (private to the app, same protection as the Windows loose tree
+// before build 13). That folder is mounted through PhysFS in front of data.zip, file-backed.
+namespace {
+const std::string CHAOS_DATA_FOLDER = "chaos_update/android";
+}
+
+// Decrypts the update blob `from` (inside chaos_update/) into the plain file `to`, which must lie in
+// chaos_update/android/ under modules/ mods/ data/ layouts/. The plaintext goes to "<to>.part" and is renamed only
+// after the GCM tag authenticated, so a half-written or tampered file never has its final name. Returns the SHA-256
+// (lowercase hex) of the plaintext, "" on any failure (nothing is left behind).
+std::string ResourceManager::unpackUpdateBlob(const std::string& from, const std::string& to)
+{
+#if defined(__EMSCRIPTEN__)
+    (void)from; (void)to;
+    return "";
+#else
+    if (!isChaosUpdatePath(from) || !isChaosUpdatePath(to) || m_updateKey.size() != 32)
+        return "";
+    std::string rel = to;
+    if (!rel.empty() && rel[0] == '/')
+        rel = rel.substr(1);
+    const std::string prefix = CHAOS_DATA_FOLDER + "/";
+    if (!stdext::starts_with(rel, prefix) || !isUpdateRoot(rel.substr(prefix.size()))) {
+        g_logger.warning(stdext::format("updater: refused to unpack into '%s'", to));
+        return "";
+    }
+    const auto src = chaosUpdateRealPath(from), dst = chaosUpdateRealPath(to);
+    std::error_code ec;
+    const auto size = (src.empty() || dst.empty()) ? 0 : std::filesystem::file_size(src, ec);
+    if (src.empty() || dst.empty() || ec || size < chaosblob::OVERHEAD)
+        return "";
+    std::ifstream f(src, std::ios::binary);
+    unsigned char header[chaosblob::HEADER_LEN];
+    if (!f || !f.read(reinterpret_cast<char*>(header), sizeof(header)))
+        return "";
+    chaosblob::Header h;
+    chaosblob::Decryptor d;
+    if (!d.begin(m_updateKey, header, h) || h.plainLen != size - chaosblob::OVERHEAD)
+        return "";
+    std::filesystem::create_directories(dst.parent_path(), ec);
+    if (ec)
+        return "";
+    std::filesystem::path part = dst;
+    part += ".part";
+    std::ofstream out(part, std::ios::binary | std::ios::trunc);
+    if (!out)
+        return "";
+    chaosupdate::Sha256Stream sha;
+    std::vector<unsigned char> buffer(1024 * 1024);
+    uint64_t left = h.plainLen;
+    bool ok = true;
+    while (ok && left > 0) {
+        const size_t n = static_cast<size_t>(std::min<uint64_t>(left, buffer.size()));
+        ok = f.read(reinterpret_cast<char*>(buffer.data()), static_cast<std::streamsize>(n)) &&
+            d.update(buffer.data(), buffer.data(), n);
+        if (ok) {
+            sha.update(buffer.data(), n);
+            out.write(reinterpret_cast<const char*>(buffer.data()), static_cast<std::streamsize>(n));
+            ok = out.good();
+        }
+        left -= n;
+    }
+    unsigned char tag[chaosblob::TAG_LEN];
+    ok = ok && f.read(reinterpret_cast<char*>(tag), sizeof(tag)) && d.finish(tag);
+    out.close();
+    std::fill(buffer.begin(), buffer.end(), 0);
+    if (ok && !out.fail())
+        std::filesystem::rename(part, dst, ec);
+    if (!ok || out.fail() || ec) {
+        std::filesystem::remove(part, ec);
+        return "";
+    }
+    return sha.finishHex();
+#endif
+}
+
+// Android only: mounts the plain phone data folder chaos_update/android of the write dir at "/" in front of every
+// other search path (data.zip included), so its files override the APK's. Files are read from disk on demand.
+bool ResourceManager::mountDataFolder(const std::string& path)
+{
+#if !defined(ANDROID)
+    (void)path;
+    return false;
+#else
+    std::string rel = path;
+    while (!rel.empty() && rel.front() == '/')
+        rel.erase(0, 1);
+    while (!rel.empty() && rel.back() == '/')
+        rel.pop_back();
+    if (rel != CHAOS_DATA_FOLDER) {
+        g_logger.warning(stdext::format("updater: refused to mount '%s'", path));
+        return false;
+    }
+    const auto real = chaosUpdateRealPath(rel);
+    std::error_code ec;
+    if (real.empty() || !std::filesystem::is_directory(real, ec))
+        return false;
+    unmountDataFolder();
+    const std::string realStr = real.u8string();
+    if (!PHYSFS_mount(realStr.c_str(), "/", 0)) {
+        g_logger.warning(stdext::format("updater: unable to mount the phone data folder: %s",
+                                        PHYSFS_getErrorByCode(PHYSFS_getLastErrorCode())));
+        return false;
+    }
+    m_dataFolderReal = realStr;
+    ++m_generation;
+    g_logger.info(stdext::format("updater: phone data folder mounted ('%s')", realStr));
+    return true;
+#endif
+}
+
+bool ResourceManager::unmountDataFolder()
+{
+    if (m_dataFolderReal.empty())
+        return false;
+    const bool ok = PHYSFS_unmount(m_dataFolderReal.c_str()) != 0;
+    m_dataFolderReal.clear();
+    ++m_generation;
+    return ok;
+}
+
+// bytes free for the app on the disk of the write dir, -1 when unknown (the first-start screen checks it before a
+// download of about a gigabyte)
+int64_t ResourceManager::getFreeSpace()
+{
+#if defined(__EMSCRIPTEN__)
+    return -1;
+#else
+    const char* writeDir = PHYSFS_getWriteDir();
+    if (!writeDir)
+        return -1;
+    std::error_code ec;
+    const auto info = std::filesystem::space(std::filesystem::u8path(writeDir), ec);
+    if (ec)
+        return -1;
+    return static_cast<int64_t>(info.available);
+#endif
+}
