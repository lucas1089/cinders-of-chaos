+// Cinders of Chaos (base patch 0167): the restart. Runs from main() after the runtime is shut down; the Java side
+// (ChaosActivity.restartApp) opens a helper activity in its own process that starts the game again and ends this one.
+void AndroidWindow::restartApp()
+{
+    JNIEnv* env = getJNIEnv();
+    JavaVM* vm = getJavaVM();
+    jint nResult = vm->AttachCurrentThread(&env, NULL);
+    if (nResult != JNI_ERR) {
+        jclass clazz = env->GetObjectClass(getClazz());
+        jmethodID methodID = env->GetMethodID(clazz, "restartApp", "()V");
+        if (methodID)
+            env->CallVoidMethod(getClazz(), methodID);
+        if (env->ExceptionCheck())
+            env->ExceptionClear();
+        vm->DetachCurrentThread();
+    }
+}
