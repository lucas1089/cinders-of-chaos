+bool ThingType::chaosBodyAlpha(int xPattern, int zPattern, std::vector<uint8>& alpha, int& width, int& height)
+{
+    const int tile = 32;
+    if (m_null || m_spritesIndex.empty() || m_animationPhases < 1 || m_layers < 1 || m_numPatternY < 1 ||
+        m_size.width() < 1 || m_size.height() < 1 || m_size.width() > 16 || m_size.height() > 16 ||
+        xPattern < 0 || xPattern >= m_numPatternX || zPattern < 0 || zPattern >= m_numPatternZ)
+        return false;
+    width = m_size.width() * tile;
+    height = m_size.height() * tile;
+    alpha.assign(static_cast<size_t>(width) * height, 0);
+    bool any = false;
+    for (int h = 0; h < m_size.height(); ++h) {
+        for (int w = 0; w < m_size.width(); ++w) {
+            const size_t index = ((((((static_cast<size_t>(0) * m_numPatternZ + zPattern) * m_numPatternY) * m_numPatternX + xPattern) *
+                                    m_layers) * m_size.height() + h) * m_size.width()) + w;
+            if (index >= m_spritesIndex.size() || m_spritesIndex[index] <= 0)
+                continue;
+            ImagePtr image = g_sprites.getSpriteImage(m_spritesIndex[index]);
+            if (!image || image->getBpp() != 4 || image->getWidth() < tile || image->getHeight() < tile)
+                continue;
+            // a sprite stored larger than a tile (an upscaled set) is read every `step` pixels
+            const int step = image->getWidth() / tile;
+            const std::vector<uint8>& pixels = image->getPixels();
+            const int ox = (m_size.width() - 1 - w) * tile, oy = (m_size.height() - 1 - h) * tile;
+            for (int y = 0; y < tile; ++y) {
+                for (int x = 0; x < tile; ++x) {
+                    const size_t at = (static_cast<size_t>(y) * step * image->getWidth() + static_cast<size_t>(x) * step) * 4 + 3;
+                    if (at < pixels.size() && pixels[at]) {
+                        alpha[static_cast<size_t>(oy + y) * width + ox + x] = pixels[at];
+                        any = true;
+                    }
+                }
+            }
+        }
+    }
+    return any;
+}
