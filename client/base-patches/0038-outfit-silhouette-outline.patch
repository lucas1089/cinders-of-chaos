+// Cinders of Chaos (base patch 0038): queued before the outfit's parts, drawn from them at draw time (their final
+// rects, after flips and outfit corrections). One textured quad per part, grown by the outline width, through a
+// program that samples the part's alpha in a ring and paints only where the part itself is transparent. The parts
+// are drawn over it afterwards, so where they overlap (rider on mount, addons) the inner lines are hidden and only the
+// outer contour of the whole silhouette stays.
+struct DrawQueueItemOutfitOutline : public DrawQueueItem {
+    DrawQueueItemOutfitOutline(const OutfitOutline& outline, float pixelScale) :
+        DrawQueueItem(nullptr, Color::white), m_outline(outline), m_pixelScale(pixelScale)
+    {};
+
+    void addPart(DrawQueueItem* item)
+    {
+        if (auto* rect = dynamic_cast<DrawQueueItemTexturedRect*>(item))
+            m_parts.push_back(rect);
+    }
+    void draw() override;
+    bool cache() override
+    {
+        return false;
+    }
+
+    OutfitOutline m_outline;
+    float m_pixelScale; // map units per sprite pixel (g_sprites.getOffsetFactor())
+    std::vector<DrawQueueItemTexturedRect*> m_parts; // items of the same queue, drawn after this one
+};
+
 #endif
