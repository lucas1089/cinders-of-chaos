+void Creature::setOutline(int r, int g, int b, int a, int width, int pulseMs)
+{
+    auto channel = [](int v) { return (uint8)std::max(0, std::min(255, v)); };
+    width = std::max(0, std::min(3, width));
+    if (width == 0) {
+        clearOutline();
+        return;
+    }
+    m_outline.color = Color(channel(r), channel(g), channel(b), channel(a));
+    m_outline.topColor = m_outline.color;
+    m_outline.width = width;
+    m_outline.pulseMs = std::max(0, std::min(60000, pulseMs));
+}
+
+void Creature::setOutlineGradient(int r, int g, int b, int a)
+{
+    auto channel = [](int v) { return (uint8)std::max(0, std::min(255, v)); };
+    m_outline.topColor = Color(channel(r), channel(g), channel(b), channel(a));
+}
+
 void Creature::drawOutfit(const Rect& destRect, Otc::Direction direction, const Color& color, bool animate, bool ui, bool oldScaling, bool mountOnly, bool ignoreDisplacement)
 {
