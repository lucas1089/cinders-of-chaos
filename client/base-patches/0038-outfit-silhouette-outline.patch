+// Cinders of Chaos (base patch 0038): the silhouette outline program and its queue item.
+namespace
+{
+// a_TexCoord stays in texture pixels (the ring is measured in them); v_Pos is the map position for the gradient
+const std::string glslOutlineVertexShader = "\n\
+    attribute vec2 a_Vertex;\n\
+    attribute vec2 a_TexCoord;\n\
+    uniform mat3 u_TransformMatrix;\n\
+    uniform mat3 u_ProjectionMatrix;\n\
+    varying vec2 v_TexCoord;\n\
+    varying vec2 v_Pos;\n\
+    void main()\n\
+    {\n\
+        gl_Position = vec4((u_ProjectionMatrix * u_TransformMatrix * vec3(a_Vertex.xy, 1.0)).xy, 0.0, 1.0);\n\
+        v_TexCoord = a_TexCoord;\n\
+        v_Pos = a_Vertex;\n\
+    }\n";
+
+// alpha of the part at a texture pixel; nothing outside its own frame rect (the texture holds other frames there)
+const std::string glslOutlineFragmentShader = "\n\
+    uniform mat3 u_TextureMatrix;\n\
+    uniform sampler2D u_Tex0;\n\
+    uniform vec4 u_Color;\n\
+    uniform vec4 u_OutlineTop;\n\
+    uniform vec4 u_OutlineSrc;\n\
+    uniform vec3 u_OutlineRing;\n\
+    uniform vec2 u_OutlineSpan;\n\
+    varying vec2 v_TexCoord;\n\
+    varying vec2 v_Pos;\n\
+    float alphaAt(vec2 p)\n\
+    {\n\
+        if (p.x < u_OutlineSrc.x || p.y < u_OutlineSrc.y || p.x >= u_OutlineSrc.z || p.y >= u_OutlineSrc.w)\n\
+            return 0.0;\n\
+        return texture2D(u_Tex0, (u_TextureMatrix * vec3(p, 1.0)).xy).a;\n\
+    }\n\
+    void main()\n\
+    {\n\
+        float inside = alphaAt(v_TexCoord);\n\
+        if (inside > 0.98)\n\
+            discard;\n\
+        float near = 0.0;\n\
+        for (int i = 1; i <= 4; i++) {\n\
+            if (float(i) > u_OutlineRing.z)\n\
+                break;\n\
+            vec2 s = u_OutlineRing.xy * float(i);\n\
+            vec2 d = s * 0.7071;\n\
+            near = max(near, alphaAt(v_TexCoord + vec2(s.x, 0.0)));\n\
+            near = max(near, alphaAt(v_TexCoord - vec2(s.x, 0.0)));\n\
+            near = max(near, alphaAt(v_TexCoord + vec2(0.0, s.y)));\n\
+            near = max(near, alphaAt(v_TexCoord - vec2(0.0, s.y)));\n\
+            near = max(near, alphaAt(v_TexCoord + d));\n\
+            near = max(near, alphaAt(v_TexCoord - d));\n\
+            near = max(near, alphaAt(v_TexCoord + vec2(d.x, -d.y)));\n\
+            near = max(near, alphaAt(v_TexCoord + vec2(-d.x, d.y)));\n\
+        }\n\
+        float a = clamp(near * 2.0, 0.0, 1.0) * (1.0 - inside);\n\
+        if (a < 0.01)\n\
+            discard;\n\
+        float t = clamp((v_Pos.y - u_OutlineSpan.x) / max(1.0, u_OutlineSpan.y - u_OutlineSpan.x), 0.0, 1.0);\n\
+        vec4 c = mix(u_OutlineTop, u_Color, t);\n\
+        gl_FragColor = vec4(c.rgb, c.a * a);\n\
+    }\n";
+
+enum {
+    OUTLINE_TOP_UNIFORM = 20,
+    OUTLINE_SRC_UNIFORM = 21,
+    OUTLINE_RING_UNIFORM = 22,
+    OUTLINE_SPAN_UNIFORM = 23
+};
+
+constexpr float OUTLINE_PULSE_LOW = 0.45f; // the lowest alpha of a pulsing outline (game_cosmeticfx PULSE_LOW)
+constexpr int OUTLINE_MAX_RADII = 4;       // ring samples per direction (the fragment shader's loop)
+
+PainterShaderProgramPtr outlineProgram()
+{
+    static PainterShaderProgramPtr program;
+    static bool failed = false;
+    if (program || failed)
+        return program;
+    program = PainterShaderProgram::create("chaosOutlineProgram", glslOutlineVertexShader, glslOutlineFragmentShader);
+    if (!program) {
+        failed = true;
+        g_logger.error("outline program could not be built; creature outlines are off");
+        return nullptr;
+    }
+    program->bindUniformLocation(OUTLINE_TOP_UNIFORM, "u_OutlineTop");
+    program->bindUniformLocation(OUTLINE_SRC_UNIFORM, "u_OutlineSrc");
+    program->bindUniformLocation(OUTLINE_RING_UNIFORM, "u_OutlineRing");
+    program->bindUniformLocation(OUTLINE_SPAN_UNIFORM, "u_OutlineSpan");
+    return program;
+}
+
+Color scaledAlpha(Color color, float factor)
+{
+    color.setAlpha(std::max(0.f, std::min(1.f, color.aF() * factor)));
+    return color;
+}
+}
+
+void DrawQueueItemOutfitOutline::draw()
+{
+    if (m_parts.empty() || m_outline.width <= 0)
+        return;
+    PainterShaderProgramPtr program = outlineProgram();
+    if (!program)
+        return;
+
+    float alpha = m_color.aF(); // the queue's opacity (setOpacity) applies to the outline too
+    if (m_outline.pulseMs > 0) {
+        const float phase = (float)(g_clock.millis() % m_outline.pulseMs) / m_outline.pulseMs;
+        alpha *= OUTLINE_PULSE_LOW + (1.f - OUTLINE_PULSE_LOW) * (0.5f - 0.5f * std::cos(phase * 6.2831853f));
+    }
+    const Color bottom = scaledAlpha(m_outline.color, alpha);
+    const Color top = scaledAlpha(m_outline.topColor, alpha);
+    if (bottom.aF() <= 0.f && top.aF() <= 0.f)
+        return;
+
+    // the gradient runs over the whole silhouette (the parts' rects are cropped to their opaque pixels)
+    Rect span = m_parts.front()->m_dest;
+    for (auto* part : m_parts)
+        span = span.united(part->m_dest);
+
+    // the width in texture pixels: sprite pixels times the sprite size factor (HD upscaling keeps the same look); a
+    // part drawn scaled (a widget's preview) scales its line with it
+    const float radiusTex = std::max(1.f, m_outline.width * m_pixelScale);
+
+    g_painter->setShaderProgram(program);
+    program->bind();
+    program->setUniformValue(OUTLINE_TOP_UNIFORM, top);
+    program->setUniformValue(OUTLINE_SPAN_UNIFORM, (float)span.top(), (float)(span.bottom() + 1));
+    g_painter->setColor(bottom);
+    for (auto* part : m_parts) {
+        if (!part->m_texture || part->m_dest.isEmpty() || part->m_src.isEmpty())
+            continue;
+        const Rect& src = part->m_src;
+        const Rect& dest = part->m_dest;
+        // texture pixels per destination pixel (1 on the map)
+        const float sx = (float)src.width() / dest.width();
+        const float sy = (float)src.height() / dest.height();
+        // one sample per texture pixel of the radius, at most OUTLINE_MAX_RADII per direction
+        const int radii = std::max(1, std::min(OUTLINE_MAX_RADII, (int)std::ceil(radiusTex)));
+        program->setUniformValue(OUTLINE_SRC_UNIFORM, (float)src.left(), (float)src.top(), (float)(src.right() + 1), (float)(src.bottom() + 1));
+        program->setUniformValue(OUTLINE_RING_UNIFORM, radiusTex / radii, radiusTex / radii, (float)radii);
+        // the quad grows by the radius on each side, in destination pixels and in texture pixels alike
+        const int growX = std::max(1, (int)std::ceil(radiusTex / sx)), growY = std::max(1, (int)std::ceil(radiusTex / sy));
+        const Rect grownDest(Point(dest.left() - growX, dest.top() - growY), Size(dest.width() + 2 * growX, dest.height() + 2 * growY));
+        const int texX = (int)std::ceil(growX * sx), texY = (int)std::ceil(growY * sy);
+        const Rect grownSrc(Point(src.left() - texX, src.top() - texY), Size(src.width() + 2 * texX, src.height() + 2 * texY));
+        g_painter->drawTexturedRect(grownDest, part->m_texture, grownSrc, part->getFlipDirection());
+    }
+    g_painter->resetShaderProgram();
+    g_painter->resetColor();
+}
