-        const auto countFont = g_fonts.getFont("verdana-cap-bold");
+        if (!m_iconCountFont)
+            m_iconCountFont = g_fonts.getFont("verdana-cap-bold");
+        const BitmapFontPtr& countFont = m_iconCountFont;
         const float iconX = backgroundRect.x() + 15.5 + 12;
         const float iconY = backgroundRect.y() + 5;
         const int iconStepY = 14;
@@ -597,10 +599,24 @@
                 g_drawQueue->addTexturedRect(r, tex, Rect(0, 0, tex->getSize()));
 
                 if (iconCount > 0) {
-                    std::string countStr = std::to_string(iconCount);
-                    g_drawQueue->addText(countFont, countStr,
-                        Rect(r.right() + 2, r.y() - 1, 24, r.height() + 2),
-                        Fw::AlignLeftCenter, Color::white, true);
+                    // Chaos (base patch 0137): the layout entry of this icon's count, rebuilt only when the number, the font, the
+                    // font texture or the box change (the text is std::to_string(iconCount), so the count is the revision)
+                    const Rect countRect(r.right() + 2, r.y() - 1, 24, r.height() + 2);
+                    const Size boxSize = countRect.size();
+                    if (countFont && boxSize.isValid()) {
+                        chaos::TextSlotKey key;
+                        key.fontId = countFont->getId();
+                        key.texture = countFont->getTexture().get();
+                        key.width = boxSize.width();
+                        key.height = boxSize.height();
+                        key.align = static_cast<int>(Fw::AlignLeftCenter);
+                        const uint32_t countValue = iconCount; // a structured binding cannot be captured before C++20
+                        key.revision = countValue;
+                        const std::shared_ptr<TextRenderCache>& entry = m_iconCountSlots[i].get(key, [&]() {
+                            return g_text.makeEntry(countFont, std::to_string(countValue), boxSize, Fw::AlignLeftCenter);
+                        });
+                        g_drawQueue->addTextEntry(entry, countRect.topLeft(), Color::white, true);
+                    }
                 }
             }
         }
