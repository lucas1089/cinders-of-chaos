# Helper: no packet burst after a long frame. Catch-up cycles (same frame or < 25 ms real time after the last one) are skipped, and the spells the helper says are limited by real time: heals one per 200 ms, and every heal, magic shooter and auto haste spell is said again only after 500 ms unless the server's cooldown comes first. Without it a 2 s stall replayed ~40 cycles at once and a rejected heal went out 20 times a second, and the server kicked for packets per second.
--- a/mods/game_helper/classes/auto_haste.lua
+++ b/mods/game_helper/classes/auto_haste.lua
@@ -226,11 +226,20 @@ _Helper.AutoHaste.check = function()
     return
   end
 
+  -- Chaos: real-time retry guard (helper.lua, spellTalkGuard). The haste cycle is its own 500 ms cycleEvent, so after a
+  -- long frame its missed cycles run back to back, and a rejected haste gets no cooldown to stop them.
+  if _Helper.spellTalkBlocked and _Helper.spellTalkBlocked(spellId, true) then
+    return
+  end
+
   local safeDoThing = _Helper.safeDoThing and _Helper.safeDoThing
   if safeDoThing then
     safeDoThing(false)
   end
   g_game.talk(spell.words, true)
+  if _Helper.noteSpellTalk then
+    _Helper.noteSpellTalk(spellId, true)
+  end
   if safeDoThing then
     safeDoThing(true)
   end
