+++ b/src/client/chaoswinglayers.h
@@ -0,0 +1,40 @@
+// Cinders of Chaos (base patch 0203): wings with a part in front of the body. Pure and header-only so
+// client/tools/chaoswinglayers_test.cpp can run it without the engine.
+// The engine draws a look's wings once: before the body when the creature faces south or east, after it when it
+// faces north or west. A wing that wraps the body (a ring, an orbit, a feather that crosses the shoulder) needs both.
+// A wings look with two y patterns is such a wing:
+//   y pattern 0  the whole wing (what a client without this patch draws, in the order above),
+//   y pattern 1  only the part in front of the body.
+// For it the engine draws y 0 before the body and y 1 after it, in every direction. A wings look with one y pattern
+// is drawn as before. The pair writes the patterns (client/tools/sprites/gen_drawn_wings.py apply).
+#ifndef CHAOSWINGLAYERS_H
+#define CHAOSWINGLAYERS_H
+
+namespace chaos {
+namespace winglayers {
+
+constexpr int kNone = -1;
+constexpr int kWhole = 0;  // y pattern of the whole wing
+constexpr int kFront = 1;  // y pattern of the part in front of the body
+
+inline bool layered(int numPatternY) { return numPatternY >= 2; }
+
+struct Plan {
+    int before;  // y pattern to draw before the body, kNone for no draw
+    int after;   // y pattern to draw after the body, kNone for no draw
+};
+
+// direction: 0 north, 1 east, 2 south, 3 west (a diagonal is folded to east or west before)
+inline Plan plan(int numPatternY, int direction)
+{
+    if (layered(numPatternY))
+        return Plan{ kWhole, kFront };
+    if (direction == 1 || direction == 2)
+        return Plan{ kWhole, kNone };
+    return Plan{ kNone, kWhole };
+}
+
+}  // namespace winglayers
+}  // namespace chaos
+
+#endif
