@@ -0,0 +1,95 @@
+// Cinders of Chaos (base patch 0210): the head and cape layer (O747). Pure and header-only so client/tools/chaoswear_test.cpp can
+// run it without the engine.
+// A head piece and a cape are creature looks of pair 83 (client/tools/sprites/gen_wst_wear.py): one layer, 4 directions, y pattern
+// 0 the back (with the solid pixels of the front on it), y pattern 1 the front, their frames at 83 ms. Who wears which comes from
+// the server's cosmetics (kinds head and cape, the "looks" of the cosmetics opcode); game_cosmetics hands it in by character name
+// (setCreatureWear). Outfit::draw then draws, round the body and lifted with it (base patch 0209):
+//   before the body: the cape's back, the head piece's back
+//   after the body:  the cape's front, the head piece's front
+// each placed by its anchor tile (chaospiece.h place) and in its own looping frame. A piece needs a row of chaospiece.h (its
+// anchor tile): a look without one, or a pair without the look, is not drawn. Never on a mount (a seated rider's picture has
+// its own head place), never for a thing that is not a creature look.
+#ifndef CHAOSWEAR_H
+#define CHAOSWEAR_H
+
+#include <cctype>
+#include <string>
+#include <unordered_map>
+
+namespace chaos {
+namespace wear {
+
+constexpr int kMaxLook = 0xffff;
+constexpr size_t kMaxNames = 4096;   // more characters than any screen shows: a bad caller is cut off here
+
+struct Worn {
+    int head = 0;
+    int cape = 0;
+};
+
+struct Tables {
+    std::unordered_map<std::string, Worn> byName;  // lower case name -> what it wears
+};
+
+inline Tables& tables()
+{
+    static Tables t;
+    return t;
+}
+
+inline std::string key(const std::string& name)
+{
+    std::string out(name);
+    for (char& c : out)
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return out;
+}
+
+inline bool validLook(int look) { return look >= 0 && look <= kMaxLook; }
+
+// both 0: the character wears neither (the row goes)
+inline bool set(const std::string& name, int head, int cape)
+{
+    if (name.empty() || !validLook(head) || !validLook(cape))
+        return false;
+    const std::string k = key(name);
+    if (head == 0 && cape == 0) {
+        tables().byName.erase(k);
+        return true;
+    }
+    if (!tables().byName.count(k) && tables().byName.size() >= kMaxNames)
+        return false;
+    tables().byName[k] = Worn{ head, cape };
+    return true;
+}
+
+inline void clear() { tables().byName.clear(); }
+
+inline Worn of(const std::string& name)
+{
+    if (name.empty() || tables().byName.empty())
+        return Worn{};
+    auto it = tables().byName.find(key(name));
+    return it == tables().byName.end() ? Worn{} : it->second;
+}
+
+// the draw order round the body: step 0, 1 before it, 2, 3 after it
+struct Step {
+    bool cape;   // false: the head piece
+    int yPattern;
+};
+
+inline Step step(int i)
+{
+    switch (i) {
+        case 0: return Step{ true, 0 };
+        case 1: return Step{ false, 0 };
+        case 2: return Step{ true, 1 };
+        default: return Step{ false, 1 };
+    }
+}
+
+}  // namespace wear
+}  // namespace chaos
+
+#endif
