+// Chaos (base patch 0132): the soft glow. Graphics thread, right after the map picture is on the screen. Four small draws:
+//  1. chaos_bloom_extract: the map picture (source rect) at 1/4 size into bloom A, keeping only what is bright (luma over 0.80,
+//     smooth up to 0.96); everything else becomes black, so the biome's own colours are never in the glow;
+//  2. chaos_bloom_blur horizontal, A -> B; 3. chaos_bloom_blur vertical, B -> A (5 bilinear taps each, about 13 screen pixels);
+//  4. A is drawn over the map rect with the screen blend (src + dst * (1 - src)) at the option's strength: black adds nothing,
+//     and a pixel that is already white cannot get whiter, so only the dark pixels next to a bright one pick up a halo.
+// Off, or a missing shader: no buffers and no draws. Cost in client/BASE.md.
+void GraphicalApplication::drawMapBloom(const Rect& dest, const Rect& src)
+{
+    if (!m_mapBloom.load()) {
+        if (m_bloomA || m_bloomB) // memory goes back when the option is turned off
+            m_bloomA = m_bloomB = nullptr;
+        return;
+    }
+    PainterShaderProgramPtr extract = g_shaders.getShader("chaos_bloom_extract");
+    PainterShaderProgramPtr blur = g_shaders.getShader("chaos_bloom_blur");
+    if (!extract || !blur || !m_mapFramebuffer || dest.isEmpty() || src.isEmpty())
+        return;
+    const Size small(std::max(1, dest.width() / 4), std::max(1, dest.height() / 4));
+    const Size full = m_mapFramebuffer->getSize();
+    if (!m_bloomA) {
+        m_bloomA = g_framebuffers.createFrameBuffer();
+        m_bloomB = g_framebuffers.createFrameBuffer();
+    }
+    m_bloomA->resize(small);
+    m_bloomB->resize(small);
+    const Rect smallRect(0, 0, small);
+    const Rect smallSrc(0, 0, small);
+
+    // 1. bright pass, 4 taps a quarter of a small pixel off the middle of each small pixel
+    m_bloomA->bind();
+    g_painter->clear(Color::black);
+    g_painter->setShaderProgram(extract);
+    extract->setParams(0.5f * src.width() / small.width() / full.width(), 0.5f * src.height() / small.height() / full.height(), 0, 0);
+    m_mapFramebuffer->draw(smallRect, src);
+    g_painter->resetShaderProgram();
+    m_bloomA->release();
+
+    // 2 and 3. the separable blur
+    m_bloomB->bind();
+    g_painter->clear(Color::black);
+    g_painter->setShaderProgram(blur);
+    blur->setParams(1.f / small.width(), 0, 0, 0);
+    m_bloomA->draw(smallRect, smallSrc);
+    g_painter->resetShaderProgram();
+    m_bloomB->release();
+
+    m_bloomA->bind();
+    g_painter->clear(Color::black);
+    g_painter->setShaderProgram(blur);
+    blur->setParams(0, 1.f / small.height(), 0, 0);
+    m_bloomB->draw(smallRect, smallSrc);
+    g_painter->resetShaderProgram();
+    m_bloomA->release();
+
+    // 4. the one additive composite over the map rect
+    const float s = m_mapBloomStrength.load();
+    g_painter->setCompositionMode(Painter::CompositionMode_Screen);
+    g_painter->setColor(Color(s, s, s, 1.f));
+    m_bloomA->draw(dest, smallRect);
+    g_painter->resetColor();
+    g_painter->resetCompositionMode();
+}
