 -- MAGIC SHIELD FUNCTIONS (Sorcerer/Druid Only)
 -- ============================================================
 
+-- Chaos: spell words come from the client's spell table (the server's words, renamed by game_chaosspells)
+local function spellWords(spellId, fallback)
+  local spell = Spells and Spells.getSpellDataById and Spells.getSpellDataById(spellId)
+  return spell and spell.words or fallback
+end
