+// one widget over the tile: centred on it, moved by its margins
+static void drawWidgetOverTile(const UIWidgetPtr& widget, Point dest)
+{
+    Rect dest_rect = widget->getRect();
+    dest.x += widget->getMarginLeft();
+    dest.x -= widget->getMarginRight();
+    dest.y += widget->getMarginTop();
+    dest.y -= widget->getMarginBottom();
+    dest_rect = Rect(dest - Point(dest_rect.width() / 2 - g_sprites.spriteSize(), dest_rect.height() / 2 - g_sprites.spriteSize()), dest_rect.width(), dest_rect.height());
+    widget->setRect(dest_rect);
+    widget->draw(dest_rect, Fw::ForegroundPane);
+}
+
 void Tile::drawWidget(Point dest)
 {
-    if (!m_widget)
+    if (m_widget)
+        drawWidgetOverTile(m_widget, dest);
+
+    // Chaos (base patch 0041): the overlay widgets, in the order they were added
+    for (const UIWidgetPtr& widget : m_overlayWidgets) {
+        if (widget && !widget->isDestroyed() && widget->isVisible())
+            drawWidgetOverTile(widget, dest);
+    }
+}
+
+void Tile::addOverlayWidget(const UIWidgetPtr& widget)
+{
+    if (!widget || hasOverlayWidget(widget))
         return;
-    
-    Rect dest_rect = m_widget->getRect();
-    dest.x += m_widget->getMarginLeft();
-    dest.x -= m_widget->getMarginRight();
-    dest.y += m_widget->getMarginTop();
-    dest.y -= m_widget->getMarginBottom();
-    dest_rect = Rect(dest - Point(dest_rect.width() / 2 - g_sprites.spriteSize(), dest_rect.height() / 2 - g_sprites.spriteSize()), dest_rect.width(), dest_rect.height());
-    m_widget->setRect(dest_rect);
-    m_widget->draw(dest_rect, Fw::ForegroundPane);
+    if (m_overlayWidgets.size() >= 16) { // a module that keeps adding: drop the oldest
+        m_overlayWidgets.erase(m_overlayWidgets.begin());
+    }
+    m_overlayWidgets.push_back(widget);
+}
+
+bool Tile::removeOverlayWidget(const UIWidgetPtr& widget)
+{
+    auto it = std::find(m_overlayWidgets.begin(), m_overlayWidgets.end(), widget);
+    if (it == m_overlayWidgets.end())
+        return false;
+    m_overlayWidgets.erase(it);
+    return true;
+}
+
+bool Tile::hasOverlayWidget(const UIWidgetPtr& widget)
+{
+    return std::find(m_overlayWidgets.begin(), m_overlayWidgets.end(), widget) != m_overlayWidgets.end();
 }
 
