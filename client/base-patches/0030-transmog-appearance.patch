+// Chaos transmog: patterns and animation phase of the drawn look (its own pattern and phase counts; equipment has no
+// count or fluid patterns, so only the position patterns and a clock-driven animation apply)
+static void appearancePatterns(ThingType* look, const Position& pos, bool animate, int& xPattern, int& yPattern, int& zPattern, int& animationPhase)
+{
+    xPattern = pos.x % std::max<int>(1, look->getNumPatternX());
+    yPattern = pos.y % std::max<int>(1, look->getNumPatternY());
+    zPattern = pos.z % std::max<int>(1, look->getNumPatternZ());
+    const int phases = look->getAnimationPhases();
+    if (phases <= 1) {
+        animationPhase = 0;
+    } else if (!animate) {
+        animationPhase = phases - 1;
+    } else if (look->getAnimator()) {
+        animationPhase = look->getAnimator()->getPhase();
+    } else {
+        const int ticks = g_game.getFeature(Otc::GameEnhancedAnimations) ? Otc::ITEM_TICKS_PER_FRAME_FAST : Otc::ITEM_TICKS_PER_FRAME;
+        animationPhase = static_cast<int>((g_clock.millis() / ticks) % phases);
+    }
+}
