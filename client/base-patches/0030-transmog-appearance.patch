+ThingType* Item::getAppearanceThingType()
+{
+    const uint16 look = getAppearanceId();
+    if (look == 0 || look == m_clientId || !g_things.isValidDatId(look, ThingCategoryItem))
+        return nullptr;
+    ThingType* type = g_things.rawGetThingType(look, ThingCategoryItem);
+    // a look with count or fluid patterns would need this item's subtype: the server never sends one (patch 0019)
+    if (!type || type->isStackable() || type->isFluidContainer() || type->isSplash())
+        return nullptr;
+    return type;
+}
