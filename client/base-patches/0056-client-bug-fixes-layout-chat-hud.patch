+-- The login-screen services (clientServicesLink, server/tools/clientservices.py) may not run, as with the Windows
+-- server package. A failure is logged once per address, and each request then retries after 1, 2, 4 ... up to 30
+-- minutes instead of every minute (and the status request no longer schedules two retries per failure).
+local serviceFailures = {} -- request kind -> failures in a row
+local serviceLogged = {}   -- url -> true once its failure was logged
+local SERVICE_RETRY_MS, SERVICE_RETRY_MAX_MS = 60000, 30 * 60000
+
+local function serviceFailed(kind, url, err)
+  local n = (serviceFailures[kind] or 0) + 1
+  serviceFailures[kind] = n
+  if not serviceLogged[url] then
+    serviceLogged[url] = true
+    g_logger.warning("HTTP error for " .. url .. ": " .. tostring(err) .. " (the login screen works without it; retrying less often)")
+  end
+  return math.min(SERVICE_RETRY_MS * 2 ^ (n - 1), SERVICE_RETRY_MAX_MS)
+end
+
+local function serviceAnswered(kind, url)
+  serviceFailures[kind] = 0
+  if serviceLogged[url] then
+    serviceLogged[url] = nil
+    g_logger.info(url .. " answers again")
+  end
+end
