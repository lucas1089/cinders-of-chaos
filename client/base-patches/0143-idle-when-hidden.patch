# Chaos: no work while the window is minimized, honest limit while it is not in front (O227; client/BASE.md "0143";
# src/framework/core/chaosidle.h (new, pure), graphicalapplication.cpp; after 0001-0142).
# Audit of the base (graphicalapplication.cpp run(), platform windows): X11 sets m_visible on Map/UnmapNotify and m_focused on
# FocusIn/Out, Win32 on WM_SIZE (SIZE_MINIMIZED) and WM_ACTIVATE. Neither reports a window that other windows cover, so a
# covered window is "unfocused" (the player clicked the other window) and gets that path. What the base did:
#  * hidden: the graphics thread drew nothing, but woke up to 500 times a second (2 ms sleeps), and the logic thread kept
#    building the three draw queues (g_ui.render) at 10 Hz for a frame nobody draws, and polled every millisecond;
#  * unfocused: a fixed 30 fps cap, even when the frame limit of the options was lower (the option that the settings call
#    backgroundFrameRate is the plain frame limit of the window; the base has no separate background value).
# This patch:
#  * hidden: the logic thread builds no draw queue and sleeps kHiddenPollUs (4 ms) between polls. It still runs
#    Application::poll (sockets, dispatcher, scheduled events, so packets, the ping, chat and a disconnect are handled; at most
#    10 ms later than before, asserted in the test). The graphics thread wakes 50 times a second (window events are read every
#    10 ms by the base) and still calls g_adaptiveRenderer.refresh() so the quality level does not sink.
#  * shown again: the logic thread sees the hidden to shown change once (chaos::idle::Tracker), resets its build clocks and asks
#    for a repaint, so the first frame is a new one and input works at once (the input events came through the window poll).
#  * unfocused: min(30, option) instead of 30.
# Not changed: the shown and focused path, vsync, unlimited fps, the browser build (runBrowser).
# Checked: applies after 0001-0142 on the base tree with 0 fuzz; graphicalapplication.cpp passes g++ -fsyntax-only with no
# new error; the header passes client/tools/chaosidle_test.cpp (CI step "Idle state of the window").
# Not built, linked or run in a client; the saving is not measured (see ROADMAP O227).
--- a/src/framework/core/chaosidle.h
+++ b/src/framework/core/chaosidle.h
@@ -0,0 +1,70 @@
+// Chaos (O227): what the client does when the player is not looking at it. Pure, no engine types, so a test can run it.
+//  * Active    : visible and focused. Nothing changes.
+//  * Unfocused : visible, another window has the focus (also the usual state of a window that another one covers: neither
+//                X11 nor Windows tell a client that it is covered). Renders at most kUnfocusedFps, and never more than the
+//                frame limit of the options (a player who set 20 gets 20, not 30).
+//  * Hidden    : minimized or unmapped. No frame is drawn and no draw queue is built (the base built them at 10 Hz and
+//                nobody drew them). Network and dispatcher polling go on at kHiddenPollUs, so packets, pings, chat and a
+//                disconnect are handled as before, at most a few milliseconds later.
+#ifndef CHAOSIDLE_H
+#define CHAOSIDLE_H
+
+#include <algorithm>
+#include <cstdint>
+
+namespace chaos {
+namespace idle {
+
+enum class State { Active, Unfocused, Hidden };
+
+constexpr int kUnfocusedFps = 30;
+constexpr int64_t kActivePollUs = 1000;        // logic poll interval while the window is shown
+constexpr int64_t kHiddenPollUs = 4000;        // logic poll interval while hidden (limit: kMaxHiddenPollUs)
+constexpr int64_t kMaxHiddenPollUs = 10000;    // a ping or a packet waits at most this long more than before
+constexpr int64_t kHiddenMainSleepUs = 20000;  // the graphics thread wakes 50 times a second when hidden, not 500
+constexpr int64_t kMaxMainSleepUs = 2000;      // the base cap between two frames of a shown window
+
+inline State classify(bool visible, bool focused)
+{
+    if (!visible)
+        return State::Hidden;
+    return focused ? State::Active : State::Unfocused;
+}
+
+// Frame limit of the render loop for a shown window. userCap is the option (0 or less: none). The caller handles the
+// Active case (vsync, unlimited); this is the limit for Unfocused: the lower of the two.
+inline int unfocusedCap(int userCap)
+{
+    return userCap > 0 ? std::min(userCap, kUnfocusedFps) : kUnfocusedFps;
+}
+
+inline bool rendersFrames(State s) { return s != State::Hidden; }
+inline bool buildsDrawQueues(State s) { return s != State::Hidden; }
+
+inline int64_t logicPollIntervalUs(State s) { return s == State::Hidden ? kHiddenPollUs : kActivePollUs; }
+
+// Longest sleep of the graphics thread in one go: a window that is not drawn needs no quick wake-up (events are read
+// every 10 ms at most anyway, the base polls the window only that often).
+inline int64_t mainSleepUs(State s) { return s == State::Hidden ? kHiddenMainSleepUs : kMaxMainSleepUs; }
+
+// Remembers the last state. update() returns true once when a window that was hidden is shown again: the caller asks for a
+// full repaint at once, because the draw queues are stale (or missing) and the player must not wait for the next change.
+class Tracker
+{
+public:
+    bool update(State now)
+    {
+        const bool resumed = m_last == State::Hidden && now != State::Hidden;
+        m_last = now;
+        return resumed;
+    }
+    State last() const { return m_last; }
+
+private:
+    State m_last = State::Active;
+};
+
+} // namespace idle
+} // namespace chaos
+
+#endif
