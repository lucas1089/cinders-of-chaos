+  local listWidth = #choices > 0 and (choicesWidth + horizontalPadding + 24) or 0
+  modalDialog:setWidth(math.min(modalDialog.maximumWidth, math.max(buttonsWidth, labelWidth, listWidth, modalDialog.minimumWidth)))
   messageLabel:setTextWrap(true)
 
