# Chaos: modal dialog choices keep 44 characters and the dialog grows to the widest (client/BASE.md "0215";
# modules/game_modaldialog/modaldialog.lua; after 0001-0214). Lua only, no engine code. V35, seen in a client 2026-11-27:
# the Archivist's tale list (a server modal window) cut "Cinderhold I: The Torn Ledger (new)" to 28 characters, so the
# story quest's state "(new)" never showed. A choice keeps up to 44 characters (longer ones are cut and keep the
# tooltip, as before) and the dialog is at least as wide as the widest choice plus the scrollbar, up to maximumWidth
# (600). Test: client/tools/modal_choices_patch_test.py.
--- a/modules/game_modaldialog/modaldialog.lua
+++ b/modules/game_modaldialog/modaldialog.lua
@@ -47,16 +47,21 @@
   choiceList:focus()
 
   local labelHeight
+  -- Chaos: a choice keeps up to 44 characters (28 cut "Cinderhold I: The Torn Ledger (new)" before its state) and the
+  -- dialog grows to the widest one, up to maximumWidth; a longer one is cut and keeps its tooltip
+  local choiceChars = 44
+  local choicesWidth = 0
   for i = 1, #choices do
     local choiceId = choices[i][1]
     local choiceName = choices[i][2]
 
     local label = g_ui.createWidget('ChoiceListLabel', choiceList)
     label.choiceId = choiceId
-    label:setText(short_text(choiceName, 28))
-    if #choiceName > 28 then
+    label:setText(short_text(choiceName, choiceChars))
+    if #choiceName > choiceChars then
       label:setTooltip(choiceName)
     end
+    choicesWidth = math.max(choicesWidth, label:getTextSize().width)
     label:setPhantom(false)
     label:setBackgroundColor(i % 2 == 0 and "#414141" or "#484848")
     label:setActionId(i)
@@ -108,7 +113,9 @@
   buttonsWidth = buttonsWidth + horizontalPadding
 
   local labelWidth = math.min(600, math.floor(message:len() * 1.5))
-  modalDialog:setWidth(math.min(modalDialog.maximumWidth, math.max(buttonsWidth, labelWidth, modalDialog.minimumWidth)))
