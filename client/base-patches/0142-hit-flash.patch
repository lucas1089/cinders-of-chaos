--- a/src/client/chaoshitflash.h
+++ b/src/client/chaoshitflash.h
@@ -0,0 +1,103 @@
+// Cinders of Chaos (base patch 0142): the hit flash tint of a creature, pure and header-only so
+// client/tools/chaoshitflash_test.cpp can run it without the engine. When the health percent of a creature on the map goes
+// down, its sprite is drawn once more in white with a falling alpha for kDurationMs (ease-out). Nothing is kept per frame
+// but one start time and one strength per creature; a small budget caps how many flashes are alive at once.
+#ifndef CHAOSHITFLASH_H
+#define CHAOSHITFLASH_H
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace chaos {
+namespace hitflash {
+
+constexpr int kDurationMs = 120;     // from the hit to a normal sprite
+constexpr int kMinGapMs = 100;       // one creature does not restart its flash faster than this
+constexpr size_t kMaxActive = 16;    // flashes alive at once over all creatures; more are skipped
+constexpr float kPeakMin = 0.35f;    // white share for a 1% hit
+constexpr float kPeakMax = 0.75f;    // white share for a hit of kBigDrop% or more
+constexpr int kBigDrop = 25;
+
+// the white share at the first frame, from how many percent of the health the hit took (bigger hit, brighter flash)
+inline float peakForDrop(int dropPercent)
+{
+    const int d = std::max(1, std::min(kBigDrop, dropPercent));
+    return kPeakMin + (kPeakMax - kPeakMin) * static_cast<float>(d - 1) / static_cast<float>(kBigDrop - 1);
+}
+
+// the white share `elapsedMs` after the hit: the peak at the start, then (1 - u)^2 (fast first, slow tail), 0 from
+// kDurationMs on; never outside 0..peak
+inline float strengthAt(int64_t elapsedMs, float peak)
+{
+    if (elapsedMs >= kDurationMs)
+        return 0.0f;
+    if (elapsedMs <= 0)
+        return peak;
+    const float u = static_cast<float>(elapsedMs) / static_cast<float>(kDurationMs);
+    const float r = 1.0f - u;
+    return peak * r * r;
+}
+
+// the alpha byte for the painter colour
+inline int alphaByte(float strength)
+{
+    const int a = static_cast<int>(strength * 255.0f + 0.5f);
+    return std::max(0, std::min(255, a));
+}
+
+// the one decision whether a health change starts a flash: the option is on, the creature stands on a map tile and was
+// already shown (the first update after it appears is the starting value, not a hit), the health went down and it is not
+// 0 (a dying creature is removed at once; the death fade has its own copy)
+inline bool wantsFlash(bool optionOn, bool onMap, bool shown, int oldPercent, int newPercent)
+{
+    return optionOn && onMap && shown && newPercent > 0 && newPercent < oldPercent;
+}
+
+// per creature: whether the last flash started long enough ago (0 = never flashed)
+inline bool gapPassed(int64_t lastStart, int64_t now)
+{
+    return lastStart == 0 || now < lastStart || now - lastStart >= kMinGapMs;
+}
+
+// how many flashes may be alive at once; a fixed array, no allocation
+class Budget
+{
+public:
+    // true and the flash is counted until now + kDurationMs; false when kMaxActive are alive
+    bool tryAcquire(int64_t now)
+    {
+        size_t freeSlot = kMaxActive;
+        for (size_t i = 0; i < kMaxActive; ++i) {
+            // a slot is free when its flash is over (or the clock ran backwards, so it can never block for long)
+            if (m_ends[i] <= now || m_ends[i] > now + kDurationMs) {
+                freeSlot = i;
+                break;
+            }
+        }
+        if (freeSlot == kMaxActive)
+            return false;
+        m_ends[freeSlot] = now + kDurationMs;
+        return true;
+    }
+
+    size_t active(int64_t now) const
+    {
+        size_t n = 0;
+        for (int64_t e : m_ends)
+            if (e > now && e <= now + kDurationMs)
+                ++n;
+        return n;
+    }
+
+    void clear() { m_ends.fill(0); }
+
+private:
+    std::array<int64_t, kMaxActive> m_ends{};
+};
+
+} // namespace hitflash
+} // namespace chaos
+
+#endif
