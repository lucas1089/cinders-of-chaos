+CreaturePtr MapView::getCreatureAt(const Point& point, const Size& mapSize, int maxZ, bool* big)
+{
+    if (big)
+        *big = false;
+    if (!getCameraPosition().isValid() || m_drawnCreatures.empty())
+        return nullptr;
+
+    // the point in the map's framebuffer, where the creatures were queued (as getPositionOffset, without the tile)
+    Rect srcRect = calcFramebufferSource(mapSize);
+    float sh = srcRect.width() / (float)mapSize.width();
+    float sv = srcRect.height() / (float)mapSize.height();
+    const Point framebufferPoint = Point(point.x * sh, point.y * sv) + srcRect.topLeft();
+
+    std::vector<CreatureHit::Candidate> candidates(m_drawnCreatures.size());
+    for (size_t i = 0; i < m_drawnCreatures.size(); ++i) {
+        const DrawnCreature& drawn = m_drawnCreatures[i];
+        CreatureHit::Candidate& candidate = candidates[i];
+        if (!drawn.creature || drawn.z > maxZ || drawn.creature->isRemoved())
+            continue;
+        candidate.localPlayer = drawn.creature->isLocalPlayer();
+        candidate.ownTile = drawn.ownTile.contains(framebufferPoint);
+        if (!drawn.big)
+            continue;
+        int px = framebufferPoint.x, py = framebufferPoint.y;
+        CreatureHit::unscale(drawn.scale, drawn.scaleCenter.x, drawn.scaleCenter.y, px, py);
+        for (const CreatureHitPart& part : drawn.parts) {
+            const CreatureHit::Box dest{ part.dest.x(), part.dest.y(), part.dest.width(), part.dest.height() };
+            const CreatureHit::Box src{ part.src.x(), part.src.y(), part.src.width(), part.src.height() };
+            if (CreatureHit::partHit(dest, src, part.flip, part.mask.get(), px, py)) {
+                candidate.pixels = true;
+                break;
+            }
+        }
+    }
+
+    const int index = CreatureHit::pick(candidates);
+    if (index < 0)
+        return nullptr;
+    if (big)
+        *big = m_drawnCreatures[index].big;
+    return m_drawnCreatures[index].creature;
+}
+
