--- a/src/client/creaturehit.h
+++ b/src/client/creaturehit.h
@@ -0,0 +1,129 @@
+// Cinders of Chaos (base patch 0051): the pure maths of clicking a creature by what is drawn of it.
+// No engine types: MapView records what each creature drew in the last frame and asks these functions which one a
+// point of the map's framebuffer takes. Tested by client/tools/creaturehit_test.cpp (CI).
+#ifndef CREATUREHIT_H
+#define CREATUREHIT_H
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace CreatureHit
+{
+// a rectangle in framebuffer or texture pixels (x, y the top-left pixel)
+struct Box {
+    int x = 0, y = 0, w = 0, h = 0;
+    bool contains(int px, int py) const { return w > 0 && h > 0 && px >= x && py >= y && px < x + w && py < y + h; }
+};
+
+// the box a thing of widthTiles x heightTiles tiles covers when drawn at dest (the top-left of its own tile): it grows
+// up and left from that tile and moves by its displacement (positive = up and left), as ThingType::draw places it
+inline Box drawnBox(int destX, int destY, int dispX, int dispY, int widthTiles, int heightTiles, int spriteSize)
+{
+    return Box{ destX - dispX - (widthTiles - 1) * spriteSize, destY - dispY - (heightTiles - 1) * spriteSize,
+                widthTiles * spriteSize, heightTiles * spriteSize };
+}
+
+// true when a creature is drawn over more than its own tile (any part wider or taller than one tile)
+inline bool isBig(int widthTiles, int heightTiles) { return widthTiles > 1 || heightTiles > 1; }
+
+// a point drawn through a scale of `factor` around (cx, cy) (Creature draw scale, base patch 0020) back to where it was
+// queued: the inverse of p' = c + (p - c) * factor
+inline void unscale(float factor, int cx, int cy, int& px, int& py)
+{
+    if (!(factor > 0.f) || factor == 1.f)
+        return;
+    px = cx + (int)std::floor((px - cx) / factor);
+    py = cy + (int)std::floor((py - cy) / factor);
+}
+
+// the texel of src that the point (px, py) of dest shows (dest may be another size than src; flip 1 mirrors x, 2
+// mirrors y, as DrawQueueItemTexturedRect::setFlipDirection); false when the point is outside dest
+inline bool texelAt(const Box& dest, const Box& src, int flip, int px, int py, int& tx, int& ty)
+{
+    if (!dest.contains(px, py) || src.w <= 0 || src.h <= 0)
+        return false;
+    int dx = (int)((int64_t)(px - dest.x) * src.w / dest.w);
+    int dy = (int)((int64_t)(py - dest.y) * src.h / dest.h);
+    if (flip == 1)
+        dx = src.w - 1 - dx;
+    else if (flip == 2)
+        dy = src.h - 1 - dy;
+    tx = src.x + dx;
+    ty = src.y + dy;
+    return true;
+}
+
+// one bit per pixel of a thing type's texture: set where the pixel is not transparent
+struct AlphaMask {
+    int width = 0, height = 0;
+    std::vector<uint8_t> bits;
+
+    void reset(int w, int h)
+    {
+        width = w > 0 ? w : 0;
+        height = h > 0 ? h : 0;
+        bits.assign(((size_t)width * height + 7) / 8, 0);
+    }
+    void set(int x, int y)
+    {
+        if (x < 0 || y < 0 || x >= width || y >= height)
+            return;
+        const size_t i = (size_t)y * width + x;
+        bits[i >> 3] |= (uint8_t)(1u << (i & 7));
+    }
+    bool get(int x, int y) const
+    {
+        if (x < 0 || y < 0 || x >= width || y >= height)
+            return false;
+        const size_t i = (size_t)y * width + x;
+        return (bits[i >> 3] >> (i & 7)) & 1;
+    }
+};
+
+// does (px, py) fall on an opaque pixel of a part drawn from src to dest? Without a mask the part's box counts (its
+// rect is already cropped to the frame's opaque pixels)
+inline bool partHit(const Box& dest, const Box& src, int flip, const AlphaMask* mask, int px, int py)
+{
+    int tx = 0, ty = 0;
+    if (!texelAt(dest, src, flip, px, py, tx, ty))
+        return false;
+    return !mask || mask->bits.empty() || mask->get(tx, ty);
+}
+
+// what a point hits of one drawn creature
+struct Candidate {
+    bool ownTile = false;     // the creature's own tile (the stock one-tile click box)
+    bool pixels = false;      // a drawn pixel of a big creature, anywhere (its own tile included)
+    bool localPlayer = false; // the player's own character
+};
+
+// the creature a click takes, candidates in draw order (the last one is drawn on top); -1 for none.
+// The topmost hit wins. The player's own character is left out of that pass (a creature over it is still clicked, as
+// before) but keeps every click on it that only the overhang of a big creature would take: a big creature hit outside
+// its own tile never steals the own character.
+inline int pick(const std::vector<Candidate>& candidates)
+{
+    int top = -1, self = -1;
+    for (int i = (int)candidates.size() - 1; i >= 0; --i) {
+        const Candidate& c = candidates[i];
+        if (!c.ownTile && !c.pixels)
+            continue;
+        if (c.localPlayer) {
+            if (self < 0)
+                self = i;
+            continue;
+        }
+        if (top < 0)
+            top = i;
+    }
+    if (top < 0)
+        return self;
+    if (self >= 0 && !candidates[top].ownTile)
+        return self;
+    return top;
+}
+}
+
+#endif
