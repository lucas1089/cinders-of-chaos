+-- Chaos (base patch 0060, client/MANIFEST.md "Owned and locked lists"): every outfit, mount, aura and shader of the
+-- game is listed, the ones the character does not own greyed out with their source in the tooltip; they can be
+-- looked at but not worn (Ok stays disabled and accept() sends nothing; the server refuses them too). The catalogue
+-- is the server's wardrobe answer kept by the overlay module game_unlocks; the rule is its UnlocksCore. "Only mine" is
+-- one setting per character and list. Cards show the look facing south, filling the card (game_lookpreview.fitCard).
+-- Without game_unlocks the window lists what the packet sent, as before.
+local onlyMineSync = false
+local lockedSets = {}
+local CARD_W, CARD_H = 108, 80 -- the picture part of a SelectionButton (above its name)
+
+local function unlocks()
+  local m = modules.game_unlocks
+  return m and m.UnlocksCore and m or nil
+end
+
+local function catalogueOf(kind)
+  local u = unlocks()
+  local w = u and u.wardrobe()
+  return w and w[kind] or nil
+end
+
+-- the stock list plus the locked catalogue entries (a store try-on look is locked too)
+local function fullList(kind, stock)
+  local u = unlocks()
+  if not u then return stock end
+  if kind == "outfit" then
+    for _, data in ipairs(stock) do
+      if getOutfitStoreInfo(data) ~= 0 then
+        data.locked = true
+        data.how = data.how or "Store"
+      end
+    end
+  end
+  local OSL = shaderLogic()
+  return u.UnlocksCore.display(kind, stock, catalogueOf(kind), kind == "shader" and OSL and OSL.label or nil)
+end
+
+local function refreshLocks()
+  local u = unlocks()
+  if not u then
+    lockedSets = {}
+    return
+  end
+  lockedSets = u.UnlocksCore.lockedSets({
+    outfit = fullList("outfit", ServerData.outfits),
+    mount = fullList("mount", ServerData.mounts),
+    aura = fullList("aura", ServerData.auras),
+    shader = fullList("shader", ServerData.shaders)
+  })
+end
+
+-- what the list shows: everything, or only the owned entries when "Only mine" is checked
+local function shownList(kind, list)
+  local u = unlocks()
+  if not u then return list end
+  return u.UnlocksCore.filter(list, window.filter_outfits.onlyCheck:isChecked())
+end
+
+-- the "Only mine" box shows this list's setting (game_unlocks keeps it per character)
+local function syncOnlyMine(listName)
+  local u = unlocks()
+  local box = window.filter_outfits.onlyCheck
+  onlyMineSync = true
+  box:setEnabled(u ~= nil)
+  if u then box:setChecked(u.onlyMine(listName)) end
+  onlyMineSync = false
+end
+
+local function styleCard(button, entry, outfit)
+  local u = unlocks()
+  if u then u.styleEntry(button, entry) end
+  local lp = modules.game_lookpreview
+  if lp and type(lp.fitCard) == "function" and outfit then
+    lp.fitCard(button.outfit, outfit, CARD_W, CARD_H)
+  end
+end
+
+-- Ok only while every part in use is owned
+local function updateOkButton()
+  if not window then return end
+  local u = unlocks()
+  if not u then return end
+  local parts = u.UnlocksCore.lockedParts(tempOutfit, lockedSets, {
+    mounted = window.appearance.mountCheck and showMountCheck and showMountCheck:isChecked(),
+    aura = window.configure.aura.auraCheck:isChecked()
+  })
+  if #parts > 0 then
+    window.okButton:setEnabled(false)
+    window.okButton:setTooltip(tr("You have not unlocked everything you picked."))
+  else
+    window.okButton:removeTooltip()
+  end
+  return #parts == 0
+end
+
+local function lockedFocus(child)
+  if not child then return false end
+  local u = unlocks()
+  return u ~= nil and child.locked == true
+end
+
