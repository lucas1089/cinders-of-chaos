+// Chaos (base patch 0126): the soft shadow texture, a 64x32 ellipse that fades from the middle to nothing at the rim
+// (built once; Texture uploads on first draw), and the shadow option
+bool Creature::s_softShadow = false;
+
+static TexturePtr softShadowTexture()
+{
+    static TexturePtr texture;
+    if (!texture) {
+        const int w = 64, h = 32;
+        auto image = std::make_shared<Image>(Size(w, h));
+        for (int y = 0; y < h; ++y) {
+            for (int x = 0; x < w; ++x) {
+                const float nx = (x + 0.5f) / w * 2.f - 1.f;
+                const float ny = (y + 0.5f) / h * 2.f - 1.f;
+                const float t = 1.f - std::sqrt(nx * nx + ny * ny);
+                const float a = t <= 0.f ? 0.f : t * t * (3.f - 2.f * t);
+                image->setPixel(x, y, Color(0, 0, 0, static_cast<int>(a * 255.f + 0.5f)));
+            }
+        }
+        texture = std::make_shared<Texture>(image, false, false, true);
+    }
+    return texture;
+}
