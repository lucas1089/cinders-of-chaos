+// Cinders of Chaos (base patch 0209): the purchased wings, heads and capes of pair 83 (O747) and the levitation of their wings.
+// Pure and header-only so client/tools/chaospiece_test.cpp can run it without the engine.
+// A pack piece is a creature look drawn round a body: a picture of w x h tiles whose anchor tile (column ax, row ay) is the
+// wearer's tile. The picture's top left goes on the wearer's tile minus anchor x 32 px, the wearer's tile being the creature's
+// place minus the body's displacement (where ThingType::draw puts the body's own bottom right tile). ThingType::draw puts a
+// look without displacement at dest - (w - 1, h - 1) tiles, so the point handed to it is
+//   wearer's tile + ((w - 1 - ax) x 32, (h - 1 - ay) x 32)
+// A wings look of the pack also lifts its wearer: per frame of the wings animation an offset of the body (x then y, sprite px
+// at 1x; negative is up and left, the oblique height), the wings themselves stay where they are (they rise inside their own
+// frames, and the ground shadow stays on the ground). The frame is the same for wings and body: (now / frame ms) mod frames.
+// client_chaos_wingfit hands the tables in (wear_pieces.lua, made by client/tools/sprites/gen_wst_wear.py). A look without a row
+// is drawn as before (bases 0193, 0203, 0204).
+#ifndef CHAOSPIECE_H
+#define CHAOSPIECE_H
+
+#include <cstdint>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace chaos {
+namespace piece {
+
+constexpr int kTile = 32;
+constexpr int kFrameMs = 83;     // 12 frames a second, the pack's speed
+constexpr int kMaxAnchor = 8;    // tiles
+constexpr int kMaxLiftPx = 32;   // a larger lift is a bad row: ignored
+constexpr int kMaxFrames = 64;
+
+struct Point2 {
+    int x = 0;
+    int y = 0;
+};
+
+struct Piece {
+    int ax = 0;
+    int ay = 0;
+};
+
+struct Tables {
+    std::unordered_map<int, Piece> pieces;               // look -> anchor tile
+    std::unordered_map<int, std::vector<Point2>> lifts;  // wings look -> the body's offset per frame
+};
+
+inline Tables& tables()
+{
+    static Tables t;
+    return t;
+}
+
+inline bool setPiece(int look, int ax, int ay)
+{
+    if (look <= 0 || ax < 0 || ay < 0 || ax > kMaxAnchor || ay > kMaxAnchor)
+        return false;
+    tables().pieces[look] = Piece{ ax, ay };
+    return true;
+}
+
+// text: "dx dy dx dy ..." one pair a frame; a bad text sets nothing
+inline bool setLift(int look, const std::string& text)
+{
+    if (look <= 0)
+        return false;
+    std::istringstream in(text);
+    std::vector<Point2> out;
+    int x = 0, y = 0;
+    while (in >> x) {
+        if (!(in >> y))
+            return false;
+        if (x < -kMaxLiftPx || x > kMaxLiftPx || y < -kMaxLiftPx || y > kMaxLiftPx)
+            return false;
+        out.push_back(Point2{ x, y });
+        if (static_cast<int>(out.size()) > kMaxFrames)
+            return false;
+    }
+    if (!in.eof() || out.empty())
+        return false;
+    tables().lifts[look] = out;
+    return true;
+}
+
+inline void clear()
+{
+    tables().pieces.clear();
+    tables().lifts.clear();
+}
+
+inline bool piece(int look, Piece& out)
+{
+    auto it = tables().pieces.find(look);
+    if (it == tables().pieces.end())
+        return false;
+    out = it->second;
+    return true;
+}
+
+// the frame of a looping piece of `phases` frames at `frameMs` each
+inline int phase(int64_t millis, int phases, int frameMs = kFrameMs)
+{
+    if (phases <= 1 || frameMs <= 0 || millis < 0)
+        return 0;
+    return static_cast<int>((millis / frameMs) % phases);
+}
+
+// the body's offset in frame `frame` of a wings look (0, 0 without a row; a row shorter than the animation wraps)
+inline Point2 lift(int look, int frame)
+{
+    auto it = tables().lifts.find(look);
+    if (it == tables().lifts.end() || it->second.empty() || frame < 0)
+        return Point2{};
+    return it->second[static_cast<size_t>(frame) % it->second.size()];
+}
+
+// the point ThingType::draw takes for a piece of w x h tiles, from the wearer's tile (sprite px at 1x); a piece whose anchor is
+// outside its picture is placed as if the anchor were its bottom right tile
+inline Point2 place(int tileX, int tileY, int w, int h, const Piece& p)
+{
+    const int ax = (p.ax >= 0 && p.ax < w) ? p.ax : w - 1;
+    const int ay = (p.ay >= 0 && p.ay < h) ? p.ay : h - 1;
+    return Point2{ tileX + (w - 1 - ax) * kTile, tileY + (h - 1 - ay) * kTile };
+}
+
+}  // namespace piece
+}  // namespace chaos
+
+#endif
