+void Minimap::setHdEnabled(bool on)
+{
+    if(on == m_hdEnabled)
+        return;
+    m_hdEnabled = on;
+    if(!on)
+        trimHd(0);
+}
+
+// drop the HD pictures beyond `keep` blocks, the least recently drawn first (a block drawn in the current call stays)
+void Minimap::trimHd(size_t keep)
+{
+    if(m_hdBlocks.empty())
+        return;
+    std::vector<uint64_t> stamps;
+    stamps.reserve(m_hdBlocks.size());
+    for(const MinimapBlock_ptr& b : m_hdBlocks)
+        stamps.push_back(b->m_hdTexture ? std::max<uint64_t>(b->m_hdStamp, 1) : 0);
+    std::vector<size_t> drop = keep == 0 ? std::vector<size_t>() : chaos::minimaphd::evictOldest(stamps, m_hdFrame, keep);
+    if(keep == 0) {
+        for(size_t i = 0; i < m_hdBlocks.size(); ++i)
+            drop.push_back(i);
+    }
+    std::vector<bool> gone(m_hdBlocks.size(), false);
+    for(size_t i : drop) {
+        MinimapBlock& b = *m_hdBlocks[i];
+        b.m_hdTexture.reset();
+        b.m_hdStamp = 0;
+        b.m_hdDirty = true;
+        gone[i] = true;
+    }
+    std::vector<MinimapBlock_ptr> kept;
+    for(size_t i = 0; i < m_hdBlocks.size(); ++i)
+        if(!gone[i])
+            kept.push_back(m_hdBlocks[i]);
+    m_hdBlocks.swap(kept);
+}
+
+// the HD picture of a block at the texel density of lod (2, 4 or 8 px per tile). A picture that is out of date is composed again
+// at once only when `budget` allows (one block a draw call, and a block at most every 250 ms, so a step that brings new tiles
+// does not stall a frame); the older picture is drawn meanwhile. Null: none yet, the caller draws the flat block.
+TexturePtr Minimap::hdTexture(MinimapBlock& block, const Position& blockPos, int lod, int& budget)
+{
+    using namespace chaos::minimaphd;
+    block.m_hdStamp = m_hdFrame;
+    const bool have = block.m_hdTexture != nullptr;
+    if(have && !block.m_hdDirty && block.m_hdLod == lod)
+        return block.m_hdTexture;
+    const int64_t now = (int64_t)g_clock.millis();
+    if(budget <= 0 || (have && block.m_hdLod == lod && now - block.m_hdBuiltAt < 250))
+        return block.m_hdTexture;
+    --budget;
+
+    // the block and a ring of tiles of its neighbours
+    std::vector<GridTile> grid((size_t)kGrid * kGrid);
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        MinimapBlock_ptr nbs[3][3];
+        for(int by = -1; by <= 1; ++by) {
+            for(int bx = -1; bx <= 1; ++bx) {
+                int nx = blockPos.x + bx * MMBLOCK_SIZE, ny = blockPos.y + by * MMBLOCK_SIZE;
+                if(nx < 0 || ny < 0 || nx >= 65536 || ny >= 65536)
+                    continue;
+                Position np(nx, ny, blockPos.z);
+                if(hasBlock(np))
+                    nbs[by + 1][bx + 1] = m_tileBlocks[np.z][getBlockIndex(np)];
+            }
+        }
+        for(int ty = -kMargin; ty < kBlockTiles + kMargin; ++ty) {
+            for(int tx = -kMargin; tx < kBlockTiles + kMargin; ++tx) {
+                const int bx = tx < 0 ? -1 : (tx >= kBlockTiles ? 1 : 0);
+                const int by = ty < 0 ? -1 : (ty >= kBlockTiles ? 1 : 0);
+                const MinimapBlock_ptr& nb = nbs[by + 1][bx + 1];
+                if(!nb)
+                    continue;
+                const MinimapTile& mt = nb->getTile(tx - bx * kBlockTiles, ty - by * kBlockTiles);
+                GridTile& gt = grid[(size_t)(ty + kMargin) * kGrid + (tx + kMargin)];
+                gt.color = mt.color;
+                gt.seen = mt.color != 255;
+                gt.r.ground = mt.ground;
+                gt.r.border = mt.border;
+                gt.r.decor = mt.decor;
+                gt.r.solid = mt.solid;
+            }
+        }
+    }
+
+    m_hdScratch.resize((size_t)kFullPx * kFullPx * 4);
+    composeBlock(m_atlas, grid.data(), m_hdScratch.data());
+    const int px = lod * kBlockTiles;
+    ImagePtr image;
+    if(px == kFullPx) {
+        image = std::make_shared<Image>(Size(px, px), 4, m_hdScratch.data());
+    } else {
+        std::vector<uint8_t> shrunk((size_t)px * px * 4);
+        downscale(m_hdScratch.data(), px, shrunk.data());
+        image = std::make_shared<Image>(Size(px, px), 4, shrunk.data());
+    }
+    TexturePtr tex = std::make_shared<Texture>(image, false, false, true);
+    block.m_hdTexture = tex;
+    block.m_hdLod = lod;
+    block.m_hdDirty = false;
+    block.m_hdBuiltAt = now;
+    if(!have) {
+        for(const MinimapBlock_ptr& b : m_hdBlocks)
+            if(b.get() == &block)
+                return tex;
+        std::lock_guard<std::mutex> lock(m_lock);
+        auto it = m_tileBlocks[blockPos.z].find(getBlockIndex(blockPos));
+        if(it != m_tileBlocks[blockPos.z].end())
+            m_hdBlocks.push_back(it->second);
+    }
+    return tex;
+}
