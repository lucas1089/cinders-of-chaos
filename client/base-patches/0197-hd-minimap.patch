+// Chaos (0197): the recipe of a tile for the HD minimap, the client ids of its ground, its ground border, the top decoration and
+// the top solid. Only items that belong to the map count (creatures and things a player drops or moves do not): a decoration is a
+// static thing (bottom, top) or one that cannot be moved; a solid blocks walking and cannot be picked up.
+static void chaosRecipe(const TilePtr& tile, MinimapTile& out)
+{
+    for(const ThingPtr& thing : tile->getThings()) {
+        if(!thing || !thing->isItem())
+            continue;
+        uint32 id = thing->getId();
+        if(id == 0 || id > 65535)
+            continue;
+        if(thing->isGround())
+            out.ground = id;
+        else if(thing->isGroundBorder())
+            out.border = id;
+        else if(thing->isNotWalkable() && !thing->isPickupable())
+            out.solid = id;
+        else if(thing->isStatic() || thing->isNotMoveable())
+            out.decor = id;
+    }
+}
