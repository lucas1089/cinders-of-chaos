+int Minimap::loadHdAtlas(const std::string& dir)
+{
+    unloadHdAtlas();
+    try {
+        std::string text = g_resources.readFileContents(dir + "/index.txt");
+        std::string err;
+        if(!m_atlas.parseIndex(text, err)) {
+            g_logger.error(stdext::format("minimap HD index '%s': %s", dir, err));
+            m_atlas.clear();
+            return 0;
+        }
+        ImagePtr image = Image::load(dir + "/" + m_atlas.file());
+        if(!image || image->getBpp() != 4 || !m_atlas.setPixels(image->getPixels(), image->getWidth(), image->getHeight())) {
+            g_logger.error(stdext::format("minimap HD atlas '%s' does not match its index", m_atlas.file()));
+            m_atlas.clear();
+            return 0;
+        }
+    } catch(stdext::exception& e) {
+        g_logger.error(stdext::format("failed to load the minimap HD atlas: %s", e.what()));
+        m_atlas.clear();
+        return 0;
+    }
+    std::lock_guard<std::mutex> lock(m_lock);
