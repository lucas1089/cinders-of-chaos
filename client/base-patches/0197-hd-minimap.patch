diff -ruN a/src/client/chaosminimaphd.h b/src/client/chaosminimaphd.h
--- /dev/null
+++ b/src/client/chaosminimaphd.h
@@ -0,0 +1,579 @@
+// Cinders of Chaos (base patch 0197): the HD minimap. Pure and header-only so client/tools/chaosminimaphd_test.cpp can run it
+// without the engine.
+// The minimap keeps, per explored tile, the client ids of its ground, ground border, decoration and top solid item (the recipe).
+// A block of 64 x 64 tiles is composed from the swatch atlas (client/tools/gen_minimap_swatches.py: one picture of 8 px per tile
+// cell for every item type of the map) into one RGBA picture of 8 px per tile (512 x 512), then shaded (shadows, rim, water and
+// lava tint), then reduced to the texel density the zoom needs. The engine file only turns the result into a texture.
+//   * Index file (text, written by gen_minimap_swatches.py):
+//       chaos-minimap-hd 1
+//       atlas <png name> <width> <height> <cell px> <sha256>
+//       <client id> <x> <y> <w h as two digits> <flags hex>     flags: 1 solid, 2 tall, 4 water, 8 lava
+//   * An id without a swatch, a tile without a recipe (a minimap file of version 1) and an atlas that did not load all give the
+//     flat colour square of the old minimap, so nothing is ever blank that the old map showed.
+//   * Alpha of the composed picture: 0 not explored, 255 explored, kWaterAlpha / kLavaAlpha explored liquid ground. The fragment
+//     shader chaos_minimap_hd reads the two codes to move water and lava, and writes alpha 1; a linear filter between a liquid
+//     and a plain tile gives a value between, which the shader reads as a weaker effect.
+#ifndef CHAOSMINIMAPHD_H
+#define CHAOSMINIMAPHD_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace chaos {
+namespace minimaphd {
+
+constexpr int kBlockTiles = 64;           // tiles a side of a minimap block (MMBLOCK_SIZE)
+constexpr int kCellPx = 8;                // composed px per tile
+constexpr int kFullPx = kBlockTiles * kCellPx;
+constexpr int kMargin = 2;                // tiles of neighbours read round a block (a tall item spills up and to the left)
+constexpr int kGrid = kBlockTiles + 2 * kMargin;
+constexpr int kPad = 8;                   // px of mask margin for the shadow and blur passes
+constexpr uint8_t kWaterAlpha = 245;
+constexpr uint8_t kLavaAlpha = 235;
+constexpr float kSolidBoost = 1.55f;      // a thin wall or tree keeps its body when the picture is reduced
+
+enum SwatchFlag : uint8_t { FlagSolid = 1, FlagTall = 2, FlagWater = 4, FlagLava = 8 };
+
+struct Recipe {
+    uint16_t ground = 0, border = 0, decor = 0, solid = 0;
+    bool empty() const { return !ground && !border && !decor && !solid; }
+};
+
+// one tile as the composer reads it: the recipe, the flat 8 bit minimap colour (255 none) and whether it was explored
+struct GridTile {
+    Recipe r;
+    uint8_t color = 255;
+    bool seen = false;
+};
+
+struct Swatch {
+    uint16_t x = 0, y = 0;
+    uint8_t w = 1, h = 1, flags = 0;
+};
+
+// the colour of the 6x6x6 cube byte the old minimap draws (Color::from8bit)
+inline void cubeColor(int c, uint8_t& r, uint8_t& g, uint8_t& b)
+{
+    r = (uint8_t)((c / 36) % 6 * 51);
+    g = (uint8_t)((c / 6) % 6 * 51);
+    b = (uint8_t)(c % 6 * 51);
+}
+
+class Atlas {
+public:
+    // true when the text is a usable index; err names the first problem
+    bool parseIndex(const std::string& text, std::string& err)
+    {
+        m_sw.clear();
+        m_ready = false;
+        std::istringstream in(text);
+        std::string line;
+        if (!std::getline(in, line) || trim(line) != "chaos-minimap-hd 1") {
+            err = "bad index header";
+            return false;
+        }
+        if (!std::getline(in, line)) {
+            err = "no atlas line";
+            return false;
+        }
+        {
+            std::istringstream ls(line);
+            std::string tag, sha;
+            if (!(ls >> tag >> m_file >> m_w >> m_h >> m_cell >> sha) || tag != "atlas" || m_w <= 0 || m_h <= 0 || m_cell != kCellPx) {
+                err = "bad atlas line";
+                return false;
+            }
+        }
+        while (std::getline(in, line)) {
+            line = trim(line);
+            if (line.empty())
+                continue;
+            std::istringstream ls(line);
+            long id, x, y, flags;
+            std::string wh;
+            std::string fl;
+            if (!(ls >> id >> x >> y >> wh >> fl) || wh.size() != 2 || id < 0 || id > 65535) {
+                err = "bad item line: " + line;
+                return false;
+            }
+            Swatch s;
+            s.w = (uint8_t)(wh[0] - '0');
+            s.h = (uint8_t)(wh[1] - '0');
+            flags = std::strtol(fl.c_str(), nullptr, 16);
+            if (s.w < 1 || s.w > 9 || s.h < 1 || s.h > 9 || x < 0 || y < 0 || x + s.w * m_cell > m_w || y + s.h * m_cell > m_h) {
+                err = "swatch outside the atlas: " + line;
+                return false;
+            }
+            s.x = (uint16_t)x;
+            s.y = (uint16_t)y;
+            s.flags = (uint8_t)(flags & 15);
+            m_sw[(uint16_t)id] = s;
+        }
+        err.clear();
+        return true;
+    }
+
+    // the decoded atlas picture, RGBA; the index and the picture must agree on the size
+    bool setPixels(std::vector<uint8_t> rgba, int w, int h)
+    {
+        if (w != m_w || h != m_h || rgba.size() != (size_t)w * h * 4)
+            return false;
+        m_pix = std::move(rgba);
+        m_ready = !m_sw.empty();
+        return m_ready;
+    }
+
+    void clear()
+    {
+        m_sw.clear();
+        m_pix.clear();
+        m_ready = false;
+    }
+
+    bool ready() const { return m_ready; }
+    size_t count() const { return m_sw.size(); }
+    const std::string& file() const { return m_file; }
+    int width() const { return m_w; }
+    int height() const { return m_h; }
+
+    const Swatch* find(uint16_t id) const
+    {
+        if (!m_ready || !id)
+            return nullptr;
+        auto it = m_sw.find(id);
+        return it == m_sw.end() ? nullptr : &it->second;
+    }
+    uint8_t flagsOf(uint16_t id) const
+    {
+        const Swatch* s = find(id);
+        return s ? s->flags : 0;
+    }
+    const uint8_t* pixel(int x, int y) const { return &m_pix[((size_t)y * m_w + x) * 4]; }
+
+private:
+    static std::string trim(const std::string& s)
+    {
+        size_t a = s.find_first_not_of(" \t\r\n");
+        if (a == std::string::npos)
+            return std::string();
+        size_t b = s.find_last_not_of(" \t\r\n");
+        return s.substr(a, b - a + 1);
+    }
+    std::unordered_map<uint16_t, Swatch> m_sw;
+    std::vector<uint8_t> m_pix;
+    std::string m_file;
+    int m_w = 0, m_h = 0, m_cell = 0;
+    bool m_ready = false;
+};
+
+// ---------------------------------------------------------------- composing
+namespace detail {
+
+inline const GridTile& gridAt(const GridTile* grid, int tx, int ty)   // tile coordinates inside the block, -kMargin .. 63 + kMargin
+{
+    return grid[(ty + kMargin) * kGrid + (tx + kMargin)];
+}
+
+inline bool inGrid(int tx, int ty)
+{
+    return tx >= -kMargin && ty >= -kMargin && tx < kBlockTiles + kMargin && ty < kBlockTiles + kMargin;
+}
+
+// blit a swatch whose bottom right cell sits on tile (tx, ty); only pixels of explored tiles inside the block are written
+inline void blit(const Atlas& atlas, const Swatch& s, const GridTile* grid, int tx, int ty, bool boost, uint8_t* out)
+{
+    int pw = s.w * kCellPx, ph = s.h * kCellPx;
+    int ox = (tx + 1) * kCellPx - pw;
+    int oy = (ty + 1) * kCellPx - ph;
+    int boostK = boost ? (int)(kSolidBoost * 256.0f) : 256;
+    for (int sy = 0; sy < ph; ++sy) {
+        int py = oy + sy;
+        if (py < 0 || py >= kFullPx)
+            continue;
+        for (int sx = 0; sx < pw; ++sx) {
+            int px = ox + sx;
+            if (px < 0 || px >= kFullPx)
+                continue;
+            const uint8_t* src = atlas.pixel(s.x + sx, s.y + sy);
+            if (!src[3])
+                continue;
+            if (!gridAt(grid, px / kCellPx, py / kCellPx).seen)
+                continue;
+            int a = std::min(256, (src[3] * boostK) >> 8);      // 0..256
+            if (src[3] == 255)
+                a = 256;
+            uint8_t* dst = &out[((size_t)py * kFullPx + px) * 4];
+            for (int k = 0; k < 3; ++k)
+                dst[k] = (uint8_t)((dst[k] * (256 - a) + src[k] * a + 128) >> 8);
+            dst[3] = 255;
+        }
+    }
+}
+
+struct Plane {
+    int w = 0, h = 0;
+    std::vector<float> v;
+    Plane() = default;
+    Plane(int w_, int h_) : w(w_), h(h_), v((size_t)w_ * h_, 0.0f) {}
+    float& at(int x, int y) { return v[(size_t)y * w + x]; }
+    float get(int x, int y) const
+    {
+        if (x < 0 || y < 0 || x >= w || y >= h)
+            return 0.0f;
+        return v[(size_t)y * w + x];
+    }
+};
+
+// separable box blur, radius r, edges read as 0 (a running sum, so the cost does not grow with r)
+inline Plane boxBlur(const Plane& in, int r)
+{
+    Plane tmp(in.w, in.h), out(in.w, in.h);
+    const float inv = 1.0f / (2 * r + 1);
+    for (int y = 0; y < in.h; ++y) {
+        const float* row = &in.v[(size_t)y * in.w];
+        float* dst = &tmp.v[(size_t)y * in.w];
+        float s = 0;
+        for (int k = 0; k <= r && k < in.w; ++k)
+            s += row[k];
+        for (int x = 0; x < in.w; ++x) {
+            dst[x] = s * inv;
+            if (x + r + 1 < in.w)
+                s += row[x + r + 1];
+            if (x - r >= 0)
+                s -= row[x - r];
+        }
+    }
+    for (int x = 0; x < in.w; ++x) {
+        float s = 0;
+        for (int k = 0; k <= r && k < in.h; ++k)
+            s += tmp.v[(size_t)k * in.w + x];
+        for (int y = 0; y < in.h; ++y) {
+            out.v[(size_t)y * in.w + x] = s * inv;
+            if (y + r + 1 < in.h)
+                s += tmp.v[(size_t)(y + r + 1) * in.w + x];
+            if (y - r >= 0)
+                s -= tmp.v[(size_t)(y - r) * in.w + x];
+        }
+    }
+    return out;
+}
+
+// [1 2 1] / 4 on both axes: a soft edge for the shadow (the outermost ring stays 0: the planes carry kPad px of margin)
+inline Plane softEdge(const Plane& in)
+{
+    Plane tmp(in.w, in.h), out(in.w, in.h);
+    for (int y = 0; y < in.h; ++y) {
+        const float* r = &in.v[(size_t)y * in.w];
+        float* d = &tmp.v[(size_t)y * in.w];
+        for (int x = 1; x < in.w - 1; ++x)
+            d[x] = 0.25f * r[x - 1] + 0.5f * r[x] + 0.25f * r[x + 1];
+    }
+    for (int y = 1; y < in.h - 1; ++y) {
+        const float* up = &tmp.v[(size_t)(y - 1) * in.w];
+        const float* mid = &tmp.v[(size_t)y * in.w];
+        const float* dn = &tmp.v[(size_t)(y + 1) * in.w];
+        float* d = &out.v[(size_t)y * in.w];
+        for (int x = 0; x < in.w; ++x)
+            d[x] = 0.25f * up[x] + 0.5f * mid[x] + 0.25f * dn[x];
+    }
+    return out;
+}
+
+} // namespace detail
+
+constexpr int kMaskPx = kFullPx + 2 * kPad;
+
+struct ComposeStats {
+    int ground = 0, flat = 0, solid = 0, tall = 0, water = 0, lava = 0;
+};
+
+// grid: kGrid x kGrid tiles, the block's tile (0, 0) at grid[kMargin * kGrid + kMargin]; out: kFullPx x kFullPx RGBA
+inline ComposeStats composeBlock(const Atlas& atlas, const GridTile* grid, uint8_t* out)
+{
+    using namespace detail;
+    ComposeStats st;
+    std::memset(out, 0, (size_t)kFullPx * kFullPx * 4);
+
+    // 1. flat colour square, ground, border, decoration (borders and decorations alpha over)
+    for (int ty = 0; ty < kBlockTiles; ++ty) {
+        for (int tx = 0; tx < kBlockTiles; ++tx) {
+            const GridTile& t = gridAt(grid, tx, ty);
+            if (!t.seen)
+                continue;
+            uint8_t r = 24, g = 24, b = 24;
+            if (t.color != 255)
+                cubeColor(t.color, r, g, b);
+            for (int y = 0; y < kCellPx; ++y) {
+                uint8_t* p = &out[((size_t)(ty * kCellPx + y) * kFullPx + tx * kCellPx) * 4];
+                for (int x = 0; x < kCellPx; ++x, p += 4) {
+                    p[0] = r;
+                    p[1] = g;
+                    p[2] = b;
+                    p[3] = 255;
+                }
+            }
+            if (!atlas.find(t.r.ground))
+                ++st.flat;
+        }
+    }
+    for (int ty = -kMargin; ty < kBlockTiles + kMargin; ++ty) {
+        for (int tx = -kMargin; tx < kBlockTiles + kMargin; ++tx) {
+            const GridTile& t = gridAt(grid, tx, ty);
+            if (!t.seen)
+                continue;
+            if (const Swatch* s = atlas.find(t.r.ground)) {
+                blit(atlas, *s, grid, tx, ty, false, out);
+                ++st.ground;
+            }
+            if (const Swatch* s = atlas.find(t.r.border))
+                blit(atlas, *s, grid, tx, ty, false, out);
+            if (const Swatch* s = atlas.find(t.r.decor))
+                blit(atlas, *s, grid, tx, ty, false, out);
+        }
+    }
+    // 2. solids on top, with the alpha boost
+    for (int ty = -kMargin; ty < kBlockTiles + kMargin; ++ty) {
+        for (int tx = -kMargin; tx < kBlockTiles + kMargin; ++tx) {
+            const GridTile& t = gridAt(grid, tx, ty);
+            if (!t.seen)
+                continue;
+            if (const Swatch* s = atlas.find(t.r.solid)) {
+                blit(atlas, *s, grid, tx, ty, true, out);
+                ++st.solid;
+            }
+        }
+    }
+
+    // 3. masks at pixel level (bit 1 tall, 2 water, 4 lava), kPad px of margin round the block
+    std::vector<uint8_t> mk((size_t)kMaskPx * kMaskPx, 0);
+    bool anyTall = false, anyWater = false, anyLava = false;
+    for (int ty = -kMargin; ty < kBlockTiles + kMargin; ++ty) {
+        for (int tx = -kMargin; tx < kBlockTiles + kMargin; ++tx) {
+            const GridTile& t = gridAt(grid, tx, ty);
+            if (!t.seen)
+                continue;
+            bool isTall = (atlas.flagsOf(t.r.solid) & FlagTall) != 0;
+            uint8_t gf = atlas.flagsOf(t.r.ground);
+            bool isWater = (gf & FlagWater) != 0, isLava = (gf & FlagLava) != 0;
+            if (!isTall && !isWater && !isLava)
+                continue;
+            anyTall |= isTall;
+            anyWater |= isWater;
+            anyLava |= isLava;
+            uint8_t bits = (uint8_t)((isTall ? 1 : 0) | (isWater ? 2 : 0) | (isLava ? 4 : 0));
+            for (int y = 0; y < kCellPx; ++y) {
+                int py = ty * kCellPx + y + kPad;
+                if (py < 0 || py >= kMaskPx)
+                    continue;
+                for (int x = 0; x < kCellPx; ++x) {
+                    int px = tx * kCellPx + x + kPad;
+                    if (px >= 0 && px < kMaskPx)
+                        mk[(size_t)py * kMaskPx + px] = bits;
+                }
+            }
+            if (ty >= 0 && tx >= 0 && ty < kBlockTiles && tx < kBlockTiles) {
+                st.tall += isTall;
+                st.water += isWater;
+                st.lava += isLava;
+            }
+        }
+    }
+
+    // soft passes at half resolution (4 px per tile, 2 px of mask margin per side kept): shadow, contact shadow, lava glow
+    constexpr int kHalf = kMaskPx / 2;
+    Plane shade, ao, glow;
+    if (anyTall || anyLava) {
+        Plane t2(kHalf, kHalf), l2(kHalf, kHalf);
+        for (int y = 0; y < kHalf; ++y) {
+            const uint8_t* r0 = &mk[(size_t)(2 * y) * kMaskPx];
+            const uint8_t* r1 = r0 + kMaskPx;
+            for (int x = 0; x < kHalf; ++x) {
+                t2.v[(size_t)y * kHalf + x] = 0.25f * ((r0[2 * x] & 1) + (r0[2 * x + 1] & 1) + (r1[2 * x] & 1) + (r1[2 * x + 1] & 1));
+                l2.v[(size_t)y * kHalf + x] = 0.25f * (((r0[2 * x] >> 2) & 1) + ((r0[2 * x + 1] >> 2) & 1) + ((r1[2 * x] >> 2) & 1) + ((r1[2 * x + 1] >> 2) & 1));
+            }
+        }
+        if (anyTall) {
+            Plane sh(kHalf, kHalf);
+            for (int y = 1; y < kHalf; ++y) {
+                const float* cur = &t2.v[(size_t)y * kHalf];
+                const float* up = &t2.v[(size_t)(y - 1) * kHalf];
+                float* dst = &sh.v[(size_t)y * kHalf];
+                for (int x = 1; x < kHalf; ++x)
+                    dst[x] = cur[x] > 0.5f ? 0.0f : std::max(up[x - 1], 0.55f * cur[x - 1]);
+            }
+            shade = softEdge(sh);
+            ao = boxBlur(t2, 2);
+            for (size_t i = 0; i < ao.v.size(); ++i)
+                if (t2.v[i] > 0.5f)
+                    ao.v[i] = 0.0f;
+        }
+        if (anyLava) {
+            glow = boxBlur(boxBlur(l2, 2), 1);
+            for (size_t i = 0; i < glow.v.size(); ++i)
+                if (l2.v[i] > 0.5f)
+                    glow.v[i] = 0.0f;
+        }
+    }
+
+    // 4. shading per pixel of explored tiles
+    for (int y = 0; y < kFullPx; ++y) {
+        const int my = y + kPad;
+        const uint8_t* m0 = &mk[(size_t)(my - 1) * kMaskPx + kPad];
+        const uint8_t* m1 = &mk[(size_t)my * kMaskPx + kPad];
+        const uint8_t* m2 = &mk[(size_t)(my + 1) * kMaskPx + kPad];
+        for (int x = 0; x < kFullPx; ++x) {
+            uint8_t* p = &out[((size_t)y * kFullPx + x) * 4];
+            if (!p[3])
+                continue;
+            const int hx = (x + kPad) / 2, hy = my / 2;
+            float c[3] = {(float)p[0], (float)p[1], (float)p[2]};
+            if (anyTall) {
+                float m;
+                if (m1[x] & 1) {
+                    m = 1.0f;
+                    if (!(m0[x - 1] & 1))
+                        m *= 1.16f;                     // north west rim
+                    if (!(m2[x + 1] & 1))
+                        m *= 0.80f;                     // south east edge
+                    if ((m1[x - 1] & 1) + (m1[x + 1] & 1) + (m0[x] & 1) + (m2[x] & 1) < 4)
+                        m *= 0.94f;                     // a thin dark line where rock meets open ground
+                } else {
+                    m = (1.0f - 0.52f * shade.v[(size_t)hy * kHalf + hx]) * (1.0f - 0.20f * ao.v[(size_t)hy * kHalf + hx]);
+                }
+                for (int i = 0; i < 3; ++i)
+                    c[i] *= m;
+            }
+            if (anyWater && (m1[x] & 2)) {
+                static const float tint[3] = {24, 84, 170};
+                for (int i = 0; i < 3; ++i)
+                    c[i] = c[i] * 0.82f + tint[i] * 0.18f;
+                p[3] = kWaterAlpha;
+            } else if (anyLava && (m1[x] & 4)) {
+                static const float tint[3] = {255, 110, 20};
+                for (int i = 0; i < 3; ++i)
+                    c[i] = c[i] * 0.70f + tint[i] * 0.30f;
+                p[3] = kLavaAlpha;
+            } else if (anyLava) {
+                float g = glow.v[(size_t)hy * kHalf + hx];
+                c[0] += 70.0f * g;
+                c[1] += 25.0f * g;
+            }
+            float grey = (c[0] + c[1] + c[2]) / 3.0f;
+            for (int i = 0; i < 3; ++i) {
+                float v = grey + (c[i] - grey) * 1.10f;
+                p[i] = (uint8_t)std::min(255.0f, std::max(0.0f, v + 0.5f));
+            }
+        }
+    }
+    return st;
+}
+
+// reduce a composed block to dstPx x dstPx (dstPx 2, 4 or 8 per tile times 64): box average, colour weighted by alpha
+inline void downscale(const uint8_t* src, int dstPx, uint8_t* dst)
+{
+    int f = kFullPx / dstPx;
+    for (int y = 0; y < dstPx; ++y) {
+        for (int x = 0; x < dstPx; ++x) {
+            float sr = 0, sg = 0, sb = 0, sa = 0;
+            for (int j = 0; j < f; ++j) {
+                for (int i = 0; i < f; ++i) {
+                    const uint8_t* p = &src[((size_t)(y * f + j) * kFullPx + (x * f + i)) * 4];
+                    float a = p[3];
+                    sr += p[0] * a;
+                    sg += p[1] * a;
+                    sb += p[2] * a;
+                    sa += a;
+                }
+            }
+            uint8_t* o = &dst[((size_t)y * dstPx + x) * 4];
+            if (sa <= 0) {
+                o[0] = o[1] = o[2] = o[3] = 0;
+                continue;
+            }
+            o[0] = (uint8_t)std::lround(sr / sa);
+            o[1] = (uint8_t)std::lround(sg / sa);
+            o[2] = (uint8_t)std::lround(sb / sa);
+            o[3] = (uint8_t)std::lround(sa / (f * f));
+        }
+    }
+}
+
+// ---------------------------------------------------------------- small rules the engine file asks
+// the texel density of a block picture for a zoom: 2 px per tile up to scale 3, 4 up to 7, else 8 (0 = draw the flat map)
+inline int lodFor(float scale, float minScale)
+{
+    if (scale + 0.001f < minScale || scale < 2.0f)
+        return 0;
+    if (scale < 4.0f)
+        return 2;
+    if (scale < 8.0f)
+        return 4;
+    return 8;
+}
+
+// the sub tile shift of the camera while the player walks: the walk offset in sprite pixels (0 at rest, towards the old tile
+// while walking) over the sprite size; the camera follows the sprite, not the tile
+inline float subTile(int walkOffsetPx, int spriteSize)
+{
+    if (spriteSize <= 0)
+        return 0.0f;
+    float v = (float)walkOffsetPx / (float)spriteSize;
+    return std::max(-1.0f, std::min(1.0f, v));
+}
+
+// the least recently used picture goes first; a picture used this frame stays. Returns indexes into stamps to drop so that at
+// most `limit` pictures are kept (stamps: the frame each picture was last drawn, 0 for none)
+inline std::vector<size_t> evictOldest(const std::vector<uint64_t>& stamps, uint64_t frame, size_t limit)
+{
+    std::vector<size_t> held;
+    for (size_t i = 0; i < stamps.size(); ++i)
+        if (stamps[i] != 0)
+            held.push_back(i);
+    std::vector<size_t> drop;
+    if (held.size() <= limit)
+        return drop;
+    std::sort(held.begin(), held.end(), [&](size_t a, size_t b) { return stamps[a] != stamps[b] ? stamps[a] < stamps[b] : a < b; });
+    size_t over = held.size() - limit;
+    for (size_t i = 0; i < held.size() && drop.size() < over; ++i)
+        if (stamps[held[i]] != frame)
+            drop.push_back(held[i]);
+    return drop;
+}
+
+// the old minimap file (version 1) stores 3 bytes a tile (flags, colour, speed), the new one 11 (and the 4 ids); expand a v1
+// block so it loads as flat colour squares without a recipe
+constexpr int kTileBytesV1 = 3;
+constexpr int kTileBytesV2 = 11;
+inline void expandV1Block(const uint8_t* v1, uint8_t* v2)
+{
+    for (int i = 0; i < kBlockTiles * kBlockTiles; ++i) {
+        std::memcpy(v2 + (size_t)i * kTileBytesV2, v1 + (size_t)i * kTileBytesV1, kTileBytesV1);
+        std::memset(v2 + (size_t)i * kTileBytesV2 + kTileBytesV1, 0, kTileBytesV2 - kTileBytesV1);
+    }
+}
+
+// the liquid shimmer of the shader, written here so the test can hold the shader's decoding to it: alpha code -> (water, lava)
+// weights, 0..1 each. Plain tiles (alpha 255) give 0, 0; the edge to an unexplored tile (alpha below 0.9) gives 0, 0.
+inline void liquidWeights(float alpha, float& water, float& lava)
+{
+    float d = 1.0f - alpha;
+    water = lava = 0.0f;
+    if (alpha < 0.88f)
+        return;
+    float lv = std::min(1.0f, std::max(0.0f, (d - 0.04f) / 0.04f));
+    float wt = std::min(1.0f, std::max(0.0f, d / 0.04f));
+    lava = lv;
+    water = wt * (1.0f - lv);
+}
