+-- Chaos (base patch 0045): the owned outfit shaders of the server's list, worn through the Shader row. The logic is
+-- OutfitShaderList of the overlay module game_chaosshaders (tested there); without it the row stays hidden.
+local function shaderLogic()
+  local m = modules.game_chaosshaders
+  return m and m.OutfitShaderList or nil
+end
+
+local function useShaderRow()
+  return shaderLogic() ~= nil and g_game.getFeature(GameOutfitShaders) and not g_game.getFeature(GamePlayerFamiliars)
+end
