--- a/src/client/chaosmissile.h
+++ b/src/client/chaosmissile.h
@@ -0,0 +1,106 @@
+// Cinders of Chaos (base patch 0147): trail and arc of missiles, pure and header-only so client/tools/chaosmissile_test.cpp
+// can run it without the engine. A missile is drawn at a path fraction f (0 at the shooter, 1 at the target). With the
+// option on it gets a short fading trail (the same frame again at f - k * kTrailStep with a falling opacity) and, when its
+// id is in the arc list (arrows, bolts, spears, stones: the list comes from Lua), a slight arc: a lift of 4 * h * f * (1 - f)
+// pixels, h growing with the distance up to a cap. Nothing is kept per missile.
+#ifndef CHAOSMISSILE_H
+#define CHAOSMISSILE_H
+
+#include <algorithm>
+#include <bitset>
+#include <cstddef>
+#include <cstdint>
+
+namespace chaos {
+namespace missile {
+
+constexpr int kMaxTrail = 4;           // most extra draws per missile
+constexpr int kTrailCount = 3;         // as shipped
+constexpr float kTrailStep = 0.05f;    // path fraction between two trail copies
+constexpr float kMinTiles = 2.0f;      // a shorter shot gets no trail and no arc
+constexpr float kArcPerTile = 1.6f;    // h in pixels (of a 32 px sprite) per tile of distance
+constexpr float kArcMax = 14.0f;       // cap of h; the lift at the top of the arc is h
+
+// opacity of the k-th trail copy (k = 1 is the one right behind the missile): falls with k, always inside (0, 1)
+inline float trailOpacity(int k)
+{
+    static const float table[kMaxTrail] = { 0.50f, 0.32f, 0.18f, 0.08f };
+    if (k < 1)
+        return table[0];
+    if (k > kMaxTrail)
+        return table[kMaxTrail - 1];
+    return table[k - 1];
+}
+
+inline float clampFraction(float f)
+{
+    if (!(f > 0.0f)) // also NaN
+        return 0.0f;
+    return f > 1.0f ? 1.0f : f;
+}
+
+// fraction of the k-th trail copy; negative when it would lie before the start of the path (not drawn)
+inline float trailFraction(float f, int k)
+{
+    return clampFraction(f) - static_cast<float>(k) * kTrailStep;
+}
+
+// how many trail copies are drawn at fraction f: copies before the start of the path are left out, so a missile that just
+// left the shooter has none
+inline int trailCount(float f)
+{
+    int n = 0;
+    for (int k = 1; k <= kTrailCount && k <= kMaxTrail; ++k) {
+        if (trailFraction(f, k) >= 0.0f)
+            ++n;
+    }
+    return n;
+}
+
+// trail and arc only for a shot of at least kMinTiles tiles (path length in tiles, a finite number)
+inline bool wantsEffect(float tiles)
+{
+    return tiles >= kMinTiles;
+}
+
+// the height of the arc in pixels of a 32 px sprite (scale it by the sprite size / 32): 0 for a missile that is not in the
+// arc list, otherwise grows with the distance and stops at kArcMax
+inline float arcHeight(float tiles, bool arcs)
+{
+    if (!arcs || !(tiles > 0.0f))
+        return 0.0f;
+    return std::min(kArcMax, tiles * kArcPerTile);
+}
+
+// the lift (pixels upward, to subtract from y) at fraction f of an arc of height h: 0 at both ends, h in the middle
+inline float arcLift(float f, float h)
+{
+    const float x = clampFraction(f);
+    return 4.0f * h * x * (1.0f - x);
+}
+
+// the set of missile ids that arc, filled from Lua (game_visualfx sends the list, one call per id, like the spell light table)
+class IdSet
+{
+public:
+    void clear() { m_bits.reset(); }
+    void add(int id)
+    {
+        if (id > 0 && id < static_cast<int>(kIds))
+            m_bits.set(static_cast<size_t>(id));
+    }
+    bool contains(int id) const
+    {
+        return id > 0 && id < static_cast<int>(kIds) && m_bits.test(static_cast<size_t>(id));
+    }
+    size_t size() const { return m_bits.count(); }
+
+private:
+    static constexpr size_t kIds = 65536;
+    std::bitset<kIds> m_bits;
+};
+
+} // namespace missile
+} // namespace chaos
+
+#endif
