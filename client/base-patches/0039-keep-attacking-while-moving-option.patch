     size: 505 44
     anchors.top: prev.bottom
--- a/modules/game_inventory/inventory.lua
+++ b/modules/game_inventory/inventory.lua
@@ -636,6 +636,11 @@
 end
 
 function check()
+  -- Keep attacking while moving (overlay module game_kitewalk, server src-patch 0028): the server lets a walk by click
+  -- or key win over the chase and resumes the chase when it ends, so the stance stays Chase Opponent
+  if m_settings.getOption('keepAttackingWhileMoving') ~= false then
+    return
+  end
   if m_settings.getOption('autoChaseOverride') then
     if g_game.isAttacking() and g_game.getChaseMode() == ChaseOpponent then
       g_game.doThing(false)
