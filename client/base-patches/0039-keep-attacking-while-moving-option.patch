# Keep attacking while moving (client/MANIFEST.md "game_kitewalk", server/README.md "Keep attacking while moving"): one option in Options > Interface, "Keep attacking while moving" (keepAttackingWhileMoving), on by default, in a new panel after "Right-click equips items". Its apply hands the new value to the overlay module game_kitewalk, which tells the server (extended opcode 186; server src-patch 0028 lets a walk by click or key win over the chase and keep the attacks going). While it is on, the base "Auto Chase Off" (game_inventory check(), on by default) no longer switches the stance to Don't Chase on every manual walk while attacking: the server resumes the chase when the walk ends. The Auto Chase Off tooltip says so. Without this patch the option counts as on on the server, and Auto Chase Off still flips the stance.
--- a/mods/client_settings/classes/dataset.lua
+++ b/mods/client_settings/classes/dataset.lua
@@ -1919,6 +1919,19 @@ return {
 		end,
 	},
 
+	-- keep attacking while moving (overlay module game_kitewalk, server src-patch 0028): a walk by click or key keeps
+	-- the attack target and the attacks going and wins over the chase; the module tells the server when this changes
+	keepAttackingWhileMoving = {
+		value = true,
+		apply = function(value)
+			local m = modules.game_kitewalk
+			if m and m.onOptionChange then
+				m.onOptionChange(value)
+			end
+			return true
+		end,
+	},
+
 	enableLights = {
 		value = true,
         apply = function(value)
