+// Chaos: numbers above the map are shortened, 1000 -> 1k, 15300 -> 15.3k, 2450000 -> 2.45M, 1200000000 -> 1.2B
+// (three significant digits, trailing zeros dropped; below 1000 the number is shown as it is)
+static std::string chaosShortNumber(uint64_t value)
+{
+    static const char* units[] = { "", "k", "M", "B", "T" };
+    if (value < 1000)
+        return std::to_string(value);
+    uint64_t div = 1;
+    int unit = 0;
+    while (value / div >= 1000 && unit < 4) {
+        div *= 1000;
+        ++unit;
+    }
+    // integer maths only: floating point turns 1150 into "1.14k"
+    const uint64_t whole = value / div;
+    const int decimals = whole >= 100 ? 0 : (whole >= 10 ? 1 : 2);
+    std::string text = std::to_string(whole);
+    if (decimals > 0) {
+        const uint64_t step = div / (decimals == 2 ? 100 : 10);
+        std::string frac = std::to_string((value % div) / step);
+        frac.insert(0, decimals - frac.size(), '0');
+        while (!frac.empty() && frac.back() == '0')
+            frac.pop_back();
+        if (!frac.empty())
+            text += "." + frac;
+    }
+    return text + units[unit];
+}
