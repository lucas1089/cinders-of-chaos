+// Chaos: numbers above the map are shortened, 1000 -> 1k, 15300 -> 15.3k, 2450000 -> 2.45M, 1200000000 -> 1.2B
+// (three significant digits, trailing zeros dropped; below 1000 the number is shown as it is)
+static std::string chaosShortNumber(uint64_t value)
+{
+    static const char* units[] = { "", "k", "M", "B", "T" };
+    if (value < 1000)
+        return std::to_string(value);
+    double v = static_cast<double>(value);
+    int unit = 0;
+    while (v >= 1000.0 && unit < 4) {
+        v /= 1000.0;
+        ++unit;
+    }
+    const int decimals = v >= 100.0 ? 0 : (v >= 10.0 ? 1 : 2);
+    double factor = decimals == 2 ? 100.0 : (decimals == 1 ? 10.0 : 1.0);
+    v = std::floor(v * factor) / factor; // floor: 999999 is 999k, not 1000k
+    char buffer[32];
+    snprintf(buffer, sizeof(buffer), "%.*f", decimals, v);
+    std::string text = buffer;
+    if (text.find('.') != std::string::npos) {
+        while (!text.empty() && text.back() == '0')
+            text.pop_back();
+        if (!text.empty() && text.back() == '.')
+            text.pop_back();
+    }
+    return text + units[unit];
+}
