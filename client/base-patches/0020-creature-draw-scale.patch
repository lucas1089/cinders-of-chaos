+void DrawQueueConditionScale::start(DrawQueue*)
+{
+    g_painter->pushTransformMatrix();
+    g_painter->translate(-m_center.x, -m_center.y);
+    g_painter->scale(m_factor);
+    g_painter->translate(m_center.x, m_center.y);
+}
+
+void DrawQueueConditionScale::end(DrawQueue*)
+{
+    g_painter->popTransformMatrix();
+}
