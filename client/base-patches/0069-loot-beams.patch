+// Chaos (base patch 0069): loot beams (lootbeam.h has the maths). The two textures are made once from the profiles
+// (white, alpha = value: premultiplied for the additive blend) and uploaded on first use.
+namespace
+{
+TexturePtr makeLootBeamTexture(int w, int h, float (*profile)(float, float))
+{
+    ImagePtr image = std::make_shared<Image>(Size(w, h));
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const float v = profile((x + 0.5f) / w, (y + 0.5f) / h);
+            const uint8 c = (uint8)std::lround(lootbeam::clamp01(v) * 255.f);
+            image->setPixel(x, y, Color(c, c, c, c));
+        }
+    }
+    return std::make_shared<Texture>(image, false, false, true);
+}
+
+const TexturePtr& lootBeamTexture(int which)
+{
+    static TexturePtr column, pool;
+    if (which == lootbeam::TexColumn) {
+        if (!column)
+            column = makeLootBeamTexture(lootbeam::ColumnWidth, lootbeam::ColumnHeight, &lootbeam::column);
+        return column;
+    }
+    if (!pool)
+        pool = makeLootBeamTexture(lootbeam::PoolSize, lootbeam::PoolSize, &lootbeam::pool);
+    return pool;
+}
+
+// the quads of one or more beams, drawn added onto what is under them (ONE, ONE); the colour's alpha is 0, so the
+// framebuffer's alpha is left alone
+struct DrawQueueItemLootBeams : public DrawQueueItem {
+    DrawQueueItemLootBeams() : DrawQueueItem(nullptr) {}
+    bool cache() override { return false; }
+    void draw() override
+    {
+        if (m_quads.empty())
+            return;
+        g_painter->setCompositionMode(Painter::CompositionMode_Add);
+        for (const lootbeam::Quad& q : m_quads) {
+            const TexturePtr& texture = lootBeamTexture(q.tex);
+            if (!texture)
+                continue;
+            CoordsBuffer coords;
+            coords.addRect(RectF(q.x, q.y, q.w, q.h), RectF(0.f, 0.f, (float)texture->getWidth(), (float)texture->getHeight()));
+            const float k = m_color.aF(); // the floor fading (DrawQueue::setOpacity) dims the light it adds
+            g_painter->setColor(Color(lootbeam::clamp01(q.r * k), lootbeam::clamp01(q.g * k), lootbeam::clamp01(q.b * k), 0.f));
+            g_painter->drawTextureCoords(coords, texture);
+        }
+        g_painter->resetCompositionMode();
+        g_painter->resetColor();
+    }
+    std::vector<lootbeam::Quad> m_quads;
+};
+
+lootbeam::Rgb lootBeamRgb(const Color& color)
+{
+    return { color.rF(), color.gF(), color.bF() };
+}
+
+uint32_t lootBeamSeed(const Position& pos)
+{
+    return (uint32_t)pos.x * 73856093u ^ (uint32_t)pos.y * 19349663u ^ (uint32_t)pos.z * 83492791u;
+}
+}
