index 0000000..20b7b56
--- /dev/null
+++ b/src/client/lootbeam.h
@@ -0,0 +1,147 @@
+/*
+ * Chaos (base patch 0069): loot beams. A thin light pillar over a corpse or an item tile, with a soft glow pool on
+ * the ground at its base, drawn by MapView with additive blending (no sprites: the two textures are made here from
+ * the profiles below). The overlay module game_lootbeams says where and in which colour (g_map.setLootBeam).
+ *
+ * This header is the maths only (no engine types), so the mock renderer of client/BASE.md draws the same picture:
+ *   column(u, v)  the pillar texture: a gaussian across, bright at the base and fading to the top
+ *   pool(u, v)    the ground glow texture: a soft radial spot (drawn squashed into an ellipse)
+ *   pillar(...)   the quads of a pillar: a wide tinted halo, a narrow near-white core and a glint rising inside it
+ *   groundPool(...) the quads of the glow pool: a wide tinted ellipse and a small bright one
+ * Every colour is premultiplied (the textures are white with alpha = value; blending is ONE, ONE), so a quad's
+ * r, g, b are what it adds at full texture value.
+ */
+#ifndef CHAOS_LOOTBEAM_H
+#define CHAOS_LOOTBEAM_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace lootbeam {
+
+constexpr int MaxBeams = 64;          // the engine draws at most this many (the overlay module caps lower)
+constexpr int ColumnWidth = 32;       // pillar texture size
+constexpr int ColumnHeight = 128;
+constexpr int PoolSize = 64;          // pool texture size
+constexpr float PulsePeriodMs = 1900.f;
+constexpr float GlintPeriodMs = 1700.f;
+constexpr float Pi = 3.14159265f;
+
+enum Texture { TexColumn = 0, TexPool = 1 };
+
+struct Rgb {
+    float r, g, b;
+};
+
+// x, y = top-left, w, h in pixels; r, g, b premultiplied (0..1, may exceed 1 before the framebuffer clamps)
+struct Quad {
+    float x, y, w, h;
+    float r, g, b;
+    int tex;
+};
+
+inline float clamp01(float x) { return std::min(1.f, std::max(0.f, x)); }
+
+inline float smoothstep(float a, float b, float x)
+{
+    const float t = clamp01((x - a) / (b - a));
+    return t * t * (3.f - 2.f * t);
+}
+
+inline Rgb mix(const Rgb& a, const Rgb& b, float t)
+{
+    return { a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t };
+}
+
+inline Rgb scale(const Rgb& c, float k) { return { c.r * k, c.g * k, c.b * k }; }
+
+// u: 0..1 across, v: 0 at the top .. 1 at the base
+inline float column(float u, float v)
+{
+    const float d = (u - 0.5f) * 2.f;                    // -1 .. 1
+    const float across = std::exp(-d * d * 5.f) * (1.f - smoothstep(0.8f, 1.f, std::fabs(d)));
+    const float up = std::pow(clamp01(v), 1.4f);         // brightest at the ground
+    const float tip = smoothstep(0.f, 0.2f, v);          // soft top end
+    const float foot = 1.f - 0.3f * smoothstep(0.94f, 1.f, v); // meets the pool without a hard edge
+    return clamp01(across * up * tip * foot);
+}
+
+inline float pool(float u, float v)
+{
+    const float dx = (u - 0.5f) * 2.f, dy = (v - 0.5f) * 2.f;
+    const float r = std::sqrt(dx * dx + dy * dy);
+    return clamp01(std::exp(-r * r * 3.f) * (1.f - smoothstep(0.75f, 1.f, r)));
+}
+
+// a per-beam phase 0..1 from its seed (the tile position), so neighbouring beams do not pulse in step
+inline float phaseOf(uint32_t seed, uint32_t salt)
+{
+    uint32_t h = seed * 2654435761u + salt * 40503u;
+    h ^= h >> 15;
+    h *= 2246822519u;
+    h ^= h >> 13;
+    return (h & 0xffffu) / 65536.f;
+}
+
+// gentle breathing, 0.8 .. 1
+inline float pulse(int64_t ms, uint32_t seed)
+{
+    const float t = (float)(ms % 1000000) / PulsePeriodMs + phaseOf(seed, 1);
+    return 0.9f + 0.1f * std::sin(2.f * Pi * t);
+}
+
+// cx = the tile's centre, baseY = where the pillar stands, s = one tile in pixels, heightTiles = pillar height in
+// tiles, intensity 0..1. Writes up to 3 quads (halo, core, glint) and returns how many.
+inline int pillar(float cx, float baseY, float s, float heightTiles, float intensity, const Rgb& c, uint32_t seed,
+                  int64_t ms, Quad* out)
+{
+    const float h = std::max(0.5f, heightTiles) * s;
+    const float p = pulse(ms, seed);
+    const float k = clamp01(intensity) * p;
+    const Rgb white = { 1.f, 1.f, 1.f };
+    int n = 0;
+    const Rgb halo = scale(c, 0.6f * k);
+    const float hw = 1.0f * s;
+    out[n++] = { cx - hw / 2.f, baseY - h, hw, h, halo.r, halo.g, halo.b, TexColumn };
+    const Rgb core = scale(mix(c, white, 0.6f), 0.95f * k);
+    const float cw = 0.16f * s;
+    out[n++] = { cx - cw / 2.f, baseY - h * 0.97f, cw, h * 0.97f, core.r, core.g, core.b, TexColumn };
+    // a glint rising inside the pillar, fading in and out
+    const float g = std::fmod((float)(ms % 1000000) / GlintPeriodMs + phaseOf(seed, 2), 1.f);
+    const float ga = std::sin(Pi * g) * 0.6f * clamp01(intensity);
+    if (ga > 0.01f) {
+        const Rgb gc = scale(mix(c, white, 0.5f), ga);
+        const float gw = 0.24f * s, gh = 0.5f * s;
+        const float gy = baseY - 0.2f * s - g * h * 0.8f;
+        out[n++] = { cx - gw / 2.f, gy - gh / 2.f, gw, gh, gc.r, gc.g, gc.b, TexPool };
+    }
+    return n;
+}
+
+// the glow pool on the ground, centred on (cx, baseY). Writes 2 quads.
+inline int groundPool(float cx, float baseY, float s, float intensity, const Rgb& c, uint32_t seed, int64_t ms,
+                      Quad* out)
+{
+    const float p = pulse(ms, seed);
+    const float k = clamp01(intensity);
+    const Rgb white = { 1.f, 1.f, 1.f };
+    const Rgb outer = scale(c, 0.6f * k * (0.85f + 0.15f * p));
+    const float ow = 1.3f * s, oh = 0.62f * s;
+    out[0] = { cx - ow / 2.f, baseY - oh / 2.f, ow, oh, outer.r, outer.g, outer.b, TexPool };
+    const Rgb inner = scale(mix(c, white, 0.45f), 0.6f * k * p);
+    const float iw = 0.5f * s, ih = 0.22f * s;
+    out[1] = { cx - iw / 2.f, baseY - ih / 2.f, iw, ih, inner.r, inner.g, inner.b, TexPool };
+    return 2;
+}
+
+// where a beam stands in a tile whose top-left is (x, y): the centre, a little below the middle (a corpse lies there)
+inline void anchor(float x, float y, float s, float& cx, float& baseY)
+{
+    cx = x + s * 0.5f;
+    baseY = y + s * 0.6f;
+}
+
+} // namespace lootbeam
+
+#endif
