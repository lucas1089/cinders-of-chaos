+// Chaos (base patch 0069): loot beams. false when the position is invalid or the cap is reached (a new tile)
+bool Map::setLootBeam(const Position& pos, const Color& color, float height, float intensity)
+{
+    if (!pos.isValid())
+        return false;
+    auto it = m_lootBeams.find(pos);
+    if (it == m_lootBeams.end() && (int)m_lootBeams.size() >= lootbeam::MaxBeams)
+        return false;
+    LootBeam beam = { color, std::min(8.f, std::max(0.5f, height)), std::min(1.f, std::max(0.f, intensity)) };
+    m_lootBeams[pos] = beam;
+    return true;
+}
