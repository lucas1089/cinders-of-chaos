--- /dev/null
+++ b/src/client/chaoshdoverlay.h
@@ -0,0 +1,273 @@
+// Cinders of Chaos (base patch 0196): the HD sprite overlay. Pure and header-only so client/tools/chaoshdoverlay_test.cpp can
+// run it without the engine.
+// A parallel set of high resolution pictures keyed by sprite id: the 32 px sprites of the pair stay as they are, and the
+// overlay maps a sprite id to a square tile of an atlas PNG, 32 * scale px a side (scale 2 or 4). SpriteManager::getSpriteImage
+// returns that picture, resampled to the size one sprite has now (spriteSize), instead of the sprite or its xBRZ upscale, so
+// the thing is drawn in the same rectangle with finer detail.
+// Index file (UTF-8 text, one record a line, '#' starts a comment, written by client/tools/sprites/gen_hd_overlay.py):
+//   chaos-hd-overlay 1
+//   atlas <n> <file name next to the index>
+//   sprite <id> <atlas n> <x> <y> <scale> <crc32 of the 32x32 RGBA bytes of the pair's sprite, 8 hex digits, 00000000 = unchecked>
+//   slot <category> <thing id> <sprite index> <sprite id> <atlas n> <x> <y> <scale>
+// A `sprite` line is for a sprite id that only one picture of one thing uses. The crc (spriteCrc) keeps its tile from showing on a
+// sprite id that a later pair gave another picture. A `slot` line is for the places a sprite id cannot reach: a place with no
+// sprite (id 0: the pair's art leaves that tile empty), a sprite that other things draw too, and a sprite that a thing repeats
+// with another tile. It names the place itself: the thing (category 0 item, 1 creature, 2 effect, 3 missile; id as the dat
+// numbers it) and the index into its sprite list, and the sprite id the pair has there now (0 for none), so a pair that moves
+// things around hides the tile. A slot wins over a `sprite` line.
+#ifndef CHAOSHDOVERLAY_H
+#define CHAOSHDOVERLAY_H
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace chaos {
+namespace hdoverlay {
+
+constexpr int kBase = 32;        // a sprite of the pair
+constexpr int kMaxScale = 8;     // 32 * 8 = 256 px a tile, more is refused
+constexpr size_t kMaxSprites = 400000;
+constexpr size_t kMaxAtlases = 4096;
+
+struct Entry
+{
+    uint16_t atlas = 0;
+    uint16_t x = 0;
+    uint16_t y = 0;
+    uint8_t scale = 2;
+    uint32_t crc = 0;
+};
+
+inline uint64_t slotKey(unsigned category, unsigned thingId, unsigned index)
+{
+    return (static_cast<uint64_t>(category) << 40) | (static_cast<uint64_t>(thingId) << 20) | static_cast<uint64_t>(index);
+}
+
+struct Slot
+{
+    uint32_t sprite = 0;       // the sprite id the pair has at this place (0: none)
+    Entry tile;
+};
+
+struct Index
+{
+    std::vector<std::string> atlases;
+    std::unordered_map<uint32_t, Entry> sprites;
+    std::unordered_map<uint64_t, Slot> slots;
+    std::string error;
+    bool ok() const { return error.empty(); }
+};
+
+// CRC-32 (IEEE, the zlib one) of a byte run
+inline uint32_t crc32(const uint8_t* data, size_t size)
+{
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < size; ++i) {
+        crc ^= data[i];
+        for (int k = 0; k < 8; ++k)
+            crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+
+// the crc of a sprite of the pair: its 32x32 RGBA bytes with the colour of a transparent pixel taken as 0 (the pair and the
+// decoder need not agree on what lies under alpha 0)
+inline uint32_t spriteCrc(const uint8_t* rgba, size_t pixels)
+{
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < pixels; ++i) {
+        const uint8_t* p = rgba + i * 4;
+        const uint8_t px[4] = { static_cast<uint8_t>(p[3] ? p[0] : 0), static_cast<uint8_t>(p[3] ? p[1] : 0),
+                                static_cast<uint8_t>(p[3] ? p[2] : 0), p[3] };
+        for (int b = 0; b < 4; ++b) {
+            crc ^= px[b];
+            for (int k = 0; k < 8; ++k)
+                crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+        }
+    }
+    return ~crc;
+}
+
+inline bool validAtlasName(const std::string& name)
+{
+    if (name.empty() || name.size() > 120 || name[0] == '.')
+        return false;
+    for (char c : name) {
+        if (c == '/' || c == '\\' || c == ':' || static_cast<unsigned char>(c) < 32)
+            return false;
+    }
+    return true;
+}
+
+inline bool parseUnsigned(const std::string& s, unsigned long long maxValue, int base, unsigned long long& out)
+{
+    if (s.empty() || s.size() > 12)
+        return false;
+    char* end = nullptr;
+    out = std::strtoull(s.c_str(), &end, base);
+    return end && *end == 0 && out <= maxValue && s[0] != '-' && s[0] != '+';
+}
+
+// Reads the index text. Stops at the first bad line and says which in `error`; what was read before stays.
+inline Index parseIndex(const std::string& text)
+{
+    Index index;
+    std::istringstream in(text);
+    std::string line;
+    int lineNo = 0;
+    bool header = false;
+    auto fail = [&](const std::string& why) { index.error = "line " + std::to_string(lineNo) + ": " + why; };
+    while (std::getline(in, line)) {
+        ++lineNo;
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        if (line.empty() || line[0] == '#')
+            continue;
+        std::istringstream ls(line);
+        std::vector<std::string> w;
+        std::string t;
+        while (ls >> t)
+            w.push_back(t);
+        if (!header) {
+            if (w.size() != 2 || w[0] != "chaos-hd-overlay" || w[1] != "1") {
+                fail("not a chaos-hd-overlay 1 file");
+                return index;
+            }
+            header = true;
+        } else if (w[0] == "atlas") {
+            unsigned long long n;
+            if (w.size() != 3 || !parseUnsigned(w[1], kMaxAtlases, 10, n) || n != index.atlases.size() || !validAtlasName(w[2])) {
+                fail("bad atlas line");
+                return index;
+            }
+            index.atlases.push_back(w[2]);
+        } else if (w[0] == "sprite") {
+            unsigned long long id, atlas, x, y, scale, crc;
+            if (w.size() != 7 || !parseUnsigned(w[1], 0xFFFFFFFFull, 10, id) || id == 0 || !parseUnsigned(w[2], 65535, 10, atlas) ||
+                !parseUnsigned(w[3], 65535, 10, x) || !parseUnsigned(w[4], 65535, 10, y) || !parseUnsigned(w[5], kMaxScale, 10, scale) ||
+                scale < 1 || w[6].size() != 8 || !parseUnsigned(w[6], 0xFFFFFFFFull, 16, crc)) {
+                fail("bad sprite line");
+                return index;
+            }
+            if (atlas >= index.atlases.size()) {
+                fail("sprite names an atlas that is not declared");
+                return index;
+            }
+            if (index.sprites.size() >= kMaxSprites) {
+                fail("too many sprites");
+                return index;
+            }
+            Entry e;
+            e.atlas = static_cast<uint16_t>(atlas);
+            e.x = static_cast<uint16_t>(x);
+            e.y = static_cast<uint16_t>(y);
+            e.scale = static_cast<uint8_t>(scale);
+            e.crc = static_cast<uint32_t>(crc);
+            index.sprites[static_cast<uint32_t>(id)] = e;
+        } else if (w[0] == "slot") {
+            unsigned long long cat, thing, idx, sprite, atlas, x, y, scale;
+            if (w.size() != 9 || !parseUnsigned(w[1], 3, 10, cat) || !parseUnsigned(w[2], 65535, 10, thing) || thing == 0 ||
+                !parseUnsigned(w[3], 65535, 10, idx) || !parseUnsigned(w[4], 0xFFFFFFFFull, 10, sprite) ||
+                !parseUnsigned(w[5], 65535, 10, atlas) || !parseUnsigned(w[6], 65535, 10, x) || !parseUnsigned(w[7], 65535, 10, y) ||
+                !parseUnsigned(w[8], kMaxScale, 10, scale) || scale < 1) {
+                fail("bad slot line");
+                return index;
+            }
+            if (atlas >= index.atlases.size()) {
+                fail("slot names an atlas that is not declared");
+                return index;
+            }
+            if (index.slots.size() >= kMaxSprites) {
+                fail("too many slots");
+                return index;
+            }
+            Slot sl;
+            sl.sprite = static_cast<uint32_t>(sprite);
+            sl.tile.atlas = static_cast<uint16_t>(atlas);
+            sl.tile.x = static_cast<uint16_t>(x);
+            sl.tile.y = static_cast<uint16_t>(y);
+            sl.tile.scale = static_cast<uint8_t>(scale);
+            index.slots[slotKey(static_cast<unsigned>(cat), static_cast<unsigned>(thing), static_cast<unsigned>(idx))] = sl;
+        } else {
+            fail("unknown record '" + w[0] + "'");
+            return index;
+        }
+    }
+    if (!header)
+        index.error = "empty index";
+    return index;
+}
+
+// Copies the tile at (x, y), size px a side, out of an RGBA atlas. False when it does not lie inside the atlas.
+inline bool cropTile(const uint8_t* atlas, int atlasW, int atlasH, int x, int y, int size, std::vector<uint8_t>& out)
+{
+    if (!atlas || size <= 0 || x < 0 || y < 0 || x + size > atlasW || y + size > atlasH)
+        return false;
+    out.resize(static_cast<size_t>(size) * size * 4);
+    for (int row = 0; row < size; ++row)
+        std::memcpy(&out[static_cast<size_t>(row) * size * 4], atlas + (static_cast<size_t>(y + row) * atlasW + x) * 4, static_cast<size_t>(size) * 4);
+    return true;
+}
+
+// Resamples a square RGBA tile to dst x dst px. Same size: a copy. Smaller: the mean of the covered source area, colour
+// weighted by alpha (premultiplied), so an edge does not pick up the colour of the clear pixels. Larger: nearest, so the
+// pixel edges of the art stay hard.
+inline void resample(const uint8_t* src, int srcSize, std::vector<uint8_t>& dst, int dstSize)
+{
+    dst.assign(static_cast<size_t>(dstSize) * dstSize * 4, 0);
+    if (!src || srcSize <= 0 || dstSize <= 0)
+        return;
+    if (srcSize == dstSize) {
+        std::memcpy(dst.data(), src, dst.size());
+        return;
+    }
+    if (dstSize > srcSize) {
+        for (int y = 0; y < dstSize; ++y) {
+            const int sy = static_cast<int>(static_cast<int64_t>(y) * srcSize / dstSize);
+            for (int x = 0; x < dstSize; ++x) {
+                const int sx = static_cast<int>(static_cast<int64_t>(x) * srcSize / dstSize);
+                std::memcpy(&dst[(static_cast<size_t>(y) * dstSize + x) * 4], src + (static_cast<size_t>(sy) * srcSize + sx) * 4, 4);
+            }
+        }
+        return;
+    }
+    // area average with exact fractional weights: source pixel i covers [i, i+1) of srcSize, a target pixel [t * r, (t+1) * r)
+    const double ratio = static_cast<double>(srcSize) / dstSize;
+    for (int y = 0; y < dstSize; ++y) {
+        const double y0 = y * ratio, y1 = (y + 1) * ratio;
+        for (int x = 0; x < dstSize; ++x) {
+            const double x0 = x * ratio, x1 = (x + 1) * ratio;
+            double sumA = 0, sumR = 0, sumG = 0, sumB = 0, area = 0;
+            for (int sy = static_cast<int>(y0); sy < srcSize && sy < y1; ++sy) {
+                const double wy = (sy + 1 < y1 ? sy + 1 : y1) - (sy > y0 ? sy : y0);
+                for (int sx = static_cast<int>(x0); sx < srcSize && sx < x1; ++sx) {
+                    const double wx = (sx + 1 < x1 ? sx + 1 : x1) - (sx > x0 ? sx : x0);
+                    const double w = wx * wy;
+                    const uint8_t* p = src + (static_cast<size_t>(sy) * srcSize + sx) * 4;
+                    sumA += w * p[3];
+                    sumR += w * p[0] * p[3];
+                    sumG += w * p[1] * p[3];
+                    sumB += w * p[2] * p[3];
+                    area += w;
+                }
+            }
+            uint8_t* o = &dst[(static_cast<size_t>(y) * dstSize + x) * 4];
+            if (area <= 0 || sumA <= 0)
+                continue;
+            o[0] = static_cast<uint8_t>(sumR / sumA + 0.5);
+            o[1] = static_cast<uint8_t>(sumG / sumA + 0.5);
+            o[2] = static_cast<uint8_t>(sumB / sumA + 0.5);
+            o[3] = static_cast<uint8_t>(sumA / area + 0.5);
+        }
+    }
+}
+
+} // namespace hdoverlay
+} // namespace chaos
+
+#endif
