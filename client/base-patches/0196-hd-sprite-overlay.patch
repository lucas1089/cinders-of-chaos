+// Chaos (0196)
+int SpriteManager::loadHdOverlay(std::string dir)
+{
+    unloadHdOverlay();
+    while (dir.size() > 1 && dir.back() == '/')
+        dir.pop_back();
+    try {
+        const std::string file = dir + "/index.txt";
+        if (!g_resources.fileExists(file))
+            return 0;
+        m_hdIndex = chaos::hdoverlay::parseIndex(g_resources.readFileContents(file));
+    } catch (const std::exception& e) {
+        m_hdIndex = chaos::hdoverlay::Index();
+        m_hdIndex.error = e.what();
+    }
+    if (!m_hdIndex.ok()) {
+        g_logger.warning(stdext::format("HD overlay: %s/index.txt: %s", dir, m_hdIndex.error));
+        m_hdIndex = chaos::hdoverlay::Index();
+        return 0;
+    }
+    m_hdDir = dir;
+    m_hdAtlases.assign(m_hdIndex.atlases.size(), nullptr);
+    m_hdAtlasTried.assign(m_hdIndex.atlases.size(), false);
+    clearImageCache();
+    return static_cast<int>(m_hdIndex.sprites.size() + m_hdIndex.slots.size());
+}
+
+void SpriteManager::unloadHdOverlay()
+{
+    m_hdIndex = chaos::hdoverlay::Index();
+    m_hdAtlases.clear();
+    m_hdAtlasTried.clear();
+    m_hdDir.clear();
+    m_hdCrcWarned = false;
+    clearImageCache();
+}
+
+void SpriteManager::setHdOverlayEnabled(bool enabled)
+{
+    if (m_hdEnabled == enabled)
+        return;
+    m_hdEnabled = enabled;
+    clearImageCache();
+}
+
+ImagePtr SpriteManager::hdOverlayImage(int id, const ImagePtr& baseSprite)
+{
+    auto it = m_hdIndex.sprites.find(static_cast<uint32>(id));
+    if (it == m_hdIndex.sprites.end())
+        return nullptr;
+    const chaos::hdoverlay::Entry& entry = it->second;
+    if (entry.atlas >= m_hdAtlases.size())
+        return nullptr;
+
+    // the tile belongs to the sprite it was cut for: a pair that gave this id another picture hides it
+    if (entry.crc != 0 && baseSprite->getBpp() == 4) {
+        const std::vector<uint8>& pixels = baseSprite->getPixels();
+        if (chaos::hdoverlay::spriteCrc(pixels.data(), pixels.size() / 4) != entry.crc) {
+            if (!m_hdCrcWarned) {
+                m_hdCrcWarned = true;
+                g_logger.warning(stdext::format("HD overlay: sprite %d is not the picture its tile was made for, tile skipped (more of these are not logged)", id));
+            }
+            return nullptr;
+        }
+    }
+
+    return hdTileImage(entry);
+}
+
+ImagePtr SpriteManager::getHdSlotImage(int category, int thingId, int index, uint32 sprite)
+{
+    if (!m_hdEnabled || m_hdIndex.slots.empty() || category < 0 || thingId <= 0 || index < 0)
+        return nullptr;
+    auto it = m_hdIndex.slots.find(chaos::hdoverlay::slotKey(category, thingId, index));
+    if (it == m_hdIndex.slots.end() || it->second.sprite != sprite)
+        return nullptr;
+    return hdTileImage(it->second.tile);
+}
+
+// the tile of an entry cut out of its atlas and resampled to the size one sprite has now (spriteSize: 32 at scale 1, 64 with HD
+// Sprite Upscaling), so it fills the same rectangle as the sprite
+ImagePtr SpriteManager::hdTileImage(const chaos::hdoverlay::Entry& entry)
+{
+    if (entry.atlas >= m_hdAtlases.size())
+        return nullptr;
+    if (!m_hdAtlasTried[entry.atlas]) {
+        m_hdAtlasTried[entry.atlas] = true;
+        try {
+            ImagePtr atlas = Image::loadPNG(m_hdDir + "/" + m_hdIndex.atlases[entry.atlas]);
+            if (atlas && atlas->getBpp() == 4)
+                m_hdAtlases[entry.atlas] = atlas;
+            else
+                g_logger.warning(stdext::format("HD overlay: atlas %s is not an RGBA picture", m_hdIndex.atlases[entry.atlas]));
+        } catch (const std::exception& e) {
+            g_logger.warning(stdext::format("HD overlay: atlas %s: %s", m_hdIndex.atlases[entry.atlas], e.what()));
+        }
+    }
+    const ImagePtr& atlas = m_hdAtlases[entry.atlas];
+    if (!atlas)
+        return nullptr;
+
+    const int tileSize = chaos::hdoverlay::kBase * entry.scale;
+    std::vector<uint8_t> tile;
+    if (!chaos::hdoverlay::cropTile(atlas->getPixels().data(), atlas->getWidth(), atlas->getHeight(), entry.x, entry.y, tileSize, tile))
+        return nullptr;
+
+    // the same rectangle as the sprite: spriteSize px a side (32 at scale 1, 64 with HD Sprite Upscaling)
+    const int target = m_spriteSize;
+    std::vector<uint8_t> sized;
+    chaos::hdoverlay::resample(tile.data(), tileSize, sized, target);
+    auto image = std::make_shared<Image>(Size(target, target));
+    std::memcpy(image->getPixels().data(), sized.data(), sized.size());
+    return image;
+}
+
 void SpriteManager::clearImageCache()
 {
     m_imageCache.clear();
