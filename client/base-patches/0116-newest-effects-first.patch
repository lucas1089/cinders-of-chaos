# Chaos: a tile with more effects than the adaptive limit draws the newest ones, and combat feedback always draws
# (src/client/tile.cpp; after 0001-0115; 0113 and 0114 are taken by other branches and touch none of this). Owner beta:
# the crit, dodge and reflect animations stopped appearing. The server sent them (crit_burst 415, dodge_whoosh 416,
# reflect_aegis 417, reflect_bubble 628). Tile::drawTop and drawGroundEffects drew m_effects from index
# min(size - 1, effetsLimit()) down to 0, and addThing appends new effects at the back, so on a busy tile the oldest
# effects drew and the newest were dropped. effetsLimit() is 10 or less in auto mode, and pair 29 keeps a condition
# aura (1079 ms) on a fighting creature, re-sent as each copy ends, with the blasts and hit splashes beside it. Now the
# effetsLimit() + 1 newest effects draw; an older one draws only when it is combat feedback (415-417, the elemental
# imbues 418-423 of chaos_fx.lua, 628: all short) or a top effect. The draw order is the old one. An effect sent again
# on a tile replaces its running copy, so a re-sent aura no longer stacks; the old copy's scheduled removal then finds
# nothing. Model test: tools/effect_limit_test.py.
--- a/src/client/tile.cpp
+++ b/src/client/tile.cpp
@@ -284,6 +284,20 @@ void Tile::drawCreatures(const Point& dest, LightView* lightView, const bool glo
     }
 }
 
+// Chaos (base patch 0116): which effects of a tile draw. m_effects is oldest first (addThing push_back), so the
+// effetsLimit() + 1 newest are at the back; an older one draws only when it is combat feedback (crit 415, dodge 416,
+// reflect 417, the elemental imbues 418-423 and reflect 628 of chaos_fx.lua, all short) or a top effect.
+static bool chaosAlwaysDrawEffect(const EffectPtr& effect)
+{
+    int id = effect->getId();
+    return (id >= 415 && id <= 423) || id == 628 || effect->isTopEffect();
+}
+
+static int chaosFirstDrawnEffect(const std::vector<EffectPtr>& effects)
+{
+    return std::max<int>(0, (int)effects.size() - (g_adaptiveRenderer.effetsLimit() + 1));
+}
