+std::shared_ptr<TextRenderCache> TextRender::makeEntry(const BitmapFontPtr& font, const std::string& text, const Size& size,
+                                                       Fw::AlignmentFlag align)
+{
+    return std::make_shared<TextRenderCache>(TextRenderCache{ font, text, size, align, font->getTexture(), CoordsBuffer(), 0 });
+}
+
+void TextRender::drawEntry(const Point& pos, const std::shared_ptr<TextRenderCache>& entry, const Color& color, bool shadow,
+                           const PainterShaderProgramPtr& shader)
+{
+    VALIDATE_GRAPHICS_THREAD();
+    if (!entry)
+        return;
+    TextRenderCache* it = entry.get();
+    if (it->font) { // first draw: calculate text coords, exactly as the map entries do
+        it->font->calculateDrawTextCoords(it->coords, it->text, Rect(0, 0, it->size), it->align);
+        it->coords.cache();
+        it->text.clear();
+        it->font.reset();
+    }
+
+    if (shadow) {
+        auto shadowPos = Point(pos);
+        shadowPos.x += 1;
+        shadowPos.y += 1;
+        g_painter->drawText(shadowPos, it->coords, Color::black, it->texture, shader.get());
+    }
+
+    g_painter->drawText(pos, it->coords, color, it->texture, shader.get());
+}
+
+void TextRender::drawColoredEntry(const Point& pos, const std::shared_ptr<TextRenderCache>& entry,
+                                  const std::vector<std::pair<int, Color>>& colors, bool shadow,
+                                  const PainterShaderProgramPtr& shader)
+{
+    if (colors.empty())
+        return drawEntry(pos, entry, Color::white, shadow, shader);
+    VALIDATE_GRAPHICS_THREAD();
+    if (!entry)
+        return;
+    TextRenderCache* it = entry.get();
+    if (it->font) {
+        it->font->calculateDrawTextCoords(it->coords, it->text, Rect(0, 0, it->size), it->align);
+        it->coords.cache();
+        it->text.clear();
+        it->font.reset();
+    }
+    g_painter->drawText(pos, it->coords, colors, it->texture, shader.get());
+}
