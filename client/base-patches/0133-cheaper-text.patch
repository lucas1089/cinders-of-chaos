--- a/src/framework/graphics/chaostextslot.h
+++ b/src/framework/graphics/chaostextslot.h
@@ -0,0 +1,67 @@
+// Chaos (base patch 0133): one remembered text layout per piece of text that is drawn every frame.
+// Pure logic, no engine types, so tools/chaostextslot_test.cpp and tools/text_bench.cpp compile it without the client.
+//
+// The stock path hands every draw of a name, a bar label or a damage number to TextRender::addText, which hashes the whole
+// string, takes a mutex, looks the hash up in a std::map, and again on the graphics thread (mutex, second lookup, a
+// clock read). A TextSlot lives in the object that owns the text (CachedText) and keeps the layout entry itself: while the
+// text, the font, the font texture, the box size and the alignment are unchanged the same entry is handed out with no
+// hashing, no lock and no lookup. Any change builds one new entry; the old one dies with its last queue item.
+// Colour is not part of a layout (the painter takes it per draw), and the render scale is applied by the painter and the
+// draw queue, not by the layout, so neither can make an entry stale.
+#ifndef CHAOS_TEXTSLOT_H
+#define CHAOS_TEXTSLOT_H
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+
+namespace chaos {
+
+struct TextSlotKey {
+    int fontId = 0;                 // BitmapFont::getId(), unique per font object
+    const void* texture = nullptr;  // identity of the font texture the entry was built with (a reloaded font gets a new one)
+    int width = 0;                  // box size of the draw: the layout depends on it
+    int height = 0;
+    int align = 0;
+    uint32_t revision = 0;          // bumped by the owner on every change of the text
+
+    bool operator==(const TextSlotKey& o) const
+    {
+        return fontId == o.fontId && texture == o.texture && width == o.width && height == o.height
+            && align == o.align && revision == o.revision;
+    }
+    bool operator!=(const TextSlotKey& o) const { return !(*this == o); }
+};
+
+template <class Entry>
+class TextSlot
+{
+public:
+    // The entry for `key`; `make` (returns std::shared_ptr<Entry>) runs only when the key differs from the last draw.
+    // One entry per slot: memory is bounded by the number of live texts, whatever strings pass through them.
+    template <class Make>
+    const std::shared_ptr<Entry>& get(const TextSlotKey& key, Make&& make)
+    {
+        if (!m_entry || m_key != key) {
+            m_entry = make();
+            m_key = key;
+            ++m_builds;
+        }
+        ++m_gets;
+        return m_entry;
+    }
+
+    void reset() { m_entry.reset(); }
+    uint64_t builds() const { return m_builds; }
+    uint64_t gets() const { return m_gets; }
+
+private:
+    std::shared_ptr<Entry> m_entry;
+    TextSlotKey m_key;
+    uint64_t m_builds = 0;
+    uint64_t m_gets = 0;
+};
+
+} // namespace chaos
+
+#endif
