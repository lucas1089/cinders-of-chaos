+// Cinders of Chaos (base patch 0168): the loading screen of the Java shell (ChaosActivity.splashProgress / splashHide),
+// shown from the start until the first frame. Same calls as the Windows native splash (nativesplash.h).
+static void callSplash(const char* method, const char* signature, int percent, const char* stage)
+{
+    if (!g_androidState || !g_androidState->activity)
+        return;
+    JNIEnv* env = g_androidState->activity->env;
+    JavaVM* vm = g_androidState->activity->vm;
+    jobject activity = g_androidState->activity->clazz;
+    jint nResult = vm->AttachCurrentThread(&env, NULL);
+    if (nResult == JNI_ERR)
+        return;
+    jclass clazz = env->GetObjectClass(activity);
+    jmethodID methodID = env->GetMethodID(clazz, method, signature);
+    if (methodID) {
+        if (stage) {
+            jstring jstage = env->NewStringUTF(stage);
+            env->CallVoidMethod(activity, methodID, (jint)percent, jstage);
+            env->DeleteLocalRef(jstage);
+        } else {
+            env->CallVoidMethod(activity, methodID);
+        }
+    }
+    if (env->ExceptionCheck())
+        env->ExceptionClear();
+    env->DeleteLocalRef(clazz);
+    vm->DetachCurrentThread();
+}
+
+void showNativeSplash() {}
+void setNativeSplashEnabled(bool) {}
+void setNativeSplashProgress(int percent, const char* stage)
+{
+    callSplash("splashProgress", "(ILjava/lang/String;)V", percent, stage ? stage : "");
+}
+void finishNativeSplash() { callSplash("splashHide", "()V", 0, nullptr); }
+void hideNativeSplash() { callSplash("splashHide", "()V", 0, nullptr); }
