-function addToPanels(uiWidget)
+-- Chaos (base patch 0191, O485): a window that must open is never thrown away for lack of side panel room. The rule
+-- (which panel, which other windows shrink and to what) is the pure ChaosPanelRoom.plan of game_chaoslayout
+-- (panelroom_logic.lua, tested by panelroom_test.lua); this is the glue: the panels as data in, the shrinks applied out.
+-- Nothing is closed. Without game_chaoslayout the window goes on the first panel, as a priority window does.
+local function sidePanelModel(panel, except)
+  local windows, widgets = {}, {}
+  for _, child in ipairs(panel:getChildren()) do
+    if child ~= except and child:isVisible() then
+      local id = child:getId() or ''
+      local minimum = child.getMinimumHeight ~= nil and child:getMinimumHeight() or 0
+      -- the same floors configureWidgetOnPanel keeps for the battle list and the minimap
+      if id:find('BattleWindow') then
+        minimum = math.max(minimum, 104)
+      elseif id:find('minimapWindow') then
+        minimum = math.max(minimum, 200)
+      end
+      windows[#windows + 1] = {
+        id = id,
+        height = child:getHeight(),
+        min = minimum,
+        kind = (child.container ~= nil or id:find('^container') ~= nil) and 'container' or 'mini',
+        resizable = child.isResizeable ~= nil and child:isResizeable() == true,
+        minimized = child.isOn ~= nil and child:isOn() == true,
+        protected = id:find('inventoryWindow') ~= nil or id:find('mainButtons') ~= nil,
+      }
+      widgets[#windows] = child
+    end
+  end
+  return {
+    id = panel:getId(),
+    height = panel:getHeight() - panel:getPaddingTop() - panel:getPaddingBottom(),
+    windows = windows,
+  }, widgets
+end
+
+local function applyShrinks(plan, widgets)
+  for _, shrink in ipairs(plan.shrinks or {}) do
+    local widget = widgets and widgets[shrink.window]
+    if widget and not widget:isDestroyed() then
+      widget:setHeight(shrink.to)
+    end
+  end
+end
+
+-- Windows that overflow a panel (a restored layout in a smaller client) shrink towards their minimum height, the
+-- biggest container first, instead of the panel's fitAll doing it to one window. Nothing happens when they fit.
+function fitPanelWithoutClosing(panel)
+  local Room = rawget(_G, 'ChaosPanelRoom')
+  if not Room or not panel or isMinimapExpansionReservation(panel) then
+    return false
+  end
+  local model, widgets = sidePanelModel(panel)
+  local plan = Room.plan({ model }, { height = 0, min = 0 })
+  if not plan or #plan.shrinks == 0 then
+    return false
+  end
+  applyShrinks(plan, widgets)
+  return true
+end
+
+local function placeWithoutClosing(uiWidget, panels)
+  local Room = rawget(_G, 'ChaosPanelRoom')
+  local plan, widgets
+  if Room then
+    local ok, result, list = pcall(function()
+      local models, lists = {}, {}
+      for i, panel in ipairs(panels) do
+        models[i], lists[i] = sidePanelModel(panel, uiWidget)
+      end
+      return Room.plan(models, { height = uiWidget:getHeight(), min = uiWidget:getMinimumHeight() }), lists
+    end)
+    if ok and result then
+      plan, widgets = result, list[result.panel]
+    end
+  end
+  if not plan and #panels > 0 then
+    plan = { action = 'force', panel = 1, shrinks = {} }
+  end
+  if not plan then
+    uiWidget:close()
+    return false
+  end
+
+  local panel = panels[plan.panel]
+  applyShrinks(plan, widgets)
+  if plan.action == 'force' and plan.height then
+    uiWidget:setHeight(plan.height)
+  end
+  uiWidget:setParent(panel)
+  local oldOnClose = uiWidget.onClose
+  uiWidget.onClose = function()
+    if oldOnClose then oldOnClose() end
+    local parent = uiWidget:getParent()
+    if parent then parent:removeChild(uiWidget) end
+  end
+  if panel.fitAll then
+    panel:fitAll(uiWidget)
+  end
+  return true
+end
+
