+
+// Chaos (base patch 0081): a speed scale below 1 set after onAppear lengthens the life of the text: the first removal
+// finds time left and asks again for the rest
+void AnimatedText::scheduleRemoval(int delay)
+{
     auto self = asAnimatedText();
-    g_dispatcher.scheduleEvent([self]() { g_map.removeThing(self); }, Otc::ANIMATED_TEXT_DURATION);
+    g_dispatcher.scheduleEvent([self]() {
+        const float left = self->m_duration - self->m_animationTimer.ticksElapsed();
+        if(left > 1.0f)
+            self->scheduleRemoval(static_cast<int>(std::ceil(left)));
+        else
+            g_map.removeThing(self);
+    }, delay);
+}
+
+void AnimatedText::setSpeedScale(float scale)
+{
+    // 0.5 .. 2: half or twice the stock speed
+    m_speedScale = std::max(0.5f, std::min(2.0f, scale));
+    m_duration = Otc::ANIMATED_TEXT_DURATION / m_speedScale;
 }
 
