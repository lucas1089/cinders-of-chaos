# Chaos: interface scale (O207; src/framework/core/graphicalapplication.cpp and Lua: mods/client_settings/classes/dataset.lua,
# settings.lua, options/interface.otui; after 0001-0128). The base already scales the whole interface (g_app.scale draws it
# at window size / N and stretches it, the mouse is divided by N on Windows) but with a linear filter, which blurs the pixel
# fonts and skin. This patch draws a whole N with hard pixel edges (a fraction keeps the linear filter) and adds the option
# uiScale (a scrollbar with the steps 100 / 200 / 300 %, saved by the settings, applied at once) to Options > Interface.
# Overlay module game_chaosuiscale (client/MANIFEST.md "Interface scale (O207)") limits the step to what the window fits.
--- a/src/framework/core/graphicalapplication.cpp
+++ b/src/framework/core/graphicalapplication.cpp
@@ -42,6 +42,7 @@
 #include <framework/input/mouse.h>
 #include <framework/util/extras.h>
 #include <framework/util/stats.h>
+#include <cmath>
 #include <mutex>
 #include <array>
 
@@ -415,6 +416,9 @@
         AutoStat stat(STATS_RENDER, "SetupScaling");
         g_painter->setResolution(g_graphics.getViewportSize() / m_scaling);
         m_framebuffer->resize(g_painter->getResolution());
+        // Chaos (O207): a whole factor stretches the interface with hard pixel edges (sharp bitmap fonts and skin), a
+        // fraction keeps the linear filter
+        m_framebuffer->setSmooth(m_scaling.load() != std::floor(m_scaling.load()));
         m_framebuffer->bind();
     }
 
@@ -777,6 +781,7 @@
             AutoStat s(STATS_RENDER, "SetupScaling");
             g_painter->setResolution(g_graphics.getViewportSize() / m_scaling);
             m_framebuffer->resize(g_painter->getResolution());
+            m_framebuffer->setSmooth(m_scaling.load() != std::floor(m_scaling.load()));
             m_framebuffer->bind();
         }
 
--- a/mods/client_settings/classes/dataset.lua
+++ b/mods/client_settings/classes/dataset.lua
@@ -10,6 +10,25 @@
     end
 end
 
+-- Chaos (base patch 0129): the text of the interface scale line in Options > Interface; says so when the window only fits
+-- a smaller step than the one chosen
+function updateUiScaleLabel(index)
+    local win = GameOptions and GameOptions:getLoadedWindow('interface')
+    local label = win and win:recursiveGetChildById('uiScaleLabel')
+    if not label then return end
+    local want, got = ({100, 200, 300})[math.max(1, math.min(3, math.floor(tonumber(index) or 1)))], nil
+    local m = modules.game_chaosuiscale
+    if m and m.info then
+        local ok, w, g = pcall(m.info, index)
+        if ok and w then want, got = w, g end
+    end
+    if got and got < want then
+        label:setText(tr('Interface scale: %d%% (this window fits %d%%)', want, got))
+    else
+        label:setText(tr('Interface scale: %d%%', want))
+    end
+end
+
 return {
     layout = {
         value = DEFAULT_LAYOUT,
@@ -2279,6 +2298,22 @@
       end,
   },
 
+  -- Chaos (base patch 0129; overlay module game_chaosuiscale): interface scale. The value is the step index (1 = 100%,
+  -- 2 = 200%, 3 = 300%), also the scrollbar value; the module lowers it to what the window fits and calls g_app.scale
+  uiScale = {
+    value = 1,
+    apply = function(value)
+      local m = modules.game_chaosuiscale
+      if m and m.onOption then m.onOption(value) end
+      updateUiScaleLabel(value)
+      return true
+    end,
+    tempApply = function(value)
+      updateUiScaleLabel(value)
+      return true
+    end,
+  },
+
   quickAllCorpses = {
     value = false,
   },
