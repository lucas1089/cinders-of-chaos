+// Chaos (base patch 0128): the liquid ground ids (one byte per client id: 0 none, 1 water, 2 lava) and the option
+static std::vector<uint8_t> s_liquidKind;
+static bool s_liquidShimmer = false;
+static const std::string s_liquidShaders[3] = { "", "chaos_liquid_water", "chaos_liquid_lava" };
+
+void Item::setLiquidShimmer(bool enabled) { s_liquidShimmer = enabled; }
+void Item::clearLiquidIds() { s_liquidKind.clear(); }
+void Item::addLiquidId(int clientId, int kind)
+{
+    if (clientId <= 0 || clientId > 0xFFFF || kind < 1 || kind > 2)
+        return;
+    if (s_liquidKind.size() <= (size_t)clientId)
+        s_liquidKind.resize((size_t)clientId + 1, 0);
+    s_liquidKind[clientId] = (uint8_t)kind;
+}
+
 // Chaos (base patch 0044): the rarity outline style (set from Lua) and the queue item that starts an outline
 static ItemRarityOutlineStyle s_rarityOutline;
 
