+    // Chaos (base patch 0128): living water and lava. Ground items whose client id Lua listed (kind 1 water, 2 lava) draw
+    // with the liquid shader of their kind while the option is on (client/BASE.md 0128); no per-tile Lua, no extra pass.
+    static void setLiquidShimmer(bool enabled);
+    static void clearLiquidIds();
+    static void addLiquidId(int clientId, int kind);
     static void setRarityOutlineStyle(int width, int minRarity, int pulseFromRarity, int pulseMs);
     static bool isRarityOutlineOnMap();
     static bool isRarityOutlineInSlots();
