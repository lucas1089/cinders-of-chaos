+    const std::string* liquidShader = nullptr;
+    if (s_liquidShimmer && m_shader.empty() && (size_t)m_clientId < s_liquidKind.size() && s_liquidKind[m_clientId] != 0)
+        liquidShader = &s_liquidShaders[s_liquidKind[m_clientId]];
+    if (liquidShader) {
+        type->drawWithShader(dest, 0, xPattern, yPattern, zPattern, animationPhase, *liquidShader, color, lightView);
+    }
+    else if (!m_shader.empty()) {
         type->drawWithShader(dest, 0, xPattern, yPattern, zPattern, animationPhase, m_shader, color, lightView);
     }
