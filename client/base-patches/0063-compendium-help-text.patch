# said the protocol is 8.60. It now points to the task systems in the top menu bar, Hunt > Kill Tasks and Adventure >
# Bounty Board, and names the 10.98 protocol this client speaks.
diff --git a/mods/game_compendium/compendium.lua b/mods/game_compendium/compendium.lua
