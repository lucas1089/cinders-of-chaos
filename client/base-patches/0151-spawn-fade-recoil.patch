+// Chaos (base patch 0151): called from setHealthPercent with the old and the new percent. The push is away from the local
+// player (the usual attacker); the local player, a creature on the player's tile or another floor gets a small random one.
+// Uses the option of the hit flash (s_hitTint).
+void Creature::startRecoil(int oldPercent, int newPercent)
+{
+    const bool shown = m_healthShown && !m_removed;
+    if (!chaos::recoil::wantsRecoil(s_hitTint, m_position.isMapPosition(), shown, oldPercent, newPercent))
+        return;
+    const ticks_t now = g_clock.millis();
+    if (!chaos::recoil::gapPassed(m_recoilStart, now))
+        return;
+    bool known = false;
+    int dx = 0;
+    int dy = 0;
+    const LocalPlayerPtr player = g_game.getLocalPlayer();
+    if (player && player.get() != this && player->getPosition().isMapPosition() && player->getPosition().z == m_position.z) {
+        known = true;
+        dx = m_position.x - player->getPosition().x;
+        dy = m_position.y - player->getPosition().y;
+    }
+    const chaos::recoil::Offset dir = chaos::recoil::pushDirection(known, dx, dy, static_cast<uint32_t>(getId()) * 2654435761u + static_cast<uint32_t>(now));
+    m_recoilDx = dir.x;
+    m_recoilDy = dir.y;
+    m_recoilPx = chaos::recoil::pixelsForDrop(oldPercent - newPercent);
+    m_recoilStart = now == 0 ? 1 : now;
+}
