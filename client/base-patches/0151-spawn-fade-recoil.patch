+// Cinders of Chaos (base patch 0151): the spawn fade-in and the hit recoil of a creature, pure and header-only so
+// client/tools/chaosrecoil_test.cpp can run it without the engine. Both are draw-time maths from one start time per
+// creature: a creature that appears fades from 0 to full opacity in kFadeMs, and a creature whose health percent goes
+// down is drawn a pixel or two away from the attacker and eases back in kRecoilMs. Nothing is stored but the start times.
+#ifndef CHAOSRECOIL_H
+#define CHAOSRECOIL_H
+
+#include <algorithm>
+#include <cstdint>
+
+namespace chaos {
+namespace recoil {
+
+constexpr int kFadeMs = 180;        // from invisible to full opacity
+constexpr int kRecoilMs = 120;      // from the nudge back to the tile
+constexpr int kMinGapMs = 100;      // one creature does not restart its recoil faster than this
+constexpr int kSmallPx = 1;         // nudge of a small hit (in 32 px sprites)
+constexpr int kBigPx = 2;           // nudge of a hit of kBigDrop% or more
+constexpr int kBigDrop = 10;
+
+// A plain offset in pixels; kept free of engine types.
+struct Offset {
+    int x = 0;
+    int y = 0;
+};
+
+// Opacity of a creature `elapsedMs` after it appeared: 0 at the first frame, 1 from kFadeMs on, smoothstep in between,
+// never outside 0..1. A start in the future (the clock ran backwards) counts as the first frame.
+inline float fadeAlpha(int64_t elapsedMs)
+{
+    if (elapsedMs <= 0)
+        return 0.0f;
+    if (elapsedMs >= kFadeMs)
+        return 1.0f;
+    const float u = static_cast<float>(elapsedMs) / static_cast<float>(kFadeMs);
+    return u * u * (3.0f - 2.0f * u);
+}
+
+// The one decision whether an appearance starts a fade: the option is on and it is not the local player.
+inline bool wantsFade(bool optionOn, bool localPlayer)
+{
+    return optionOn && !localPlayer;
+}
+
+// Nudge in sprite pixels (at 32 px) from how many percent of the health the hit took.
+inline int pixelsForDrop(int dropPercent)
+{
+    return dropPercent >= kBigDrop ? kBigPx : kSmallPx;
+}
+
+inline int sign(int v)
+{
+    return v > 0 ? 1 : (v < 0 ? -1 : 0);
+}
+
+// Direction the creature is pushed: away from the attacker, one step per axis (-1, 0 or 1). When the attacker is unknown
+// or stands on the same tile (dx and dy both 0) the answer is a small random direction from the seed. Never (0, 0).
+inline Offset randomDirection(uint32_t seed)
+{
+    // Wang hash, then one of the 8 neighbours
+    seed = (seed ^ 61u) ^ (seed >> 16);
+    seed *= 9u;
+    seed = seed ^ (seed >> 4);
+    seed *= 0x27d4eb2du;
+    seed = seed ^ (seed >> 15);
+    static const int kDx[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+    static const int kDy[8] = { -1, -1, 0, 1, 1, 1, 0, -1 };
+    const uint32_t i = seed % 8u;
+    return Offset{ kDx[i], kDy[i] };
+}
+
+// attackerKnown false: no attacker position is known. dx, dy: the creature's tile minus the attacker's tile.
+inline Offset pushDirection(bool attackerKnown, int dx, int dy, uint32_t seed)
+{
+    if (attackerKnown && (dx != 0 || dy != 0))
+        return Offset{ sign(dx), sign(dy) };
+    return randomDirection(seed);
+}
+
+// Share of the nudge left `elapsedMs` after the hit: 1 at the start, 0 from kRecoilMs on, ease-out (1 - u)^2.
+inline float recoilShare(int64_t elapsedMs)
+{
+    if (elapsedMs >= kRecoilMs)
+        return 0.0f;
+    if (elapsedMs <= 0)
+        return 1.0f;
+    const float u = static_cast<float>(elapsedMs) / static_cast<float>(kRecoilMs);
+    const float r = 1.0f - u;
+    return r * r;
+}
+
+// The draw offset in pixels. `dir` is a pushDirection, `px` a pixelsForDrop value, `pixelScale` the sprite size over 32
+// (1 for a 32 px sprite). Each axis is at most px * pixelScale and 0 once the recoil is over.
+inline Offset offsetAt(int64_t elapsedMs, Offset dir, int px, int pixelScale)
+{
+    const float share = recoilShare(elapsedMs);
+    const int peak = std::max(0, px) * std::max(1, pixelScale);
+    auto axis = [&](int d) {
+        const float v = static_cast<float>(sign(d) * peak) * share;
+        return static_cast<int>(v >= 0.0f ? v + 0.5f : v - 0.5f);
+    };
+    return Offset{ axis(dir.x), axis(dir.y) };
+}
+
+// The one decision whether a health change starts a recoil: the option is on, the creature stands on a map tile and was
+// already shown (the first health after it appears is a starting value, not a hit), the health went down and it is not 0
+// (a dying creature is removed at once).
+inline bool wantsRecoil(bool optionOn, bool onMap, bool shown, int oldPercent, int newPercent)
+{
+    return optionOn && onMap && shown && newPercent > 0 && newPercent < oldPercent;
+}
+
+// per creature: whether the last recoil started long enough ago (0 = never)
+inline bool gapPassed(int64_t lastStart, int64_t now)
+{
+    return lastStart == 0 || now < lastStart || now - lastStart >= kMinGapMs;
+}
+
+} // namespace recoil
+} // namespace chaos
+
+#endif
