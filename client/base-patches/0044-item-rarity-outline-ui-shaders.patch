+namespace
+{
+// a_TexCoord stays in texture pixels (the rings are measured in them)
+const std::string glslItemOutlineVertexShader = "\n\
+    attribute vec2 a_Vertex;\n\
+    attribute vec2 a_TexCoord;\n\
+    uniform mat3 u_TransformMatrix;\n\
+    uniform mat3 u_ProjectionMatrix;\n\
+    varying vec2 v_TexCoord;\n\
+    void main()\n\
+    {\n\
+        gl_Position = vec4((u_ProjectionMatrix * u_TransformMatrix * vec3(a_Vertex.xy, 1.0)).xy, 0.0, 1.0);\n\
+        v_TexCoord = a_TexCoord;\n\
+    }\n";
+
+// the sprite's alpha at a texture pixel (nothing outside its own frame rect: the texture holds other frames there).
+// Per ring i (1..n) the 8 neighbours at i steps; the nearest opaque ring counts most (smooth falloff), so the glow is
+// strongest at the edge and fades out over the reach. Only where the sprite itself is transparent.
+const std::string glslItemOutlineFragmentShader = "\n\
+    uniform mat3 u_TextureMatrix;\n\
+    uniform sampler2D u_Tex0;\n\
+    uniform vec4 u_Color;\n\
+    uniform vec4 u_GlowSrc;\n\
+    uniform vec3 u_GlowRing;\n\
+    varying vec2 v_TexCoord;\n\
+    float alphaAt(vec2 p)\n\
+    {\n\
+        if (p.x < u_GlowSrc.x || p.y < u_GlowSrc.y || p.x >= u_GlowSrc.z || p.y >= u_GlowSrc.w)\n\
+            return 0.0;\n\
+        return texture2D(u_Tex0, (u_TextureMatrix * vec3(p, 1.0)).xy).a;\n\
+    }\n\
+    float ringAt(vec2 c, vec2 s)\n\
+    {\n\
+        vec2 d = s * 0.7071;\n\
+        float a = max(max(alphaAt(c + vec2(s.x, 0.0)), alphaAt(c - vec2(s.x, 0.0))),\n\
+                      max(alphaAt(c + vec2(0.0, s.y)), alphaAt(c - vec2(0.0, s.y))));\n\
+        a = max(a, max(max(alphaAt(c + d), alphaAt(c - d)),\n\
+                       max(alphaAt(c + vec2(d.x, -d.y)), alphaAt(c + vec2(-d.x, d.y)))));\n\
+        return a;\n\
+    }\n\
+    void main()\n\
+    {\n\
+        float inside = alphaAt(v_TexCoord);\n\
+        if (inside > 0.98)\n\
+            discard;\n\
+        float glow = 0.0;\n\
+        for (int i = 1; i <= 4; i++) {\n\
+            float fi = float(i);\n\
+            if (fi > u_GlowRing.z)\n\
+                break;\n\
+            float t = (fi - 0.5) / u_GlowRing.z;\n\
+            float fall = 1.0 - t * t * (3.0 - 2.0 * t);\n\
+            glow = max(glow, ringAt(v_TexCoord, u_GlowRing.xy * fi) * fall);\n\
+            glow = max(glow, ringAt(v_TexCoord, u_GlowRing.xy * (fi - 0.5)) * min(1.0, fall + 0.15));\n\
+        }\n\
+        float a = glow * (1.0 - inside);\n\
+        if (a < 0.01)\n\
+            discard;\n\
+        gl_FragColor = vec4(u_Color.rgb, u_Color.a * a);\n\
+    }\n";
+
+enum {
+    ITEM_GLOW_SRC_UNIFORM = 24,
+    ITEM_GLOW_RING_UNIFORM = 25
+};
+
+constexpr float ITEM_GLOW_PULSE_LOW = 0.5f; // the lowest alpha of a pulsing item outline
+constexpr int ITEM_GLOW_MAX_RINGS = 4;      // the fragment shader's loop
+
+PainterShaderProgramPtr itemOutlineProgram()
+{
+    static PainterShaderProgramPtr program;
+    static bool failed = false;
+    if (program || failed)
+        return program;
+    program = PainterShaderProgram::create("chaosItemOutlineProgram", glslItemOutlineVertexShader, glslItemOutlineFragmentShader);
+    if (!program) {
+        failed = true;
+        g_logger.error("item outline program could not be built; rarity outlines are off");
+        return nullptr;
+    }
+    program->bindUniformLocation(ITEM_GLOW_SRC_UNIFORM, "u_GlowSrc");
+    program->bindUniformLocation(ITEM_GLOW_RING_UNIFORM, "u_GlowRing");
+    return program;
+}
+}
+
+void DrawQueueItemItemOutline::draw()
+{
+    if (!m_part || !m_part->m_texture || m_part->m_dest.isEmpty() || m_part->m_src.isEmpty() || m_width <= 0)
+        return;
+    PainterShaderProgramPtr program = itemOutlineProgram();
+    if (!program)
+        return;
+
+    // the queue's opacity (setOpacity, a fading item) applies to the outline too
+    float alpha = m_color.aF() * m_outlineColor.aF();
+    if (m_pulseMs > 0) {
+        const float phase = (float)(g_clock.millis() % m_pulseMs) / m_pulseMs;
+        alpha *= ITEM_GLOW_PULSE_LOW + (1.f - ITEM_GLOW_PULSE_LOW) * (0.5f - 0.5f * std::cos(phase * 6.2831853f));
+    }
+    if (alpha <= 0.f)
+        return;
+    Color color = m_outlineColor;
+    color.setAlpha(alpha);
+
+    const Rect& src = m_part->m_src;
+    const Rect& dest = m_part->m_dest;
+    // the reach in texture pixels: sprite pixels times the sprite size factor (HD upscaling keeps the look)
+    const float radiusTex = std::max(1.f, m_width * m_pixelScale);
+    const float sx = (float)src.width() / dest.width();
+    const float sy = (float)src.height() / dest.height();
+    const int rings = std::max(1, std::min(ITEM_GLOW_MAX_RINGS, (int)std::ceil(radiusTex)));
+
+    g_painter->setShaderProgram(program);
+    program->bind();
+    program->setUniformValue(ITEM_GLOW_SRC_UNIFORM, (float)src.left(), (float)src.top(), (float)(src.right() + 1), (float)(src.bottom() + 1));
+    program->setUniformValue(ITEM_GLOW_RING_UNIFORM, radiusTex / rings, radiusTex / rings, (float)rings);
+    g_painter->setColor(color);
+    // the quad grows by the reach on each side, in destination pixels and in texture pixels alike
+    const int growX = std::max(1, (int)std::ceil(radiusTex / sx)), growY = std::max(1, (int)std::ceil(radiusTex / sy));
+    const Rect grownDest(Point(dest.left() - growX, dest.top() - growY), Size(dest.width() + 2 * growX, dest.height() + 2 * growY));
+    const int texX = (int)std::ceil(growX * sx), texY = (int)std::ceil(growY * sy);
+    const Rect grownSrc(Point(src.left() - texX, src.top() - texY), Size(src.width() + 2 * texX, src.height() + 2 * texY));
+    g_painter->drawTexturedRect(grownDest, m_part->m_texture, grownSrc, m_part->getFlipDirection());
+    g_painter->resetShaderProgram();
+    g_painter->resetColor();
+}
