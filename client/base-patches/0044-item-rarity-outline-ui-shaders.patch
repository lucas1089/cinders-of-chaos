+// Chaos (base patch 0044): the rarity outline of items
+Color Item::getRarityOutlineColor()
+{
+    const bool unique = m_customAttribs.get<uint64>(ITEM_CUSTOM_ATTR_UNIQUE) > 0;
+    const uint64 rarity = m_customAttribs.get<uint64>(ITEM_CUSTOM_ATTR_RARITY);
+    if (unique && s_rarityOutline.colors[ItemRarityOutlineStyle::UNIQUE].aF() > 0.f)
+        return s_rarityOutline.colors[ItemRarityOutlineStyle::UNIQUE];
+    if (rarity < 1 || rarity > 15 || (int)rarity < s_rarityOutline.minRarity)
+        return Color::alpha;
+    return s_rarityOutline.colors[rarity];
+}
+
+int Item::getRarityOutlinePulseMs()
+{
+    const int from = s_rarityOutline.pulseFromRarity;
+    if (from <= 0)
+        return 0;
+    const bool unique = m_customAttribs.get<uint64>(ITEM_CUSTOM_ATTR_UNIQUE) > 0;
+    const uint64 rarity = m_customAttribs.get<uint64>(ITEM_CUSTOM_ATTR_RARITY);
+    return unique || (int)rarity >= from ? s_rarityOutline.pulseMs : 0;
+}
+
+void Item::setRarityOutlineColor(int rarity, int r, int g, int b, int a)
+{
+    if (rarity < 1 || rarity > ItemRarityOutlineStyle::UNIQUE)
+        return;
+    auto channel = [](int v) { return (uint8)std::max(0, std::min(255, v)); };
+    s_rarityOutline.colors[rarity] = Color(channel(r), channel(g), channel(b), channel(a));
+}
+
+void Item::setRarityOutlineEnabled(bool onMap, bool inSlots)
+{
+    s_rarityOutline.onMap = onMap;
+    s_rarityOutline.inSlots = inSlots;
+}
+
+void Item::setRarityOutlineStyle(int width, int minRarity, int pulseFromRarity, int pulseMs)
+{
+    s_rarityOutline.width = std::max(1, std::min(4, width));
+    s_rarityOutline.minRarity = std::max(1, std::min(15, minRarity));
+    s_rarityOutline.pulseFromRarity = std::max(0, std::min(16, pulseFromRarity));
+    s_rarityOutline.pulseMs = std::max(200, std::min(60000, pulseMs));
+}
+
+bool Item::isRarityOutlineOnMap()
+{
+    return s_rarityOutline.onMap;
+}
+
+bool Item::isRarityOutlineInSlots()
+{
+    return s_rarityOutline.inSlots;
+}
