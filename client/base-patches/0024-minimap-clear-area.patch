+int Minimap::clearArea(const Position& from, const Position& to)
+{
+    if(from.z != to.z || from.z > g_gameConfig.getMapMaxZ())
+        return 0;
+    int x1 = std::min(from.x, to.x), x2 = std::max(from.x, to.x);
+    int y1 = std::min(from.y, to.y), y2 = std::max(from.y, to.y);
+    if(x2 - x1 > 2048 || y2 - y1 > 2048)
+        return 0;
+    int cleared = 0;
+    for(int y = y1; y <= y2; ++y) {
+        for(int x = x1; x <= x2; ++x) {
+            Position pos(x, y, from.z);
+            if(!hasBlock(pos))
+                continue;
+            MinimapBlock& block = getBlock(pos);
+            Point offsetPos = getBlockOffset(Point(x, y));
+            if(block.getTile(x - offsetPos.x, y - offsetPos.y) == MinimapTile())
+                continue;
+            block.resetTile(x - offsetPos.x, y - offsetPos.y);
+            block.mustUpdate();
+            ++cleared;
+            // keep what the client holds right now (the tiles in view)
+            if(const TilePtr& tile = g_map.getTile(pos))
+                updateTile(pos, tile);
+        }
+    }
+    return cleared;
+}
