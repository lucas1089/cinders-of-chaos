+    // ground effects (g_map.setGroundEffect: a portal circle on the floor) go under every creature. A big effect
+    // reaches up and left of the tile it is on, into tiles drawn before it, so the first tile it covers (up and left,
+    // the earliest diagonal of the painter order) draws it right after its own bottom layer; the grounds are already
+    // drawn (GameMapDrawGroundFirst) and the walls and items of the later tiles still go over it.
+    std::unordered_map<const Tile*, std::vector<TilePtr>> groundEffectHosts;
+    if (g_map.hasGroundEffects()) {
+        std::unordered_set<const Tile*> visible;
+        for (auto& tile : tiles)
+            visible.insert(tile.get());
+        for (auto& tile : tiles) {
+            if (!tile->hasGroundEffect())
+                continue;
+            int w = 1, h = 1;
+            for (const EffectPtr& effect : tile->getEffects()) {
+                if (g_map.isGroundEffect(effect->getId())) {
+                    w = std::max<int>(w, effect->getWidth());
+                    h = std::max<int>(h, effect->getHeight());
+                }
+            }
+            const Tile* host = tile.get();
+            if (!negativeOffsetPass && g_game.getFeature(Otc::GameMapDrawGroundFirst)) {
+                const TilePtr& first = g_map.getTile(tile->getPosition().translated(1 - w, 1 - h));
+                if (first && visible.count(first.get()))
+                    host = first.get();
+            }
+            groundEffectHosts[host].push_back(tile);
+        }
+    }
+    auto drawGroundEffectsOf = [&](const TilePtr& host) {
+        if (groundEffectHosts.empty())
+            return;
+        auto it = groundEffectHosts.find(host.get());
+        if (it == groundEffectHosts.end())
+            return;
+        for (const TilePtr& owner : it->second)
+            owner->drawGroundEffects(transformPositionTo2D(owner->getPosition(), cameraPosition), m_lightView.get());
+    };
