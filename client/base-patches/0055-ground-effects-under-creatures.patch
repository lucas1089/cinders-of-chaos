+bool Tile::hasGroundEffect()
+{
+    if (m_effects.empty() || !g_map.hasGroundEffects())
+        return false;
+    for (const EffectPtr& effect : m_effects) {
+        if (g_map.isGroundEffect(effect->getId()))
+            return true;
+    }
+    return false;
+}
+
+void Tile::drawGroundEffects(const Point& dest, LightView* lightView)
+{
+    if (m_fill != Color::alpha)
+        return;
+    int limit = std::min<int>((int)m_effects.size() - 1, g_adaptiveRenderer.effetsLimit());
+    for (int i = limit; i >= 0; --i) {
+        if (m_effects[i]->isHidden() || !g_map.isGroundEffect(m_effects[i]->getId()))
+            continue;
+        m_effects[i]->draw(dest - m_drawElevation * g_sprites.getOffsetFactor(), m_position.x - g_map.getCentralPosition().x, m_position.y - g_map.getCentralPosition().y, true, lightView);
+    }
