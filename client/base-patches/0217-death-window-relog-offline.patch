+-- Chaos 0217: the server removes a dead player at once and sends nothing more, so the client's
+-- 30 s read timeout ends the game while the death window waits. The window stays open through
+-- that game end; Ok then logs in again from the character list, Cancel leaves the list showing.
+-- A new game start (any relog) closes it.
+function onGameEnd()
+  if not deathWindow then return end
+  deathWindow.chaosOffline = true
+  -- the character list takes the input lock in its own onGameEnd; give it back to the window
+  addEvent(function()
+    if deathWindow then
+      deathWindow:show()
+      deathWindow:raise()
+      deathWindow:focus()
+      g_client.setInputLockWidget(deathWindow)
+    end
+  end)
+end
+
+-- Chaos 0217: the character list asks this before it shows a connection error. While the death
+-- window is open, the lost connection is the expected end of a dead player's session: no error box.
+function holdsConnectionError()
+  return deathWindow ~= nil
+end
+
