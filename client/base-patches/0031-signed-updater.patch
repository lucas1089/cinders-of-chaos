+// Cinders of Chaos signed updater: the native helpers (client/base-patches/0031-signed-updater.patch).
+//
+// Header only, so client/tests/chaosupdate_test.cpp can build it on its own against OpenSSL:
+//   * ed25519Verify: Ed25519 (RFC 8032) signature check with OpenSSL's EVP interface (OpenSSL 1.1.1 or newer;
+//     the client already links OpenSSL for RSA, SHA and TLS). No crypto code of our own.
+//   * sha256Hex / Sha256Stream: SHA-256 as lowercase hex.
+//   * isSafeUpdatePath: the relative paths the updater may write under its folder in the write dir.
+// The Lua side (modules/client_chaos_updater) checks paths again with its own, stricter rules.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#ifndef __EMSCRIPTEN__
+#include <openssl/evp.h>
+#endif
+
+namespace chaosupdate
+{
+
+inline int hexValue(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+inline bool hexToBytes(const std::string& hex, std::string& out)
+{
+    out.clear();
+    if (hex.size() % 2 != 0)
+        return false;
+    out.reserve(hex.size() / 2);
+    for (size_t i = 0; i < hex.size(); i += 2) {
+        const int hi = hexValue(hex[i]), lo = hexValue(hex[i + 1]);
+        if (hi < 0 || lo < 0)
+            return false;
+        out.push_back(static_cast<char>((hi << 4) | lo));
+    }
+    return true;
+}
+
+inline std::string bytesToHex(const unsigned char* data, size_t size)
+{
+    static const char digits[] = "0123456789abcdef";
+    std::string out(size * 2, '0');
+    for (size_t i = 0; i < size; ++i) {
+        out[i * 2] = digits[data[i] >> 4];
+        out[i * 2 + 1] = digits[data[i] & 15];
+    }
+    return out;
+}
+
+// publicKeyHex: 64 hex digits (32 bytes); signatureHex: 128 hex digits (64 bytes); message: the exact signed bytes.
+// Anything malformed is a failed check, never an exception.
+inline bool ed25519Verify(const std::string& publicKeyHex, const std::string& message, const std::string& signatureHex)
+{
+#ifdef __EMSCRIPTEN__
+    (void)publicKeyHex; (void)message; (void)signatureHex;
+    return false;
+#else
+    std::string key, signature;
+    if (!hexToBytes(publicKeyHex, key) || key.size() != 32)
+        return false;
+    if (!hexToBytes(signatureHex, signature) || signature.size() != 64)
+        return false;
+
+    EVP_PKEY* pkey = EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr,
+                                                 reinterpret_cast<const unsigned char*>(key.data()), key.size());
+    if (!pkey)
+        return false;
+    EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+    bool ok = false;
+    if (ctx && EVP_DigestVerifyInit(ctx, nullptr, nullptr, nullptr, pkey) == 1) {
+        ok = EVP_DigestVerify(ctx, reinterpret_cast<const unsigned char*>(signature.data()), signature.size(),
+                              reinterpret_cast<const unsigned char*>(message.data()), message.size()) == 1;
+    }
+    EVP_MD_CTX_free(ctx);
+    EVP_PKEY_free(pkey);
+    return ok;
+#endif
+}
+
+#ifndef __EMSCRIPTEN__
+// incremental SHA-256 (files are hashed in 1 MB blocks, never read whole)
+class Sha256Stream
+{
+public:
+    Sha256Stream() : m_ctx(EVP_MD_CTX_new())
+    {
+        m_ok = m_ctx && EVP_DigestInit_ex(m_ctx, EVP_sha256(), nullptr) == 1;
+    }
+    ~Sha256Stream() { EVP_MD_CTX_free(m_ctx); }
+    Sha256Stream(const Sha256Stream&) = delete;
+    Sha256Stream& operator=(const Sha256Stream&) = delete;
+
+    void update(const void* data, size_t size)
+    {
+        if (m_ok && size > 0)
+            m_ok = EVP_DigestUpdate(m_ctx, data, size) == 1;
+    }
+    // "" when anything failed
+    std::string finishHex()
+    {
+        unsigned char md[EVP_MAX_MD_SIZE];
+        unsigned int len = 0;
+        if (!m_ok || EVP_DigestFinal_ex(m_ctx, md, &len) != 1 || len != 32)
+            return "";
+        m_ok = false;
+        return bytesToHex(md, len);
+    }
+
+private:
+    EVP_MD_CTX* m_ctx;
+    bool m_ok = false;
+};
+
+inline std::string sha256Hex(const std::string& data)
+{
+    Sha256Stream s;
+    s.update(data.data(), data.size());
+    return s.finishHex();
+}
+#endif
+
+// A relative path under the updater's own folder of the write dir: segments of [A-Za-z0-9 ._()+,-] (the client's
+// own data has names like "Label Money.png" and "62-(33253-31491-7)subarea.png"), no empty segment, no "." or "..",
+// no segment starting or ending with a space or ending with a dot, no leading or trailing "/", no backslash, no
+// drive letter, at most 240 characters.
+inline bool isSafeUpdatePath(const std::string& path)
+{
+    if (path.empty() || path.size() > 240 || path.front() == '/' || path.back() == '/')
+        return false;
+    size_t start = 0;
+    while (start <= path.size()) {
+        size_t end = path.find('/', start);
+        if (end == std::string::npos)
+            end = path.size();
+        const std::string part = path.substr(start, end - start);
+        if (part.empty() || part == "." || part == ".." || part.front() == ' ' || part.back() == ' ' || part.back() == '.')
+            return false;
+        for (char c : part) {
+            const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                c == '.' || c == '_' || c == '-' || c == ' ' || c == '(' || c == ')' || c == '+' || c == ',';
+            if (!ok)
+                return false;
+        }
+        start = end + 1;
+    }
+    return true;
+}
+
