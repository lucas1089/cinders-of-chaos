+// ---- Cinders of Chaos signed updater (modules/client_chaos_updater) ----
+// The updater keeps everything under "chaos_update/" in the write dir: downloads are staged there, checked against
+// the signed manifest and only then moved into "chaos_update/files", which init.lua mounts in front of the client's
+// own folder at the next start. These helpers never touch anything outside that folder.
+namespace {
+const std::string CHAOS_UPDATE_ROOT = "chaos_update/";
+
+bool isChaosUpdatePath(std::string path)
+{
+    if (!path.empty() && path[0] == '/')
+        path = path.substr(1);
+    return stdext::starts_with(path, CHAOS_UPDATE_ROOT) && path.size() > CHAOS_UPDATE_ROOT.size() &&
+        chaosupdate::isSafeUpdatePath(path);
+}
+
+std::filesystem::path chaosUpdateRealPath(std::string path)
+{
+    if (!path.empty() && path[0] == '/')
+        path = path.substr(1);
+    const char* writeDir = PHYSFS_getWriteDir();
+    if (!writeDir)
+        return {};
+    return std::filesystem::u8path(writeDir) / std::filesystem::u8path(path);
+}
+}
+
+// SHA-256 (lowercase hex) of a file in the virtual file system, read in 1 MB blocks; "" if it cannot be read
+std::string ResourceManager::fileSha256(const std::string& path)
+{
+#ifdef __EMSCRIPTEN__
+    (void)path;
+    return "";
+#else
+    PHYSFS_File* file = PHYSFS_openRead(path.c_str());
+    if (!file)
+        return "";
+    chaosupdate::Sha256Stream sha;
+    std::vector<char> buffer(1024 * 1024);
+    bool ok = true;
+    while (true) {
+        const PHYSFS_sint64 n = PHYSFS_readBytes(file, buffer.data(), buffer.size());
+        if (n < 0) { ok = false; break; }
+        if (n == 0) break;
+        sha.update(buffer.data(), static_cast<size_t>(n));
+    }
+    PHYSFS_close(file);
+    return ok ? sha.finishHex() : "";
+#endif
+}
+
+// size in bytes of a file in the virtual file system, -1 if it does not exist (opened, so a symbolic link counts
+// with the size of its target)
+int64_t ResourceManager::fileSize(const std::string& path)
+{
+    if (PHYSFS_isDirectory(path.c_str()))
+        return -1;
+    PHYSFS_File* file = PHYSFS_openRead(path.c_str());
+    if (!file)
+        return -1;
+    const PHYSFS_sint64 size = PHYSFS_fileLength(file);
+    PHYSFS_close(file);
+    return size;
+}
+
+// appends to a file of the write dir (created when missing); used for resumable downloads in parts
+bool ResourceManager::appendFileContents(const std::string& fileName, const std::string& data)
+{
+    PHYSFS_File* file = PHYSFS_openAppend(fileName.c_str());
+    if (!file) {
+        g_logger.error(stdext::format("unable to open file for appending '%s': %s", fileName, PHYSFS_getErrorByCode(PHYSFS_getLastErrorCode())));
+        return false;
+    }
+    const bool ok = PHYSFS_writeBytes(file, data.data(), data.size()) == static_cast<PHYSFS_sint64>(data.size());
+    return PHYSFS_close(file) != 0 && ok;
+}
+
+// renames a file inside chaos_update/ of the write dir (one atomic step on the same disk), replacing the target
+bool ResourceManager::moveUpdateFile(const std::string& from, const std::string& to)
+{
+    if (!isChaosUpdatePath(from) || !isChaosUpdatePath(to)) {
+        g_logger.warning(stdext::format("updater: refused move '%s' -> '%s'", from, to));
+        return false;
+    }
+    const auto src = chaosUpdateRealPath(from), dst = chaosUpdateRealPath(to);
+    if (src.empty() || dst.empty())
+        return false;
+    std::error_code ec;
+    std::filesystem::create_directories(dst.parent_path(), ec);
+    std::filesystem::rename(src, dst, ec);
+    if (ec) {
+        g_logger.warning(stdext::format("updater: unable to move '%s' -> '%s': %s", from, to, ec.message()));
+        return false;
+    }
+    return true;
+}
+
+// removes a file or a whole folder inside chaos_update/ of the write dir
+bool ResourceManager::removeUpdateTree(const std::string& path)
+{
+    if (!isChaosUpdatePath(path))
+        return false;
+    const auto real = chaosUpdateRealPath(path);
+    if (real.empty())
+        return false;
+    std::error_code ec;
+    std::filesystem::remove_all(real, ec);
+    return !ec;
+}
+
+// mounts a folder of chaos_update/ at "/" in front of every other search path (its files override the client's)
+bool ResourceManager::mountUpdateDir(const std::string& path)
+{
+    if (!isChaosUpdatePath(path))
+        return false;
+    const auto real = chaosUpdateRealPath(path);
+    std::error_code ec;
+    if (real.empty() || !std::filesystem::is_directory(real, ec))
+        return false;
+    if (!PHYSFS_mount(real.u8string().c_str(), nullptr, 0)) {
+        g_logger.warning(stdext::format("updater: unable to mount '%s': %s", path, PHYSFS_getErrorByCode(PHYSFS_getLastErrorCode())));
+        return false;
+    }
+    return true;
+}
+
+bool ResourceManager::unmountUpdateDir(const std::string& path)
+{
+    if (!isChaosUpdatePath(path))
+        return false;
+    const auto real = chaosUpdateRealPath(path);
+    return !real.empty() && PHYSFS_unmount(real.u8string().c_str()) != 0;
+}
