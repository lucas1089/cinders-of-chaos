+// Chaos (base patch 0153): see shadermanager.h. The values are clamped here so a bad Lua call cannot blow the picture out.
+void ShaderManager::setMapGrade(float tintR, float tintG, float tintB, float saturation, float contrast)
+{
+    const float v[5] = {tintR, tintG, tintB, saturation, contrast};
+    for (int i = 0; i < 5; ++i) {
+        float x = v[i];
+        if (!(x == x)) // not a number
+            x = 0.f;
+        const float lim = i < 3 ? 0.15f : 0.35f;
+        m_mapGrade[i].store(x < -lim ? -lim : (x > lim ? lim : x));
+    }
+}
+
+void ShaderManager::applyMapGrade(const PainterShaderProgramPtr& shader)
+{
+    if (!shader)
+        return;
+    shader->setParams(m_mapGrade[0].load(), m_mapGrade[1].load(), m_mapGrade[2].load(), m_mapGrade[3].load());
+    shader->setParams2(m_mapGrade[4].load(), 0.f, 0.f, 0.f);
+}
