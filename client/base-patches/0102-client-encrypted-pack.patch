+// Cinders of Chaos encrypted client pack (base patch 0102, client/BASE.md "Client packs"). Looks for chaos.pack
+// beside the exe (and in the current / base dir), streams it from disk through AES-256-GCM and inflate
+// (util/chaospack.h) into one buffer of the ZIP's size and mounts that buffer, so the shipped folder is just the exe and
+// this one file and modules keep reading through g_resources. Called from main() before getCompactName(), so init.lua
+// is read from the pack. A wrong key or a corrupt pack is fatal (the client cannot run without its files). Returns
+// false when no pack is present (dev tree).
+bool ResourceManager::mountEncryptedPack(const std::string& key)
+{
+#if defined(ANDROID) || defined(__EMSCRIPTEN__)
+    (void)key;
+    return false;
+#else
+    if (key.size() != 32)
+        return false;
+
+    std::vector<std::filesystem::path> dirs;
+    if (!m_binaryPath.empty())
+        dirs.push_back(m_binaryPath.parent_path());
+    dirs.push_back(std::filesystem::u8path(g_platform.getCurrentDir()));
+    const char* baseDir = PHYSFS_getBaseDir();
+    if (baseDir)
+        dirs.push_back(std::filesystem::u8path(baseDir));
+
+    for (const auto& dir : dirs) {
+        const auto packPath = dir / "chaos.pack";
+        std::error_code ec;
+        if (!std::filesystem::is_regular_file(packPath, ec) || ec)
+            continue;
+
+        // streamed: 4 MB of ciphertext at a time is decrypted and inflated straight into one buffer of the ZIP's size
+        // (the header's plaintext length), which is then mounted as it is. Peak memory ~ the ZIP + 4 MB.
+        auto data = std::make_shared<std::vector<uint8_t>>();
+        const auto size = std::filesystem::file_size(packPath, ec);
+        std::ifstream stream(packPath, std::ios::binary);
+        if (ec || !stream) {
+            g_logger.warning(stdext::format("Unable to read client pack '%s'", packPath.string()));
+            continue;
+        }
+        auto read = [&stream](unsigned char* dst, size_t n) {
+            return static_cast<bool>(stream.read(reinterpret_cast<char*>(dst), static_cast<std::streamsize>(n)));
+        };
+        stdext::timer timer;
+        if (!chaospack::decryptStream(key, static_cast<uint64_t>(size), read, *data)) {
+            g_logger.fatal(stdext::format("Unable to decrypt client pack '%s' (wrong build key, corrupt file or not "
+                                          "enough memory)", packPath.string()));
+            return false;
+        }
+        stream.close();
+
+        const size_t plainSize = data->size();
+        if (mountMemoryData(data)) {
+            m_packMounted = true;
+            g_logger.info(stdext::format("Mounted encrypted client pack '%s' (%u MB, %u MB unpacked, %u ms)",
+                                         packPath.string(), static_cast<unsigned>(size >> 20),
+                                         static_cast<unsigned>(plainSize >> 20),
+                                         static_cast<unsigned>(timer.elapsed_millis())));
+            return true;
+        }
+        g_logger.fatal(stdext::format("The client pack '%s' decrypted but has no init.lua or could not be mounted",
+                                      packPath.string()));
+        return false;
+    }
+    return false;
+#endif
+}
