+// Cinders of Chaos encrypted client pack (client/base-patches/0102-client-encrypted-pack.patch, client/BASE.md
+// "Client packs"). The client ships one file beside the exe, chaos.pack: a store-only ZIP of the whole client tree
+// (init.lua, data/, modules/, mods/, layouts/) encrypted as one blob with AES-256-GCM. The engine decrypts it to
+// memory and mounts it (src/framework/core/resourcemanager.cpp), so modules keep reading files through g_resources.
+//
+// The key is derived with HKDF-SHA256 from the client guard build secret (chaosguard::builtInKey(), base patch 0035):
+// no new secret. This deters copying; it does not stop a determined reverse engineer, since the key is in the binary
+// (obfuscated the way chaosguard_key.h is). The packing tool client/tools/pack_client.py uses the identical format;
+// client/tools/chaospack_test.cpp checks a fixed vector against it.
+//
+// Header only, so chaospack_test.cpp builds it on its own against OpenSSL (which the client links already).
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+
+namespace chaospack
+{
+
+constexpr char MAGIC[4] = { 'C', 'H', 'P', 'K' };
+constexpr uint8_t VERSION = 1;
+constexpr size_t HEADER_LEN = 28; // magic(4) ver(1) flags(1) reserved(2) nonce(12) plaintextLen(8)
+constexpr size_t NONCE_LEN = 12;
+constexpr size_t TAG_LEN = 16;
+constexpr uint8_t FLAG_DEV = 0x01;
+
+// HKDF context, byte-identical to client/tools/pack_client.py.
+inline const std::string& hkdfSalt() { static const std::string s = "CindersOfChaos/pack/v1"; return s; }
+inline const std::string& infoEnc() { static const std::string s = "chaos-pack-aes-256-gcm"; return s; }
+inline const std::string& infoNonce() { static const std::string s = "chaos-pack-nonce"; return s; }
+
+inline std::string hmacSha256(const std::string& key, const std::string& data)
+{
+    unsigned char out[EVP_MAX_MD_SIZE];
+    unsigned int outLen = 0;
+    if (!HMAC(EVP_sha256(), key.data(), static_cast<int>(key.size()),
+              reinterpret_cast<const unsigned char*>(data.data()), data.size(), out, &outLen) || outLen != 32)
+        return std::string();
+    return std::string(reinterpret_cast<const char*>(out), outLen);
+}
+
+// RFC 5869 HKDF-SHA256 (extract + expand). Matches pack_client.py's _hkdf_sha256.
+inline std::string hkdfSha256(const std::string& ikm, const std::string& salt, const std::string& info, size_t length)
+{
+    const std::string prk = hmacSha256(salt, ikm);
+    if (prk.empty())
+        return std::string();
+    std::string okm;
+    std::string t;
+    uint8_t counter = 1;
+    while (okm.size() < length) {
+        std::string input = t + info;
+        input.push_back(static_cast<char>(counter));
+        t = hmacSha256(prk, input);
+        if (t.empty())
+            return std::string();
+        okm += t;
+        ++counter;
+    }
+    okm.resize(length);
+    return okm;
+}
+
+// clientKey: 32 raw bytes (chaosguard::builtInKey()). Returns false on any OpenSSL failure.
+inline bool deriveKeys(const std::string& clientKey, std::string& encKey, std::string& nonceKey)
+{
+    if (clientKey.size() != 32)
+        return false;
+    encKey = hkdfSha256(clientKey, hkdfSalt(), infoEnc(), 32);
+    nonceKey = hkdfSha256(clientKey, hkdfSalt(), infoNonce(), 32);
+    return encKey.size() == 32 && nonceKey.size() == 32;
+}
+
+inline void writeU64LE(std::string& s, uint64_t v)
+{
+    for (int i = 0; i < 8; ++i)
+        s.push_back(static_cast<char>((v >> (8 * i)) & 0xFF));
+}
+
+inline uint64_t readU64LE(const unsigned char* p)
+{
+    uint64_t v = 0;
+    for (int i = 0; i < 8; ++i)
+        v |= static_cast<uint64_t>(p[i]) << (8 * i);
+    return v;
+}
+
+// AES-256-GCM. aad covers the pack header so version/flags/nonce/length cannot be tampered with.
+inline bool aesGcmEncrypt(const std::string& key, const std::string& nonce, const std::string& aad,
+                          const std::string& plaintext, std::string& ciphertext, std::string& tag)
+{
+    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
+    if (!ctx)
+        return false;
+    bool ok = false;
+    do {
+        int len = 0;
+        if (EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1)
+            break;
+        if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, static_cast<int>(nonce.size()), nullptr) != 1)
+            break;
+        if (EVP_EncryptInit_ex(ctx, nullptr, nullptr,
+                               reinterpret_cast<const unsigned char*>(key.data()),
+                               reinterpret_cast<const unsigned char*>(nonce.data())) != 1)
+            break;
+        if (!aad.empty() &&
+            EVP_EncryptUpdate(ctx, nullptr, &len, reinterpret_cast<const unsigned char*>(aad.data()),
+                              static_cast<int>(aad.size())) != 1)
+            break;
+        ciphertext.resize(plaintext.size());
+        int outLen = 0;
+        if (!plaintext.empty() &&
+            EVP_EncryptUpdate(ctx, reinterpret_cast<unsigned char*>(&ciphertext[0]), &outLen,
+                              reinterpret_cast<const unsigned char*>(plaintext.data()),
+                              static_cast<int>(plaintext.size())) != 1)
+            break;
+        int finalLen = 0;
+        unsigned char dummy[16];
+        if (EVP_EncryptFinal_ex(ctx, dummy, &finalLen) != 1)
+            break;
+        tag.resize(TAG_LEN);
+        if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, static_cast<int>(TAG_LEN),
+                                reinterpret_cast<unsigned char*>(&tag[0])) != 1)
+            break;
+        ok = true;
+    } while (false);
+    EVP_CIPHER_CTX_free(ctx);
+    return ok;
+}
+
+inline bool aesGcmDecrypt(const std::string& key, const std::string& nonce, const std::string& aad,
+                          const std::string& ciphertext, const std::string& tag, std::string& plaintext)
+{
+    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
+    if (!ctx)
+        return false;
+    bool ok = false;
+    do {
+        int len = 0;
+        if (EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1)
+            break;
+        if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, static_cast<int>(nonce.size()), nullptr) != 1)
+            break;
+        if (EVP_DecryptInit_ex(ctx, nullptr, nullptr,
+                               reinterpret_cast<const unsigned char*>(key.data()),
+                               reinterpret_cast<const unsigned char*>(nonce.data())) != 1)
+            break;
+        if (!aad.empty() &&
+            EVP_DecryptUpdate(ctx, nullptr, &len, reinterpret_cast<const unsigned char*>(aad.data()),
+                              static_cast<int>(aad.size())) != 1)
+            break;
+        plaintext.resize(ciphertext.size());
+        int outLen = 0;
+        if (!ciphertext.empty() &&
+            EVP_DecryptUpdate(ctx, reinterpret_cast<unsigned char*>(&plaintext[0]), &outLen,
+                              reinterpret_cast<const unsigned char*>(ciphertext.data()),
+                              static_cast<int>(ciphertext.size())) != 1)
+            break;
+        if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, static_cast<int>(tag.size()),
+                                const_cast<char*>(tag.data())) != 1)
+            break;
+        int finalLen = 0;
+        unsigned char dummy[16];
+        if (EVP_DecryptFinal_ex(ctx, dummy, &finalLen) != 1) // authentication failed
+            break;
+        ok = true;
+    } while (false);
+    EVP_CIPHER_CTX_free(ctx);
+    return ok;
+}
+
+// Encrypt a plaintext blob into the chaos.pack byte layout. Deterministic: the nonce is HMAC(nonceKey, plaintext).
+// Used by the test and by any in-engine packing; the shipped pack is built by pack_client.py.
+inline bool encrypt(const std::string& clientKey, const std::string& plaintext, bool devKey, std::string& out)
+{
+    std::string encKey, nonceKey;
+    if (!deriveKeys(clientKey, encKey, nonceKey))
+        return false;
+    std::string nonce = hmacSha256(nonceKey, plaintext).substr(0, NONCE_LEN);
+    if (nonce.size() != NONCE_LEN)
+        return false;
+    std::string header;
+    header.append(MAGIC, 4);
+    header.push_back(static_cast<char>(VERSION));
+    header.push_back(static_cast<char>(devKey ? FLAG_DEV : 0));
+    header.push_back('\0');
+    header.push_back('\0');
+    header += nonce;
+    writeU64LE(header, plaintext.size());
+    std::string ciphertext, tag;
+    if (!aesGcmEncrypt(encKey, nonce, header, plaintext, ciphertext, tag))
+        return false;
+    out = header + ciphertext + tag;
+    return true;
+}
+
+// Decrypt a chaos.pack blob. Returns false on bad format, wrong key or any tampering.
+inline bool decrypt(const std::string& clientKey, const std::string& pack, std::string& out)
+{
+    if (pack.size() < HEADER_LEN + TAG_LEN)
+        return false;
+    if (std::memcmp(pack.data(), MAGIC, 4) != 0)
+        return false;
+    if (static_cast<uint8_t>(pack[4]) != VERSION)
+        return false;
+    const auto* bytes = reinterpret_cast<const unsigned char*>(pack.data());
+    const std::string nonce = pack.substr(8, NONCE_LEN);
+    const uint64_t plaintextLen = readU64LE(bytes + 20);
+    const std::string header = pack.substr(0, HEADER_LEN);
+    const size_t bodyLen = pack.size() - HEADER_LEN - TAG_LEN;
+    const std::string ciphertext = pack.substr(HEADER_LEN, bodyLen);
+    const std::string tag = pack.substr(pack.size() - TAG_LEN);
+    std::string encKey, nonceKey;
+    if (!deriveKeys(clientKey, encKey, nonceKey))
+        return false;
+    if (!aesGcmDecrypt(encKey, nonce, header, ciphertext, tag, out))
+        return false;
+    if (out.size() != plaintextLen) {
+        out.clear();
+        return false;
+    }
+    return true;
+}
+
+// Decrypt a chaos.pack in place: `buf` holds the whole file on entry and only the plaintext (the ZIP) on success, so
+// the client needs one buffer of the pack's size, never a second or third copy (the pack is mostly the ~900 MB sprites).
+// The body is decrypted in chunks (GCM allows the output to be the input) and moved down over the header. On failure
+// `buf` is cleared. Same format and checks as decrypt().
+inline bool decryptInPlace(const std::string& clientKey, std::vector<uint8_t>& buf)
+{
+    constexpr size_t CHUNK = 64u * 1024u * 1024u; // EVP lengths are int
+    bool ok = false;
+    EVP_CIPHER_CTX* ctx = nullptr;
+    do {
+        if (buf.size() < HEADER_LEN + TAG_LEN || std::memcmp(buf.data(), MAGIC, 4) != 0 || buf[4] != VERSION)
+            break;
+        const uint64_t plaintextLen = readU64LE(buf.data() + 20);
+        const size_t bodyLen = buf.size() - HEADER_LEN - TAG_LEN;
+        if (plaintextLen != bodyLen)
+            break;
+        std::string encKey, nonceKey;
+        if (!deriveKeys(clientKey, encKey, nonceKey))
+            break;
+        ctx = EVP_CIPHER_CTX_new();
+        if (!ctx)
+            break;
+        int len = 0;
+        if (EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr) != 1 ||
+            EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, static_cast<int>(NONCE_LEN), nullptr) != 1 ||
+            EVP_DecryptInit_ex(ctx, nullptr, nullptr, reinterpret_cast<const unsigned char*>(encKey.data()),
+                               buf.data() + 8) != 1 ||
+            EVP_DecryptUpdate(ctx, nullptr, &len, buf.data(), static_cast<int>(HEADER_LEN)) != 1)
+            break;
+        bool bodyOk = true;
+        for (size_t at = 0; at < bodyLen; at += CHUNK) {
+            const int n = static_cast<int>(std::min(CHUNK, bodyLen - at));
+            unsigned char* p = buf.data() + HEADER_LEN + at;
+            int outLen = 0;
+            if (EVP_DecryptUpdate(ctx, p, &outLen, p, n) != 1 || outLen != n) {
+                bodyOk = false;
+                break;
+            }
+        }
+        if (!bodyOk)
+            break;
+        unsigned char tag[TAG_LEN];
+        std::memcpy(tag, buf.data() + HEADER_LEN + bodyLen, TAG_LEN);
+        if (EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, static_cast<int>(TAG_LEN), tag) != 1)
+            break;
+        unsigned char dummy[16];
+        int finalLen = 0;
+        if (EVP_DecryptFinal_ex(ctx, dummy, &finalLen) != 1) // authentication failed
+            break;
+        std::memmove(buf.data(), buf.data() + HEADER_LEN, bodyLen);
+        buf.resize(bodyLen);
+        buf.shrink_to_fit();
+        ok = true;
+    } while (false);
+    if (ctx)
+        EVP_CIPHER_CTX_free(ctx);
+    if (!ok) {
+        std::fill(buf.begin(), buf.end(), 0);
+        buf.clear();
+        buf.shrink_to_fit();
+    }
+    return ok;
+}
+
