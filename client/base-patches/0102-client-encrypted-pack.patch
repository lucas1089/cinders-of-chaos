+// Cinders of Chaos encrypted client pack (base patch 0102, client/BASE.md "Client packs"). Looks for chaos.pack
+// beside the exe (and in the current / base dir), decrypts it with the client guard key (AES-256-GCM, util/chaospack.h)
+// into memory and mounts it, so the shipped folder is just the exe and this one file and modules keep reading through
+// g_resources. Called from main() before getCompactName(), so init.lua is read from the pack. A wrong key or a
+// corrupt pack is fatal (the client cannot run without its files). Returns false when no pack is present (dev tree).
+bool ResourceManager::mountEncryptedPack(const std::string& key)
+{
+#if defined(ANDROID) || defined(__EMSCRIPTEN__)
+    (void)key;
+    return false;
+#else
+    if (key.size() != 32)
+        return false;
+
+    std::vector<std::filesystem::path> dirs;
+    if (!m_binaryPath.empty())
+        dirs.push_back(m_binaryPath.parent_path());
+    dirs.push_back(std::filesystem::u8path(g_platform.getCurrentDir()));
+    const char* baseDir = PHYSFS_getBaseDir();
+    if (baseDir)
+        dirs.push_back(std::filesystem::u8path(baseDir));
+
+    for (const auto& dir : dirs) {
+        const auto packPath = dir / "chaos.pack";
+        std::error_code ec;
+        if (!std::filesystem::is_regular_file(packPath, ec) || ec)
+            continue;
+
+        // one buffer of the pack's size: read, decrypted in place, then mounted as it is (no copies)
+        auto data = std::make_shared<std::vector<uint8_t>>();
+        {
+            const auto size = std::filesystem::file_size(packPath, ec);
+            std::ifstream stream(packPath, std::ios::binary);
+            if (ec || !stream) {
+                g_logger.warning(stdext::format("Unable to read client pack '%s'", packPath.string()));
+                continue;
+            }
+            data->resize(static_cast<size_t>(size));
+            if (size > 0 && !stream.read(reinterpret_cast<char*>(data->data()), static_cast<std::streamsize>(size))) {
+                g_logger.warning(stdext::format("Unable to read client pack '%s'", packPath.string()));
+                continue;
+            }
+        }
+
+        if (!chaospack::decryptInPlace(key, *data)) {
+            g_logger.fatal(stdext::format("Unable to decrypt client pack '%s' (wrong build key or corrupt file)",
+                                          packPath.string()));
+            return false;
+        }
+
+        const size_t plainSize = data->size();
+        if (mountMemoryData(data)) {
+            m_packMounted = true;
+            g_logger.info(stdext::format("Mounted encrypted client pack '%s' (%u bytes)", packPath.string(),
+                                         static_cast<unsigned>(plainSize)));
+            return true;
+        }
+        g_logger.fatal(stdext::format("The client pack '%s' decrypted but has no init.lua or could not be mounted",
+                                      packPath.string()));
+        return false;
+    }
+    return false;
+#endif
+}
