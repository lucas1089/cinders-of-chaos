# Options > Graphics on a phone: the engine combo box lists OpenGL ES alone (greyed out) instead of the ANGLE choices (Vulkan, DirectX), and a saved engine index is set back to 1. Applies after 0156.
diff -ru a/mods/client_settings/classes/dataset.lua b/mods/client_settings/classes/dataset.lua
--- a/mods/client_settings/classes/dataset.lua	2026-11-04 11:42:00.179051000 +0000
+++ b/mods/client_settings/classes/dataset.lua	2026-11-04 11:42:00.200731154 +0000
@@ -1032,7 +1032,9 @@
         apply = function(value)
             -- Only an OpenGL ES build (ANGLE) can switch to Vulkan or DirectX at start; a desktop OpenGL build
             -- always draws with OpenGL and its combo box lists OpenGL alone (index 1)
-            if not isOpenGlEsRenderer() and value ~= 1 then
+            -- a phone lists OpenGL ES alone (index 1) too
+            local mobile = g_app.isMobile and g_app.isMobile()
+            if (mobile or not isOpenGlEsRenderer()) and value ~= 1 then
                 addEvent(function() GameOptions:setOption('engine', 1) end)
             end
             return true
diff -ru a/mods/client_settings/options/graphics.otui b/mods/client_settings/options/graphics.otui
--- a/mods/client_settings/options/graphics.otui	2026-11-04 11:42:00.176510217 +0000
+++ b/mods/client_settings/options/graphics.otui	2026-11-04 11:42:00.200303772 +0000
@@ -40,7 +40,12 @@
       @onSetup: |
         -- only an OpenGL ES (ANGLE) build can draw through Vulkan or DirectX; our builds are desktop OpenGL, so they list
         -- OpenGL alone (greyed out: there is nothing to pick)
-        if modules.client_settings.isOpenGlEsRenderer() then
+        -- a phone draws with OpenGL ES alone (no Vulkan or DirectX to pick)
+        if g_app.isMobile and g_app.isMobile() then
+          self:addOption("OpenGL ES", nil, true)
+          self:setEnabled(false)
+          self:setTooltip(tr('This client draws with OpenGL ES.'))
+        elseif modules.client_settings.isOpenGlEsRenderer() then
           self:addOption("Vulkan", nil, true)
           self:addOption("DirectX11", nil, true)
           self:addOption("DirectX11 (WARP)", nil, true)
