--- a/src/client/chaosdeathfade.h
+++ b/src/client/chaosdeathfade.h
@@ -0,0 +1,84 @@
+// Cinders of Chaos (base patch 0139): the death fade of a creature, pure and header-only so
+// client/tools/chaosdeathfade_test.cpp can run it without the engine. A creature that is removed from the map at 0 health
+// leaves a "ghost" (a copy of what it drew) that fades out in kDurationMs; the corpse is not touched. The queue holds copies
+// only, never a pointer into the map, and is bounded.
+#ifndef CHAOSDEATHFADE_H
+#define CHAOSDEATHFADE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <utility>
+
+namespace chaos {
+namespace deathfade {
+
+constexpr int kDurationMs = 350;      // from the last drawn frame to nothing
+constexpr size_t kMaxGhosts = 32;     // alive at once; a new one pushes the oldest out
+
+// 1 at the first frame, 0 from kDurationMs on, smoothstep in between (soft start, soft end), never outside 0..1
+inline float alphaAt(int64_t elapsedMs)
+{
+    if (elapsedMs <= 0)
+        return 1.0f;
+    if (elapsedMs >= kDurationMs)
+        return 0.0f;
+    const float u = static_cast<float>(elapsedMs) / static_cast<float>(kDurationMs);
+    return 1.0f - u * u * (3.0f - 2.0f * u);
+}
+
+// the one decision whether a removed creature gets a ghost: the option is on, it is not the local player, it can be
+// seen, it has 0 health (a creature that walks out of view or moves has more) and it stood on a map tile
+inline bool wantsGhost(bool optionOn, bool localPlayer, bool visible, int healthPercent, bool onMap)
+{
+    return optionOn && !localPlayer && visible && healthPercent <= 0 && onMap;
+}
+
+template <class T>
+class GhostQueue
+{
+public:
+    struct Entry {
+        uint32_t id;
+        int64_t start;
+        T value;
+    };
+
+    // false when this creature id already has a ghost (a second removal must not restart the fade)
+    bool push(uint32_t id, T value, int64_t now)
+    {
+        if (id != 0) {
+            for (const Entry& e : m_entries)
+                if (e.id == id)
+                    return false;
+        }
+        while (m_entries.size() >= kMaxGhosts)
+            m_entries.pop_front();
+        m_entries.push_back(Entry{ id, now, std::move(value) });
+        return true;
+    }
+
+    // drops every ghost whose fade is over (also one whose start lies in the future: the clock never ran backwards)
+    void expire(int64_t now)
+    {
+        for (auto it = m_entries.begin(); it != m_entries.end();) {
+            if (now - it->start >= kDurationMs || now < it->start)
+                it = m_entries.erase(it);
+            else
+                ++it;
+        }
+    }
+
+    void clear() { m_entries.clear(); }
+    bool empty() const { return m_entries.empty(); }
+    size_t size() const { return m_entries.size(); }
+    std::deque<Entry>& entries() { return m_entries; }
+
+private:
+    std::deque<Entry> m_entries;
+};
+
+} // namespace deathfade
+} // namespace chaos
