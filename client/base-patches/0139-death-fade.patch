+// Chaos (base patch 0139): the copy of the last frame. It mirrors the placement of Creature::draw (the same offsets), but
+// holds no outline, hit parts or shader, so nothing in it points at the creature or the map.
+bool Creature::takeDeathGhost(DeathGhost& out)
+{
+    if (!chaos::deathfade::wantsGhost(s_deathFade, isLocalPlayer(), canBeSeen(), m_healthPercent, m_position.isMapPosition()))
+        return false;
+
+    out.outfit = m_outfit;
+    out.outfit.setDrawOutline(nullptr);
+    out.outfit.setHitParts(nullptr);
+    out.outfit.resetShader(); // a shader item does not take the queue's opacity
+    out.pos = m_position;
+    out.direction = m_walking ? m_walkDirection : m_direction;
+    out.phase = m_walkAnimationPhase;
+    out.scale = m_drawScale;
+    out.jumpOffset = Point(m_jumpOffset.x, m_jumpOffset.y);
+    out.walkOffset = m_walkOffset;
+    out.logicalDisplacement = usesNegativeDisplacement() ? Point() : getDisplacement();
+    out.outfitShift = m_outfit.getCategory() != ThingCategoryCreature ? getDisplacement() : Point();
+    return true;
+}
+
+void Creature::drawDeathGhost(DeathGhost& ghost, const Point& dest, float alpha)
+{
+    if (alpha <= 0.0f)
+        return;
+    const int sprSize = g_sprites.spriteSize();
+    const Point creatureCenter = dest - ghost.jumpOffset + ghost.walkOffset - ghost.logicalDisplacement + Point(sprSize / 2, sprSize / 2);
+    const size_t start = g_drawQueue->size();
+    ghost.outfit.draw(dest - ghost.jumpOffset + ghost.walkOffset - ghost.outfitShift, ghost.direction, ghost.phase, true, nullptr);
+    if (ghost.scale != 1.0f)
+        g_drawQueue->setScale(start, creatureCenter + Point(0, sprSize / 2), ghost.scale);
+    if (alpha < 1.0f)
+        g_drawQueue->setOpacity(start, alpha);
+}
