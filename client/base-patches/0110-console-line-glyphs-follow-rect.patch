# Chaos: a console line is drawn where its label is (src/framework/ui; after 0001-0109). Beta report 2026-10-21: "com a
# janela do chat em tamanho padrão, o texto fica em cima do outro" (the newest line drawn over the top line).
# UITextEdit::update() stores its glyphs in screen coordinates; they are placed again only by onGeometryChange, which
# UIWidget::setRect sends one event later and skips when the rect is back where it was when the event was scheduled.
# The console reuses 200 hidden labels; a hidden one keeps its last slot. A new line: its text is set, show() lays it
# out at the top of the buffer (event scheduled, old rect = its slot), game_cosmetics / game_chatlinks set the coloured
# text there (glyphs at the top), moveChildToIndex lays it out at the bottom, in its old slot. The event saw no change,
# so the text stayed at the top, over the first visible line, and the bottom line looked empty.
# Now the event calls onGeometryRestored() in that case; UITextEdit places its glyphs again when the rect they were
# placed for is not its rect. Model: client/tools/console_glyphs_test.py.
--- a/src/framework/ui/uitextedit.cpp
+++ b/src/framework/ui/uitextedit.cpp
@@ -264,6 +264,7 @@
         fireAreaUpdate = true;
 
     Rect textScreenCoords = m_rect;
+    m_glyphsRect = m_rect;
     textScreenCoords.expandLeft(-m_padding.left);
     textScreenCoords.expandRight(-m_padding.right);
     textScreenCoords.expandBottom(-m_padding.bottom);
@@ -740,6 +741,14 @@
     UIWidget::onGeometryChange(oldRect, newRect);
 }
 
+void UITextEdit::onGeometryRestored()
+{
+    // e.g. a console line: text set at the top of the buffer, then moved back to its old slot in the same frame;
+    // the glyphs stayed where the text was set and were drawn over another line
+    if(m_glyphsRect != m_rect)
+        update(true);
+}
+
 void UITextEdit::onFocusChange(bool focused, Fw::FocusReason reason)
 {
     if(focused) {
