+++ b/src/client/chaosshadow.h
@@ -0,0 +1,61 @@
+// Cinders of Chaos (base patch 0155): where the soft shadow under a creature sits, pure and header-only so
+// client/tools/chaosshadow_test.cpp can run it without the engine. The shadow is centred on the drawn body (the middle of
+// its pieces) at the lowest drawn row, not on the logical tile: a creature look is drawn from its tile corner minus the
+// look's displacement and minus (tiles - 1) tiles, so the tile and the feet are different places.
+#ifndef CHAOSSHADOW_H
+#define CHAOSSHADOW_H
+
+#include <algorithm>
+
+namespace chaos {
+namespace shadow {
+
+constexpr float kLiftPx = 5.0f;     // from the lowest drawn row up to the middle of the ellipse (at 32 px sprites)
+constexpr float kTileWidthPx = 22.0f;  // ellipse width for a one tile look (at 32 px sprites)
+constexpr float kExtraTilePx = 4.0f;   // more width for every tile beyond the first
+constexpr float kHeightRatio = 0.42f;  // ellipse height over its width
+constexpr int kMaxTiles = 4;
+
+struct Ellipse {
+    int x = 0, y = 0, w = 0, h = 0;
+};
+
+inline int clampTiles(int widthTiles)
+{
+    return std::max(1, std::min(kMaxTiles, widthTiles));
+}
+
+// The ellipse for a body whose drawn pieces have the middle `bodyCenterX` and the lower edge `bodyBottomY` (the row under
+// the lowest drawn pixel). `unit` is spriteSize / 32. A creature drawn scaled by `scale` around (scaleX, scaleY) gets its
+// shadow moved and sized the same way (the shadow is queued outside the scaled pieces).
+inline Ellipse place(float bodyCenterX, float bodyBottomY, int widthTiles, float unit, float scale, float scaleX, float scaleY)
+{
+    const int tiles = clampTiles(widthTiles);
+    const float w = (kTileWidthPx * tiles + (tiles - 1) * kExtraTilePx) * unit * scale;
+    const float h = w * kHeightRatio;
+    const float cx = scaleX + (bodyCenterX - scaleX) * scale;
+    const float cy = scaleY + ((bodyBottomY - kLiftPx * unit) - scaleY) * scale;
+    Ellipse e;
+    e.w = static_cast<int>(w);
+    e.h = static_cast<int>(h);
+    e.x = static_cast<int>(cx) - e.w / 2;
+    e.y = static_cast<int>(cy) - e.h / 2;
+    return e;
+}
+
+// The drawn body without its pieces (a look whose texture is not loaded yet): the same middle and lower edge, worked out
+// from the place the outfit is drawn at (`destX`, `destY`, the tile corner plus walk offset), as ThingType::draw does:
+// the frame starts at dest - displacement - (tiles - 1) * spriteSize and is `tiles` tiles wide and high.
+inline void bodyFromPlacement(float destX, float destY, float dispX, float dispY, int widthTiles, int spriteSize,
+                              float& centerX, float& bottomY)
+{
+    const float s = static_cast<float>(spriteSize);
+    const int tiles = std::max(1, widthTiles);
+    centerX = destX - dispX - (tiles - 1) * s + tiles * s / 2.0f;
+    bottomY = destY - dispY + s;
+}
+
+}  // namespace shadow
+}  // namespace chaos
+
+#endif
