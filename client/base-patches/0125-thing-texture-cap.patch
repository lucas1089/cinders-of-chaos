+namespace {
+constexpr size_t DefaultTextureCacheMB = 256;
+constexpr time_t CapGraceSeconds = 5;
+}
+
+size_t ThingTypeManager::getTextureCacheLimitBytes() const
+{
+    size_t mb = DefaultTextureCacheMB;
+    const auto settings = g_configs.getSettings();
+    if (settings) {
+        const std::string value = settings->getValue("textureCacheMB");
+        if (!value.empty()) {
+            char* end = nullptr;
+            const long parsed = std::strtol(value.c_str(), &end, 10);
+            if (end != value.c_str() && parsed >= 0)
+                mb = static_cast<size_t>(parsed);
+        }
+    }
+    // 0 = no cap; a cap under 64 MB would thrash a single screen, so it is raised to that
+    if (mb == 0)
+        return 0;
+    return std::max<size_t>(mb, 64) * 1024 * 1024;
+}
+
+void ThingTypeManager::enforceTextureCap()
+{
+    const size_t limit = getTextureCacheLimitBytes();
+    if (limit == 0 || ThingType::getAllTextureBytes() <= limit)
+        return;
+    // oldest use first; what was drawn in the last seconds stays (the next frames need it)
+    const time_t now = g_clock.seconds();
+    std::vector<ThingType*> loaded;
+    for (int category = 0; category < ThingLastCategory; ++category) {
+        for (const ThingTypePtr& thingType : m_thingTypes[category]) {
+            if (thingType && thingType->isLoaded() && thingType->getLastUsage() + CapGraceSeconds < now)
+                loaded.push_back(thingType.get());
+        }
+    }
+    std::sort(loaded.begin(), loaded.end(), [](ThingType* a, ThingType* b) { return a->getLastUsage() < b->getLastUsage(); });
+    const size_t target = limit - limit / 10; // leave room, so the next check does not start again at once
+    for (ThingType* thingType : loaded) {
+        if (ThingType::getAllTextureBytes() <= target)
+            break;
+        thingType->unload();
+        ++m_textureEvictions;
+    }
+}
+
