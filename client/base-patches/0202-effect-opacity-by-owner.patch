+// Cinders of Chaos (base patch 0202): who an effect belongs to and how opaque it is drawn, pure and header-only so
+// client/tools/chaosfxowner_test.cpp can run it without the engine. The engine already keeps one alpha per effect source
+// (Client::m_effectAlphas: own, other players, monsters, boss area) and Effect / Missile pick one with their source, but the
+// 10.98 server sends no source byte, so the stock draw used the "own" alpha for everything. Here an effect or missile carries
+// the source the server marked it with (the Lua call g_map.markEffectSources, fed by the extended opcode of game_effectopacity),
+// and one that was never marked counts as "other". Warning effects of an id list (boss telegraphs) always use the slot 0 alpha,
+// which nothing changes (1.0). All numbers are the engine's Otc::MagicEffectSources.
+#ifndef CHAOSFXOWNER_H
+#define CHAOSFXOWNER_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdlib>
+#include <unordered_set>
+#include <vector>
+
+namespace chaos {
+namespace fxowner {
+
+constexpr int kSourceDefault = 0;   // not marked; its alpha slot is never set, so 1.0
+constexpr int kSourceOwn = 1;
+constexpr int kSourceOther = 2;
+constexpr int kSourceMonster = 3;
+constexpr int kSourceBoss = 4;
+
+constexpr int kKindEffect = 0;      // a mark is {kind, dx, dy, id}
+constexpr int kKindMissile = 1;     // a missile: dx, dy name the tile it starts on
+constexpr int kMatchRadius = 3;     // an engine that shifts a big effect moves it by a tile or two: look this far around the mark
+constexpr int kMaxMarks = 400;      // marks read from one message; the rest stay "other"
+constexpr int kMaxOffset = 127;     // |dx|, |dy| of a mark
+constexpr int kMaxId = 65535;       // effect and missile ids are 16 bit
+
+// a source number from a script: 1..4 as is, anything else is "not marked"
+inline int sanitizeSource(int source)
+{
+    return (source >= kSourceOwn && source <= kSourceBoss) ? source : kSourceDefault;
+}
+
+// the alpha slot of an effect. exempt (a warning): slot 0. A marked effect keeps its mark. An unmarked effect: slot 0 when the
+// server sends the source itself (the stock path), else "other" (the stock draw used "own" here).
+inline int pickSource(int tagged, bool serverSendsSource, bool exempt)
+{
+    if (exempt)
+        return kSourceDefault;
+    if (tagged != kSourceDefault)
+        return tagged;
+    return serverSendsSource ? kSourceDefault : kSourceOther;
+}
+
+inline float clamp01(float v)
+{
+    if (!std::isfinite(v))
+        return 1.0f;
+    return std::max(0.0f, std::min(1.0f, v));
+}
+
+// the colour alpha byte of an alpha; a missile has its own slider on top of its source's
+inline int alphaByte(float sourceAlpha, float missileAlpha = 1.0f)
+{
+    return static_cast<int>(clamp01(sourceAlpha) * clamp01(missileAlpha) * 255.0f);
+}
+
+struct Mark
+{
+    int kind;
+    int dx;
+    int dy;
+    int id;
+};
+
+// flat {kind, dx, dy, id, kind, dx, dy, id, ...} -> marks. A group with a bad kind, a far offset or an id out of 1..65535 is
+// skipped, a partial group at the end too, and at most kMaxMarks groups are read. true when at least one mark is left.
+inline bool decode(const std::vector<int>& flat, std::vector<Mark>& out)
+{
+    out.clear();
+    size_t groups = flat.size() / 4;
+    if (groups > static_cast<size_t>(kMaxMarks))
+        groups = static_cast<size_t>(kMaxMarks);
+    for (size_t i = 0; i < groups; ++i) {
+        const Mark m{ flat[4 * i], flat[4 * i + 1], flat[4 * i + 2], flat[4 * i + 3] };
+        if (m.kind != kKindEffect && m.kind != kKindMissile)
+            continue;
+        if (std::abs(m.dx) > kMaxOffset || std::abs(m.dy) > kMaxOffset)
+            continue;
+        if (m.id < 1 || m.id > kMaxId)
+            continue;
+        out.push_back(m);
+    }
+    return !out.empty();
+}
+
+inline int distance(int dx, int dy)
+{
+    return std::max(std::abs(dx), std::abs(dy));
+}
+
+// tries the offsets around a mark nearest first: the mark's own tile, then the ring at 1, 2 ... radius (rows top to bottom, left
+// to right inside a ring). take(dx, dy) -> true when it used that tile; the walk stops there. true when something was taken.
+template <class F>
+inline bool findNearest(int radius, F take)
+{
+    for (int ring = 0; ring <= radius; ++ring) {
+        for (int dy = -ring; dy <= ring; ++dy) {
+            for (int dx = -ring; dx <= ring; ++dx) {
+                if (distance(dx, dy) != ring)
+                    continue;
+                if (take(dx, dy))
+                    return true;
+            }
+        }
+    }
+    return false;
+}
+
+// how well a flying missile fits a mark (distance = tiles between the missile's start and the marked tile): -1 not at all, else
+// lower is better. The same id within kMatchRadius; another id only on the tile or next to it, because the server swaps the id
+// of a stock missile when a script sends one (src-patch 0045), so the id a script named is not always the id that flies.
+inline int missileScore(bool sameId, int distance)
+{
+    if (distance < 0)
+        return -1;
+    if (sameId && distance <= kMatchRadius)
+        return distance;
+    if (!sameId && distance <= 1)
+        return 100 + distance;
+    return -1;
+}
+
+// effect ids that ignore the opacity (warnings): Lua g_client.setEffectAlphaExempt(id, on)
+class ExemptIds
+{
+public:
+    void set(int id, bool on)
+    {
+        if (on)
+            m_ids.insert(id);
+        else
+            m_ids.erase(id);
+    }
+    bool has(int id) const { return !m_ids.empty() && m_ids.count(id) > 0; }
+    void clear() { m_ids.clear(); }
+    size_t size() const { return m_ids.size(); }
+
+private:
+    std::unordered_set<int> m_ids;
+};
+
+} // namespace fxowner
+} // namespace chaos
+
+#endif
