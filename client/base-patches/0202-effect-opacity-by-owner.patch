+// Chaos (base patch 0202): `flat` is {kind, dx, dy, id, ...} (chaosfxowner.h) around the tile (baseX, baseY, baseZ). Each mark takes
+// the nearest effect of that id that has no source yet (the mark's own tile first, then up to kMatchRadius tiles around it: an
+// engine that shifts a big effect sends it a tile or two off the tile the script named), or the best fitting missile that starts
+// there (missileScore: the same id first, then the nearest), and gives it `source`. Returns how many marks found their effect or missile.
+int Effect::markSources(int source, int baseX, int baseY, int baseZ, const std::vector<int>& flat)
+{
+    namespace fx = chaos::fxowner;
+    source = fx::sanitizeSource(source);
+    if (source == fx::kSourceDefault || baseZ < 0 || baseZ > 15)
+        return 0;
+    std::vector<fx::Mark> marks;
+    if (!fx::decode(flat, marks))
+        return 0;
+    int marked = 0;
+    for (const fx::Mark& m : marks) {
+        const int x = baseX + m.dx;
+        const int y = baseY + m.dy;
+        if (m.kind == fx::kKindEffect) {
+            const bool took = fx::findNearest(fx::kMatchRadius, [&](int dx, int dy) {
+                const int tx = x + dx, ty = y + dy;
+                if (tx < 0 || ty < 0 || tx > 65534 || ty > 65534)
+                    return false;
+                const TilePtr tile = g_map.getTile(Position(static_cast<uint16>(tx), static_cast<uint16>(ty), static_cast<uint8>(baseZ)));
+                if (!tile)
+                    return false;
+                for (const EffectPtr& effect : tile->getEffects()) {
+                    if (effect->getId() == static_cast<uint32>(m.id) && effect->getSource() == Otc::ME_SOURCE_DEFAULT) {
+                        effect->setSource(static_cast<Otc::MagicEffectSources>(source));
+                        return true;
+                    }
+                }
+                return false;
+            });
+            if (took)
+                ++marked;
+        } else {
+            MissilePtr best;
+            int bestScore = -1;
+            for (const MissilePtr& missile : g_map.getFloorMissiles(baseZ)) {
+                if (missile->getEffectSource() != Otc::ME_SOURCE_DEFAULT)
+                    continue;
+                const Position from = missile->getSource();
+                const int score = fx::missileScore(missile->getId() == static_cast<uint32>(m.id),
+                                                   fx::distance(static_cast<int>(from.x) - x, static_cast<int>(from.y) - y));
+                if (score >= 0 && (bestScore < 0 || score < bestScore)) {
+                    bestScore = score;
+                    best = missile;
+                }
+            }
+            if (best) {
+                best->setEffectSource(static_cast<Otc::MagicEffectSources>(source));
+                ++marked;
+            }
+        }
+    }
+    return marked;
+}
