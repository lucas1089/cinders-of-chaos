+-- Chaos (base-patch 0052): a spell entry lists the server's vocation ids (game_chaosspells: the Chaos spells as the
+-- server has them, the stock entries remapped and corrected in spellfix.lua), so a class casts it when its own id is
+-- listed. The old map (the base class plus its promotion) let a Mystic try Elementalist-only spells and kept the
+-- Illusionist, Berserker and Beastmaster from their own Chaos spells. Runes keep the map (their lists are stock ids).
+local function canCastByServerVoc(spellVocations, serverVocId)
+  return serverVocId ~= nil and type(spellVocations) == "table" and table.contains(spellVocations, serverVocId)
+end
+
 _Helper.canUseByServerVoc = function(spellVocations, serverVocId)
-  return canUseByServerVoc(spellVocations, serverVocId)
+  return canCastByServerVoc(spellVocations, serverVocId)
 end
 
