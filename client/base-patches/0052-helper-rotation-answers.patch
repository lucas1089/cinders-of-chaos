+-- pre-cooldowns go through _Helper.onSpellCooldown / onSpellGroupCooldown, which only set the time.
+local helperRotation = nil
+function _Helper.getRotation()
+  if not helperRotation and ChaosHelperRotation and ChaosHelperRotation.new then
+    helperRotation = ChaosHelperRotation.new()
+  end
+  return helperRotation
+end
+
 function onSpellCooldown(spellId, delay)
   spellsCooldown[spellId] = g_clock.millis() + delay
+  local rotation = _Helper.getRotation()
+  if rotation then
+    ChaosHelperRotation.confirmSpell(rotation, spellId, g_clock.millis())
+  end
 end
 
 function onSpellGroupCooldown(groupId, delay)
   groupsCooldown[groupId] = g_clock.millis() + delay
+  local rotation = _Helper.getRotation()
+  if rotation then
+    ChaosHelperRotation.confirmGroup(rotation, groupId, g_clock.millis())
