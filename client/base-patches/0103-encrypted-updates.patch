+// Cinders of Chaos encrypted update blobs (client/base-patches/0103-encrypted-updates.patch, client/BASE.md
+// "Encrypted updates", client/MANIFEST.md "Signed updater"). Every file the signed updater downloads is one blob in the
+// per-file variant of the chaos.pack format (util/chaospack.h, base patch 0102) with its own magic and HKDF labels:
+//
+//   header (28) = "CHUB" | version 1 | flags (bit 0: development key) | 2 reserved | 12-byte nonce | plaintext length
+//                 (u64 LE);  blob = header | AES-256-GCM(plaintext, AAD = header) | 16-byte tag
+//   enc key     = HKDF-SHA256(client guard key, "CindersOfChaos/update/v1", "chaos-update-blob-aes-256-gcm")
+//   nonce       = HMAC-SHA256(HKDF(..., "chaos-update-blob-nonce"), plaintext)[:12]  (deterministic per content)
+//
+// The blobs stay encrypted on disk (chaos_update/files/ in the write dir). At start the engine decrypts them into one
+// in-memory store-only ZIP (StoreZip below, each file read straight into its slot and decrypted in place) and mounts
+// it in front of the pack. Byte-identical to the publisher client/tools/update_crypt.py; client/tools/chaosblob_test.cpp
+// checks a fixed vector, round trip, wrong key, tamper, the streaming decryptor and the ZIP writer.
+//
+// Header only, so chaosblob_test.cpp builds it on its own against OpenSSL (with chaospack.h from base patch 0102).
+#pragma once
+
+#include "chaospack.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <openssl/evp.h>
+
+namespace chaosblob
+{
+
+constexpr char MAGIC[4] = { 'C', 'H', 'U', 'B' };
+constexpr uint8_t VERSION = 1;
+constexpr size_t HEADER_LEN = 28;
+constexpr size_t NONCE_LEN = 12;
+constexpr size_t TAG_LEN = 16;
+constexpr size_t OVERHEAD = HEADER_LEN + TAG_LEN;
+constexpr uint8_t FLAG_DEV = 0x01;
+
+inline const std::string& hkdfSalt() { static const std::string s = "CindersOfChaos/update/v1"; return s; }
+inline const std::string& infoEnc() { static const std::string s = "chaos-update-blob-aes-256-gcm"; return s; }
+inline const std::string& infoNonce() { static const std::string s = "chaos-update-blob-nonce"; return s; }
+
+// the decryption key the engine keeps (never the client guard key itself): 32 bytes, "" on failure
+inline std::string deriveEncKey(const std::string& clientKey)
+{
+    if (clientKey.size() != 32)
+        return std::string();
+    std::string k = chaospack::hkdfSha256(clientKey, hkdfSalt(), infoEnc(), 32);
+    return k.size() == 32 ? k : std::string();
+}
+
+struct Header
+{
+    uint8_t flags = 0;
+    uint64_t plainLen = 0;
+};
+
+inline bool parseHeader(const unsigned char* p, size_t n, Header& h)
+{
+    if (n < HEADER_LEN || std::memcmp(p, MAGIC, 4) != 0 || p[4] != VERSION)
+        return false;
+    h.flags = p[5];
+    h.plainLen = chaospack::readU64LE(p + 20);
+    return true;
+}
+
+// Encrypts one file into a blob (tests; the publisher is update_crypt.py). Deterministic.
+inline bool encrypt(const std::string& clientKey, const std::string& plaintext, bool devKey, std::string& out)
+{
+    if (clientKey.size() != 32)
+        return false;
+    const std::string encKey = deriveEncKey(clientKey);
+    const std::string nonceKey = chaospack::hkdfSha256(clientKey, hkdfSalt(), infoNonce(), 32);
+    const std::string nonce = chaospack::hmacSha256(nonceKey, plaintext).substr(0, NONCE_LEN);
+    if (encKey.empty() || nonce.size() != NONCE_LEN)
+        return false;
+    std::string header(MAGIC, 4);
+    header.push_back(static_cast<char>(VERSION));
+    header.push_back(static_cast<char>(devKey ? FLAG_DEV : 0));
+    header.push_back('\0');
+    header.push_back('\0');
+    header += nonce;
+    chaospack::writeU64LE(header, plaintext.size());
+    std::string ciphertext, tag;
+    if (!chaospack::aesGcmEncrypt(encKey, nonce, header, plaintext, ciphertext, tag))
+        return false;
+    out = header + ciphertext + tag;
+    return true;
+}
+
+// Streaming AES-256-GCM decryption of one blob: begin(header), update(...) over the body in any pieces (in place is
+// fine), finish(tag). Nothing it returned may be used unless finish() is true.
+class Decryptor
+{
+public:
+    Decryptor() = default;
+    ~Decryptor()
+    {
+        if (m_ctx)
+            EVP_CIPHER_CTX_free(m_ctx);
+    }
+    Decryptor(const Decryptor&) = delete;
+    Decryptor& operator=(const Decryptor&) = delete;
+
+    // encKey: deriveEncKey(); header: the blob's first HEADER_LEN bytes
+    bool begin(const std::string& encKey, const unsigned char* header, Header& h)
+    {
+        if (encKey.size() != 32 || !parseHeader(header, HEADER_LEN, h))
+            return false;
+        m_ctx = EVP_CIPHER_CTX_new();
+        int len = 0;
+        m_ok = m_ctx && EVP_DecryptInit_ex(m_ctx, EVP_aes_256_gcm(), nullptr, nullptr, nullptr) == 1 &&
+            EVP_CIPHER_CTX_ctrl(m_ctx, EVP_CTRL_GCM_SET_IVLEN, static_cast<int>(NONCE_LEN), nullptr) == 1 &&
+            EVP_DecryptInit_ex(m_ctx, nullptr, nullptr, reinterpret_cast<const unsigned char*>(encKey.data()),
+                               header + 8) == 1 &&
+            EVP_DecryptUpdate(m_ctx, nullptr, &len, header, static_cast<int>(HEADER_LEN)) == 1;
+        m_left = h.plainLen;
+        return m_ok;
+    }
+
+    bool update(const unsigned char* in, unsigned char* out, size_t n)
+    {
+        constexpr size_t CHUNK = 64u * 1024u * 1024u; // EVP lengths are int
+        if (!m_ok || n > m_left)
+            return m_ok = false;
+        for (size_t at = 0; at < n; at += CHUNK) {
+            const int k = static_cast<int>(std::min(CHUNK, n - at));
+            int outLen = 0;
+            if (EVP_DecryptUpdate(m_ctx, out + at, &outLen, in + at, k) != 1 || outLen != k)
+                return m_ok = false;
+        }
+        m_left -= n;
+        return true;
+    }
+
+    // true only when the whole body went through update() and the tag authenticates header and body
+    bool finish(const unsigned char* tag)
+    {
+        if (!m_ok || m_left != 0)
+            return false;
+        unsigned char t[TAG_LEN];
+        std::memcpy(t, tag, TAG_LEN);
+        unsigned char dummy[16];
+        int finalLen = 0;
+        m_ok = EVP_CIPHER_CTX_ctrl(m_ctx, EVP_CTRL_GCM_SET_TAG, static_cast<int>(TAG_LEN), t) == 1 &&
+            EVP_DecryptFinal_ex(m_ctx, dummy, &finalLen) == 1;
+        return m_ok;
+    }
+
+private:
+    EVP_CIPHER_CTX* m_ctx = nullptr;
+    bool m_ok = false;
+    uint64_t m_left = 0;
+};
+
+// Whole-blob decryption (tests and small files). encKey: deriveEncKey(). False on a bad format, a wrong key or any
+// changed byte.
+inline bool decrypt(const std::string& encKey, const std::string& blob, std::string& out)
+{
+    out.clear();
+    if (blob.size() < OVERHEAD)
+        return false;
+    const auto* p = reinterpret_cast<const unsigned char*>(blob.data());
+    Header h;
+    Decryptor d;
+    if (!d.begin(encKey, p, h) || h.plainLen != blob.size() - OVERHEAD)
+        return false;
+    std::string plain(static_cast<size_t>(h.plainLen), '\0');
+    if (!d.update(p + HEADER_LEN, reinterpret_cast<unsigned char*>(&plain[0]), plain.size()) ||
+        !d.finish(p + blob.size() - TAG_LEN))
+        return false;
+    out.swap(plain);
+    return true;
+}
+
+// ---- store-only ZIP in one buffer (what PhysFS mounts from memory) ----
+
+inline uint32_t crc32Update(const unsigned char* p, size_t n, uint32_t crc = 0)
+{
+    static uint32_t table[256];
+    static bool ready = false;
+    if (!ready) {
+        for (uint32_t i = 0; i < 256; ++i) {
+            uint32_t c = i;
+            for (int k = 0; k < 8; ++k)
+                c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            table[i] = c;
+        }
+        ready = true;
+    }
+    crc = ~crc;
+    for (size_t i = 0; i < n; ++i)
+        crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
+    return ~crc;
+}
+
+class StoreZip
+{
+public:
+    // the exact size of the archive of these entries (reserve it once, so the buffer never moves)
+    static uint64_t sizeFor(const std::vector<std::pair<std::string, uint64_t>>& entries)
+    {
+        uint64_t total = 22;
+        for (const auto& e : entries)
+            total += 30 + 46 + 2 * static_cast<uint64_t>(e.first.size()) + e.second;
+        return total;
+    }
+
+    // appends a local header and room for `size` bytes; returns where the data goes (fill it, then endEntry)
+    size_t beginEntry(std::vector<uint8_t>& buf, const std::string& name, uint64_t size)
+    {
+        Entry e;
+        e.name = name;
+        e.size = static_cast<uint32_t>(size);
+        e.offset = static_cast<uint32_t>(buf.size());
+        put32(buf, 0x04034b50);
+        put16(buf, 10); // version needed: stored
+        put16(buf, 0);  // flags
+        put16(buf, 0);  // method: stored
+        put16(buf, 0);  // time
+        put16(buf, 0x21); // date 1980-01-01
+        put32(buf, 0);  // crc, set by endEntry
+        put32(buf, e.size);
+        put32(buf, e.size);
+        put16(buf, static_cast<uint16_t>(name.size()));
+        put16(buf, 0);
+        buf.insert(buf.end(), name.begin(), name.end());
+        const size_t at = buf.size();
+        buf.resize(at + static_cast<size_t>(size));
+        m_entries.push_back(e);
+        return at;
+    }
+
+    void endEntry(std::vector<uint8_t>& buf, uint32_t crc)
+    {
+        Entry& e = m_entries.back();
+        e.crc = crc;
+        set32(buf, e.offset + 14, crc);
+    }
+
+    void finish(std::vector<uint8_t>& buf)
+    {
+        const uint32_t cdStart = static_cast<uint32_t>(buf.size());
+        for (const Entry& e : m_entries) {
+            put32(buf, 0x02014b50);
+            put16(buf, 20);
+            put16(buf, 10);
+            put16(buf, 0);
+            put16(buf, 0);
+            put16(buf, 0);
+            put16(buf, 0x21);
+            put32(buf, e.crc);
+            put32(buf, e.size);
+            put32(buf, e.size);
+            put16(buf, static_cast<uint16_t>(e.name.size()));
+            put16(buf, 0);
+            put16(buf, 0);
+            put16(buf, 0);
+            put16(buf, 0);
+            put32(buf, 0);
+            put32(buf, e.offset);
+            buf.insert(buf.end(), e.name.begin(), e.name.end());
+        }
+        const uint32_t cdSize = static_cast<uint32_t>(buf.size()) - cdStart;
+        put32(buf, 0x06054b50);
+        put16(buf, 0);
+        put16(buf, 0);
+        put16(buf, static_cast<uint16_t>(m_entries.size()));
+        put16(buf, static_cast<uint16_t>(m_entries.size()));
+        put32(buf, cdSize);
+        put32(buf, cdStart);
+        put16(buf, 0);
+    }
+
+    // a ZIP without ZIP64: below 4 GB and 65535 entries
+    static bool fits(uint64_t total, size_t count) { return total < 0xFFFFFFF0ull && count < 0xFFFF; }
+
+private:
+    struct Entry
+    {
+        std::string name;
+        uint32_t size = 0, offset = 0, crc = 0;
+    };
+    std::vector<Entry> m_entries;
+
+    static void put16(std::vector<uint8_t>& b, uint16_t v)
+    {
+        b.push_back(static_cast<uint8_t>(v & 0xFF));
+        b.push_back(static_cast<uint8_t>(v >> 8));
+    }
+    static void put32(std::vector<uint8_t>& b, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            b.push_back(static_cast<uint8_t>((v >> (8 * i)) & 0xFF));
+    }
+    static void set32(std::vector<uint8_t>& b, size_t at, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+            b[at + i] = static_cast<uint8_t>((v >> (8 * i)) & 0xFF);
+    }
+};
+
+} // namespace chaosblob
