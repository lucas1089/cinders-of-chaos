+// Cinders of Chaos (base patch 0193): wings centred on the body they are drawn with. Pure and header-only so
+// client/tools/chaoswingfit_test.cpp can run it without the engine.
+// A look's wings are drawn at the creature's place and its body 6 px up and left of it (GameWingOffset). The wings'
+// art was placed against one body, so on a class look that stands further left or right in its tile the wings sit off
+// its back. client_chaos_wingfit hands the engine two small tables made from the pair (gen_wing_centres.py): per look
+// and direction the x of the body's torso, per wings look and direction the x of the wings' pair centre, both in
+// sprite pixels at 1x from the creature's place, the look's own displacement taken out. The shift is
+//   bodyCentre - wingsCentre - lift
+// (lift = the 6 px the body is drawn up and left of the wings): it moves the wings' pair centre onto the torso.
+// A look or wings missing from a table gets no shift (the draw as before).
+#ifndef CHAOSWINGFIT_H
+#define CHAOSWINGFIT_H
+
+#include <array>
+#include <climits>
+#include <unordered_map>
+
+namespace chaos {
+namespace wingfit {
+
+constexpr int kLiftPx = 6;      // GameWingOffset: the body is drawn this many px up and left of the wings
+constexpr int kMaxShiftPx = 64; // a larger shift is a bad table row: ignored
+constexpr int kMaxCentrePx = 256;
+constexpr int kUnset = INT_MIN;
+
+typedef std::array<int, 4> Row;  // north, east, south, west
+
+struct Tables {
+    std::unordered_map<int, Row> bodies;
+    std::unordered_map<int, Row> wings;
+};
+
+inline Tables& tables()
+{
+    static Tables t;
+    return t;
+}
+
+inline Row emptyRow()
+{
+    Row r;
+    r.fill(kUnset);
+    return r;
+}
+
+inline bool setCentre(std::unordered_map<int, Row>& map, int look, int direction, int px)
+{
+    if (look <= 0 || direction < 0 || direction > 3 || px < -kMaxCentrePx || px > kMaxCentrePx)
+        return false;
+    auto it = map.find(look);
+    if (it == map.end())
+        it = map.emplace(look, emptyRow()).first;
+    it->second[direction] = px;
+    return true;
+}
+
+inline bool setBodyCentre(int look, int direction, int px) { return setCentre(tables().bodies, look, direction, px); }
+inline bool setWingsCentre(int wings, int direction, int px) { return setCentre(tables().wings, wings, direction, px); }
+
+inline void clearCentres()
+{
+    tables().bodies.clear();
+    tables().wings.clear();
+}
+
+inline bool find(const std::unordered_map<int, Row>& map, int id, int direction, int& px)
+{
+    if (direction < 0 || direction > 3)
+        return false;
+    auto it = map.find(id);
+    if (it == map.end() || it->second[direction] == kUnset)
+        return false;
+    px = it->second[direction];
+    return true;
+}
+
+// the x shift, in sprite pixels at 1x, to add to the wings' destination; 0 without both rows. `lift` is the
+// GameWingOffset lift (kLiftPx when the feature is on, else 0).
+inline int shiftX(int bodyLook, int wingsLook, int direction, int lift)
+{
+    int body = 0, wings = 0;
+    if (!find(tables().bodies, bodyLook, direction, body) || !find(tables().wings, wingsLook, direction, wings))
+        return 0;
+    const int shift = body - wings - lift;
+    return (shift < -kMaxShiftPx || shift > kMaxShiftPx) ? 0 : shift;
+}
+
+}  // namespace wingfit
+}  // namespace chaos
+
+#endif
