@@ -0,0 +1,81 @@
+// Cinders of Chaos (base patch 0152): additive blend for bright spell effects, pure and header-only so
+// client/tools/chaosglow_test.cpp can run it without the engine. The effects of the glow list (fire, energy, holy and
+// arcane effects; the list comes from Lua, game_visualfx) are not drawn where the map pass meets them: the tile pass hands
+// them to a Batch and MapView::drawFloor draws the whole batch once, after everything else of the floor, between one start
+// and one end of an additive blend. That is the only place the blend (and the draw cache) changes, so a floor with any
+// glowing effect costs two cache flushes and two blend changes however many effects play, and a floor with none costs nothing.
+#ifndef CHAOSGLOW_H
+#define CHAOSGLOW_H
+
+#include <bitset>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+namespace chaos {
+namespace glow {
+
+constexpr size_t kMaxDeferred = 64;  // glowing effects held per floor; the next ones draw with the normal blend
+constexpr int kFlushesPerGroup = 2;  // draw cache flushes around the one additive group (start and end)
+
+// the set of effect ids that glow, filled from Lua (one call per id, like the spell light table of base patch 0127)
+class IdSet
+{
+public:
+    void clear() { m_bits.reset(); }
+    void add(int id)
+    {
+        if (id > 0 && id < static_cast<int>(kIds))
+            m_bits.set(static_cast<size_t>(id));
+    }
+    bool contains(int id) const
+    {
+        return id > 0 && id < static_cast<int>(kIds) && m_bits.test(static_cast<size_t>(id));
+    }
+    size_t size() const { return m_bits.count(); }
+
+private:
+    static constexpr size_t kIds = 65536;
+    std::bitset<kIds> m_bits;
+};
+
+// the one decision whether an effect is held for the additive group: the option is on (the spell light option, sent as
+// the engine switch), the map pass is collecting (a floor is being queued) and the id is in the glow list
+inline bool wantsGlow(bool optionOn, bool collecting, const IdSet& ids, int id)
+{
+    return optionOn && collecting && ids.contains(id);
+}
+
+// the effects held for the group, in the order the tiles handed them over; at most kMaxDeferred, so a screen full of
+// effects cannot make the group (and its overdraw) grow without bound
+template <class T>
+class Batch
+{
+public:
+    // false when the batch is full: the caller then draws that effect with the normal blend
+    bool add(T item)
+    {
+        if (m_items.size() >= kMaxDeferred)
+            return false;
+        m_items.push_back(std::move(item));
+        return true;
+    }
+    void clear() { m_items.clear(); }
+    bool empty() const { return m_items.empty(); }
+    size_t size() const { return m_items.size(); }
+    const std::vector<T>& items() const { return m_items; }
+
+private:
+    std::vector<T> m_items;
+};
+
+// draw cache flushes the group of n held effects costs: none for no effects, else the same two for one or for sixty
+inline int flushCount(size_t n)
+{
+    return n == 0 ? 0 : kFlushesPerGroup;
+}
