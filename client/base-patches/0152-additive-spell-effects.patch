+void DrawQueueConditionGlow::start(DrawQueue*)
+{
+    // the cache was flushed by DrawQueue::draw before this call: the blend changes between two batches
+    g_painter->setCompositionMode(Painter::CompositionMode_AddAlpha);
+}
