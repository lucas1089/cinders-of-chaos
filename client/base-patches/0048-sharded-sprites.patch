+bool SpriteManager::loadShardedSpr(const std::string& indexFile)
+{
+    uint32 signature = 0;
+    uint32 total = 0;
+    std::vector<SprShard> shards;
+
+    try {
+        // the index is a small text file (format: spr_shards.py); safe = true: never decrypted or rewritten
+        std::istringstream in(g_resources.readFileContents(indexFile, true));
+        const auto slash = indexFile.find_last_of('/');
+        const std::string dir = slash == std::string::npos ? std::string() : indexFile.substr(0, slash + 1);
+        bool haveFormat = false, haveSignature = false, haveTotal = false;
+        std::string line;
+        while (std::getline(in, line)) {
+            stdext::trim(line);
+            if (line.empty() || line[0] == '#')
+                continue;
+            if (!haveFormat) {
+                if (line != "chaos-spr-shards 1")
+                    stdext::throw_exception("unknown index format");
+                haveFormat = true;
+                continue;
+            }
+            std::istringstream words(line);
+            std::string key;
+            words >> key;
+            if (key == "signature" && (words >> signature)) {
+                haveSignature = true;
+            } else if (key == "sprites" && (words >> total)) {
+                haveTotal = true;
+            } else if (key == "per-shard") {
+                // informative (the ranges below decide)
+            } else if (key == "shard") {
+                SprShard shard;
+                std::string name, sha;
+                if (!(words >> shard.firstId >> shard.count >> name >> shard.size >> sha))
+                    stdext::throw_exception("bad shard line: " + line);
+                if (name.empty() || name[0] == '.' || name.find('/') != std::string::npos ||
+                    name.find('\\') != std::string::npos)
+                    stdext::throw_exception("bad shard file name: " + name);
+                const uint32 expectFirst = shards.empty() ? 1 : shards.back().firstId + shards.back().count;
+                if (shard.firstId != expectFirst)
+                    stdext::throw_exception(stdext::format("shard %s starts at %d, expected %d", name, shard.firstId, expectFirst));
+                if (shard.count > (0xFFFFFFFFu - 8) / 4 || shard.size < 8 + 4 * shard.count)
+                    stdext::throw_exception("shard too small for its sprites: " + name);
+                // resolved here, on the main thread: the workers only call PhysFS with the final path
+                shard.path = g_resources.resolvePath(dir + name);
+                PHYSFS_Stat st;
+                if (!PHYSFS_stat(shard.path.c_str(), &st) || st.filetype != PHYSFS_FILETYPE_REGULAR)
+                    stdext::throw_exception("missing shard " + name);
+                if (st.filesize != static_cast<PHYSFS_sint64>(shard.size))
+                    stdext::throw_exception(stdext::format("shard %s has %d bytes, the index says %d", name,
+                                                           static_cast<int>(st.filesize), static_cast<int>(shard.size)));
+                shard.lock = std::make_unique<std::mutex>();
+                shard.state = std::make_unique<std::atomic<int>>(0);
+                shards.push_back(std::move(shard));
+            } else {
+                stdext::throw_exception("bad index line: " + line);
+            }
+        }
+        if (!haveFormat || !haveSignature || !haveTotal || shards.empty())
+            stdext::throw_exception("incomplete index");
+        if (shards.back().firstId + shards.back().count - 1 != total)
+            stdext::throw_exception("the shards do not hold exactly the sprites the index names");
+    } catch (std::exception& e) {
+        g_logger.error(stdext::format("Sprite shard index '%s': %s", indexFile, e.what()));
+        return false;
+    }
+
+    m_spriteAddresses.assign(total, 0);
+    m_shards = std::move(shards);
+    m_signature = signature;
+    m_spritesCount = static_cast<int>(total);
+    m_spritesOffset = 0;
+    m_spritesFile = nullptr;
+    m_loaded = true;
+
+    // the shards' address tables are read in the background, several at once; a sprite needed before its shard is
+    // read reads that shard on the spot (ensureShard)
+    size_t workers = 0;
+#ifndef __EMSCRIPTEN__
+    const unsigned hardware = std::thread::hardware_concurrency();
+    workers = std::min<size_t>({ m_shards.size(), static_cast<size_t>(hardware ? hardware : 2), static_cast<size_t>(8) });
+#endif
+    m_shardStop = false;
+    m_shardNext = 0;
+    m_shardBackgroundMillis = -1;
+    m_shardsLogged = false;
+    m_shardStartMicros = stdext::micros();
+    m_shardWorkersLeft = static_cast<int>(workers);
+    for (size_t t = 0; t < workers; ++t)
+        m_shardWorkers.emplace_back(&SpriteManager::shardWorker, this);
+    return true;
+}
+
+bool SpriteManager::ensureShard(SprShard& shard)
+{
+    const int known = shard.state->load(std::memory_order_acquire);
+    if (known != 0)
+        return known == 1;
+    std::lock_guard<std::mutex> guard(*shard.lock);
+    if (shard.state->load(std::memory_order_relaxed) != 0)
+        return shard.state->load(std::memory_order_relaxed) == 1;
+
+    bool ok = false;
+    try {
+        PHYSFS_File* handle = PHYSFS_openRead(shard.path.c_str());
+        if (!handle)
+            stdext::throw_exception("cannot open the file");
+        FileStreamPtr f = std::make_shared<FileStream>(shard.path, handle, false);
+        if (f->size() != shard.size)
+            stdext::throw_exception("the file changed size after the index was read");
+        const uint32 sig = f->getU32();
+        const uint32 count = f->getU32();
+        if (sig != m_signature || count != shard.count)
+            stdext::throw_exception("header does not match the index");
+        uint32* addresses = m_spriteAddresses.data() + (shard.firstId - 1);
+        const uint32 tableBytes = shard.count * 4;
+        if (tableBytes > 0 && f->read(addresses, 1, tableBytes) != static_cast<int>(tableBytes))
+            stdext::throw_exception("incomplete address table");
+        for (uint32 k = 0; k < shard.count; ++k) {
+            const uint32 address = stdext::readULE32(reinterpret_cast<const uint8*>(&addresses[k]));
+            if (address != 0 && (address < 8 + tableBytes || address > shard.size - 5))
+                stdext::throw_exception(stdext::format("sprite %d has an address outside the shard", shard.firstId + k));
+            addresses[k] = address;
+        }
+        shard.file = f;
+        ok = true;
+    } catch (std::exception& e) {
+        shard.error = e.what();
+    } catch (...) {
+        shard.error = "unknown error";
+    }
+    if (!ok)
+        std::fill_n(m_spriteAddresses.begin() + (shard.firstId - 1), shard.count, 0u);
+    shard.state->store(ok ? 1 : 2, std::memory_order_release);
+    return ok;
+}
+
+void SpriteManager::shardWorker()
+{
+    for (size_t i = m_shardNext++; i < m_shards.size() && !m_shardStop; i = m_shardNext++)
+        ensureShard(m_shards[i]);
+    if (--m_shardWorkersLeft == 0)
+        m_shardBackgroundMillis = static_cast<int>((stdext::micros() - m_shardStartMicros) / 1000);
+}
+
+void SpriteManager::stopShardWorkers()
+{
+    m_shardStop = true;
+    for (auto& worker : m_shardWorkers) {
+        if (worker.joinable())
+            worker.join();
+    }
+    m_shardWorkers.clear();
+}
