+# Cinders of Chaos client guard (base patch 0035, client/BASE.md "Client guard"; server src-patch 0021).
+# CHAOS_CLIENT_BUILD: the build number the client sends at login (1..65535; the server's clientGuardBuilds and the
+# updater's min_package / Services.update.package count the same builds).
+# The handshake key: the environment variable CHAOS_CLIENT_KEY (64 hex digits; the Windows workflows pass the GitHub
+# secret of that name), else the file CHAOS_CLIENT_KEY_FILE, else the public DEVELOPMENT key, which a server refuses
+# unless its config says clientGuardAllowDevKey = true. The key is read at configure time, never cached and written
+# only into the build folder (chaosguard/chaosguard_key.h), shuffled and XOR-masked with a random mask: obfuscation,
+# not protection (whoever has the binary can recover it).
+set(CHAOS_CLIENT_BUILD "1" CACHE STRING "Cinders of Chaos client build number (1..65535), sent at login")
+set(CHAOS_CLIENT_KEY_FILE "" CACHE FILEPATH "File holding the client guard key (64 hex digits)")
+if(NOT CHAOS_CLIENT_BUILD MATCHES "^[0-9]+$" OR CHAOS_CLIENT_BUILD LESS 1 OR CHAOS_CLIENT_BUILD GREATER 65535)
+    message(FATAL_ERROR "CHAOS_CLIENT_BUILD must be a number from 1 to 65535")
+endif()
+set(_chaos_key "$ENV{CHAOS_CLIENT_KEY}")
+if(_chaos_key STREQUAL "" AND CHAOS_CLIENT_KEY_FILE)
+    file(READ "${CHAOS_CLIENT_KEY_FILE}" _chaos_key)
+endif()
+string(STRIP "${_chaos_key}" _chaos_key)
+string(TOLOWER "${_chaos_key}" _chaos_key)
+set(_chaos_dev 0)
+if(_chaos_key STREQUAL "")
+    # the bytes of "DEV-KEY-cinders-of-chaos-UNSAFE!" (server ClientGuard::DEV_KEY_HEX)
+    set(_chaos_key "4445562d4b45592d63696e646572732d6f662d6368616f732d554e5341464521")
+    set(_chaos_dev 1)
+    message(WARNING "Client guard: no CHAOS_CLIENT_KEY; this client gets the public DEVELOPMENT key (test servers only)")
+else()
+    string(LENGTH "${_chaos_key}" _chaos_len)
+    if(NOT _chaos_key MATCHES "^[0-9a-f]+$" OR NOT _chaos_len EQUAL 64)
+        message(FATAL_ERROR "Client guard: CHAOS_CLIENT_KEY must be 64 hex digits (32 bytes)")
+    endif()
+endif()
+string(SHA256 _chaos_fp "chaos-client-guard-fingerprint:${_chaos_key}")
+set(_chaos_hdr "${CMAKE_BINARY_DIR}/chaosguard/chaosguard_key.h")
+set(_chaos_old "")
+if(EXISTS "${_chaos_hdr}")
+    file(STRINGS "${_chaos_hdr}" _chaos_old REGEX "^// fingerprint ")
+endif()
+if(NOT _chaos_old STREQUAL "// fingerprint ${_chaos_fp}")
+    string(RANDOM LENGTH 64 ALPHABET "0123456789abcdef" _chaos_mask)
+    string(RANDOM LENGTH 2 ALPHABET "0123456789" _chaos_shift)
+    math(EXPR _chaos_shift "${_chaos_shift} % 32")
+    set(_chaos_x "")
+    set(_chaos_m "")
+    set(_chaos_p "")
+    foreach(_i RANGE 31)
+        math(EXPR _p "(${_i} * 13 + ${_chaos_shift}) % 32")
+        math(EXPR _ko "${_p} * 2")
+        math(EXPR _mo "${_i} * 2")
+        string(SUBSTRING "${_chaos_key}" ${_ko} 2 _kb)
+        string(SUBSTRING "${_chaos_mask}" ${_mo} 2 _mb)
+        math(EXPR _xb "0x${_kb} ^ 0x${_mb}" OUTPUT_FORMAT HEXADECIMAL)
+        string(APPEND _chaos_x "${_xb},")
+        string(APPEND _chaos_m "0x${_mb},")
+        string(APPEND _chaos_p "${_p},")
+    endforeach()
+    file(WRITE "${_chaos_hdr}"
+        "// generated by src/client/CMakeLists.txt (Cinders of Chaos client guard); never commit this file\n"
+        "// fingerprint ${_chaos_fp}\n"
+        "#pragma once\n"
+        "#define CHAOS_GUARD_KEY_IS_DEV ${_chaos_dev}\n"
+        "namespace chaosguard_key {\n"
+        "static const volatile unsigned char x[32] = {${_chaos_x}};\n"
+        "static const volatile unsigned char m[32] = {${_chaos_m}};\n"
+        "static const volatile unsigned char p[32] = {${_chaos_p}};\n"
+        "}\n")
+endif()
+unset(_chaos_key)
+unset(_chaos_mask)
+include_directories("${CMAKE_BINARY_DIR}/chaosguard")
+add_definitions(-DCHAOS_CLIENT_BUILD=${CHAOS_CLIENT_BUILD})
+if(_chaos_dev)
+    message(STATUS "Client guard: build ${CHAOS_CLIENT_BUILD}, DEVELOPMENT key")
+else()
+    message(STATUS "Client guard: build ${CHAOS_CLIENT_BUILD}, key from CHAOS_CLIENT_KEY / CHAOS_CLIENT_KEY_FILE")
+endif()
+set(client_SOURCES ${client_SOURCES}
+    ${CMAKE_CURRENT_LIST_DIR}/chaosguard.h
+    ${CMAKE_CURRENT_LIST_DIR}/chaosguard_builtin.h
+)
