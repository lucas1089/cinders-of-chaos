@@ -0,0 +1,118 @@
+// Cinders of Chaos client guard: the client half of server src-patch 0021 (client/base-patches/0035-client-guard.patch,
+// client/BASE.md "Client guard").
+//
+//  * login gate: both login packets carry clientId() in their u32 "client version" field (0x4343 << 16 | build) where
+//    a stock client sends its version (1098);
+//  * handshake: the game server sends "cg1:<32 hex digits nonce>" on extended opcode OPCODE right after the game login;
+//    the client answers on the same opcode, from C++ (the challenge never reaches Lua), with
+//        "cg1:<build>:" + hex(HMAC-SHA256(key, nonce || u16le #account || account || u16le #character || character
+//                                          || u16le build))
+//    The key comes from the build (src/client/CMakeLists.txt, environment variable CHAOS_CLIENT_KEY), see
+//    chaosguard_builtin.h. This is obfuscation, not protection: the key is in every binary.
+//
+// Header only, so client/tools/chaosguard_test.cpp builds it on its own against OpenSSL.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <openssl/crypto.h>
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+
+#ifndef CHAOS_CLIENT_BUILD
+#define CHAOS_CLIENT_BUILD 1
+#endif
+
+namespace chaosguard
+{
+
+constexpr uint32_t CLIENT_ID_TAG = 0x4343; // "CC", the server's ClientGuard::CLIENT_ID_TAG
+constexpr uint8_t OPCODE = 189;            // the server's ClientGuard::HANDSHAKE_OPCODE
+constexpr size_t NONCE_BYTES = 16;
+
+inline uint16_t build() { return static_cast<uint16_t>(CHAOS_CLIENT_BUILD); }
+inline uint32_t clientId() { return (CLIENT_ID_TAG << 16) | build(); }
+
+inline std::string toHex(const std::string& bytes)
+{
+    static const char digits[] = "0123456789abcdef";
+    std::string out;
+    out.reserve(bytes.size() * 2);
+    for (unsigned char c : bytes) {
+        out.push_back(digits[c >> 4]);
+        out.push_back(digits[c & 15]);
+    }
+    return out;
+}
+
+inline bool fromHex(const std::string& hex, std::string& out)
+{
+    if (hex.size() % 2 != 0)
+        return false;
+    out.clear();
+    for (size_t i = 0; i < hex.size(); i += 2) {
+        int v = 0;
+        for (size_t j = 0; j < 2; ++j) {
+            const char c = hex[i + j];
+            v <<= 4;
+            if (c >= '0' && c <= '9') v |= c - '0';
+            else if (c >= 'a' && c <= 'f') v |= c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F') v |= c - 'A' + 10;
+            else return false;
+        }
+        out.push_back(static_cast<char>(v));
+    }
+    return true;
+}
+
+// "cg1:<32 hex digits>" -> the 16 nonce bytes
+inline bool parseChallenge(const std::string& payload, std::string& nonce)
+{
+    if (payload.size() != 4 + NONCE_BYTES * 2 || payload.compare(0, 4, "cg1:") != 0)
+        return false;
+    return fromHex(payload.substr(4), nonce);
+}
+
+inline void appendU16(std::string& s, size_t v)
+{
+    s.push_back(static_cast<char>(v & 0xFF));
+    s.push_back(static_cast<char>((v >> 8) & 0xFF));
+}
+
+// raw 32-byte HMAC-SHA256 of the handshake message; "" when OpenSSL fails
+inline std::string mac(const std::string& key, const std::string& nonce, const std::string& account,
+                       const std::string& character, uint16_t buildNumber)
+{
+    std::string data = nonce;
+    appendU16(data, account.size());
+    data += account;
+    appendU16(data, character.size());
+    data += character;
+    appendU16(data, buildNumber);
+    unsigned char out[EVP_MAX_MD_SIZE];
+    unsigned int outLen = 0;
+    if (!HMAC(EVP_sha256(), key.data(), static_cast<int>(key.size()), reinterpret_cast<const unsigned char*>(data.data()),
+              data.size(), out, &outLen) || outLen != 32)
+        return std::string();
+    return std::string(reinterpret_cast<const char*>(out), outLen);
+}
+
+// what the client sends back: "cg1:<build>:<64 hex digits>"
+inline std::string answer(const std::string& key, const std::string& nonce, const std::string& account,
+                          const std::string& character, uint16_t buildNumber)
+{
+    const std::string m = mac(key, nonce, account, character, buildNumber);
+    if (m.empty())
+        return std::string();
+    return "cg1:" + std::to_string(buildNumber) + ":" + toHex(m);
+}
+
+inline void wipe(std::string& secret)
+{
+    if (!secret.empty())
+        OPENSSL_cleanse(&secret[0], secret.size());
+    secret.clear();
+}
+
+} // namespace chaosguard
