+++ b/src/client/chaosguard_builtin.h
@@ -0,0 +1,24 @@
+// Cinders of Chaos client guard: the key built into this client (client/base-patches/0035-client-guard.patch).
+// chaosguard_key.h is written by src/client/CMakeLists.txt into the build folder (never into the source tree) from the
+// environment variable CHAOS_CLIENT_KEY or the file CHAOS_CLIENT_KEY_FILE, else from the public development key. It
+// holds the 32 key bytes shuffled and XOR-masked with a mask made at configure time; the arrays are volatile so the
+// compiler cannot fold them back into the plain key. Obfuscation only: anyone with the binary can recover the key.
+#pragma once
+
+#include "chaosguard.h"
+#include "chaosguard_key.h"
+
+namespace chaosguard
+{
+
+inline bool builtInKeyIsDevelopment() { return CHAOS_GUARD_KEY_IS_DEV != 0; }
+
+inline std::string builtInKey()
+{
+    std::string key(32, '\0');
+    for (int i = 0; i < 32; ++i)
+        key[chaosguard_key::p[i] & 31] = static_cast<char>(chaosguard_key::x[i] ^ chaosguard_key::m[i]);
+    return key;
+}
+
+} // namespace chaosguard
