+// Chaos (base patch 0035): the client guard's answer (chaosguard.h). The account is the one the server reads from the
+// session key (its first line), the character the one this login sent; the key is put together only for the HMAC.
+void ProtocolGame::sendChaosGuardAnswer(const std::string& challenge)
+{
+    std::string nonce;
+    if (!chaosguard::parseChallenge(challenge, nonce)) {
+        g_logger.warning("client guard: malformed challenge from the server");
+        return;
+    }
+    const std::string account = m_sessionKey.empty() ? m_accountName : m_sessionKey.substr(0, m_sessionKey.find('\n'));
+    std::string key = chaosguard::builtInKey();
+    const std::string answer = chaosguard::answer(key, nonce, account, m_characterName, chaosguard::build());
+    chaosguard::wipe(key);
+    if (answer.empty()) {
+        g_logger.error("client guard: HMAC failed");
+        return;
+    }
+    if (chaosguard::builtInKeyIsDevelopment()) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            g_logger.warning("client guard: this client was built with the DEVELOPMENT key (no CHAOS_CLIENT_KEY); only test servers accept it");
+        }
+    }
+    auto msg = std::make_shared<OutputMessage>();
+    msg->addU8(Proto::ClientExtendedOpcode);
+    msg->addU8(chaosguard::OPCODE);
+    msg->addString(answer);
+    g_game.enableBotCall();
+    send(msg);
+    g_game.disableBotCall();
+}
