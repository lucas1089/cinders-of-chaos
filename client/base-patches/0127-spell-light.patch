+// Chaos (base patch 0127): spell colour light. The numbers and the maths mirror visualfx_logic.lua (L.LIGHT, L.fade,
+// L.dim, L.radiusAt, L.lightAdd), which is unit tested.
+void Map::setSpellLightColor(int effectId, int color, int radius)
+{
+    if (color <= 0 || color > 215)
+        return;
+    m_spellLightColors[effectId] = std::make_pair((uint8_t)color, (uint8_t)std::min(3, std::max(1, radius)));
+}
+
+void Map::setSpellLightConfig(bool enabled, int maxLights, int ms, float attack, int minGapMs, float minFade)
+{
+    m_spellLightOn = enabled && ms > 0 && maxLights > 0;
+    m_spellLightMax = std::min(32, std::max(0, maxLights));
+    m_spellLightMs = std::min(1000, std::max(0, ms));
+    m_spellLightAttack = std::min(0.9f, std::max(0.01f, attack));
+    m_spellLightGap = std::max(0, minGapMs);
+    m_spellLightMinFade = std::min(0.9f, std::max(0.f, minFade));
+    if (!m_spellLightOn)
+        m_spellLights.clear();
+}
+
+void Map::spellLightEffect(const Position& pos, int effectId)
+{
+    if (!m_spellLightOn)
+        return;
+    auto it = m_spellLightColors.find(effectId);
+    if (it == m_spellLightColors.end())
+        return;
+    const ticks_t now = g_clock.millis();
+    // drop the ended lights, then the duplicate and the cap
+    m_spellLights.erase(std::remove_if(m_spellLights.begin(), m_spellLights.end(),
+                                       [&](const SpellLight& l) { return now - l.start >= m_spellLightMs; }),
+                        m_spellLights.end());
+    for (const SpellLight& l : m_spellLights) {
+        if (l.effectId == effectId && l.pos == pos && now - l.start < m_spellLightGap)
+            return;
+    }
+    if ((int)m_spellLights.size() >= m_spellLightMax)
+        return;
+    m_spellLights.push_back({ pos, it->second.first, it->second.second, now, effectId });
+}
+
+void Map::collectSpellLights(std::vector<SpellLightDraw>& out)
+{
+    const ticks_t now = g_clock.millis();
+    m_spellLights.erase(std::remove_if(m_spellLights.begin(), m_spellLights.end(),
+                                       [&](const SpellLight& l) { return now - l.start >= m_spellLightMs; }),
+                        m_spellLights.end());
+    for (const SpellLight& l : m_spellLights) {
+        const float t = (float)(now - l.start) / (float)m_spellLightMs;
+        float strength;
+        if (t < m_spellLightAttack) {
+            strength = t / m_spellLightAttack;
+        } else {
+            const float u = (t - m_spellLightAttack) / (1.f - m_spellLightAttack);
+            strength = (1.f - u) * (1.f - u);
+        }
+        if (strength < m_spellLightMinFade)
+            continue;
+        const int r = (int)std::floor((l.color / 36) % 6 * strength + 0.5f);
+        const int g = (int)std::floor((l.color / 6) % 6 * strength + 0.5f);
+        const int b = (int)std::floor(l.color % 6 * strength + 0.5f);
+        const int color = r * 36 + g * 6 + b;
+        if (color <= 0)
+            continue;
+        const int radius = std::min(3, std::max(1, (int)std::floor(l.radius * strength + 0.5f)));
+        out.push_back({ l.pos, (uint8_t)color, (uint8_t)radius });
+    }
+}
+
