# Chaos: a player's or an NPC's name and bars over the head of a look taller than the stock ones (src/client/creature.*,
# mapview.cpp, luafunctions_client.cpp; after 0001-0109). Owner report 2026-10-22: "alguns outfits ficam com o nome no
# meio dele, nao em cima" (a Necromancer, look 2183, name and bar across the chest). The engine places the bar 2 px over
# the top of the creature's cell, up by the displacement, from the dat alone; many imported 64x64 looks draw the head
# 10-20 px higher in their canvas. Creature.setInformationLift(look, px) keeps a lift per look type (sprite pixels at
# 1x, capped at 96; client_chaos_infolift sets the table gen_info_lift.py measures on the pair) and drawMapForeground
# moves the anchor up by it before the map's stretch. Monsters keep the classic place. Lua: Creature.setInformationLift,
# Creature.clearInformationLifts, Creature.getLookInformationLift, creature:getInformationLift().
diff -ru a/src/client/creature.cpp b/src/client/creature.cpp
--- a/src/client/creature.cpp
+++ b/src/client/creature.cpp
@@ -95,6 +95,39 @@
 }
 }
 
+namespace {
+// Chaos (base patch 0111): look type -> information lift in sprite pixels at 1x
+std::unordered_map<int, int> informationLifts;
+}
+
+void Creature::setInformationLift(int lookType, int pixels)
+{
+    if (pixels <= 0)
+        informationLifts.erase(lookType);
+    else
+        informationLifts[lookType] = std::min(pixels, 96);
+}
+
+void Creature::clearInformationLifts()
+{
+    informationLifts.clear();
+}
+
+int Creature::getLookInformationLift(int lookType)
+{
+    auto it = informationLifts.find(lookType);
+    return it == informationLifts.end() ? 0 : it->second;
+}
+
+int Creature::getInformationLift()
+{
+    // monsters keep the classic place (a dragon's name over its body); a look worn by a player or an NPC gets its name
+    // over its head
+    if (isMonster() || m_outfit.getCategory() != ThingCategoryCreature)
+        return 0;
+    return getLookInformationLift(m_outfit.getId());
+}
+
 Creature::Creature() : Thing()
 {
     m_id = 0;
