+// Chaos (base patch 0194): the animation phase of a missile `elapsedMs` ms after setPath (its own clock): the
+// thing's phases cycle by the dat's frame durations (kFixedMs each when it has none), 1 phase is phase 0 as before.
+static int missilePhase(ThingType* type, long elapsedMs)
+{
+    const int n = type->getAnimationPhases();
+    if(n <= 1)
+        return 0;
+    const AnimatorPtr animator = type->getAnimator();
+    if(animator && animator->getAnimationPhases() == n)
+        return chaos::missileanim::phaseAt(elapsedMs, n, [&animator](int i) { return animator->getPhaseMeanDuration(i); });
+    return chaos::missileanim::phaseFixed(elapsedMs, n);
+}
