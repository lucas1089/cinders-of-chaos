+// Cinders of Chaos (base patch 0194): which animation phase a flying missile shows, pure and header-only so
+// client/tools/chaosmissileanim_test.cpp can run it without the engine. A missile starts at time 0 when its path is set and
+// flies for 150 * sqrt(tiles) ms. Its thing type has N phases, each with a duration from the dat's animator (the pair's
+// missiles have 8 phases of 50 to 83 ms); a thing without durations (or a duration of 0) uses kFixedMs. The phase cycles
+// while the missile flies, so a missile with a long flight loops. A thing with 1 phase (or none) is phase 0, as the draw was
+// before this patch (it always passed phase 0).
+#ifndef CHAOSMISSILEANIM_H
+#define CHAOSMISSILEANIM_H
+
+#include <cstddef>
+
+namespace chaos {
+namespace missileanim {
+
+constexpr int kFixedMs = 50;      // ms per phase when the thing has no frame durations
+constexpr int kMaxPhases = 255;   // the dat stores the phase count in one byte
+
+// durationOf(i) -> the ms of phase i (<= 0: not given, kFixedMs). elapsedMs may be negative (a clock step back): phase 0.
+template <class F>
+inline int phaseAt(long elapsedMs, int phases, F durationOf)
+{
+    if (phases <= 1)
+        return 0;
+    if (phases > kMaxPhases)
+        phases = kMaxPhases;
+    long total = 0;
+    for (int i = 0; i < phases; ++i) {
+        const long d = durationOf(i);
+        total += d > 0 ? d : kFixedMs;
+    }
+    if (elapsedMs <= 0 || total <= 0)
+        return 0;
+    long t = elapsedMs % total;
+    for (int i = 0; i < phases; ++i) {
+        const long d0 = durationOf(i);
+        const long d = d0 > 0 ? d0 : kFixedMs;
+        if (t < d)
+            return i;
+        t -= d;
+    }
+    return phases - 1;
+}
+
+// the phase of a thing without any durations
+inline int phaseFixed(long elapsedMs, int phases)
+{
+    return phaseAt(elapsedMs, phases, [](int) { return 0; });
+}
+
+}  // namespace missileanim
+}  // namespace chaos
+
+#endif
