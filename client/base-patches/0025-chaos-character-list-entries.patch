+          outfit.legs = msg:getU8()
+          outfit.feet = msg:getU8()
+          outfit.addons = msg:getU8()
+          character.outfit = outfit
+        else
+          msg:getU16() -- item id of an item-shaped outfit (not drawn in the list)
+        end
