+void Creature::setNameplate(const std::string& guild, const std::string& font, const Color& guildColor, const Color& nameColor,
+                            const std::string& frame, int border)
+{
+    m_plateNameColor = nameColor;
+    m_plateGuildCache.setText(guild);
+    if (!font.empty())
+        m_plateGuildCache.setFont(g_fonts.getFont(font));
+    m_plateGuildColor = guildColor;
+    m_plateFrame = frame.empty() ? nullptr : g_textures.getTexture(frame);
+    m_plateBorder = border;
+}
