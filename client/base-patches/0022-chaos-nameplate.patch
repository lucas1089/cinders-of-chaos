+// Chaos name plate: draws a texture as a 9-slice (corners kept, edges and middle stretched) into dest
+static void addNineSlice(const Rect& dest, const TexturePtr& tex, int border)
+{
+    const Size ts = tex->getSize();
+    const int b = std::max(0, std::min({ border, ts.width() / 2, ts.height() / 2, dest.width() / 2, dest.height() / 2 }));
+    const int dx[4] = { dest.x(), dest.x() + b, dest.x() + dest.width() - b, dest.x() + dest.width() };
+    const int dy[4] = { dest.y(), dest.y() + b, dest.y() + dest.height() - b, dest.y() + dest.height() };
+    const int sx[4] = { 0, b, ts.width() - b, ts.width() };
+    const int sy[4] = { 0, b, ts.height() - b, ts.height() };
+    for (int j = 0; j < 3; ++j) {
+        for (int i = 0; i < 3; ++i) {
+            if (dx[i + 1] > dx[i] && dy[j + 1] > dy[j] && sx[i + 1] > sx[i] && sy[j + 1] > sy[j])
+                g_drawQueue->addTexturedRect(Rect(dx[i], dy[j], dx[i + 1] - dx[i], dy[j + 1] - dy[j]), tex,
+                                             Rect(sx[i], sy[j], sx[i + 1] - sx[i], sy[j + 1] - sy[j]));
+        }
+    }
+}
