 end
 
+-- Chaos (base patch 0090): the cosmetic rows of Change Appearance (wings, outline, footprints, kill effect, loot label,
+-- chat colour, spell effect, plate frame, pet) belong to the overlay module game_outfitextras; nil without it
+local function extras()
+  local m = modules.game_outfitextras
+  return m and m.show and m or nil
+end
+
+-- the cosmetic row whose list is shown, or nil
+local function activeExtras()
+  local x = extras()
+  return x and x.activeKey and x.activeKey() or nil
+end
+
+local function extrasKey(id)
+  local x = extras()
+  return x and x.rowKey and x.rowKey(id) or nil
+end
+
