diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -22,6 +22,19 @@
 include(src/framework/CMakeLists.txt)
 include(src/client/CMakeLists.txt)
 
+# RmlUi documents next to the OTUI windows (spike, docs/RMLUI_SPIKE.md). Off: no RmlUi code, nothing linked.
+# On: RmlUi comes from vcpkg (port "rmlui", FreeType font engine) or any CMake package named RmlUi.
+option(CHAOS_RMLUI "RmlUi documents next to OTUI (spike)" OFF)
+if(CHAOS_RMLUI AND FRAMEWORK_GRAPHICS AND NOT WASM)
+    find_package(RmlUi CONFIG REQUIRED)
+    list(APPEND framework_SOURCES
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/framework/rml/rmlmanager.cpp
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/framework/rml/rmlmanager.h)
+    list(APPEND framework_LIBRARIES RmlUi::RmlUi)
+    add_definitions(-DCHAOS_RMLUI)
+    message(STATUS "RmlUi: ON")
+endif()
+
 # functions map for reading backtraces (flags do linker GNU; nao aplicar no MSVC)
 if(NOT APPLE AND NOT WASM AND NOT MSVC AND NOT ANDROID)
     set(CMAKE_CXX_LINK_FLAGS "${CMAKE_CXX_LINK_FLAGS} -no-pie -Wl,-Map=${PROJECT_NAME}.map")
