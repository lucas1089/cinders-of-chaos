+// Chaos (base patch 0100): one impact number (damage, heal, mana, experience). The text knows its type, the value and
+// percent the server sent and, when the server named one, the creature it belongs to. Lua:
+// g_map.onImpactText(animatedText, text, mode, typeId, value, percent, creatureId, pos) may change it (scatter, drift,
+// font, colour, text) or answer true to drop it before it reaches the map. Without GameChaosImpactText (an older
+// server) it is still called, with type 0, percent 0 and creature 0.
+static void chaosAddImpactText(Otc::MessageMode mode, const Position& pos, uint32_t value, int color,
+                               const std::string& font, int typeId, int percent, uint32_t creatureId)
+{
+    AnimatedTextPtr animatedText = std::make_shared<AnimatedText>();
+    animatedText->setColor(color);
+    const std::string text = chaosShortNumber(value);
+    animatedText->setText(text);
+    if (font.size())
+        animatedText->setFont(font);
+    animatedText->setImpact(typeId, value, percent);
+    if (creatureId != 0) {
+        if (CreaturePtr creature = g_map.getCreatureById(creatureId))
+            animatedText->setAttachedCreature(creature);
+    }
+    if (g_lua.callGlobalField<bool>("g_map", "onImpactText", animatedText, text, static_cast<int>(mode), typeId,
+                                    value, percent, creatureId, pos))
+        return;
+    g_map.addThing(animatedText, pos);
+}
