+// Chaos (base patch 0100): where an attached number is drawn. While GameChaosAttachedImpactText is on and the creature
+// is on the map, visible and on the camera's floor, the number moves with it: its walk and elevation (getDrawOffset)
+// and its jump, from the creature's own tile (the predicted one for the local player). Otherwise it stays where the
+// creature was last seen; a number whose creature was never followed keeps its tile. The tile anchor of `anchor` is
+// added by MapView, so a number that is not attached is drawn exactly as before.
+Point AnimatedText::attachedShift(const Position& cameraPosition, Position& anchor)
+{
+    anchor = getPosition();
+    if(!g_game.getFeature(Otc::GameChaosAttachedImpactText))
+        return Point(0, 0);
+
+    const CreaturePtr creature = m_attachedCreature.lock();
+    if(creature && !creature->isRemoved() && creature->canBeSeen()) {
+        const Position creaturePos = creature->getPrewalkingPosition();
+        if(creaturePos.isValid() && creaturePos.z == cameraPosition.z) {
+            const PointF jump = creature->getJumpOffset();
+            m_attachedLastPos = creaturePos;
+            m_attachedLastOffset = creature->getDrawOffset() - Point(static_cast<int>(jump.x), static_cast<int>(jump.y));
+            m_attachedSeen = true;
+        }
+    }
+    if(!m_attachedSeen)
+        return Point(0, 0);
+    anchor = m_attachedLastPos;
+    return m_attachedLastOffset;
 }
 
