# Chaos: ambient particles option (O226; client/BASE.md "0144"; mods/client_settings/classes/dataset.lua, options/graphics.otui;
# after 0001-0143). Lua and OTUI only, no engine code: the overlay module game_chaosweather draws the particles (embers, motes,
# dust over the game window, by the mood the server names in its weather message) and game_visualfx passes this option on.
#  * dataset.lua: `ambientParticles` (default on); its apply tells game_visualfx (`onOption(name, value)`), which calls
#    game_chaosweather.setAmbientEnabled.
#  * options/graphics.otui: one checkbox under "Fade windows in and out" (the visual effects panel grows from 276 to 295 px).
# Not run in a client; goes live with the next client build.
--- a/mods/client_settings/classes/dataset.lua
+++ b/mods/client_settings/classes/dataset.lua
@@ -2181,6 +2181,16 @@
     end,
   },
 
+  -- Chaos (base patch 0144): slow embers, motes or dust over the game window (game_chaosweather, through game_visualfx)
+  ambientParticles = {
+    value = true,
+    apply = function(value)
+      local m = modules.game_visualfx
+      if m and m.onOption then m.onOption('ambientParticles', value) end
+      return true
+    end,
+  },
+
   enableShaders = {
     value = true,
     apply = function(value)
--- a/mods/client_settings/options/graphics.otui
+++ b/mods/client_settings/options/graphics.otui
@@ -452,7 +452,7 @@
 
   FlatPanel
     // Chaos (base patch 0126, overlay module game_visualfx): the dark-fantasy look of the map, one switch per effect
-    size: 505 276
+    size: 505 295
     anchors.top: prev.bottom
     anchors.right: parent.right
     anchors.left: parent.left
@@ -723,6 +723,25 @@
         local value = modules.client_settings.getOption('uiFade')
         self:setChecked(value ~= false)
 
+    SettingsCheckBox
+      id: ambientParticles
+      size: 12 12
+      !text: tr('Ambient particles')
+      font: $var-cip-font
+      text-auto-resize: true
+      color: $var-text-cip-color
+      text-offset: 14 -2
+      anchors.left: parent.left
+      anchors.top: uiFade.bottom
+      margin-top: 7
+      margin-left: 16
+      image-source: /images/ui/checkbox
+      image-clip: 0 0 12 12
+      !tooltip: tr('Slow embers in burnt places, fireflies in forests and swamps and dust in caves drift over the game window.\nThey are few and cheap, and stop while the window is hidden.')
+      @onSetup: |
+        local value = modules.client_settings.getOption('ambientParticles')
+        self:setChecked(value ~= false)
+
     UIWidget
       size: 12 12
       anchors.top: parent.top
