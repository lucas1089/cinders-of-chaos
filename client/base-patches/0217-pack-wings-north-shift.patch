# picture facing one direction by whole sprite px, after its anchor tile of 0209 (setOutfitPackShift, clearOutfitPackShifts);
# the body, its lift (0209, 0211) and the head / cape layer (0210) stay. A look or direction without a row draws as before.
diff -ruN a/src/client/chaospieceshift.h b/src/client/chaospieceshift.h
