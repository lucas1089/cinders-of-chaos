+++ b/src/client/chaospieceshift.h
@@ -0,0 +1,61 @@
+// Cinders of Chaos (base patch 0217): a pack wing's picture moved per direction (O779).
+// Pure and header-only so client/tools/chaospieceshift_test.cpp can run it without the engine; it uses Point2 of chaospiece.h
+// (base patch 0209).
+// The purchased wings of pair 83 (O747) were drawn from straight above: their four direction rows turn one picture, so facing
+// north the wings lie on the side of the body towards the viewer and the picture hangs 8 to 13 px under the south one (and
+// 2 to 5 px left; pair 90, V46). The game's camera looks from the south at a slant: from behind, wings on the back stand as
+// high as from the front (the rule of the code-drawn wings, O770). A row of client_chaos_wingfit/wear_pieces.lua `shifts`
+// (made by client/tools/sprites/gen_wst_wear.py from the pair) moves the wings' picture of one direction by whole sprite px,
+// on top of the anchor tile of 0209; the body, its lift and the head / cape layer stay. A look or direction without a row
+// draws as before.
+#ifndef CHAOSPIECESHIFT_H
+#define CHAOSPIECESHIFT_H
+
+#include "chaospiece.h"
+
+#include <array>
+#include <unordered_map>
+
+namespace chaos {
+namespace piece {
+
+constexpr int kMaxShiftPx = 24;  // a larger move is a bad row: ignored
+constexpr int kDirections = 4;   // north, east, south, west (Otc::Direction 0-3)
+
+inline std::unordered_map<int, std::array<Point2, kDirections>>& shifts()
+{
+    static std::unordered_map<int, std::array<Point2, kDirections>> s;
+    return s;
+}
+
+// the move of a wings look's picture facing `dir` (0 north, 1 east, 2 south, 3 west), sprite px at 1x; a bad row sets nothing
+inline bool setShift(int look, int dir, int dx, int dy)
+{
+    if (look <= 0 || dir < 0 || dir >= kDirections)
+        return false;
+    if (dx < -kMaxShiftPx || dx > kMaxShiftPx || dy < -kMaxShiftPx || dy > kMaxShiftPx)
+        return false;
+    shifts()[look][static_cast<size_t>(dir)] = Point2{ dx, dy };
+    return true;
+}
+
+inline void clearShifts()
+{
+    shifts().clear();
+}
+
+// 0, 0 without a row, for a diagonal or any other direction
+inline Point2 shift(int look, int dir)
+{
+    if (dir < 0 || dir >= kDirections)
+        return Point2{};
+    auto it = shifts().find(look);
+    if (it == shifts().end())
+        return Point2{};
+    return it->second[static_cast<size_t>(dir)];
+}
+
+}  // namespace piece
+}  // namespace chaos
+
+#endif
