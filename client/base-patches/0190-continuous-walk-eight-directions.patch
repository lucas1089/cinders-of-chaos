+    // Chaos (base-patch 0190): carry the lateness of this start over from the step that just ended on time
+    if (!chaosWasWalking && m_lastWalkEndTicks != 0) {
+        const int gap = (int)(g_clock.millis() - m_lastWalkEndTicks);
+        if (gap >= 0 && gap <= ChaosWalkCarryMaxTicks) {
+            int late = std::min(gap + m_lastWalkOvershoot, ChaosWalkCarryMaxTicks);
+            late = std::min<int>(late, getStepDuration() / 3);
+            if (late > 0)
+                m_walkTimer.adjust(-late);
+        }
+    }
+    m_lastWalkEndTicks = 0;
