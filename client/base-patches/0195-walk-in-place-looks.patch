# Chaos (0195, O534, owner 2026-11-12: the hunt monsters that still stand still play their walk animation in place; src/client/thingtype.h, outfit.cpp, luafunctions_client.cpp; after 0001-0194): ThingType:setWalkInPlace(bool) / isWalkInPlace() for Lua. Base 0189 made an animateAlways creature draw a clock phase at all times: (millis % 1000) / (1000 / N) over the walk group's N phases counted from the idle picture, so it showed the idle picture and skipped the last walk phase, and a creature that walked kept the clock, out of step with its feet. With the flag set (game_bossanimate sets it, with animateAlways, on the generated idle_walk_looks.lua list), a creature that stands cycles the walk phases 1..N, one turn a second, and a creature that walks draws the step's phase (walkAnimationPhase). The ui path is untouched. Without this patch the module still works as with 0189 alone.
--- a/src/client/luafunctions_client.cpp
+++ b/src/client/luafunctions_client.cpp
@@ -807,6 +807,8 @@
     g_lua.bindClassMemberFunction<ThingType>("isNotPathable", &ThingType::isNotPathable);
     g_lua.bindClassMemberFunction<ThingType>("setPathable", &ThingType::setPathable);
     g_lua.bindClassMemberFunction<ThingType>("setAnimateAlways", &ThingType::setAnimateAlways);
+    g_lua.bindClassMemberFunction<ThingType>("setWalkInPlace", &ThingType::setWalkInPlace);
+    g_lua.bindClassMemberFunction<ThingType>("isWalkInPlace", &ThingType::isWalkInPlace);
     g_lua.bindClassMemberFunction<ThingType>("isPickupable", &ThingType::isPickupable);
     g_lua.bindClassMemberFunction<ThingType>("isHangable", &ThingType::isHangable);
     g_lua.bindClassMemberFunction<ThingType>("isHookSouth", &ThingType::isHookSouth);
