                                        (!g_game.getFeature(Otc::GameEnhancedAnimations) ? 333 : (1000 / phases));
                 ticksPerFrame = std::max<int>(1, ticksPerFrame);
                 animationPhase = (g_clock.millis() % (ticksPerFrame * phases)) / ticksPerFrame;
+                // Chaos (0195): a look the overlay set to walk in place (game_bossanimate): standing, it cycles its walk phases
+                // 1..N (never the idle picture) one turn a second; walking, it keeps the step's phase (walkAnimationPhase)
+                if (!ui && type->isWalkInPlace() && animator && animator->getAnimationPhases() > 1) {
+                    if (walkAnimationPhase > 0) {
+                        animationPhase = walkAnimationPhase;
+                    } else {
+                        const int walkPhases = animator->getAnimationPhases();
+                        animationPhase = 1 + static_cast<int>((g_clock.millis() % 1000) * walkPhases / 1000);
+                    }
+                }
             }
             if (idleAnimator && ui) {
                 animationPhase += idleAnimator->getAnimationPhases() - 1;
