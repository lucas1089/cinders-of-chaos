--- a/src/client/chaostextmotion.h
+++ b/src/client/chaostextmotion.h
@@ -0,0 +1,72 @@
+// Cinders of Chaos (base patch 0134): the motion maths of the floating numbers (AnimatedText), pure and header-only so
+// client/tools/chaostextmotion_test.cpp can run it without the engine. u is the share of the text's life that is over,
+// 0 (just appeared) .. 1 (removed).
+#ifndef CHAOSTEXTMOTION_H
+#define CHAOSTEXTMOTION_H
+
+#include <cmath>
+#include <cstdint>
+
+namespace chaos {
+namespace textmotion {
+
+constexpr float kPopStart = 0.75f;   // size at the first frame (a share of the final size)
+constexpr float kPopPeak = 1.3f;     // largest size
+constexpr float kPopUpEnd = 0.08f;   // u at which the peak is reached
+constexpr float kPopSettleEnd = 0.24f; // u at which the size is back to 1
+constexpr float kSpreadPixels = 8.0f;  // largest sideways spread of one text
+
+inline float clamp01(float u) { return u < 0.0f ? 0.0f : (u > 1.0f ? 1.0f : u); }
+
+// fast at the start, slow at the end: 0 -> 0, 1 -> 1, never above 1
+inline float easeOutCubic(float u)
+{
+    const float v = 1.0f - clamp01(u);
+    return 1.0f - v * v * v;
+}
+
+// 0 -> 0, 1 -> 1, flat at both ends
+inline float smoothStep(float u)
+{
+    const float v = clamp01(u);
+    return v * v * (3.0f - 2.0f * v);
+}
+
+// the share of the whole way (rise, drift) that is done at u
+inline float riseProgress(float u) { return easeOutCubic(u); }
+
+// size of the text at u: grows from kPopStart to kPopPeak, then settles to 1 and stays there
+inline float popScale(float u)
+{
+    if (u <= 0.0f)
+        return kPopStart;
+    if (u < kPopUpEnd)
+        return kPopStart + (kPopPeak - kPopStart) * easeOutCubic(u / kPopUpEnd);
+    if (u < kPopSettleEnd)
+        return kPopPeak + (1.0f - kPopPeak) * smoothStep((u - kPopUpEnd) / (kPopSettleEnd - kPopUpEnd));
+    return 1.0f;
+}
+
+// 1 until fadeStart, then a smooth fade to 0 at u = 1
+inline float fadeAlpha(float u, float fadeStart)
+{
+    if (u <= fadeStart || fadeStart >= 1.0f)
+        return 1.0f;
+    return 1.0f - smoothStep((u - fadeStart) / (1.0f - fadeStart));
+}
+
+// -1 .. 1 for the n-th text: golden-ratio steps (Fibonacci hashing), so any few texts that appear one after the other
+// land far apart sideways and stacked hits do not sit on each other
+inline float spreadUnit(uint32_t n)
+{
+    const uint32_t h = n * 2654435769u; // 2^32 / golden ratio, wraps on purpose
+    return static_cast<float>(h) / 2147483648.0f - 1.0f;
+}
+
+// sideways offset in pixels at u: the spread opens up with the rise
+inline float spreadOffset(uint32_t n, float u) { return spreadUnit(n) * kSpreadPixels * riseProgress(u); }
+
+} // namespace textmotion
+} // namespace chaos
+
+#endif
