+// Cinders of Chaos (base patch 0169): the app update. One call into ChaosActivity.apkUpdate(op, a, b, c, n) and its answer
+// as text (op "start": a url, b SHA-256 of the APK, c SHA-256 of its signing certificate, n size, answer "1" or "0";
+// "status": the status line of ApkUpdater; "cancel"). Called from the engine thread; the download runs in the shell's
+// own thread. A thread the glue already attached stays attached.
+std::string androidApkUpdate(const std::string& op, const std::string& a, const std::string& b, const std::string& c, int n)
+{
+    std::string answer;
+    if (!g_androidState || !g_androidState->activity)
+        return answer;
+    JNIEnv* env = nullptr;
+    JavaVM* vm = g_androidState->activity->vm;
+    jobject activity = g_androidState->activity->clazz;
+    const bool attachedBefore = vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) == JNI_OK;
+    if (!attachedBefore && vm->AttachCurrentThread(&env, NULL) == JNI_ERR)
+        return answer;
+    jclass clazz = env->GetObjectClass(activity);
+    jmethodID methodID = env->GetMethodID(clazz, "apkUpdate",
+                                          "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;J)Ljava/lang/String;");
+    if (methodID) {
+        jstring jop = env->NewStringUTF(op.c_str());
+        jstring ja = env->NewStringUTF(a.c_str());
+        jstring jb = env->NewStringUTF(b.c_str());
+        jstring jc = env->NewStringUTF(c.c_str());
+        jstring result = static_cast<jstring>(env->CallObjectMethod(activity, methodID, jop, ja, jb, jc, static_cast<jlong>(n)));
+        if (env->ExceptionCheck()) {
+            env->ExceptionClear();
+        } else if (result) {
+            const char* chars = env->GetStringUTFChars(result, nullptr);
+            if (chars) {
+                answer = chars;
+                env->ReleaseStringUTFChars(result, chars);
+            }
+            env->DeleteLocalRef(result);
+        }
+        env->DeleteLocalRef(jop);
+        env->DeleteLocalRef(ja);
+        env->DeleteLocalRef(jb);
+        env->DeleteLocalRef(jc);
+    } else if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+    }
+    env->DeleteLocalRef(clazz);
+    if (!attachedBefore)
+        vm->DetachCurrentThread();
+    return answer;
+}
