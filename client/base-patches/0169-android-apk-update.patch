+// ---- Cinders of Chaos app update (base patch 0169, client/BASE.md "APK updater") ----
+// The Android app updating itself: the Java shell (ChaosActivity.apkUpdate, ApkUpdater) downloads the APK the signed
+// manifest names, checks its size, SHA-256 and signing certificate and hands it to the PackageInstaller. These calls only
+// pass the request on through JNI (androidApkUpdate in androidwindow.cpp); on other platforms they do nothing.
+#if defined(ANDROID)
+std::string androidApkUpdate(const std::string& op, const std::string& a, const std::string& b, const std::string& c, int n);
+#endif
+
+bool ResourceManager::startApkUpdate(const std::string& url, const std::string& sha256, int size, const std::string& signerSha256)
+{
+#if defined(ANDROID)
+    return androidApkUpdate("start", url, sha256, signerSha256, size) == "1";
+#else
+    (void)url;
+    (void)sha256;
+    (void)size;
+    (void)signerSha256;
+    return false;
+#endif
+}
+
+std::string ResourceManager::apkUpdateStatus()
+{
+#if defined(ANDROID)
+    return androidApkUpdate("status", "", "", "", 0);
+#else
+    return "";
+#endif
+}
+
+void ResourceManager::cancelApkUpdate()
+{
+#if defined(ANDROID)
+    androidApkUpdate("cancel", "", "", "", 0);
+#endif
+}
