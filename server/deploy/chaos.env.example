# /etc/chaos/chaos.env: read by chaos-server.service (EnvironmentFile) and by server/tools/backup.sh.
# Copy this file there, fill it in, then: sudo chown root:root /etc/chaos/chaos.env && sudo chmod 600 /etc/chaos/chaos.env
# config.lua reads these at start (server/tools/prod_config.py writes mysqlHost = os.getenv("CHAOS_DB_HOST") or ...),
# so the password never lives in config.lua or in the repository. NEVER commit a filled-in copy.
CHAOS_DB_HOST=127.0.0.1
CHAOS_DB_PORT=3306
CHAOS_DB_USER=chaos
CHAOS_DB_PASS=change-me
CHAOS_DB_NAME=chaos

# backup.sh (server/tools/backup.sh); the backup timer reads this file too
CHAOS_BACKUP_DIR=/var/backups/chaos
CHAOS_BACKUP_KEEP_DAYS=14
CHAOS_SERVER_DIR=/opt/chaos/server
