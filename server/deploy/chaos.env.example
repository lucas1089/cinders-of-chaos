# /etc/chaos/chaos.env: read by chaos-server.service (EnvironmentFile), chaos-backup.service (backup.sh,
# backup_offsite.sh) and chaos-health.service (chaos_health.py).
# Copy this file there, fill it in, then: sudo chown root:root /etc/chaos/chaos.env && sudo chmod 600 /etc/chaos/chaos.env
# config.lua reads these at start (server/tools/prod_config.py writes mysqlHost = os.getenv("CHAOS_DB_HOST") or ...),
# so the password never lives in config.lua or in the repository. NEVER commit a filled-in copy.
CHAOS_DB_HOST=127.0.0.1
CHAOS_DB_PORT=3306
CHAOS_DB_USER=chaos
CHAOS_DB_PASS=change-me
CHAOS_DB_NAME=chaos

# client guard (server/README.md "Client guard"): the key the official client is built with, 64 hex digits, the same
# value as the GitHub Actions secret CHAOS_CLIENT_KEY (make it once: openssl rand -hex 32). config.lua reads it
# (clientGuardKey = os.getenv("CHAOS_CLIENT_KEY") or "", written by prod_config.py). Two keys during a rotation:
# old,new (comma separated). Without it every player is kicked at the handshake while clientGuardMode = "enforce".
CHAOS_CLIENT_KEY=

# RSA login key (server/README.md "Login encryption (RSA, XTEA)"): the path of our own 1024-bit key, made on this
# machine with server/tools/rsa_key.py gen --out /etc/chaos/rsa/login-YYYYMMDD.pem --owner chaos (mode 600, never in
# the repository). config.lua reads it (rsaKeyFile = os.getenv("CHAOS_RSA_KEY_FILE") or "key.pem", prod_config.py).
# Two files during a rotation: new,old (comma separated). Empty: the base key.pem, the public default key.
CHAOS_RSA_KEY_FILE=

# backup.sh (server/tools/backup.sh); the backup timer reads this file too
CHAOS_BACKUP_DIR=/var/backups/chaos
CHAOS_BACKUP_KEEP_DAYS=14
CHAOS_SERVER_DIR=/opt/chaos/server

# off-site copy (server/tools/backup_offsite.sh, run by chaos-backup.service after backup.sh; docs/LAUNCH.md
# "Off-site copy"). Both targets empty: one log line, no copy. Either or both:
#   CHAOS_BACKUP_REMOTE   an rclone remote and folder (S3, B2, Google Drive, ...), e.g. b2:chaos-backups
#   CHAOS_BACKUP_RSYNC    [user@]host:/path for rsync over ssh (or scp with CHAOS_BACKUP_RSYNC_TOOL=scp)
CHAOS_BACKUP_REMOTE=
CHAOS_RCLONE_CONFIG=/etc/chaos/rclone.conf
CHAOS_BACKUP_RSYNC=
CHAOS_BACKUP_RSYNC_TOOL=rsync
CHAOS_BACKUP_SSH_KEY=
# days to keep copies on the target (0 keeps everything)
CHAOS_BACKUP_REMOTE_KEEP=30
# encryption, the first one set wins: an age public key (age1...) or recipients file; a gpg key id (keyring in
# CHAOS_BACKUP_GPG_HOME); a passphrase file (gpg symmetric AES256, mode 0600). Keep the private key / passphrase OFF this
# machine too, or a lost machine loses the backups with it.
CHAOS_BACKUP_AGE_RECIPIENT=
CHAOS_BACKUP_GPG_RECIPIENT=
CHAOS_BACKUP_GPG_HOME=/etc/chaos/gnupg
CHAOS_BACKUP_PASSPHRASE_FILE=

# alerts: a webhook URL that takes {"content": "..."} (a Discord channel webhook works). Used by
# server/tools/chaos_crashlog.sh (after an unclean stop of the game server) and server/tools/chaos_health.py (every
# 5 minutes: FAIL / OK on a state change, error lines, slow COMMITs, the 09:00 daily summary). Empty: the crash is
# only recorded in /var/log/chaos/crashes/ and the health alerts only go to the journal (journalctl -u chaos-health).
CHAOS_ALERT_WEBHOOK=

# health check thresholds (server/tools/chaos_health.py); the defaults are shown
CHAOS_HEALTH_MIN_FREE_PCT=10
CHAOS_HEALTH_MIN_FREE_GB=5
CHAOS_HEALTH_BACKUP_MAX_AGE_H=26
CHAOS_HEALTH_SUMMARY_HOUR=9
# a COMMIT this slow in the slow task log (config.lua slowTaskLogMs at or under it) counts as slow; 3 in an hour warn
CHAOS_HEALTH_SLOW_COMMIT_MS=200
# the units that must be active, space separated ("a|b": whichever is installed). Empty: chaos-server, mariadb|mysql,
# chaos-clientservices, chaos-payworker. nginx and php*-fpm are checked when they are installed.
CHAOS_HEALTH_UNITS=
