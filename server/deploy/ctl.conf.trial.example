# /etc/chaos/ctl.conf for chaos-ctl.sh (and so for the admin app): the Linux kit in /opt/chaos-trial.
# Install as root: cp server/deploy/ctl.conf.trial.example /etc/chaos/ctl.conf && chmod 644 /etc/chaos/ctl.conf
# The file must be owned by root and not writable by group or others, or chaos-ctl.sh ignores it.
# Only these keys are read, one KEY=VALUE per line, no spaces, never run as shell code. server/README.md "Remote admin
# commands", settings file.

# the systemd unit (server/deploy/chaos-trial-server.service installed as chaos-server.service)
CHAOS_UNIT=chaos-server
CHAOS_ROOT=/opt/chaos-trial
CHAOS_SERVER_DIR=/opt/chaos-trial/server
# the git checkout with server/deploy and server/tools (backup, update)
CHAOS_REPO=/opt/chaos/repo
# the kit's env file: CHAOS_DB_HOST=127.0.0.1, CHAOS_DB_PORT=3307, user, password
CHAOS_ENV=/opt/chaos-trial/chaos.env
CHAOS_LOG=/opt/chaos-trial/logs/server.log
# the engine's pid, written by start-server.sh: save and backup signal the engine through it
CHAOS_PID_FILE=/opt/chaos-trial/run/server.pid
# the database client (the VPS has no system mysql). Empty: mysql, then mariadb, then CHAOS_ROOT/mariadb/bin/mariadb
CHAOS_MYSQL=/opt/chaos-trial/mariadb/bin/mariadb
# the kit's database user is 'chaos'@'127.0.0.1' (TCP, port 3307 from chaos.env), so leave the socket empty.
# Set it only for a database user that may log in over the socket.
#CHAOS_DB_SOCKET=/opt/chaos-trial/run/mariadb.sock
#CHAOS_BACKUP_DIR=/var/backups/chaos

# Painel > Atualizar servidor (chaos-ctl.sh update-check / update-apply, server/deploy/chaos_kit_update.sh)
CHAOS_KIT_DIR=/opt/chaos-trial
# the branch the checkout CHAOS_REPO follows, and the GitHub repository of the winpkg-N releases (the engine)
CHAOS_UPDATE_BRANCH=main
CHAOS_RELEASE_REPO=lucas1089/cinders-of-chaos
# the map master (the owner's edited map, server/README.md "Map master"): world/ of this branch of the same repository;
# the replaced maps are kept in CHAOS_MAP_BACKUP_DIR (the newest 3, each as large as the map)
#CHAOS_MAP_BRANCH=windows-assets
#CHAOS_MAP_BACKUP_DIR=/opt/chaos-trial/map-backups
# the update installs on a copy of the server folder (CHAOS_SERVER_DIR + ".new") while the game runs and stops it only
# for the swap; the replaced folder stays as CHAOS_SERVER_DIR + ".old" (the rollback renames it back). Needs room for
# one more copy of the folder on the same disk; without it the update installs with the server stopped, as before.
# 0 turns the copy off. The compile cache of install_all.py (default CHAOS_KIT_STATE/cache) makes a rerun faster.
#CHAOS_STAGING=1
#CHAOS_CACHE_DIR=/var/lib/chaos/kit-update/cache
# the website: the signed client update goes to CHAOS_SITE_DIR/updates/live, the client downloads to CHAOS_DL_DIR
# (a symlink is fine: the files are written next to its target), install_site.sh reads CHAOS_SITE_ENV
CHAOS_SITE_DIR=/var/www/chaos
CHAOS_DL_DIR=/var/www/chaos/dl
CHAOS_SITE_ENV=/etc/chaos/site.env
# the private key of the client updates (docs/LAUNCH.md "Publishing a client update")
CHAOS_UPDATE_KEY=/etc/chaos/update-key.hex
# the admin app's live spectator (server/README.md "Live spectator"): the client pair it draws with (Tibia.dat and
# Tibia.spr; the same folder as the site's CHAOS_SPRITE_PAIR is fine), its state folder, the branch whose pair archive
# "chaos-ctl.sh spectate-pair fetch" takes, and that fetch's log
#CHAOS_SPECTATE_PAIR=/opt/chaos-trial/pair
#CHAOS_SPECTATE_STATE=/var/lib/chaos/spectate
#CHAOS_PAIR_BRANCH=windows-assets
#CHAOS_SPECTATE_LOG=/var/log/chaos/spectate-pair.log
