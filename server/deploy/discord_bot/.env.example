# /etc/chaos/discord-bot.env: read by chaos-discordbot.service (EnvironmentFile). Mode 600. NEVER commit a filled copy.
# Easiest: the admin app, Comandos > Bot do Discord (it saves each value over SSH, nothing on a command line), or
# chaos-ctl.sh discord-bot set NAME (the value on stdin). README.md (pt-BR) explains where each value comes from.

# Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Discord ids (user settings > Advanced > Developer Mode, then right click > Copy ID)
DISCORD_OWNER_ID=
DISCORD_BUGS_CHANNEL_ID=
DISCORD_PATCH_CHANNEL_ID=
# the server (guild) id: makes the slash commands appear at once (without it they can take up to an hour)
DISCORD_GUILD_ID=
# optional: a role whose members may also use /bugs and /patch
DISCORD_ADMIN_ROLE_ID=

# optional settings (defaults shown)
# DISCORD_BOT_MODEL=claude-sonnet-5-5
# DISCORD_BOT_DATA_DIR=/var/lib/chaos/discord-bot
# 1 lets the API re-run a request its safety classifiers declined on another model; 0 switches that off
# DISCORD_BOT_FALLBACKS=1
# Claude calls one player may cause per hour (cost guard)
# DISCORD_BOT_USER_LIMIT_HOUR=20
# hour of the daily summary DM, America/Sao_Paulo
# DISCORD_BOT_DAILY_HOUR=9
