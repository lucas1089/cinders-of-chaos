# Cinders of Chaos Discord announcements (website plugins/chaos/discord_worker.php; website/README.md "Discord
# announcements"). Run every minute by chaos-discord.timer: posts the rows the game server queued in chaos_discord_queue
# and the Character Bazaar's new listings and sales to the Discord channel webhooks of /etc/chaos/discord.env
# (CHAOS_DISCORD_WEBHOOK_<CHANNEL>; never in the repository). The game never waits on Discord.
#   sudo install -m 600 -o www-data /dev/null /etc/chaos/discord.env   (then fill it in, docs/LAUNCH.md)
#   sudo cp server/deploy/chaos-discord.service server/deploy/chaos-discord.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now chaos-discord.timer
# /var/www/chaos is CHAOS_SITE_DIR (the installed website: plugins/chaos/discord_worker.php and config.local.php).

[Unit]
Description=Cinders of Chaos Discord announcements
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=-/etc/chaos/discord.env
ExecStart=/usr/bin/php /var/www/chaos/plugins/chaos/discord_worker.php --site /var/www/chaos
TimeoutStartSec=90
StandardOutput=append:/var/log/chaos/discord.log
StandardError=append:/var/log/chaos/discord.log
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/log/chaos
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# no ports, user www-data: no capability needed
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemoryMax=128M
