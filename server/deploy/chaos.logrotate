# Cinders of Chaos logs. Install: sudo cp server/deploy/chaos.logrotate /etc/logrotate.d/chaos
# systemd appends the console output to these files and keeps them open, so they are copied and truncated in place
# (copytruncate) instead of being moved; a few lines written during the copy can be lost, which is fine for a console log.
# systemd (root) creates the files, so keep /var/log/chaos owned by root: sudo install -d -m 0755 /var/log/chaos
/var/log/chaos/server.log /var/log/chaos/clientservices.log /var/log/chaos/backup.log /var/log/chaos/discord.log {
	daily
	rotate 14
	maxsize 200M
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	dateext
}

# The client guard's log (engine patch 0021, clientGuardLogFile): one line per refused or kicked login, with the IP,
# account and character. Kept 14 days like the console (docs/legal/ privacy policy, section 4). The folder belongs to
# the chaos user, so logrotate works as that user.
/opt/chaos/server/data/logs/clientguard.log {
	su chaos chaos
	daily
	rotate 14
	maxsize 50M
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	dateext
}
