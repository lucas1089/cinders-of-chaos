+class Item;
+
+// Items that are decaying, keyed by the time (OTSYS_TIME, ms) at which they decay. One scheduler event waits for the
+// earliest entry, so nothing walks the whole list while no item is due. A decaying item carries
+// ITEM_ATTRIBUTE_DURATION_TIMESTAMP (its key here) and DECAYING_TRUE, and the map holds one reference to it.
+// Item::getDuration() reads the remaining time from the timestamp; stopping the decay writes it back to
+// ITEM_ATTRIBUTE_DURATION, so saves, descriptions and scripts see the same value as with the stock countdown.
+class Decay
+{
+	public:
+		// starts the countdown: the item decays in `duration` ms (0 = on the next check)
+		void startDecay(Item* item, int64_t duration);
+		// stops the countdown and keeps the remaining time in ITEM_ATTRIBUTE_DURATION (no-op if not decaying)
+		void stopDecay(Item* item);
+
+	private:
+		void checkDecay();
+		void sweep();
+		void scheduleCheck();
+		bool erase(Item* item);
+
+		std::map<int64_t, std::vector<Item*>> decayMap;
+		uint32_t checkEventId = 0;
+		int64_t checkEventTime = 0;
+		uint32_t sweepEventId = 0;
+};
+
+extern Decay g_decay;
+
+#endif
