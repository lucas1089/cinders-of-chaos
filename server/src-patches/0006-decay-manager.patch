+#include "game.h"
+#include "scheduler.h"
+
+extern Game g_game;
+
+Decay g_decay;
+
+namespace {
+
+// Decaying items that can no longer decay (removed from the world, e.g. with a logged-out character, or given a
+// unique id) are frozen by this sweep, keeping their remaining time; the stock countdown did the same within a second.
+// Items that stop decaying through the engine (taken off, transformed, removed) are frozen at once, not here.
+constexpr int32_t DECAY_SWEEP_INTERVAL = 10 * 1000;
+
+// longest single wait; a later item is simply checked again
+constexpr int64_t DECAY_MAX_WAIT = 60 * 60 * 1000;
+
+}
+
+void Decay::startDecay(Item* item, int64_t duration)
+{
+	// already decaying: move it to its new time, keeping the reference the map holds
+	if (!erase(item)) {
+		item->incrementReferenceCounter();
+	}
+
+	const int64_t timestamp = OTSYS_TIME() + std::max<int64_t>(0, duration);
+	item->setIntAttr(ITEM_ATTRIBUTE_DURATION_TIMESTAMP, timestamp);
+	item->setDecaying(DECAYING_TRUE);
+	decayMap[timestamp].push_back(item);
+
+	scheduleCheck();
+	if (sweepEventId == 0) {
+		sweepEventId = g_scheduler.addEvent(createSchedulerTask(DECAY_SWEEP_INTERVAL, std::bind(&Decay::sweep, this)));
+	}
+}
+
+void Decay::stopDecay(Item* item)
+{
+	if (!item->hasAttribute(ITEM_ATTRIBUTE_DURATION_TIMESTAMP)) {
+		return;
+	}
+
+	const uint32_t remaining = item->getDuration();
+	if (!erase(item)) {
+		// being processed by checkDecay right now (taken out of the map there); it handles the item
+		return;
+	}
+
+	item->setDuration(remaining);
+	item->setDecaying(DECAYING_FALSE);
+	g_game.ReleaseItem(item);
+}
+
+bool Decay::erase(Item* item)
+{
+	if (!item->hasAttribute(ITEM_ATTRIBUTE_DURATION_TIMESTAMP)) {
+		return false;
+	}
+
+	auto it = decayMap.find(item->getIntAttr(ITEM_ATTRIBUTE_DURATION_TIMESTAMP));
+	if (it == decayMap.end()) {
+		return false;
+	}
+
+	std::vector<Item*>& items = it->second;
+	auto pos = std::find(items.begin(), items.end(), item);
+	if (pos == items.end()) {
+		return false;
+	}
+
+	*pos = items.back();
+	items.pop_back();
+	if (items.empty()) {
+		decayMap.erase(it);
+	}
+
+	item->removeAttribute(ITEM_ATTRIBUTE_DURATION_TIMESTAMP);
+	return true;
+}
+
+void Decay::scheduleCheck()
+{
+	if (decayMap.empty()) {
+		return;
+	}
+
+	const int64_t first = decayMap.begin()->first;
+	if (checkEventId != 0) {
+		if (checkEventTime <= first) {
+			return;
+		}
+		g_scheduler.stopEvent(checkEventId);
+	}
+
+	const int64_t now = OTSYS_TIME();
+	const int64_t delay = std::min<int64_t>(DECAY_MAX_WAIT, std::max<int64_t>(SCHEDULER_MINTICKS, first - now));
+	checkEventTime = now + delay;
+	checkEventId = g_scheduler.addEvent(createSchedulerTask(static_cast<uint32_t>(delay), std::bind(&Decay::checkDecay, this)));
+}
+
+void Decay::checkDecay()
+{
+	checkEventId = 0;
+	checkEventTime = 0;
+
+	// take every due item out first: decaying one item can start or stop the decay of others
+	const int64_t now = OTSYS_TIME();
+	std::vector<std::pair<int64_t, Item*>> due;
+	auto it = decayMap.begin();
+	while (it != decayMap.end() && it->first <= now) {
+		for (Item* item : it->second) {
+			due.emplace_back(it->first, item);
+		}
+		it = decayMap.erase(it);
+	}
+
+	for (const auto& entry : due) {
+		Item* item = entry.second;
+		if (!item->hasAttribute(ITEM_ATTRIBUTE_DURATION_TIMESTAMP) || item->getIntAttr(ITEM_ATTRIBUTE_DURATION_TIMESTAMP) != entry.first) {
+			// started again meanwhile (it holds its own reference for that)
+			g_game.ReleaseItem(item);
+			continue;
+		}
+
+		item->removeAttribute(ITEM_ATTRIBUTE_DURATION_TIMESTAMP);
+		item->setDuration(0);
+		item->setDecaying(DECAYING_FALSE);
+		if (item->canDecay()) {
+			g_game.internalDecayItem(item);
+		}
+		g_game.ReleaseItem(item);
+	}
+
+	scheduleCheck();
+	g_game.cleanup();
+}
+
+void Decay::sweep()
+{
+	sweepEventId = 0;
+
+	std::vector<Item*> stale;
+	for (const auto& entry : decayMap) {
+		for (Item* item : entry.second) {
+			if (!item->canDecay()) {
+				stale.push_back(item);
+			}
+		}
+	}
+
+	for (Item* item : stale) {
+		stopDecay(item);
+	}
+
+	if (!decayMap.empty()) {
+		sweepEventId = g_scheduler.addEvent(createSchedulerTask(DECAY_SWEEP_INTERVAL, std::bind(&Decay::sweep, this)));
+	}
+}
