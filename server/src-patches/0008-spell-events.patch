+void Spell::addCooldowns(Player* player) const
+{
+	auto add = [this, player](ConditionType_t type, uint32_t ticks, uint32_t subId, const std::string& cooldownType) {
+		if (ticks == 0) {
+			return;
+		}
+
+		if (g_events) {
+			ticks = g_events->eventPlayerOnSpellCooldown(player, this, cooldownType, ticks);
+		}
+
+		if (ticks > 0) {
+			ticks = std::min<uint32_t>(ticks, INT32_MAX);
+			player->addCondition(Condition::createCondition(CONDITIONID_DEFAULT, type, static_cast<int32_t>(ticks), 0, false, subId));
+		}
+	};
+
+	add(CONDITION_SPELLCOOLDOWN, cooldown, spellId, "spell");
+	add(CONDITION_SPELLGROUPCOOLDOWN, groupCooldown, group, "group");
+	add(CONDITION_SPELLGROUPCOOLDOWN, secondaryGroupCooldown, secondaryGroup, "secondary");
+}
