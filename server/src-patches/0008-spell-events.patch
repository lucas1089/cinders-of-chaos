+bool Spell::playerSpellPreCast(Player* player) const
+{
+	if (!g_events) {
+		return true;
+	}
+
+	const SpellCost cost = getSpellCost(player, this, false);
+	if (!g_events->eventPlayerOnSpellPreCast(player, this, cost.mana, cost.health)) {
+		spellCosts.erase(player->getID());
+		return false;
+	}
+	return true;
+}
