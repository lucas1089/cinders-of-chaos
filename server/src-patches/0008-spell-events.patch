+// The cost of the cast a player is making: what Player:onSpellCost chose in playerSpellCheck, paid in postCastSpell.
+// A cast is checked and finished in one dispatcher call, so at most one entry per player is ever in use.
+struct SpellCost {
+	const Spell* spell = nullptr;
+	uint32_t mana = 0;
+	uint32_t health = 0;
+};
+
+std::unordered_map<uint32_t, SpellCost> spellCosts;
+
+SpellCost getSpellCost(Player* player, const Spell* spell, bool take)
+{
+	SpellCost cost;
+	auto it = spellCosts.find(player->getID());
+	if (it != spellCosts.end() && it->second.spell == spell) {
+		cost = it->second;
+	} else {
+		cost.spell = spell;
+		cost.mana = spell->getManaCost(player);
+	}
+
+	if (take && it != spellCosts.end()) {
+		spellCosts.erase(it);
+	}
+	return cost;
+}
+
