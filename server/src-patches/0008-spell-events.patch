+namespace {
+
+// self, spellName, spellId, spellGroup (SPELLGROUP_*), aggressive
+void pushSpellArguments(lua_State* L, Player* player, const Spell* spell)
+{
+	LuaScriptInterface::pushUserdata<Player>(L, player);
+	LuaScriptInterface::setMetatable(L, -1, "Player");
+	LuaScriptInterface::pushString(L, spell->getName());
+	lua_pushnumber(L, spell->getId());
+	lua_pushnumber(L, spell->getGroup());
+	LuaScriptInterface::pushBoolean(L, spell->getAggressive());
+}
+
+uint32_t toCost(lua_State* L, int32_t arg, uint32_t value)
+{
+	if (!LuaScriptInterface::isNumber(L, arg)) {
+		return value;
+	}
+	return static_cast<uint32_t>(std::max<int64_t>(0, LuaScriptInterface::getNumber<int64_t>(L, arg)));
+}
+
