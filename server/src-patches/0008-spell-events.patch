+void Events::eventPlayerOnSpellCost(Player* player, const Spell* spell, uint32_t& manaCost, uint32_t& healthCost)
+{
+	// Player:onSpellCost(spellName, spellId, spellGroup, aggressive, manaCost) -> manaCost[, healthCost]
+	if (info.playerOnSpellCost == -1) {
+		return;
+	}
+
+	if (!scriptInterface.reserveScriptEnv()) {
+		std::cout << "[Error - Events::eventPlayerOnSpellCost] Call stack overflow" << std::endl;
+		return;
+	}
+
+	ScriptEnvironment* env = scriptInterface.getScriptEnv();
+	env->setScriptId(info.playerOnSpellCost, &scriptInterface);
+
+	lua_State* L = scriptInterface.getLuaState();
+	scriptInterface.pushFunction(info.playerOnSpellCost);
+	pushSpellArguments(L, player, spell);
+	lua_pushnumber(L, manaCost);
+
+	if (scriptInterface.protectedCall(L, 6, 2) != 0) {
+		LuaScriptInterface::reportError(nullptr, LuaScriptInterface::popString(L));
+	} else {
+		manaCost = toCost(L, -2, manaCost);
+		healthCost = toCost(L, -1, healthCost);
+		lua_pop(L, 2);
+	}
+
+	scriptInterface.resetScriptEnv();
+}
+
+bool Events::eventPlayerOnSpellPreCast(Player* player, const Spell* spell, uint32_t manaCost, uint32_t healthCost)
+{
+	// Player:onSpellPreCast(spellName, spellId, spellGroup, aggressive, manaCost, healthCost) -> false cancels the cast
+	if (info.playerOnSpellPreCast == -1) {
+		return true;
+	}
+
+	if (!scriptInterface.reserveScriptEnv()) {
+		std::cout << "[Error - Events::eventPlayerOnSpellPreCast] Call stack overflow" << std::endl;
+		return true;
+	}
+
+	ScriptEnvironment* env = scriptInterface.getScriptEnv();
+	env->setScriptId(info.playerOnSpellPreCast, &scriptInterface);
+
+	lua_State* L = scriptInterface.getLuaState();
+	scriptInterface.pushFunction(info.playerOnSpellPreCast);
+	pushSpellArguments(L, player, spell);
+	lua_pushnumber(L, manaCost);
+	lua_pushnumber(L, healthCost);
+
+	bool allowed = true;
+	if (scriptInterface.protectedCall(L, 7, 1) != 0) {
+		LuaScriptInterface::reportError(nullptr, LuaScriptInterface::popString(L));
+	} else {
+		// only an explicit false cancels; nil (no return) lets the cast go on
+		allowed = !(lua_isboolean(L, -1) && !lua_toboolean(L, -1));
+		lua_pop(L, 1);
+	}
+
+	scriptInterface.resetScriptEnv();
+	return allowed;
+}
+
+void Events::eventPlayerOnSpellCast(Player* player, const Spell* spell, uint32_t manaCost, uint32_t healthCost)
+{
+	// Player:onSpellCast(spellName, spellId, spellGroup, aggressive, manaCost, healthCost)
+	if (info.playerOnSpellCast == -1) {
+		return;
+	}
+
+	if (!scriptInterface.reserveScriptEnv()) {
+		std::cout << "[Error - Events::eventPlayerOnSpellCast] Call stack overflow" << std::endl;
+		return;
+	}
+
+	ScriptEnvironment* env = scriptInterface.getScriptEnv();
+	env->setScriptId(info.playerOnSpellCast, &scriptInterface);
+
+	lua_State* L = scriptInterface.getLuaState();
+	scriptInterface.pushFunction(info.playerOnSpellCast);
+	pushSpellArguments(L, player, spell);
+	lua_pushnumber(L, manaCost);
+	lua_pushnumber(L, healthCost);
+
+	scriptInterface.callVoidFunction(7);
+}
+
+uint32_t Events::eventPlayerOnSpellCooldown(Player* player, const Spell* spell, const std::string& cooldownType, uint32_t cooldown)
+{
+	// Player:onSpellCooldown(spellName, spellId, spellGroup, aggressive, cooldownType, cooldown) -> cooldown (ms)
+	if (info.playerOnSpellCooldown == -1) {
+		return cooldown;
+	}
+
+	if (!scriptInterface.reserveScriptEnv()) {
+		std::cout << "[Error - Events::eventPlayerOnSpellCooldown] Call stack overflow" << std::endl;
+		return cooldown;
+	}
+
+	ScriptEnvironment* env = scriptInterface.getScriptEnv();
+	env->setScriptId(info.playerOnSpellCooldown, &scriptInterface);
+
+	lua_State* L = scriptInterface.getLuaState();
+	scriptInterface.pushFunction(info.playerOnSpellCooldown);
+	pushSpellArguments(L, player, spell);
+	LuaScriptInterface::pushString(L, cooldownType);
+	lua_pushnumber(L, cooldown);
+
+	if (scriptInterface.protectedCall(L, 7, 1) != 0) {
+		LuaScriptInterface::reportError(nullptr, LuaScriptInterface::popString(L));
+	} else {
+		cooldown = toCost(L, -1, cooldown);
+		lua_pop(L, 1);
+	}
+
+	scriptInterface.resetScriptEnv();
+	return cooldown;
+}
