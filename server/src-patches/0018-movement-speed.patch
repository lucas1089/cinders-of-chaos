+int LuaScriptInterface::luaCreatureGetStepSpeed(lua_State* L)
+{
+	// creature:getStepSpeed() Chaos (patch 0018): the speed the creature walks at (a player's held between
+	// minPlayerSpeed and maxPlayerSpeed); creature:getSpeed() stays the unclamped sum
