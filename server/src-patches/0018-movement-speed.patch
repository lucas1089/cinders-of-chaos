+int32_t Player::getStepSpeed() const
+{
+	// Chaos (patch 0018): every speed change (haste, slows, items, mounts, Lua changeSpeed) adds to varSpeed; the sum is
+	// clamped here, so this is what the player walks at and what clients are sent. Staff with PlayerFlag_SetMaxSpeed
+	// keep the stock limits. 0 turns a limit off.
+	int32_t minSpeed = PLAYER_MIN_SPEED;
+	int32_t maxSpeed = PLAYER_MAX_SPEED;
+	if (!hasFlag(PlayerFlag_SetMaxSpeed)) {
+		const int32_t configMin = g_config.getNumber(ConfigManager::MIN_PLAYER_SPEED);
+		const int32_t configMax = g_config.getNumber(ConfigManager::MAX_PLAYER_SPEED);
+		if (configMin > 0) {
+			minSpeed = std::min<int32_t>(configMin, PLAYER_MAX_SPEED);
+		}
+		if (configMax > 0) {
+			maxSpeed = std::max<int32_t>(minSpeed, std::min<int32_t>(configMax, PLAYER_MAX_SPEED));
+		}
+	}
+	return std::max<int32_t>(minSpeed, std::min<int32_t>(maxSpeed, getSpeed()));
+}
+
+void Player::updateBaseSpeed()
+{
+	if (hasFlag(PlayerFlag_SetMaxSpeed)) {
+		baseSpeed = PLAYER_MAX_SPEED;
+		return;
+	}
+
+	// Chaos (patch 0018): stock was vocation + 2 per level. Now vocation + playerSpeedBonus, then
+	// playerSpeedPerTenLevels / 10 per level up to playerSpeedSoftLevel and playerSpeedPerTenLevelsAbove / 10 per level
+	// above it (defaults: +50, 2.5 per level to level 300, 1 per level after). Lua mirror: ChaosSpeed.baseSpeed
+	// (data/lib/chaos_speed.lua).
+	const int64_t levels = level > 1 ? level - 1 : 0;
+	const int64_t softLevel = std::max<int64_t>(1, g_config.getNumber(ConfigManager::PLAYER_SPEED_SOFT_LEVEL));
+	const int64_t below = std::min<int64_t>(levels, softLevel - 1);
+	const int64_t above = levels - below;
+	const int64_t perTen = std::max<int64_t>(0, g_config.getNumber(ConfigManager::PLAYER_SPEED_PER_TEN_LEVELS));
+	const int64_t perTenAbove = std::max<int64_t>(0, g_config.getNumber(ConfigManager::PLAYER_SPEED_PER_TEN_LEVELS_ABOVE));
+	int64_t speed = static_cast<int64_t>(vocation->getBaseSpeed()) + g_config.getNumber(ConfigManager::PLAYER_SPEED_BONUS) +
+	                (below * perTen + above * perTenAbove) / 10;
+	baseSpeed = static_cast<uint32_t>(std::max<int64_t>(1, std::min<int64_t>(speed, PLAYER_MAX_SPEED)));
+}
