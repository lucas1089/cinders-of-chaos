+int64_t Creature::getLastStepDuration() const
+{
+	// Chaos (patch 0018): after a player's diagonal step the next one waits 7/5 of a straight step (the client waits
+	// the same); everything else as stock (floor change x2; a monster's diagonal x1, the stock 1.5 truncated)
+	int64_t stepDuration = getStepDuration();
+	if (lastStepDiagonal && getPlayer()) {
+		return stepDuration * PLAYER_DIAGONAL_STEP_NUM / PLAYER_DIAGONAL_STEP_DEN;
+	}
+	return stepDuration * lastStepCost;
+}
