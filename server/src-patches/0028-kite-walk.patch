+// Chaos (kite walk, src-patch 0028): after a kite walk ends, the chase of the attacked creature starts again this long
+// after the last step, so held keys and a new click in that window keep walking without a step toward the target
+static constexpr int64_t CHAOS_KITE_CHASE_RESUME_MS = 400;
+
 void Player::onWalk(Direction& dir)
 {
 	Creature::onWalk(dir);
+	if (kiteWalk) {
+		kiteChaseResumeTime = OTSYS_TIME() + getStepDuration(dir) + CHAOS_KITE_CHASE_RESUME_MS;
+		if (attackedCreature) {
+			// Chaos (kite walk): the step neither cancels the next attack (or a queued use) nor delays it
+			return;
+		}
+	}
 	setNextActionTask(nullptr);
 	setNextAction(OTSYS_TIME() + getStepDuration(dir));
 }
 
+bool Player::isKiteWalking() const
+{
+	return (kiteWalk && (!listWalkDir.empty() || eventWalk != 0)) || OTSYS_TIME() < kiteChaseResumeTime;
+}
+
+bool Player::keepsWalkPathOnFollow(const Creature* creature) const
+{
+	// starting to chase the attacked creature does not drop the player's own path
+	return kiteWalk && creature && creature == attackedCreature;
+}
