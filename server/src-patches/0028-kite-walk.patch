+// Chaos (kite walk, src-patch 0028): a walk the player asks for (a key, a map or minimap click) keeps the attack
+// going: the chase of the attacked creature waits until the walk ends, and the steps do not cancel or delay the next
+// attack. Off while the player turned the client option "Keep attacking while moving" off (storage
+// CHAOS_KITE_WALK_OFF = 1, written by data/scripts/chaos/kitewalk.lua); then walking works as before.
+static constexpr uint32_t CHAOS_KITE_WALK_OFF = 7101820;
+
+static bool chaosKiteWalkOn(const Player* player)
+{
+	int32_t off;
+	return !(player->getStorageValue(CHAOS_KITE_WALK_OFF, off) && off == 1);
+}
