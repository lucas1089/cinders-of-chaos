 void Player::onWalkComplete()
@@ -3607,6 +3641,22 @@ void Player::onWalkComplete()
 		walkTaskEvent = g_scheduler.addEvent(walkTask);
 		walkTask = nullptr;
 	}
+	endKiteWalk();
+}
+
+void Player::endKiteWalk()
+{
+	if (!kiteWalk) {
+		return;
+	}
+
+	// Chaos (kite walk): the chase of the attacked creature starts again a moment after the last step
+	kiteWalk = false;
+	kiteChaseResumeTime = OTSYS_TIME() + CHAOS_KITE_CHASE_RESUME_MS;
+	if (followCreature && followCreature == attackedCreature) {
+		g_scheduler.addEvent(createSchedulerTask(CHAOS_KITE_CHASE_RESUME_MS + SCHEDULER_MINTICKS,
+		                                         std::bind(&Game::updateCreatureWalk, &g_game, getID())));
+	}
 }
 
