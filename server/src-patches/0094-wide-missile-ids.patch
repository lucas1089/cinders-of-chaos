diff --git a/src/chaoswidemissile.h b/src/chaoswidemissile.h
new file mode 100644
--- /dev/null
+++ b/src/chaoswidemissile.h
@@ -0,0 +1,125 @@
+// Chaos (src-patch 0094, O737): missile (distance effect) ids above 255. Pure: no engine header, so
+// server/tools/chaoswidemissile_test.cpp tests it alone (ci.yml cuts it out of the patch).
+//   * Login: after the capability byte of patch 0051 ("C" + u8) our client adds, inside the same RSA block, the string "W"
+//     and a second capability byte; bit 0 asks for 16-bit missile ids. The client adds the 4 bytes only when they fit the
+//     block. An older client pads the block with zeros, another client may pad with random bytes: only u16 length 1, the
+//     letter W and bit 0 together count as asking (markerAsks), and nothing is read past the block (markerFits).
+//   * Features: a client that asked gets feature 77 (the engine's GameDistanceEffectU16) in the 0x43 list, and from then on
+//     every 0x85 to it carries the id as u16 (decide: WORD).
+//   * Any other client gets the byte: an id up to 255 as it is, an id above 255 as its fallback (Game.setMissileFallback,
+//     set from Lua: data/lib/chaos_wide_missiles.lua) or not at all (DROP). Never a broken packet.
+//   * Missile 254 stays the engine's "weapon type" (CONST_ANI_WEAPONTYPE, resolved before anything is sent): the first id a
+//     new missile may take above the one-byte range is 256 (FIRST_WIDE).
+
+#ifndef FS_CHAOSWIDEMISSILE_H
+#define FS_CHAOSWIDEMISSILE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+
+namespace ChaosWideMissile {
+
+static constexpr char MARKER = 'W';
+static constexpr uint8_t CAPABILITY_MISSILE_U16 = 1 << 0;
+static constexpr size_t MARKER_BYTES = 4; // u16 string length 1, 'W', u8 second capability byte
+static constexpr uint8_t FEATURE_DISTANCE_EFFECT_U16 = 77; // GameDistanceEffectU16 of the server's and the client's const.h
+static constexpr uint16_t WEAPON_TYPE = 254; // CONST_ANI_WEAPONTYPE
+static constexpr uint16_t FIRST_WIDE = 256;
+
+// the 4 bytes of the "W" block can be read: they lie inside the RSA block (position and its end are offsets of the message)
+inline bool markerFits(size_t position, size_t blockEnd)
+{
+	return position <= blockEnd && blockEnd - position >= MARKER_BYTES;
+}
+
+// the client may add the "W" block: the RSA payload (payload bytes so far) has room for it
+inline bool clientFits(int payloadSize, int rsaSize)
+{
+	return payloadSize >= 0 && rsaSize > 0 && payloadSize + static_cast<int>(MARKER_BYTES) <= rsaSize;
+}
+
+// what the 4 bytes say: only the exact marker with bit 0 asks (zero padding and random padding do not)
+inline bool markerAsks(uint16_t length, uint8_t letter, uint8_t capabilities)
+{
+	return length == 1 && letter == static_cast<uint8_t>(MARKER) && (capabilities & CAPABILITY_MISSILE_U16) != 0;
+}
+
+enum class Wire : uint8_t { DROP, BYTE, WORD };
+
+struct Send {
+	Wire wire;
+	uint16_t id;
+};
+
+// how one missile goes to one client. wide: the client was told feature 77. fallback: the one-byte missile that stands in
+// for an id above 255 (0 = none)
+inline Send decide(uint16_t id, bool wide, uint16_t fallback)
+{
+	if (wide) {
+		return {Wire::WORD, id};
+	}
+	if (id <= 0xFF) {
+		return {Wire::BYTE, id};
+	}
+	if (fallback != 0 && fallback <= 0xFF) {
+		return {Wire::BYTE, fallback};
+	}
+	return {Wire::DROP, 0};
+}
+
+// the fallbacks of the ids above 255, set from Lua. A row needs an id 256..65535 and a fallback 1..255 (0 removes the row)
+class Fallbacks
+{
+	public:
+		bool set(int64_t id, int64_t fallback)
+		{
+			if (id < FIRST_WIDE || id > 0xFFFF || fallback < 0 || fallback > 0xFF) {
+				return false;
+			}
+			if (fallback == 0) {
+				rows.erase(static_cast<uint16_t>(id));
+			} else {
+				rows[static_cast<uint16_t>(id)] = static_cast<uint8_t>(fallback);
+			}
+			return true;
+		}
+
+		uint16_t get(uint16_t id) const
+		{
+			if (id < FIRST_WIDE) {
+				return 0;
+			}
+			auto it = rows.find(id);
+			return it != rows.end() ? it->second : 0;
+		}
+
+		void clear() { rows.clear(); }
+		size_t size() const { return rows.size(); }
+
+	private:
+		std::map<uint16_t, uint8_t> rows;
+};
+
+// a missile id written as text (monsters.xml shootEffect, items.xml shootType): a whole number 1..65535, else 0
+inline uint16_t parseId(const char* text)
+{
+	if (!text || !*text) {
+		return 0;
+	}
+	uint32_t v = 0;
+	for (const char* p = text; *p; ++p) {
+		if (*p < '0' || *p > '9') {
+			return 0;
+		}
+		v = v * 10 + static_cast<uint32_t>(*p - '0');
+		if (v > 0xFFFF) {
+			return 0;
+		}
+	}
+	return static_cast<uint16_t>(v);
+}
+
+} // namespace ChaosWideMissile
