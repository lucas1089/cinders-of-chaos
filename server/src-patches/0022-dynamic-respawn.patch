 	return 1;
 }
 
+int LuaScriptInterface::luaGameSetSpawnIntervalPercent(lua_State* L)
+{
+	// Game.setSpawnIntervalPercent(percent[, fromPosition, toPosition])
+	// every map spawn (or those whose centre lies in the box) respawns after percent of its spawntime (10-1000);
+	// returns how many spawns were set
+	uint16_t percent = static_cast<uint16_t>(std::max<int32_t>(10, std::min<int32_t>(getNumber<int32_t>(L, 1), 1000)));
+	bool box = lua_gettop(L) >= 3;
+	Position from, to;
+	if (box) {
+		from = getPosition(L, 2);
+		to = getPosition(L, 3);
+	}
+	uint32_t count = 0;
+	for (Spawn& spawn : g_game.map.spawns.getSpawnList()) {
+		if (box) {
+			const Position& c = spawn.getCenterPos();
+			if (c.x < from.x || c.x > to.x || c.y < from.y || c.y > to.y || c.z < from.z || c.z > to.z) {
+				continue;
+			}
+		}
+		spawn.setIntervalPercent(percent);
+		++count;
+	}
+	lua_pushnumber(L, count);
+	return 1;
+}
