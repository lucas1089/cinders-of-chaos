+uint32_t Spawn::scaledInterval(uint32_t base) const
+{
+	if (intervalPercent == 100) {
+		return base;
+	}
+	uint64_t scaled = static_cast<uint64_t>(base) * intervalPercent / 100;
+	scaled = std::max<uint64_t>(scaled, MINSPAWN_INTERVAL);
+	return static_cast<uint32_t>(std::min<uint64_t>(scaled, MAXSPAWN_INTERVAL));
+}
+
+void Spawn::setIntervalPercent(uint16_t percent)
+{
+	percent = std::max<uint16_t>(10, std::min<uint16_t>(percent, 1000));
+	if (percent == intervalPercent) {
+		return;
+	}
+	bool sooner = percent < intervalPercent;
+	intervalPercent = percent;
+	// a pending check was scheduled with the old, longer interval: check again soon (checkSpawn reschedules itself)
+	if (sooner && checkSpawnEvent != 0) {
+		stopEvent();
+		checkSpawnEvent = g_scheduler.addEvent(createSchedulerTask(1000, std::bind(&Spawn::checkSpawn, this)));
 	}
 }
 
