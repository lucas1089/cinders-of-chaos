+// Cinders of Chaos engine patch 0014 (server/src-patches/0014-salted-password-hashes.patch).
+// Part of the engine, under its GPL-2.0 License (LICENSE in the server source root).
+
+// Chaos (patch 0014): salted, slow account password hashes.
+//
+// Stored format (accounts.password, VARCHAR(255)), the same one the website writes:
+//   pbkdf2-sha256$<iterations>$<salt, standard base64>$<derived key, standard base64>
+// PBKDF2-HMAC-SHA256 (Crypto++), 16-byte random salt, 32-byte key. A 40-hex-digit value is the old unsalted SHA-1:
+// it is still accepted, and replaced by a PBKDF2 hash after the first successful login.
+
+#ifndef FS_PASSWORDHASH_H_C7A1D2F0B8E94B6C9E3A5D7F1B2C4E68
+#define FS_PASSWORDHASH_H_C7A1D2F0B8E94B6C9E3A5D7F1B2C4E68
+
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace PasswordHash {
+
+constexpr uint32_t DEFAULT_ITERATIONS = 120000;
+constexpr uint32_t MIN_ITERATIONS = 1000;
+constexpr uint32_t MAX_ITERATIONS = 10000000;
+
+struct Result {
+	bool ok = false;
+	bool needsRehash = false; // legacy SHA-1, or fewer iterations than configured
+};
+
+// passwordHashIterations from config.lua, clamped to MIN_ITERATIONS..MAX_ITERATIONS
+uint32_t configuredIterations();
+
+std::string hash(const std::string& password, uint32_t iterations);
+Result verify(const std::string& password, const std::string& stored, uint32_t wantedIterations);
+// costs what verifying a real PBKDF2 hash costs; used when the account does not exist or the legacy check failed
+void dummyVerify(const std::string& password, uint32_t iterations);
+
+bool isLegacySha1(const std::string& stored);
+
+}
+
+// A small pool of threads for login authentication (database lookup + PBKDF2), so the dispatcher and the network
+// thread never wait for a hash. Results are posted back to the dispatcher by the task itself.
+class PasswordWorker
+{
+	public:
+		PasswordWorker() = default;
+		~PasswordWorker();
+		PasswordWorker(const PasswordWorker&) = delete;
+		PasswordWorker& operator=(const PasswordWorker&) = delete;
+
+		// false when the queue is full (login flood) or the worker was shut down: the caller refuses the login
+		bool addTask(std::function<void()> task);
+		void shutdown(); // drops queued tasks, waits for the running ones
+
+		static constexpr size_t MAX_QUEUED = 64;
+
+	private:
+		void threadMain();
+
+		std::mutex lock;
+		std::condition_variable signal;
+		std::deque<std::function<void()>> tasks;
+		std::vector<std::thread> threads;
+		bool stopping = false;
+};
+
+extern PasswordWorker g_passwordWorker;
+
+#endif
