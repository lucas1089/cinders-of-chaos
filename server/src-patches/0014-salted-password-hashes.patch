+// Cinders of Chaos engine patch 0014 (server/src-patches/0014-salted-password-hashes.patch).
+// Part of the engine, under its GPL-2.0 License (LICENSE in the server source root).
+
+#include "otpch.h"
+
+#include "passwordhash.h"
+
+#include "configmanager.h"
+#include "tools.h"
+
+#include <fmt/format.h>
+
+#include <cryptopp/base64.h>
+#include <cryptopp/filters.h>
+#include <cryptopp/misc.h>
+#include <cryptopp/osrng.h>
+#include <cryptopp/pwdbased.h>
+#include <cryptopp/sha.h>
+
+extern ConfigManager g_config;
+
+PasswordWorker g_passwordWorker;
+
+namespace PasswordHash {
+
+namespace {
+
+constexpr char PREFIX[] = "pbkdf2-sha256";
+constexpr size_t SALT_BYTES = 16;
+constexpr size_t KEY_BYTES = 32;
+
+std::string toBase64(const CryptoPP::byte* data, size_t size)
+{
+	std::string out;
+	CryptoPP::StringSource ss(data, size, true, new CryptoPP::Base64Encoder(new CryptoPP::StringSink(out), false));
+	return out;
+}
+
+bool fromBase64(const std::string& in, std::string& out)
+{
+	if (in.empty() || in.size() % 4 != 0) {
+		return false;
+	}
+	for (char c : in) {
+		if (!(std::isalnum(static_cast<unsigned char>(c)) || c == '+' || c == '/' || c == '=')) {
+			return false;
+		}
+	}
+	out.clear();
+	CryptoPP::StringSource ss(in, true, new CryptoPP::Base64Decoder(new CryptoPP::StringSink(out)));
+	return !out.empty();
+}
+
+std::string derive(const std::string& password, const std::string& salt, uint32_t iterations, size_t keyBytes)
+{
+	std::string key(keyBytes, '\0');
+	CryptoPP::PKCS5_PBKDF2_HMAC<CryptoPP::SHA256> kdf;
+	kdf.DeriveKey(reinterpret_cast<CryptoPP::byte*>(&key[0]), key.size(), 0,
+	              reinterpret_cast<const CryptoPP::byte*>(password.data()), password.size(),
+	              reinterpret_cast<const CryptoPP::byte*>(salt.data()), salt.size(), iterations, 0);
+	return key;
+}
+
+bool constantTimeEquals(const std::string& a, const std::string& b)
+{
+	if (a.size() != b.size()) {
+		return false;
+	}
+	return CryptoPP::VerifyBufsEqual(reinterpret_cast<const CryptoPP::byte*>(a.data()),
+	                                 reinterpret_cast<const CryptoPP::byte*>(b.data()), a.size());
+}
+
+uint32_t clampIterations(int64_t iterations)
+{
+	return static_cast<uint32_t>(std::max<int64_t>(MIN_ITERATIONS, std::min<int64_t>(MAX_ITERATIONS, iterations)));
+}
+
+}
+
+uint32_t configuredIterations()
+{
+	return clampIterations(g_config.getNumber(ConfigManager::PASSWORD_HASH_ITERATIONS));
+}
+
+bool isLegacySha1(const std::string& stored)
+{
+	return stored.size() == 40 && std::all_of(stored.begin(), stored.end(), [](char c) { return std::isxdigit(static_cast<unsigned char>(c)); });
+}
+
+std::string hash(const std::string& password, uint32_t iterations)
+{
+	iterations = clampIterations(iterations);
+	CryptoPP::byte salt[SALT_BYTES];
+	CryptoPP::AutoSeededRandomPool rng;
+	rng.GenerateBlock(salt, sizeof(salt));
+	const std::string key = derive(password, std::string(reinterpret_cast<const char*>(salt), sizeof(salt)), iterations, KEY_BYTES);
+	return fmt::format("{:s}${:d}${:s}${:s}", PREFIX, iterations, toBase64(salt, sizeof(salt)),
+	                   toBase64(reinterpret_cast<const CryptoPP::byte*>(key.data()), key.size()));
+}
+
+void dummyVerify(const std::string& password, uint32_t iterations)
+{
+	static const std::string salt(SALT_BYTES, '\x5a');
+	derive(password, salt, clampIterations(iterations), KEY_BYTES);
+}
+
+Result verify(const std::string& password, const std::string& stored, uint32_t wantedIterations)
+{
+	Result result;
+	if (isLegacySha1(stored)) {
+		// transformToSHA1 gives lower-case hex; a value written by MySQL's SHA1() or by hand may be upper case
+		std::string lowered = stored;
+		std::transform(lowered.begin(), lowered.end(), lowered.begin(), [](unsigned char c) { return std::tolower(c); });
+		result.ok = constantTimeEquals(transformToSHA1(password), lowered);
+		if (result.ok) {
+			result.needsRehash = true;
+		} else {
+			dummyVerify(password, wantedIterations); // a wrong password costs the same on every kind of account
+		}
+		return result;
+	}
+
+	// pbkdf2-sha256$<iterations>$<salt>$<key>
+	const StringVector parts = explodeString(stored, "$");
+	if (parts.size() != 4 || parts[0] != PREFIX || parts[1].empty() || parts[1].size() > 8 ||
+	        !std::all_of(parts[1].begin(), parts[1].end(), [](char c) { return c >= '0' && c <= '9'; })) {
+		dummyVerify(password, wantedIterations);
+		return result;
+	}
+
+	const uint32_t iterations = static_cast<uint32_t>(std::stoul(parts[1]));
+	std::string salt, key;
+	if (iterations < 1 || iterations > MAX_ITERATIONS || !fromBase64(parts[2], salt) || !fromBase64(parts[3], key) ||
+	        key.size() < 16 || key.size() > 64) {
+		dummyVerify(password, wantedIterations);
+		return result;
+	}
+
+	result.ok = constantTimeEquals(derive(password, salt, iterations, key.size()), key);
+	result.needsRehash = result.ok && (iterations < wantedIterations || key.size() != KEY_BYTES);
+	return result;
+}
+
+}
+
+PasswordWorker::~PasswordWorker()
+{
+	shutdown();
+}
+
+bool PasswordWorker::addTask(std::function<void()> task)
+{
+	std::unique_lock<std::mutex> guard(lock);
+	if (stopping || tasks.size() >= MAX_QUEUED) {
+		return false;
+	}
+
+	if (threads.empty()) {
+		// two threads: one slow login never holds up the next, and a login flood costs at most two cores
+		for (int i = 0; i < 2; ++i) {
+			threads.emplace_back(&PasswordWorker::threadMain, this);
+		}
+	}
+
+	tasks.push_back(std::move(task));
+	guard.unlock();
+	signal.notify_one();
+	return true;
+}
+
+void PasswordWorker::shutdown()
+{
+	{
+		std::lock_guard<std::mutex> guard(lock);
+		if (stopping) {
+			return;
+		}
+		stopping = true;
+		tasks.clear();
+	}
+	signal.notify_all();
+	for (std::thread& thread : threads) {
+		if (thread.joinable()) {
+			thread.join();
+		}
+	}
+}
+
+void PasswordWorker::threadMain()
+{
+	while (true) {
+		std::function<void()> task;
+		{
+			std::unique_lock<std::mutex> guard(lock);
+			signal.wait(guard, [this]() { return stopping || !tasks.empty(); });
+			if (stopping) {
+				return;
+			}
+			task = std::move(tasks.front());
+			tasks.pop_front();
+		}
+
+		try {
+			task();
+		} catch (const std::exception& e) {
+			std::cout << "[Error - PasswordWorker] " << e.what() << std::endl;
+		}
+	}
+}
