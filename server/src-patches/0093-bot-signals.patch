diff --git a/src/chaosbotsignals.h b/src/chaosbotsignals.h
new file mode 100644
--- /dev/null
+++ b/src/chaosbotsignals.h
@@ -0,0 +1,127 @@
+// Chaos (src-patch 0093): what the engine sees of a player's walking and targeting that Lua cannot see, for the bot detection
+// (data/scripts/chaos/botdet.lua). Pure parts, tested by server/tools/chaosbotsignals_test.cpp. Counts and a few times only:
+// nothing here acts on the player and nothing is saved.
+#ifndef FS_CHAOSBOTSIGNALS_H
+#define FS_CHAOSBOTSIGNALS_H
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace ChaosBotSignals {
+
+// creatures that came into view and have not been attacked yet: a ring, a new one pushes the oldest out
+constexpr size_t SEEN_CAP = 64;
+// reaction times waiting for the next poll of the script (a script polls every few seconds): the oldest are dropped
+constexpr size_t REACTION_CAP = 32;
+// a creature seen longer ago than this is not a reaction when it is attacked (the player had it in view for a while)
+constexpr int64_t SEEN_MAX_AGE_MS = 30000;
+// the largest step count one path command adds (a client walks at most a screen and a half; a bigger number is a bad packet)
+constexpr uint32_t MAX_PATH_STEPS = 4096;
+
+struct Drained {
+	uint32_t keySteps = 0;
+	uint32_t pathCommands = 0;
+	uint32_t pathSteps = 0;
+	std::vector<std::pair<uint32_t, int32_t>> reactions; // (creature id, milliseconds from coming into view to the first attack)
+
+	bool empty() const {
+		return keySteps == 0 && pathCommands == 0 && pathSteps == 0 && reactions.empty();
+	}
+};
+
+class Signals
+{
+	public:
+		// a step asked for with a key (Game::playerMove)
+		void keyStep() {
+			if (keySteps != UINT32_MAX) {
+				++keySteps;
+			}
+		}
+
+		// a walk asked for with a click on the map or the minimap (Game::playerAutoWalk): one command of `steps` steps
+		void pathCommand(size_t steps) {
+			if (steps == 0) {
+				return;
+			}
+			if (pathCommands != UINT32_MAX) {
+				++pathCommands;
+			}
+			const uint32_t add = steps > MAX_PATH_STEPS ? MAX_PATH_STEPS : static_cast<uint32_t>(steps);
+			pathSteps = (UINT32_MAX - pathSteps < add) ? UINT32_MAX : pathSteps + add;
+		}
+
+		// a monster moved into the player's view (a creature already in the list keeps being listed, with the new time)
+		void seen(uint32_t id, int64_t nowMs) {
+			for (size_t i = 0; i < seenCount; ++i) {
+				if (seenList[i].id == id) {
+					seenList[i].at = nowMs;
+					return;
+				}
+			}
+			if (seenCount < SEEN_CAP) {
+				seenList[seenCount++] = {id, nowMs};
+			} else {
+				seenList[seenNext] = {id, nowMs};
+				seenNext = (seenNext + 1) % SEEN_CAP;
+			}
+		}
+
+		// the player attacked a creature: when it is one that came into view and is waiting, its first attack is a reaction time
+		// (and it is not waiting any more, so a second attack on it, a retarget, counts for nothing)
+		void attacked(uint32_t id, int64_t nowMs) {
+			for (size_t i = 0; i < seenCount; ++i) {
+				if (seenList[i].id != id) {
+					continue;
+				}
+				const int64_t ms = nowMs - seenList[i].at;
+				seenList[i] = seenList[seenCount - 1];
+				--seenCount;
+				if (seenNext >= seenCount) {
+					seenNext = 0;
+				}
+				if (ms >= 0 && ms <= SEEN_MAX_AGE_MS) {
+					if (reactions.size() >= REACTION_CAP) {
+						reactions.erase(reactions.begin());
+					}
+					reactions.emplace_back(id, static_cast<int32_t>(ms));
+				}
+				return;
+			}
+		}
+
+		// everything since the last call, and back to zero
+		Drained drain() {
+			Drained d;
+			d.keySteps = keySteps;
+			d.pathCommands = pathCommands;
+			d.pathSteps = pathSteps;
+			d.reactions.swap(reactions);
+			keySteps = pathCommands = pathSteps = 0;
+			return d;
+		}
+
+		size_t waiting() const {
+			return seenCount;
+		}
+
+	private:
+		struct Entry {
+			uint32_t id = 0;
+			int64_t at = 0;
+		};
+
+		Entry seenList[SEEN_CAP];
+		size_t seenCount = 0;
+		size_t seenNext = 0;
+		uint32_t keySteps = 0;
+		uint32_t pathCommands = 0;
+		uint32_t pathSteps = 0;
+		std::vector<std::pair<uint32_t, int32_t>> reactions;
+};
+
+} // namespace ChaosBotSignals
+
+#endif
