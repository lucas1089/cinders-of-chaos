+int LuaScriptInterface::luaPlayerGetBotSignals(lua_State* L)
+{
+	// player:getBotSignals() (Chaos, src-patch 0093): what the engine counted of this player's walking and targeting since the last call
+	// (chaosbotsignals.h), as {keys, paths, pathSteps, reactions = {{creature id, ms}, ...}}, and back to zero. nil when there is nothing
+	// (or the player is gone). Read only: nothing here changes the player.
+	Player* player = getUserdata<Player>(L, 1);
+	if (!player) {
+		lua_pushnil(L);
+		return 1;
+	}
+
+	ChaosBotSignals::Drained drained = player->getChaosBotSignals().drain();
+	if (drained.empty()) {
+		lua_pushnil(L);
+		return 1;
+	}
+
+	lua_createtable(L, 0, 4);
+	setField(L, "keys", drained.keySteps);
+	setField(L, "paths", drained.pathCommands);
+	setField(L, "pathSteps", drained.pathSteps);
+	lua_createtable(L, static_cast<int>(drained.reactions.size()), 0);
+	int index = 0;
+	for (const auto& reaction : drained.reactions) {
+		lua_createtable(L, 2, 0);
+		lua_pushnumber(L, reaction.first);
+		lua_rawseti(L, -2, 1);
+		lua_pushnumber(L, reaction.second);
+		lua_rawseti(L, -2, 2);
+		lua_rawseti(L, -2, ++index);
+	}
+	lua_setfield(L, -2, "reactions");
+	return 1;
+}
