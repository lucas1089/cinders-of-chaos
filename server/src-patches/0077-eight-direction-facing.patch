# Eight-direction facing (O283; server/README.md "Eight-direction facing (O283)"). Owner request 2026-10-28: creatures
# turn and walk on the diagonals too, for looks drawn in 8 directions (client base patch 0160 draws them).
# The server keeps its four-way Creature::direction for everything it decides with it (spell areas and waves, the
# tile in front, Lua getDirection). Next to it:
#   * src/chaosfacing.h (new, header only, no engine types; server/tools/chaosfacing_test.cpp builds it alone):
#     ofStep (the diagonal of a diagonal step), toward (the diagonal of a target that lies nearer a diagonal than an
#     axis: the smaller offset over 0.4 of the larger) and wire (the server's diagonals in the client's order:
#     north-east 4, south-east 5, south-west 6, north-west 7; the server's own values differ).
#   * creature.h: Creature::facing, set with the direction by setDirection; getFacing / setFacing.
#   * map.cpp: Map::moveCreature gives a diagonal step its diagonal facing (the direction stays east or west).
#   * monster.cpp: Monster::updateLookDirection turns to the same four-way direction as before and faces the target's
#     diagonal; with no target it does nothing (stock: a turn to the same direction, a no-op).
#   * game.cpp / game.h: Game::internalCreatureTurn(creature, dir, facing = DIRECTION_NONE) sends a turn when the
#     direction or the facing changes; a plain turn faces `dir`.
#   * protocolgame.cpp: the turn packet (0x6B) and the creature description (AddCreature) send wire(facing).
# A client without base patch 0160, or a look without diagonal columns, draws a diagonal east or west: what it drew
# before. The client already draws a diagonal walk from the move packet; this patch keeps the facing when a creature
# comes into view and turns monsters to a diagonal target. The web cast viewer (server/tools/cast_relay.py) draws a
# diagonal east or west the same way.
--- /dev/null
+++ b/src/chaosfacing.h
@@ -0,0 +1,79 @@
+// Copyright 2022 The Forgotten Server Authors. All rights reserved.
+// Use of this source code is governed by the GPL-2.0 License that can be found in the LICENSE file.
+
+#ifndef FS_CHAOSFACING_H
+#define FS_CHAOSFACING_H
+
+// Eight-direction facing (patch 0077, server/README.md "Eight-direction facing (O283)"). Header only, no engine
+// types: server/tools/chaosfacing_test.cpp builds it alone.
+//   A creature keeps its four-way direction for everything the server decides with it (spell areas, waves, the
+//   tile in front). Next to it, Creature::facing is the way the clients draw it: a diagonal after a diagonal step, or
+//   when a monster turns to a target that stands nearer a diagonal than an axis. The client draws a diagonal with the
+//   look's diagonal columns when the look has 8 (client base patch 0160), else east or west as before.
+
+#include <cstdint>
+#include <cstdlib>
+
+namespace ChaosFacing {
+
+// the server's Direction values (position.h)
+enum : uint8_t {
+	NORTH = 0,
+	EAST = 1,
+	SOUTH = 2,
+	WEST = 3,
+	SOUTHWEST = 4,
+	SOUTHEAST = 5,
+	NORTHWEST = 6,
+	NORTHEAST = 7,
+	NONE = 8,
+};
+
+// the facing of a step by (dx, dy) (y grows to the south): its diagonal, or `straight` for a straight step
+inline uint8_t ofStep(int dx, int dy, uint8_t straight)
+{
+	if (dx == 0 || dy == 0) {
+		return straight;
+	}
+	if (dy < 0) {
+		return dx > 0 ? NORTHEAST : NORTHWEST;
+	}
+	return dx > 0 ? SOUTHEAST : SOUTHWEST;
+}
+
+// the facing toward a target at offset (dx, dy): its diagonal when the target lies nearer a diagonal than an axis
+// (the smaller offset over 0.4 of the larger; tan 22.5 degrees = 0.414), else `straight` (the four-way turn the engine
+// chose)
+inline uint8_t toward(int dx, int dy, uint8_t straight)
+{
+	const int ax = std::abs(dx);
+	const int ay = std::abs(dy);
+	const int lo = ax < ay ? ax : ay;
+	const int hi = ax < ay ? ay : ax;
+	if (lo == 0 || 5 * lo <= 2 * hi) {
+		return straight;
+	}
+	return ofStep(dx, dy, straight);
+}
+
+// the direction byte of the creature packets: the client's order is north, east, south, west, north-east,
+// south-east, south-west, north-west (the server's diagonals are south-west, south-east, north-west, north-east)
+inline uint8_t wire(uint8_t facing)
+{
+	switch (facing) {
+		case NORTHEAST:
+			return 4;
+		case SOUTHEAST:
+			return 5;
+		case SOUTHWEST:
+			return 6;
+		case NORTHWEST:
+			return 7;
+		default:
+			return facing <= WEST ? facing : static_cast<uint8_t>(SOUTH);
+	}
+}
+
+} // namespace ChaosFacing
+
+#endif
