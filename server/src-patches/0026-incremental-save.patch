+// the map, and the rows of houses the map no longer has. When the `houses` table could not be read (a new database),
+// nothing is recorded and the first save writes every house.
+void IOMapSerialize::recordLoadedHouses()
+{
+	if (houseInfoRead) {
+		for (const auto& it : g_game.map.houses.getHouses()) {
+			ChaosSave::SavedHouse& saved = savedHouses[it.first];
+			saved.known = true;
+			saved.lists = ChaosSave::houseListsSignature(loadedLists[it.first]);
+			saved.tiles = ChaosSave::houseTilesSignature(loadedTileRows[it.first]);
+		}
+	}
+	for (const auto& it : loadedTileRows) {
+		if (!g_game.map.houses.getHouse(it.first)) {
+			orphanHouseIds.insert(it.first);
+		}
+	}
+	for (const auto& it : loadedLists) {
+		if (!g_game.map.houses.getHouse(it.first)) {
+			orphanHouseIds.insert(it.first);
+		}
+	}
+	loadedTileRows.clear();
+	loadedLists.clear();
+	houseInfoRead = false;
+}
+
+// Chaos (src-patch 0026): a house as the save would write it. info: the `houses` columns; lists: guest, subowner and
+// door lists; rows: the `tile_store` rows (the stock format, one per tile with saved items).
+void IOMapSerialize::collectHouse(House* house, std::string& info, std::vector<std::pair<int64_t, std::string>>& lists,
+	std::vector<std::string>& rows)
+{
+	info = ChaosSave::houseInfoKey(house->getOwner(), static_cast<uint64_t>(house->getPaidUntil()),
+		house->getPayRentWarnings(), house->getName(), house->getTownId(), house->getRent(), house->getTiles().size(),
+		house->getBedCount());
+
+	lists.clear();
+	std::string listText;
+	if (house->getAccessList(GUEST_LIST, listText) && !listText.empty()) {
+		lists.emplace_back(GUEST_LIST, listText);
+	}
+	listText.clear();
+	if (house->getAccessList(SUBOWNER_LIST, listText) && !listText.empty()) {
+		lists.emplace_back(SUBOWNER_LIST, listText);
+	}
+	for (Door* door : house->getDoors()) {
+		listText.clear();
+		if (door->getAccessList(listText) && !listText.empty()) {
+			lists.emplace_back(door->getDoorId(), listText);
+		}
+	}
+
+	rows.clear();
+	PropWriteStream stream;
+	for (HouseTile* tile : house->getTiles()) {
+		saveTile(stream, tile);
+		size_t size;
+		const char* data = stream.getStream(size);
+		if (size > 0) {
+			rows.emplace_back(data, size);
+			stream.clear();
+		}
+	}
+}
+
+// Chaos (src-patch 0026): the ids of the houses whose rows in the database differ from memory: owner, rent, warnings,
+// name, size or beds; an access or door list; or anything on the house tiles (items added, removed, moved, changed,
+// container contents, texts, beds). Compared by content, so no change can slip past a missed event.
+std::vector<uint32_t> IOMapSerialize::changedHouseIds()
+{
+	std::vector<uint32_t> changed;
+	std::string info;
+	std::vector<std::pair<int64_t, std::string>> lists;
+	std::vector<std::string> rows;
+	for (const auto& it : g_game.map.houses.getHouses()) {
+		collectHouse(it.second, info, lists, rows);
+		auto saved = savedHouses.find(it.first);
+		const ChaosSave::SavedHouse none;
+		if (ChaosSave::compareHouse(saved != savedHouses.end() ? saved->second : none, info,
+				ChaosSave::houseListsSignature(lists), ChaosSave::houseTilesSignature(rows)).any()) {
+			changed.push_back(it.first);
+		}
+	}
+	return changed;
+}
+
+// Chaos (src-patch 0026): writes the given houses (only the parts that differ from the database: the `houses` row,
+// the lists, the tile rows) in one transaction, with a few statements whatever the number of houses. On success the
+// per-house record is updated; on a failure those houses count as unknown, so the next save writes them in full.
+bool IOMapSerialize::saveHouses(const std::vector<uint32_t>& houseIds)
+{
+	struct Pending {
+		House* house;
+		ChaosSave::HouseDiff diff;
+		std::string info;
+		std::vector<std::pair<int64_t, std::string>> lists;
+		std::vector<std::string> rows;
+	};
+
+	std::vector<Pending> pending;
+	for (uint32_t houseId : houseIds) {
+		House* house = g_game.map.houses.getHouse(houseId);
+		if (!house) {
+			continue;
+		}
+		Pending p;
+		p.house = house;
+		collectHouse(house, p.info, p.lists, p.rows);
+		auto saved = savedHouses.find(houseId);
+		const ChaosSave::SavedHouse none;
+		p.diff = ChaosSave::compareHouse(saved != savedHouses.end() ? saved->second : none, p.info,
+			ChaosSave::houseListsSignature(p.lists), ChaosSave::houseTilesSignature(p.rows));
+		if (p.diff.any()) {
+			pending.push_back(std::move(p));
+		}
+	}
+
+	if (pending.empty() && orphanHouseIds.empty()) {
+		return true;
+	}
+
+	Database& db = Database::getInstance();
+	DBTransaction transaction;
+	if (!transaction.begin()) {
+		return false;
+	}
+
+	auto fail = [&pending]() {
+		for (const Pending& p : pending) {
+			savedHouses[p.house->getId()].known = false;
+		}
+		return false;
+	};
+
+	if (!orphanHouseIds.empty()) {
+		const std::string ids = idList(std::vector<uint32_t>(orphanHouseIds.begin(), orphanHouseIds.end()));
+		if (!db.executeQuery("DELETE FROM `tile_store` WHERE `house_id` IN (" + ids + ")") ||
+				!db.executeQuery("DELETE FROM `house_lists` WHERE `house_id` IN (" + ids + ")")) {
+			return fail();
+		}
+	}
+
+	// the `houses` rows: one INSERT ... ON DUPLICATE KEY UPDATE for all of them (a missing row is created)
+	std::vector<uint32_t> listIds, tileIds;
+	std::string upsert;
+	for (const Pending& p : pending) {
+		const uint32_t id = p.house->getId();
+		if (p.diff.lists) {
+			listIds.push_back(id);
+		}
+		if (p.diff.tiles) {
+			tileIds.push_back(id);
+		}
+		if (!p.diff.info) {
+			continue;
+		}
+		House* house = p.house;
+		upsert += fmt::format("{:s}({:d}, {:d}, {:d}, {:d}, {:s}, {:d}, {:d}, {:d}, {:d})", upsert.empty() ? "" : ",",
+			id, house->getOwner(), house->getPaidUntil(), house->getPayRentWarnings(), db.escapeString(house->getName()),
+			house->getTownId(), house->getRent(), house->getTiles().size(), house->getBedCount());
+	}
+	if (!upsert.empty() && !db.executeQuery("INSERT INTO `houses` (`id`, `owner`, `paid`, `warnings`, `name`, `town_id`, `rent`, `size`, `beds`) VALUES " +
+			upsert + " ON DUPLICATE KEY UPDATE `owner` = VALUES(`owner`), `paid` = VALUES(`paid`), `warnings` = VALUES(`warnings`), "
+			"`name` = VALUES(`name`), `town_id` = VALUES(`town_id`), `rent` = VALUES(`rent`), `size` = VALUES(`size`), `beds` = VALUES(`beds`)")) {
+		return fail();
+	}
+
+	if (!listIds.empty()) {
+		if (!db.executeQuery("DELETE FROM `house_lists` WHERE `house_id` IN (" + idList(listIds) + ")")) {
+			return fail();
+		}
+		DBInsert stmt("INSERT INTO `house_lists` (`house_id` , `listid` , `list`) VALUES ");
+		for (const Pending& p : pending) {
+			if (!p.diff.lists) {
+				continue;
+			}
+			for (const auto& list : p.lists) {
+				if (!stmt.addRow(fmt::format("{:d}, {:d}, {:s}", p.house->getId(), list.first, db.escapeString(list.second)))) {
+					return fail();
+				}
+			}
+		}
+		if (!stmt.execute()) {
+			return fail();
+		}
+	}
+
+	if (!tileIds.empty()) {
+		if (!db.executeQuery("DELETE FROM `tile_store` WHERE `house_id` IN (" + idList(tileIds) + ")")) {
+			return fail();
+		}
+		DBInsert stmt("INSERT INTO `tile_store` (`house_id`, `data`) VALUES ");
+		for (const Pending& p : pending) {
+			if (!p.diff.tiles) {
+				continue;
+			}
+			for (const std::string& row : p.rows) {
+				if (!stmt.addRow(fmt::format("{:d}, {:s}", p.house->getId(), db.escapeBlob(row.data(), row.size())))) {
+					return fail();
+				}
+			}
+		}
+		if (!stmt.execute()) {
+			return fail();
+		}
+	}
+
+	if (!transaction.commit()) {
+		return fail();
+	}
+
+	orphanHouseIds.clear();
+	for (Pending& p : pending) {
+		ChaosSave::SavedHouse& saved = savedHouses[p.house->getId()];
+		saved.known = true;
+		saved.hasRow = true;
+		saved.info = std::move(p.info);
+		saved.lists = ChaosSave::houseListsSignature(std::move(p.lists));
+		saved.tiles = ChaosSave::houseTilesSignature(std::move(p.rows));
+	}
+	return true;
 }
