+// Chaos (src-patch 0026): the pure parts of the incremental save, without engine types so that
+// server/tools/chaossave_test.cpp can test them on their own.
+//   SavePass      the queue of one incremental pass: player ids first, then house ids; each tick takes work while
+//                 the tick's budget (count and milliseconds) allows
+//   houseTilesSignature, houseListsSignature, houseInfoKey
+//                 what a house looks like in the database, so that a save skips the houses that did not change
+#ifndef FS_CHAOSSAVE_H
+#define FS_CHAOSSAVE_H
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ChaosSave {
+
+// The defaults of Game.saveIncremental() and of SIGUSR1: players per tick, tick budget, pause between ticks (the
+// scheduler's minimum), houses per transaction
+constexpr uint32_t PLAYERS_PER_TICK = 10;
+constexpr uint32_t TICK_BUDGET_MS = 25;
+constexpr uint32_t TICK_DELAY_MS = 50;
+constexpr uint32_t HOUSES_PER_TICK = 100;
+
+// FNV-1a, 64 bits: the same value on every platform and run (the tests pin it)
+inline uint64_t fnv1a(const char* data, size_t size, uint64_t hash = 14695981039346656037ULL)
+{
+	for (size_t i = 0; i < size; ++i) {
+		hash ^= static_cast<unsigned char>(data[i]);
+		hash *= 1099511628211ULL;
+	}
+	return hash;
+}
+
+inline uint64_t fnv1a(const std::string& s, uint64_t hash = 14695981039346656037ULL)
+{
+	return fnv1a(s.data(), s.size(), hash);
+}
+
+// The tile rows of one house (each row: x, y, z, the item count, the items; the engine's own tile format). Rows are
+// sorted first, so the order of the tiles in memory and the order of the rows in the database do not matter (every
+// row starts with its own position, so two rows are never equal). Each row is hashed with its length, so moving bytes
+// from one row to the next changes the result.
+inline uint64_t houseTilesSignature(std::vector<std::string> rows)
+{
+	std::sort(rows.begin(), rows.end());
+	uint64_t hash = fnv1a("tiles", 5);
+	for (const std::string& row : rows) {
+		const uint64_t size = row.size();
+		hash = fnv1a(reinterpret_cast<const char*>(&size), sizeof(size), hash);
+		hash = fnv1a(row, hash);
+	}
+	return hash;
+}
+
+// The access lists of one house (guest, subowner and every door list) as (list id, text) pairs; empty lists are not
+// saved, so they do not count. Sorted by list id, then text.
+inline uint64_t houseListsSignature(std::vector<std::pair<int64_t, std::string>> lists)
+{
+	lists.erase(std::remove_if(lists.begin(), lists.end(), [](const std::pair<int64_t, std::string>& l) {
+		return l.second.empty();
+	}), lists.end());
+	std::sort(lists.begin(), lists.end());
+	uint64_t hash = fnv1a("lists", 5);
+	for (const auto& list : lists) {
+		const int64_t id = list.first;
+		const uint64_t size = list.second.size();
+		hash = fnv1a(reinterpret_cast<const char*>(&id), sizeof(id), hash);
+		hash = fnv1a(reinterpret_cast<const char*>(&size), sizeof(size), hash);
+		hash = fnv1a(list.second, hash);
+	}
+	return hash;
+}
+
+// The columns of the `houses` row that the engine writes, as one comparable string
+inline std::string houseInfoKey(uint64_t owner, uint64_t paid, uint64_t warnings, const std::string& name,
+	uint64_t townId, uint64_t rent, uint64_t size, uint64_t beds)
+{
+	return std::to_string(owner) + '|' + std::to_string(paid) + '|' + std::to_string(warnings) + '|' +
+		std::to_string(townId) + '|' + std::to_string(rent) + '|' + std::to_string(size) + '|' + std::to_string(beds) +
+		'|' + name;
+}
+
+// What a house needs written: each part is written only when it differs from what the database holds.
+struct HouseDiff {
+	bool info = false;
+	bool lists = false;
+	bool tiles = false;
+	bool any() const { return info || lists || tiles; }
+};
+
+// What the database holds for one house, as far as this process knows. `known` is false until the house was read
+// at startup or written once: an unknown house is written in full.
+struct SavedHouse {
+	bool known = false;
+	bool hasRow = false;
+	std::string info;
+	uint64_t lists = 0;
+	uint64_t tiles = 0;
+};
+
+inline HouseDiff compareHouse(const SavedHouse& saved, const std::string& info, uint64_t lists, uint64_t tiles)
+{
+	HouseDiff diff;
+	if (!saved.known) {
+		diff.info = diff.lists = diff.tiles = true;
+		return diff;
+	}
+	diff.info = !saved.hasRow || saved.info != info;
+	diff.lists = saved.lists != lists;
+	diff.tiles = saved.tiles != tiles;
+	return diff;
+}
+
+// The budget of one tick: at most maxItems pieces of work and about maxMs milliseconds. Another piece starts only when
+// the time spent so far plus what the last piece took still fits. The first piece always runs, so a pass always makes
+// progress, even when one piece alone takes longer than the budget.
+struct TickBudget {
+	uint32_t maxItems;
+	int64_t maxMs;
+
+	bool allows(uint32_t doneThisTick, int64_t elapsedMs, int64_t lastPieceMs = 0) const
+	{
+		if (doneThisTick == 0) {
+			return true;
+		}
+		return doneThisTick < maxItems && elapsedMs + std::max<int64_t>(0, lastPieceMs) <= maxMs;
+	}
+};
+
+// One incremental pass. Phases: players (ids taken one by one), then houses (ids taken in chunks), then done.
+class SavePass {
+	public:
+		enum Phase { IDLE, PLAYERS, HOUSES, DONE };
+
+		void start(std::vector<uint32_t> playerIds)
+		{
+			players = std::move(playerIds);
+			houses.clear();
+			nextPlayer = nextHouse = 0;
+			phase = PLAYERS;
+		}
+
+		Phase getPhase() const { return phase; }
+		bool running() const { return phase == PLAYERS || phase == HOUSES; }
+
+		bool hasPlayer() const { return phase == PLAYERS && nextPlayer < players.size(); }
+		uint32_t takePlayer() { return players[nextPlayer++]; }
+		size_t playersLeft() const { return players.size() - nextPlayer; }
+		size_t playerCount() const { return players.size(); }
+
+		// after the last player: the caller computes the changed houses and hands them over
+		bool playersDone() const { return phase == PLAYERS && nextPlayer >= players.size(); }
+		void setHouses(std::vector<uint32_t> houseIds)
+		{
+			houses = std::move(houseIds);
+			nextHouse = 0;
+			phase = HOUSES;
+		}
+
+		bool hasHouses() const { return phase == HOUSES && nextHouse < houses.size(); }
+		std::vector<uint32_t> takeHouses(size_t maxCount)
+		{
+			const size_t n = std::min(maxCount, houses.size() - nextHouse);
+			std::vector<uint32_t> chunk(houses.begin() + nextHouse, houses.begin() + nextHouse + n);
+			nextHouse += n;
+			return chunk;
+		}
+		size_t houseCount() const { return houses.size(); }
+
+		void finish() { phase = DONE; }
+		void abort() { phase = IDLE; players.clear(); houses.clear(); }
+
+	private:
+		std::vector<uint32_t> players;
+		std::vector<uint32_t> houses;
+		size_t nextPlayer = 0;
+		size_t nextHouse = 0;
+		Phase phase = IDLE;
+};
+
+} // namespace ChaosSave
+
+#endif
