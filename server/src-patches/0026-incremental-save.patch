+// Chaos (src-patch 0026): the autosave in small steps. The stock save (saveGameState) writes every online player and
+// every house in one dispatcher task, so the game stops for the whole save (1.3-1.6 s with 200 players). This pass
+// writes the account storage in the first tick, then players one by one while the tick's budget allows (at most
+// playersPerTick and about tickBudgetMs, judged by the last player's time), then the changed houses (housesPerTick
+// per transaction), with tickDelayMs between ticks so the game runs in between. Each player save is the stock one,
+// atomic per player (IOLoginData::savePlayer, one transaction), so player:save() / Chaos.saveCharacter keep their
+// meaning; a player who logs out before his turn was saved by the logout, one who logs in during the pass is not in
+// it. The game state does not change (no maintenance state, a closed server stays closed). The full save is still
+// the one of a shutdown, a closed server, /save and saveServer().
+bool Game::saveIncremental(uint32_t playersPerTick, uint32_t tickBudgetMs, uint32_t tickDelayMs, uint32_t housesPerTick)
+{
+	if (savePass.running() || gameState == GAME_STATE_SHUTDOWN) {
+		return false;
+	}
+
+	saveBudget = { std::max<uint32_t>(1, playersPerTick), std::max<int64_t>(1, tickBudgetMs) };
+	saveDelayMs = std::max<uint32_t>(SCHEDULER_MINTICKS, tickDelayMs);
+	saveHousesPerTick = std::max<uint32_t>(1, housesPerTick);
+
+	std::vector<uint32_t> guids;
+	guids.reserve(players.size());
+	for (const auto& it : players) {
+		guids.push_back(it.second->getGUID());
+	}
+
+	saveStats = {};
+	saveStats.start = OTSYS_TIME();
+	savePass.start(std::move(guids));
+	std::cout << "Saving server in steps (" << savePass.playerCount() << " players)..." << std::endl;
+
+	if (!saveAccountStorageValues()) {
+		std::cout << "[Error - Game::saveIncremental] Failed to save account-level storage values." << std::endl;
+	}
+	saveStats.ticks = 1;
+	saveStats.longestTick = OTSYS_TIME() - saveStats.start;
+
+	g_scheduler.addEvent(createSchedulerTask(saveDelayMs, [this]() { saveIncrementalStep(); }));
+	return true;
+}
+
+void Game::saveIncrementalStep()
+{
+	if (!savePass.running()) {
+		return;
+	}
+	if (gameState == GAME_STATE_SHUTDOWN) {
+		savePass.abort(); // the shutdown saves everything itself
+		return;
+	}
+
+	const int64_t start = OTSYS_TIME();
+	if (savePass.hasPlayer()) {
+		uint32_t done = 0;
+		while (savePass.hasPlayer() && saveBudget.allows(done, OTSYS_TIME() - start, saveStats.lastPlayerMs)) {
+			Player* player = getPlayerByGUID(savePass.takePlayer());
+			++done;
+			if (!player || player->isRemoved()) {
+				++saveStats.gone; // logged out: saved by the logout
+				continue;
+			}
+			const int64_t playerStart = OTSYS_TIME();
+			player->loginPosition = player->getPosition();
+			if (IOLoginData::savePlayer(player)) {
+				++saveStats.saved;
+			} else {
+				++saveStats.failed;
+				std::cout << "[Error - Game::saveIncremental] Could not save player " << player->getName() << '.' << std::endl;
+			}
+			saveStats.lastPlayerMs = OTSYS_TIME() - playerStart;
+		}
+	} else if (savePass.playersDone()) {
+		// the houses that changed, found in a tick of their own (it reads every house tile, no database work)
+		savePass.setHouses(IOMapSerialize::changedHouseIds());
+	} else if (savePass.hasHouses()) {
+		uint32_t chunks = 0;
+		while (savePass.hasHouses() && (chunks == 0 || OTSYS_TIME() - start < saveBudget.maxMs)) {
+			const std::vector<uint32_t> chunk = savePass.takeHouses(saveHousesPerTick);
+			++chunks;
+			if (IOMapSerialize::saveHouses(chunk)) {
+				saveStats.houses += chunk.size();
+			} else {
+				++saveStats.houseFailures; // they stay changed: the next save writes them
+				std::cout << "[Error - Game::saveIncremental] Could not save " << chunk.size() << " house(s)." << std::endl;
+			}
+		}
+	} else {
+		g_databaseTasks.flush();
+		savePass.finish();
+	}
+
+	const int64_t tick = OTSYS_TIME() - start;
+	++saveStats.ticks;
+	saveStats.longestTick = std::max(saveStats.longestTick, tick);
+
+	if (!savePass.running()) {
+		std::cout << "> Saved in steps: " << saveStats.saved << " players (" << saveStats.gone << " logged out before, "
+			<< saveStats.failed << " failed), " << saveStats.houses << " changed house(s); " << saveStats.ticks
+			<< " ticks, longest " << saveStats.longestTick << " ms, total " << (OTSYS_TIME() - saveStats.start) / (1000.)
+			<< " s" << std::endl;
+		return;
+	}
+	g_scheduler.addEvent(createSchedulerTask(saveDelayMs, [this]() { saveIncrementalStep(); }));
+}
