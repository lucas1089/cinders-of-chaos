+void Monsters::updateSpellLinks()
+{
+	for (auto& it : monsters) {
+		for (auto spells : {&it.second.info.attackSpells, &it.second.info.defenseSpells}) {
+			for (spellBlock_t& sb : *spells) {
+				if (!sb.combatSpell && !sb.spellName.empty()) {
+					// nullptr when no spell has that name any more: Monster skips the block
+					sb.spell = g_spells->getSpellByName(sb.spellName);
+				}
+			}
+		}
+	}
+}
