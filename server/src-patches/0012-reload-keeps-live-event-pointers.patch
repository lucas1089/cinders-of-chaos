 void CreatureEvents::removeInvalidEvents()
 {
-	for (auto it = creatureEvents.begin(); it != creatureEvents.end(); ++it) {
-		if (it->second.getScriptId() == 0) {
-			creatureEvents.erase(it->second.getName());
+	// Creatures keep raw pointers to these entries (Creature::eventsList), so an event left without a script by a reload
+	// is never freed here: it stays in the map, unloaded (getCreatureEvents and the global events skip it), and a later
+	// reload that brings the script back reuses it, which makes it work again for the creatures that still hold it.
+	for (auto& it : creatureEvents) {
+		if (it.second.getScriptId() == 0 && it.second.isLoaded()) {
+			it.second.clearEvent();
+		}
+	}
+}
+
+bool CreatureEvents::addEvent(CreatureEvent_ptr creatureEvent)
+{
+	auto it = creatureEvents.find(creatureEvent->getName());
+	if (it != creatureEvents.end()) {
+		CreatureEvent& oldEvent = it->second;
+		if (oldEvent.isLoaded()) {
+			// a second event with the same name is ignored, as before
+			return false;
 		}
+
+		if (oldEvent.getEventType() == creatureEvent->getEventType()) {
+			//an event with the same name and type that is not loaded (happens when reloading) is reused
+			oldEvent.copyEvent(creatureEvent.get());
+			return false;
+		}
+
+		// the name now has another type: creatures may still hold the old entry, so it is moved out of the map (kept
+		// alive, unloaded) instead of being freed, and the new event takes the name
+		retiredEvents.push_back(creatureEvents.extract(it));
 	}
+
+	creatureEvents.emplace(creatureEvent->getName(), std::move(*creatureEvent));
+	return true;
 }
 
