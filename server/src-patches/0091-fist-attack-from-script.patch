--- /dev/null
+++ b/src/chaosfist.h
@@ -0,0 +1,42 @@
+// Chaos (src-patch 0091): the bare-fist hit of a player with the attack a script gave it. Pure parts, tested by server/tools/chaosfist_test.cpp.
+#ifndef FS_CHAOSFIST_H
+#define FS_CHAOSFIST_H
+
+#include <cmath>
+#include <cstdint>
+
+namespace ChaosFist {
+
+// the limits a script's numbers are cleaned to: an attack above this is no fist attack (the highest set weapon attack is about 300 and the
+// Monk's fist attack at most 60 times its weapon growth 2.6), a multiplier above this is a typo; a number outside the range, NaN or infinity
+// means "none set" (attack) or 1 (multiplier), so the stock hit stays the fallback of every bad call
+constexpr float MAX_ATTACK = 2000.0f;
+constexpr float MAX_MULTIPLIER = 10.0f;
+
+inline float cleanAttack(float attack)
+{
+	if (!std::isfinite(attack) || attack <= 0.0f || attack > MAX_ATTACK) {
+		return 0.0f;
+	}
+	return attack;
+}
+
+inline float cleanMultiplier(float multiplier)
+{
+	if (!std::isfinite(multiplier) || multiplier <= 0.0f || multiplier > MAX_MULTIPLIER) {
+		return 1.0f;
+	}
+	return multiplier;
+}
+
+// Weapons::getMaxWeaponDamage (the stock formula: level / 5 + ((skill / 4 + 1) x (attack / 3) x 1.03) / attackFactor, rounded) with the
+// script's attack, times the script's multiplier, rounded once. The integer division of the level and the doubles are the engine's.
+inline int32_t maxDamage(uint32_t level, int32_t attackSkill, float attack, float multiplier, float attackFactor)
+{
+	const double base = (level / 5) + (((((attackSkill / 4.) + 1) * (attack / 3.)) * 1.03) / attackFactor);
+	return static_cast<int32_t>(std::round(base * multiplier));
+}
+
+} // namespace ChaosFist
+
+#endif
