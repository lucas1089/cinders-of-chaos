+	registerMethod("Player", "getFistAttack", LuaScriptInterface::luaPlayerGetFistAttack); // Chaos (src-patch 0091)
 
 	registerMethod("Player", "getStoreInbox", LuaScriptInterface::luaPlayerGetStoreInbox);
 
@@ -11428,6 +11430,34 @@
 	} else {
 		lua_pushnil(L);
 	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerSetFistAttack(lua_State* L)
+{
+	// player:setFistAttack(attack, multiplier) (Chaos, src-patch 0091): the bare-fist hit of this player is rolled with this attack value
+	// (the stock fist hit is attack 7) and its maximum multiplied by multiplier (default 1). attack 0 (or none) returns to the stock hit.
+	// Values outside the safe range are cleaned (chaosfist.h). Returns true, nil for a player that is gone.
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->setChaosFist(getNumber<float>(L, 2, 0.0f), getNumber<float>(L, 3, 1.0f));
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerGetFistAttack(lua_State* L)
+{
+	// player:getFistAttack() (Chaos, src-patch 0091): the attack and the multiplier set with setFistAttack, 0 and 1 when none is set
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		lua_pushnumber(L, player->getChaosFistAttack());
+		lua_pushnumber(L, player->getChaosFistMultiplier());
+		return 2;
+	}
+	lua_pushnil(L);
 	return 1;
 }
 
