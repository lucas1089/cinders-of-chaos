+// Chaos: custom attributes for the client (GameItemCustomAttributes, keys in const.h ChaosItemAttrKey)
+namespace {
+
+constexpr uint64_t CHAOS_FNV_OFFSET = 14695981039346656037ULL;
+constexpr uint64_t CHAOS_FNV_PRIME = 1099511628211ULL;
+
+uint64_t chaosHash(uint64_t h, const void* data, size_t len)
+{
+	const uint8_t* p = static_cast<const uint8_t*>(data);
+	for (size_t i = 0; i < len; ++i) {
+		h ^= p[i];
+		h *= CHAOS_FNV_PRIME;
+	}
+	return h;
+}
+
+uint64_t chaosHashNumber(uint64_t h, int64_t v)
+{
+	return chaosHash(h, &v, sizeof(v));
+}
+
+int64_t chaosAttrNumber(const ItemAttributes::CustomAttribute& attr)
+{
+	const auto& v = attr.value;
+	if (const int64_t* i = boost::get<int64_t>(&v)) {
+		return *i;
+	}
+	if (const double* d = boost::get<double>(&v)) {
+		return static_cast<int64_t>(*d);
+	}
+	if (const bool* b = boost::get<bool>(&v)) {
+		return *b ? 1 : 0;
+	}
+	if (const std::string* s = boost::get<std::string>(&v)) {
+		char* end = nullptr;
+		const long long n = std::strtoll(s->c_str(), &end, 10);
+		return (end && end != s->c_str()) ? static_cast<int64_t>(n) : 0;
+	}
+	return 0;
+}
+
+uint64_t chaosHashAttr(uint64_t h, const ItemAttributes::CustomAttribute& attr)
+{
+	const auto& v = attr.value;
+	const uint8_t which = static_cast<uint8_t>(v.which());
+	h = chaosHash(h, &which, 1);
+	if (const std::string* s = boost::get<std::string>(&v)) {
+		return chaosHash(h, s->data(), s->size());
+	}
+	if (const double* d = boost::get<double>(&v)) {
+		return chaosHash(h, d, sizeof(*d));
+	}
+	return chaosHashNumber(h, chaosAttrNumber(attr));
+}
+
+// per-item ids: (unix time of the first id of a block) << 20 | counter. A new block starts every 2^20 ids and at every
+// start of the server, so ids stay unique across restarts; they stay below 2^53 (exact as a Lua number).
+uint64_t chaosNextItemId()
+{
+	static uint64_t base = 0;
+	static uint64_t counter = 0;
+	if (base == 0 || counter >= (1ULL << 20)) {
+		const uint64_t now = static_cast<uint64_t>(std::time(nullptr));
+		base = std::max<uint64_t>(now, base + 1);
+		counter = 0;
+	}
+	return (base << 20) | counter++;
+}
+
+}
+
+void Item::getChaosClientAttributes(std::vector<std::pair<uint16_t, uint64_t>>& out)
+{
+	out.clear();
+	const int32_t typeRarity = items[id].rarity;
+	ItemAttributes::CustomAttributeMap* custom = attributes ? attributes->getCustomAttributeMap() : nullptr;
+	if (!custom) {
+		if (typeRarity > 0) {
+			out.emplace_back(CHAOS_ITEM_KEY_RARITY, static_cast<uint64_t>(typeRarity));
+		}
+		return;
+	}
+
+	int64_t rarity = 0, level = 0, locked = 0, sockets = 0, itemId = 0;
+	bool unique = false;
+	uint64_t sum = 0; // order-independent: the map has no fixed order
+	for (const auto& entry : *custom) {
+		const std::string& key = entry.first; // stored lower case
+		if (key == "chaos_iid") {
+			itemId = chaosAttrNumber(entry.second);
+			continue;
+		}
+		const int64_t n = chaosAttrNumber(entry.second);
+		if (key == "rarity") {
+			rarity = n;
+		} else if (key == "combatpowerlevel") {
+			level = n;
+		} else if (key == "chaos_locked") {
+			locked = n;
+		} else if (key == "chaos_unique") {
+			unique = true;
+		} else if (key == "chaos_sockets") {
+			sockets = n;
+		}
+		uint64_t h = chaosHash(CHAOS_FNV_OFFSET, key.data(), key.size());
+		h = chaosHashAttr(h, entry.second);
+		sum += (h ^ (h >> 29)) * 0x9E3779B97F4A7C15ULL;
+	}
+	if (rarity <= 0) {
+		rarity = typeRarity;
+	}
+	if (rarity <= 0 && level <= 0 && locked <= 0 && !unique && sockets <= 0) {
+		return;
+	}
+
+	if (itemId <= 0) {
+		itemId = static_cast<int64_t>(chaosNextItemId());
+		std::string key = "chaos_iid";
+		ItemAttributes::CustomAttribute value;
+		value.set<int64_t>(itemId);
+		setCustomAttribute(key, value);
+	}
+
+	uint64_t v = chaosHashNumber(CHAOS_FNV_OFFSET ^ sum, id);
+	static const itemAttrTypes intTypes[] = {ITEM_ATTRIBUTE_ATTACK, ITEM_ATTRIBUTE_DEFENSE, ITEM_ATTRIBUTE_EXTRADEFENSE,
+		ITEM_ATTRIBUTE_ARMOR, ITEM_ATTRIBUTE_HITCHANCE, ITEM_ATTRIBUTE_SHOOTRANGE, ITEM_ATTRIBUTE_ATTACK_SPEED};
+	for (itemAttrTypes type : intTypes) {
+		if (hasAttribute(type)) {
+			v = chaosHashNumber(chaosHashNumber(v, static_cast<int64_t>(type)), getIntAttr(type));
+		}
+	}
+	static const itemAttrTypes strTypes[] = {ITEM_ATTRIBUTE_NAME, ITEM_ATTRIBUTE_DESCRIPTION};
+	for (itemAttrTypes type : strTypes) {
+		if (hasAttribute(type)) {
+			const std::string& s = getStrAttr(type);
+			v = chaosHash(chaosHashNumber(v, static_cast<int64_t>(type)), s.data(), s.size());
+		}
+	}
+	uint32_t version = static_cast<uint32_t>(v ^ (v >> 32));
+	if (version == 0) {
+		version = 1;
+	}
+
+	if (rarity > 0) {
+		out.emplace_back(CHAOS_ITEM_KEY_RARITY, static_cast<uint64_t>(rarity));
+	}
+	if (level > 0) {
+		out.emplace_back(CHAOS_ITEM_KEY_LEVEL, static_cast<uint64_t>(level));
+	}
+	if (locked > 0) {
+		out.emplace_back(CHAOS_ITEM_KEY_LOCKED, 1);
+	}
+	if (unique) {
+		out.emplace_back(CHAOS_ITEM_KEY_UNIQUE, 1);
+	}
+	if (sockets > 0) {
+		out.emplace_back(CHAOS_ITEM_KEY_SOCKETS, static_cast<uint64_t>(sockets));
+	}
+	out.emplace_back(CHAOS_ITEM_KEY_ID, static_cast<uint64_t>(itemId));
+	out.emplace_back(CHAOS_ITEM_KEY_VERSION, version);
+}
