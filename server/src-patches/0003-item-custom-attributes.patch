+// Chaos: send an item again to the clients that see it, after a script changed its attributes (the engine sends an item
+// only when it moves or its id or count changes; a client that reads custom attributes would keep the old ones).
+// Unlike transforming to the same id this touches nothing on the item (no decay or duration reset).
+int LuaScriptInterface::luaItemSendUpdate(lua_State* L)
+{
+	// item:sendUpdate()
+	Item* item = getUserdata<Item>(L, 1);
+	if (!item) {
+		lua_pushnil(L);
+		return 1;
+	}
+
+	bool sent = false;
+	Cylinder* parent = item->getParent();
+	if (parent) {
+		Creature* creature = parent->getCreature();
+		Player* owner = creature ? creature->getPlayer() : nullptr;
+		if (owner) {
+			const int32_t slot = owner->getThingIndex(item);
+			if (slot >= CONST_SLOT_FIRST && slot <= CONST_SLOT_LAST) {
+				owner->sendInventoryItem(static_cast<slots_t>(slot), item);
+				sent = true;
+			}
+		} else if (Container* container = parent->getContainer()) {
+			const int32_t index = container->getThingIndex(item);
+			if (index >= 0) {
+				SpectatorVec spectators;
+				g_game.map.getSpectators(spectators, container->getPosition(), false, true, 1, 1, 1, 1);
+				for (Creature* spectator : spectators) {
+					spectator->getPlayer()->sendUpdateContainerItem(container, static_cast<uint16_t>(index), item);
+				}
+				sent = true;
+			}
+		} else if (Tile* tile = parent->getTile()) {
+			if (tile->getThingIndex(item) >= 0) {
+				SpectatorVec spectators;
+				g_game.map.getSpectators(spectators, tile->getPosition(), true, true);
+				for (Creature* spectator : spectators) {
+					spectator->getPlayer()->sendUpdateTileItem(tile, tile->getPosition(), item);
+				}
+				sent = true;
+			}
+		}
+	}
+	pushBoolean(L, sent);
+	return 1;
+}
+
+int LuaScriptInterface::luaItemGetClientAttributes(lua_State* L)
+{
+	// item:getClientAttributes() -> {[key] = value} as the client gets them (keys: Chaos.itemAttr)
+	Item* item = getUserdata<Item>(L, 1);
+	if (!item) {
+		lua_pushnil(L);
+		return 1;
+	}
+
+	std::vector<std::pair<uint16_t, uint64_t>> attrs;
+	item->getChaosClientAttributes(attrs);
+	lua_createtable(L, 0, attrs.size());
+	for (const auto& attr : attrs) {
+		lua_pushnumber(L, static_cast<double>(attr.second));
+		lua_rawseti(L, -2, attr.first);
+	}
+	return 1;
+}
