+// Chaos: custom attributes after the item (client feature GameItemCustomAttributes): u16 count, then u16 key + u64
+// value per entry (keys: ChaosItemAttrKey in const.h). Every item the client reads with its item parser goes through
+// these two: map tiles, inventory, containers, trade, text windows.
+void ProtocolGame::AddItem(NetworkMessage& msg, const Item* item)
+{
+	msg.addItem(item);
+	if (!chaosItemAttributes) {
+		return;
+	}
+	std::vector<std::pair<uint16_t, uint64_t>> attrs;
+	const_cast<Item*>(item)->getChaosClientAttributes(attrs);
+	msg.add<uint16_t>(static_cast<uint16_t>(attrs.size()));
+	for (const auto& attr : attrs) {
+		msg.add<uint16_t>(attr.first);
+		msg.add<uint64_t>(attr.second);
+	}
+}
+
+void ProtocolGame::AddItem(NetworkMessage& msg, uint16_t id, uint8_t count)
+{
+	msg.addItem(id, count);
+	if (chaosItemAttributes) {
+		msg.add<uint16_t>(0x00);
+	}
+}
