# Maximum health and mana stay inside int32 (server/README.md "Vigil reservation and maximum overflow (O358)"). Owner log
# 2026-10-31: the vigils' mana reservation grew from -4.3e9 to -9.9e9 in seconds and the player's save failed
# ("failed at: UPDATE players"). Player::getMaxHealth / getMaxMana cast the vitality / spirit share through uint32_t (a
# negative stat wrapped to about 4e9) and returned a sum that could leave int32 (getMaxMana is uint32_t, the `mana` column
# is a signed INT): a maximum of billions, a current mana the database refuses. Now the stat share is never negative, the
# sum is clamped to [1 or 0, INT32_MAX], and savePlayer clamps `health` (not below 0) and `mana` (not above INT32_MAX).
# vigils.lua re-reads the true maximum when its sum does not add up. Applies after 0001-0084.
--- a/src/iologindata.cpp
+++ b/src/iologindata.cpp
@@ -764,7 +764,7 @@
 	query << "`level` = " << player->level << ',';
 	query << "`group_id` = " << player->group->id << ',';
 	query << "`vocation` = " << player->getVocationId() << ',';
-	query << "`health` = " << player->health << ',';
+	query << "`health` = " << std::max<int32_t>(0, player->health) << ','; // Chaos (patch 0085): never out of the column
 	query << "`healthmax` = " << player->healthMax << ',';
 	query << "`experience` = " << player->experience << ',';
 	query << "`lookbody` = " << static_cast<uint32_t>(player->defaultOutfit.lookBody) << ',';
@@ -774,7 +774,7 @@
 	query << "`looktype` = " << player->defaultOutfit.lookType << ',';
 	query << "`lookaddons` = " << static_cast<uint32_t>(player->defaultOutfit.lookAddons) << ',';
 	query << "`maglevel` = " << player->magLevel << ',';
-	query << "`mana` = " << player->mana << ',';
+	query << "`mana` = " << std::min<uint32_t>(player->mana, std::numeric_limits<int32_t>::max()) << ','; // Chaos (patch 0085)
 	query << "`manamax` = " << player->manaMax << ',';
 	query << "`manaspent` = " << player->manaSpent << ',';
 	query << "`soul` = " << static_cast<uint16_t>(player->soul) << ',';
