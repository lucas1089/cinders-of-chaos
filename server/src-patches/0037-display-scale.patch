# The display scale (server/README.md "Display scale"). Every combat number a player sees is the internal number x the
# factor of that player's own level; the internal numbers (health, damage, balance, the database) never change. The
# factors come from Lua once at load: Game.setDisplayScale(factors) with factors[level] for levels 1..n (whole numbers,
# data/scripts/chaos/display_scale.lua and display_scale_config.lua: 1 up to level 100, 1000 at level 1000, 10000 from
# level 1500 on); a higher level uses the last entry. Without a table every factor is 1 and nothing changes.
#   * ProtocolGame::sendTextMessage: the damage and heal messages (MESSAGE_DAMAGE_DEALT / _RECEIVED / _OTHERS,
#     MESSAGE_HEALED / _OTHERS) that a player receives carry their values x that player's factor (uint32, clamped) and
#     the numbers of the text that count hitpoints, mana, energy shield or health x the same factor ("1 hitpoint" shown
#     as more becomes "hitpoints"). So each spectator sees its own scale: the attacker, the target and the bystanders
#     of one hit each get their own numbers. The experience messages and every other type are unchanged.
#   * ProtocolGame::AddPlayerStats: the player's own health, max health, mana and max mana x its factor (uint32,
#     clamped). Health bars of creatures stay percentages.
#   * Player::sendEnergyShield (patch 0015): "es:<current>:<max>" x the player's factor.
#   * Lua: Game.setDisplayScale(factors) (returns the levels in the table), player:getDisplayScale().
# New header src/chaosdisplay.h (pure functions: the table, the clamp, the text rule; tests in
# server/tools/chaosdisplay_test.cpp, CI). A whole-number factor keeps sums exact: the shown parts of a hit add up to
# the shown total, and a shown health minus the shown hits is the new shown health. Guard: tools/display_scale_patch_test.py
# (CI). Applies after 0001-0036.
diff --git a/src/chaosdisplay.h b/src/chaosdisplay.h
new file mode 100644
--- /dev/null
+++ b/src/chaosdisplay.h
@@ -0,0 +1,107 @@
+// Chaos (patch 0037): the display scale. Every combat number a player sees is the internal number x the factor of
+// that player's level; the internal numbers (health, damage, the database) never change. The factors come from Lua
+// (Game.setDisplayScale, data/scripts/chaos/display_scale.lua: whole numbers, 1 up to level 100, 1000 at level
+// 1000, capped); without a table every factor is 1 and nothing changes. Pure functions, no engine types, so
+// server/tools/chaosdisplay_test.cpp tests them alone.
+
+#ifndef FS_CHAOSDISPLAY_H
+#define FS_CHAOSDISPLAY_H
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace ChaosDisplay {
+
+// the largest number written into a text: the same bound as the Lua side's JSON numbers (2^53)
+constexpr uint64_t TEXT_MAX = 9007199254740992ULL;
+
+// factor of level 1..n at index level - 1; a level past the end uses the last entry (the cap)
+inline std::vector<uint32_t>& table()
+{
+	static std::vector<uint32_t> factors;
+	return factors;
+}
+
+inline uint32_t factorOf(uint32_t level)
+{
+	const std::vector<uint32_t>& factors = table();
+	if (factors.empty()) {
+		return 1;
+	}
+	const size_t index = std::min<size_t>(std::max<uint32_t>(level, 1), factors.size()) - 1;
+	return std::max<uint32_t>(factors[index], 1);
+}
+
+// value x factor, clamped to [0, max]
+inline uint64_t scale(uint64_t value, uint32_t factor, uint64_t max)
+{
+	if (factor <= 1) {
+		return std::min<uint64_t>(value, max);
+	}
+	if (value > max / factor) {
+		return max;
+	}
+	return value * factor;
+}
+
+// a uint32 packet field (TextMessage values, the stats packet): a negative value is 0
+inline uint32_t scaleU32(int64_t value, uint32_t factor)
+{
+	if (value <= 0) {
+		return 0;
+	}
+	return static_cast<uint32_t>(scale(static_cast<uint64_t>(value), factor, std::numeric_limits<uint32_t>::max()));
+}
+
+// the numbers of a damage / heal text: a run of digits followed by " hitpoint", " mana", " energy shield" or
+// " health" ("A dragon loses 120 hitpoints due to your attack." -> "... loses 120000 hitpoints ..."); other numbers
+// (a name, a level, experience) stay as they are. "1 hitpoint" that became more than one is "hitpoints".
+inline std::string scaleText(const std::string& text, uint32_t factor)
+{
+	if (factor <= 1) {
+		return text;
+	}
+	static const char* const units[] = {" hitpoint", " mana", " energy shield", " health"};
+	std::string out;
+	out.reserve(text.size() + 16);
+	size_t i = 0;
+	while (i < text.size()) {
+		if (text[i] < '0' || text[i] > '9' || (i > 0 && (std::isalnum(static_cast<unsigned char>(text[i - 1])) || text[i - 1] == '.'))) {
+			out.push_back(text[i++]);
+			continue;
+		}
+		size_t end = i;
+		while (end < text.size() && text[end] >= '0' && text[end] <= '9') {
+			++end;
+		}
+		const char* unit = nullptr;
+		for (const char* u : units) {
+			if (text.compare(end, std::char_traits<char>::length(u), u) == 0) {
+				unit = u;
+				break;
+			}
+		}
+		if (!unit || end - i > 18) {
+			out.append(text, i, end - i);
+			i = end;
+			continue;
+		}
+		const uint64_t shown = scale(std::stoull(text.substr(i, end - i)), factor, TEXT_MAX);
+		out += std::to_string(shown);
+		i = end;
+		static const std::string singular = " hitpoint";
+		if (unit == units[0] && shown != 1 && text.compare(end, singular.size() + 1, singular + "s") != 0) {
+			out += singular + "s";
+			i = end + singular.size();
+		}
+	}
+	return out;
+}
+
+} // namespace ChaosDisplay
+
+#endif
