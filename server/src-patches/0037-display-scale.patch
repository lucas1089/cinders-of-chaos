+int LuaScriptInterface::luaGameSetDisplayScale(lua_State* L)
+{
+	// Game.setDisplayScale(factors) (Chaos, src-patch 0037): factors[level] for levels 1..n, whole numbers >= 1 (a
+	// missing or smaller entry is 1); a level above n uses factors[n]. The engine shows damage / heal text messages,
+	// a player's own health and mana and the energy shield in the receiving player's factor. An empty table turns
+	// it off. Returns how many levels the table has.
+	if (!isTable(L, 1)) {
+		reportErrorFunc(L, "Game.setDisplayScale: a table of factors expected");
+		pushBoolean(L, false);
+		return 1;
+	}
+	std::vector<uint32_t> factors;
+	lua_pushnil(L);
+	while (lua_next(L, 1) != 0) {
+		if (lua_isnumber(L, -2) && lua_isnumber(L, -1)) {
+			const double key = lua_tonumber(L, -2);
+			const double value = lua_tonumber(L, -1);
+			if (key >= 1 && key <= 100000) {
+				const size_t level = static_cast<size_t>(key);
+				if (factors.size() < level) {
+					factors.resize(level, 1);
+				}
+				factors[level - 1] = static_cast<uint32_t>(std::max<double>(1, std::min<double>(value, 1000000000)));
+			}
+		}
+		lua_pop(L, 1);
+	}
+	ChaosDisplay::table() = std::move(factors);
+	lua_pushnumber(L, ChaosDisplay::table().size());
+	return 1;
+}
+
 int LuaScriptInterface::luaGameSetSpawnIntervalZones(lua_State* L)
 {
 	// Game.setSpawnIntervalZones(globalPercent, zones) (Chaos, src-patches/0027)
@@ -9085,6 +9120,19 @@ int LuaScriptInterface::luaPlayerSetMaxM
 	} else {
 		lua_pushnil(L);
 	}
+	return 1;
+}
+
+// Chaos (patch 0037): the display scale
+int LuaScriptInterface::luaPlayerGetDisplayScale(lua_State* L)
+{
+	// player:getDisplayScale(): the factor of the player's level in the table of Game.setDisplayScale (1 without one)
+	const Player* player = getUserdata<const Player>(L, 1);
+	if (player) {
+		lua_pushnumber(L, ChaosDisplay::factorOf(player->getLevel()));
+	} else {
+		lua_pushnil(L);
+	}
 	return 1;
 }
 
