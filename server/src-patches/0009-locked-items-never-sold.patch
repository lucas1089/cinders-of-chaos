 	}
 
+	// Chaos: locked items (custom attribute "chaos_locked") are never sold. player:removeItem skips them anyway; refuse
+	// here with a clear message (and before any NPC script pays) when the unlocked copies are not enough.
+	const int32_t countSubType = (it.isSplash() || it.isFluidContainer()) ? subType : -1;
+	const uint32_t unlocked = player->countRemovableItemsOfType(it.id, countSubType, ignoreEquipped, false, nullptr, amount);
+	if (unlocked < amount) {
+		if (player->countRemovableItemsOfType(it.id, countSubType, ignoreEquipped, true, nullptr, amount) >= amount) {
+			player->sendTextMessage(MESSAGE_STATUS_SMALL, "Locked items cannot be sold.");
+			player->sendSaleItemList();
+			return;
+		}
+	}
+
 	merchant->onPlayerTrade(player, onSell, it.id, subType, amount, ignoreEquipped);
 }
 
