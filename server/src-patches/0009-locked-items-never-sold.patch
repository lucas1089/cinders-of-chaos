+bool Player::removeItemOfType(uint16_t itemId, uint32_t amount, int32_t subType, bool ignoreEquipped/* = false*/, bool includeLocked/* = false*/) const
+{
+	if (amount == 0) {
+		return true;
+	}
+
+	std::vector<Item*> itemList;
+	if (countRemovableItemsOfType(itemId, subType, ignoreEquipped, includeLocked, &itemList, amount) < amount) {
+		return false;
+	}
+
+	g_game.internalRemoveItems(std::move(itemList), amount, Item::items[itemId].stackable);
+	return true;
+}
