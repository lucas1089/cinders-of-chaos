+bool Item::isChaosLocked() const
+{
+	if (!attributes || !attributes->hasAttribute(ITEM_ATTRIBUTE_CUSTOM)) {
+		return false;
+	}
+
+	const ItemAttributes::Attribute* attr = attributes->getExistingAttr(ITEM_ATTRIBUTE_CUSTOM);
+	if (!attr || !attr->value.custom) {
+		return false;
+	}
+
+	auto it = attr->value.custom->find("chaos_locked");
+	if (it == attr->value.custom->end()) {
+		return false;
+	}
+
+	const ItemAttributes::CustomAttribute::VariantAttribute& v = it->second.value;
+	if (const int64_t* i = boost::get<int64_t>(&v)) {
+		return *i != 0;
+	} else if (const double* d = boost::get<double>(&v)) {
+		return *d != 0;
+	} else if (const bool* b = boost::get<bool>(&v)) {
+		return *b;
+	} else if (const std::string* s = boost::get<std::string>(&v)) {
+		return !s->empty() && *s != "0";
+	}
+	return false;
+}
+
+bool Item::holdsChaosLocked() const
+{
+	if (isChaosLocked()) {
+		return true;
+	}
+
+	if (const Container* container = getContainer()) {
+		for (ContainerIterator it = container->iterator(); it.hasNext(); it.advance()) {
+			if ((*it)->isChaosLocked()) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
 bool Item::hasMarketAttributes() const
 {
+	// Chaos: a locked item never goes on the market (any custom attribute already keeps an item off it)
+	if (isChaosLocked()) {
+		return false;
+	}
+
 	if (attributes == nullptr) {
 		return true;
 	}
