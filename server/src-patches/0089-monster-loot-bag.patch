+}
+
+int LuaScriptInterface::luaGameSetMonsterLootBag(lua_State* L)
+{
+	// Game.setMonsterLootBag(bagId, keepIds) (Chaos, src-patch 0089): every monster that has a corpse leaves the item
+	// bagId instead, except the monsters whose own corpse id is in keepIds (a list of ids). bagId 0 (or no argument)
+	// turns it off. Player corpses are not touched. Returns true.
+	ChaosLootBag::Config config;
+	config.bagId = getNumber<uint16_t>(L, 1, 0);
+	if (isTable(L, 2)) {
+		lua_pushnil(L);
+		while (lua_next(L, 2) != 0) {
+			if (lua_isnumber(L, -1)) {
+				config.keep.insert(static_cast<uint16_t>(lua_tonumber(L, -1)));
+			}
+			lua_pop(L, 1);
+		}
+	}
+	ChaosLootBag::current() = std::move(config);
+	pushBoolean(L, true);
 	return 1;
 }
 
