@@ -0,0 +1,37 @@
+// Chaos (src-patch 0089): the loot bag instead of monster bodies. Pure parts, tested by server/tools/chaoslootbag_test.cpp.
+#ifndef FS_CHAOSLOOTBAG_H
+#define FS_CHAOSLOOTBAG_H
+
+#include <cstdint>
+#include <unordered_set>
+
+namespace ChaosLootBag {
+
+struct Config {
+	uint16_t bagId = 0;                 // 0 = off: every monster leaves its own corpse
+	std::unordered_set<uint16_t> keep;  // monster corpse ids that stay as they are (quest and boss mechanics)
+};
+
+// the one table, filled by Game.setMonsterLootBag from data/scripts/chaos/corpse_config.lua
+inline Config& current()
+{
+	static Config config;
+	return config;
+}
+
+// The corpse item a monster leaves. corpse is its own look corpse (0 = it leaves nothing: stays nothing). Used by
+// Monster::getLookCorpse only: Player::getLookCorpse never asks, so a player's body is never changed.
+inline uint16_t corpseOf(const Config& config, uint16_t corpse)
+{
+	if (config.bagId == 0 || corpse == 0 || corpse == config.bagId) {
+		return corpse;
+	}
+	if (config.keep.count(corpse) != 0) {
+		return corpse;
+	}
+	return config.bagId;
+}
+
+} // namespace ChaosLootBag
+
+#endif
