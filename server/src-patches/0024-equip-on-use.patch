+// Chaos (src-patch 0024): the client position of an item the player carries, for the Lua move events of the equip
+// hotkey and of a use that equips: an inventory slot {0xFFFF, slot, 0}, a container slot {0xFFFF, 0x40 | cid, index}.
+// A container the player has not open has no cid: 0x40 | 0x3F then (no client container has that id; a script that
+// asks player:getContainerById(y - 0x40) gets nil, the cylinders are passed as well).
+static Position chaosCarriedPosition(const Player* player, const Item* item)
+{
+	const Cylinder* parent = item->getParent();
+	if (parent == player) {
+		return Position(0xFFFF, static_cast<uint16_t>(static_cast<const Cylinder*>(player)->getThingIndex(item)), 0);
+	}
+	if (const Container* container = dynamic_cast<const Container*>(parent)) {
+		int8_t cid = player->getContainerID(container);
+		return Position(0xFFFF, 0x40 | (cid >= 0 ? cid : 0x3F), static_cast<uint8_t>(container->getThingIndex(item)));
+	}
+	return item->getPosition();
+}
+
+// Chaos 0024: an equipment move of the equip hotkey or of a use that equips, with the player as the actor and the
+// client positions, so Player:onMoveItem and the onMoveItem / onItemMoved callbacks run as for drag and drop (the base
+// rarity bonuses, the item modifiers, the hands rules and the two-handed swap of default_onMoveItem.lua, archery).
+// Before 0024 the hotkey moved without them: a ring put on showed its own skill bonus only, and a ring it swapped out
+// kept its rarity conditions.
+ReturnValue Game::chaosEquipMove(Player* player, Item* item, int32_t slot, const Position& fromPos)
+{
+	const Position toPos(0xFFFF, static_cast<uint16_t>(slot), 0);
+	return internalMoveItem(item->getParent(), player, slot, item, item->getItemCount(), nullptr, 0, player, nullptr, &fromPos, &toPos);
+}
+
+// Chaos 0024: take a worn item off into the containers. The backpack first (a weapon taken off never lands in the
+// other hand); when it has no room, wherever the stock hotkey put it (Player::queryDestination: a free slot of a fitting
+// kind, then the containers; a ring never goes into the other ring slot, 0023).
+ReturnValue Game::chaosTakeOff(Player* player, Item* item, const Position& fromPos)
+{
+	ReturnValue ret = RETURNVALUE_NOTPOSSIBLE;
+	Item* backpack = player->getInventoryItem(CONST_SLOT_BACKPACK);
+	if (backpack && backpack->getContainer()) {
+		ret = chaosEquipMove(player, item, CONST_SLOT_BACKPACK, fromPos);
+		if ((ret != RETURNVALUE_CONTAINERNOTENOUGHROOM && ret != RETURNVALUE_NOTENOUGHROOM) || item->isRemoved() ||
+		    item->getParent() != player) {
+			return ret;
+		}
+	}
+	return chaosEquipMove(player, item, CONST_SLOT_WHEREEVER, fromPos);
+}
+
+// Chaos 0024: the item types a use puts on: a head, necklace, armour, legs, feet or ring item, a weapon, shield or
+// quiver. Every item may be held in a hand by default (SLOTP_HAND), so the hands count by weapon type only;
+// ammunition, the base's extra slots (deck, badge, ship, belt, gloves) and the backpack slot do not count.
+bool Game::chaosEquipsOnUse(const ItemType& it)
+{
+	if (it.slotPosition & (SLOTP_HEAD | SLOTP_NECKLACE | SLOTP_ARMOR | SLOTP_LEGS | SLOTP_FEET | SLOTP_RING)) {
+		return true;
+	}
+	switch (it.weaponType) {
+		case WEAPON_SWORD:
+		case WEAPON_CLUB:
+		case WEAPON_AXE:
+		case WEAPON_SHIELD:
+		case WEAPON_DISTANCE:
+		case WEAPON_WAND:
+		case WEAPON_QUIVER:
+			return true;
+		default:
+			return false;
+	}
+}
+
+// Chaos 0024 (server/README.md "Right-click equips"): a use of an item that has no action of its own (Actions::
+// internalUseItem, a right-click in the classic controls, Ctrl + click in the regular ones, a click in the smart ones,
+// "Use" in the context menu) puts it on when it is equipment the player carries in a container, and takes it off into
+// the backpack when it is worn. The exact item clicked moves (the equip hotkey can only name an item type). Not for a
+// hotkey use, an item on the ground, in a depot or in another's hands, and not when the player turned it off (the
+// client option "Right-click equips items" sends it, storage CHAOS_EQUIP_ON_USE_OFF = 1). RETURNVALUE_CANNOTUSETHISOBJECT
+// when none of this applies, as before.
+static constexpr uint32_t CHAOS_EQUIP_ON_USE_OFF = 7101810;
+
+ReturnValue Game::chaosUseEquip(Player* player, Item* item, const Position& pos, bool isHotkey)
+{
+	if (isHotkey || pos.x != 0xFFFF || item->getTopParent() != player || item->getContainer()) {
+		return RETURNVALUE_CANNOTUSETHISOBJECT;
+	}
+
+	const ItemType& it = Item::items[item->getID()];
+	if (!chaosEquipsOnUse(it) || !item->isPickupable() || !item->isPushable() || item->hasAttribute(ITEM_ATTRIBUTE_UNIQUEID)) {
+		return RETURNVALUE_CANNOTUSETHISOBJECT;
+	}
+
+	int32_t off;
+	if (player->getStorageValue(CHAOS_EQUIP_ON_USE_OFF, off) && off == 1) {
+		return RETURNVALUE_CANNOTUSETHISOBJECT;
+	}
+
+	const Position fromPos = chaosCarriedPosition(player, item);
+	if (item->getParent() == player) {
+		return chaosTakeOff(player, item, fromPos);
+	}
+
+	slots_t slot = getSlotType(it);
+	if (slot == CONST_SLOT_RING) {
+		// the free ring slot (9 first), else the one holding a might ring when this is one (one might ring at a
+		// time, 0023), else slot 9 (the rings swap)
+		const Item* first = player->getInventoryItem(CONST_SLOT_RING);
+		const Item* second = player->getInventoryItem(CONST_SLOT_AMMO);
+		if (it.chaosMightRing && first && Item::items[first->getID()].chaosMightRing) {
+			slot = CONST_SLOT_RING;
+		} else if (it.chaosMightRing && second && Item::items[second->getID()].chaosMightRing) {
+			slot = CONST_SLOT_AMMO;
+		} else if (first && !second) {
+			slot = CONST_SLOT_AMMO;
+		}
+	} else if (slot != CONST_SLOT_HEAD && slot != CONST_SLOT_NECKLACE && slot != CONST_SLOT_ARMOR && slot != CONST_SLOT_LEGS &&
+	           slot != CONST_SLOT_FEET && slot != CONST_SLOT_LEFT && slot != CONST_SLOT_RIGHT) {
+		return RETURNVALUE_CANNOTUSETHISOBJECT;
+	}
+
+	return chaosEquipMove(player, item, slot, fromPos);
+}
+
