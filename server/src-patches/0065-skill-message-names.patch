+// Chaos (patch 0065): the skill as the player's messages call it ("You advanced to melee level 43."). The skills window
+// (client game_simpleskills) shows one Melee row for the sword, club and axe skills, Ranged for distance fighting. Only the
+// messages use this; getSkillName stays the engine's name (item look texts, the Lua rewrite in melee_skill_look.lua).
+std::string getSkillMessageName(uint8_t skillid)
+{
+	switch (skillid) {
+		case SKILL_CLUB:
+		case SKILL_SWORD:
+		case SKILL_AXE:
+			return "melee";
+
+		case SKILL_DISTANCE:
+			return "ranged";
+
+		default:
+			return getSkillName(skillid);
+	}
+}
