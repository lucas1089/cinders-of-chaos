+int LuaScriptInterface::luaGameSetSpawnIntervalZones(lua_State* L)
+{
+	// Game.setSpawnIntervalZones(globalPercent, zones) (Chaos, src-patches/0027)
+	// every map spawn respawns after globalPercent of its spawntime, a spawn whose centre lies in one of the zones
+	// ({x0 =, y0 =, x1 =, y1 =, z =, percent =}, a later zone wins) after that zone's percent; percents 10-1000. The same
+	// result as Game.setSpawnIntervalPercent(globalPercent) and then one call per zone, without a pass over every
+	// spawn per zone. Returns how many spawns are in a zone.
+	const uint16_t globalPercent = ChaosZones::clampPercent(getNumber<int32_t>(L, 1));
+	std::vector<ChaosZones::Zone> zones;
+	if (lua_istable(L, 2)) {
+		for (int i = 1; ; ++i) {
+			lua_rawgeti(L, 2, i);
+			if (!lua_istable(L, -1)) {
+				lua_pop(L, 1);
+				break;
+			}
+			ChaosZones::Zone zone;
+			auto field = [L](const char* name) {
+				lua_getfield(L, -1, name);
+				const int32_t value = static_cast<int32_t>(lua_tonumber(L, -1));
+				lua_pop(L, 1);
+				return value;
+			};
+			zone.x0 = field("x0");
+			zone.y0 = field("y0");
+			zone.x1 = field("x1");
+			zone.y1 = field("y1");
+			zone.z = field("z");
+			zone.percent = ChaosZones::clampPercent(field("percent"));
+			zones.push_back(zone);
+			lua_pop(L, 1);
+		}
+	}
+	lua_pushnumber(L, g_game.map.spawns.setIntervalZones(globalPercent, zones));
+	return 1;
+}
