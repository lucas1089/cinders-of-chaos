+static void copyLabel(char* dest, size_t size, const std::string& text)
+{
+	size_t n = std::min(text.size(), size - 1);
+	std::copy_n(text.data(), n, dest);
+	dest[n] = '\0';
+}
+
+void luaCallDone(const char* source, int line, int64_t us, int64_t heapBefore, int64_t heapAfter)
+{
+	Record* r = current;
+	if (!r) {
+		return;
+	}
+	if (heapBefore - heapAfter > r->gcFreedBytes) {
+		r->gcFreedBytes = heapBefore - heapAfter;
+	}
+	if (r->luaDepth > 0) {
+		return; // nested in another Lua call: counted there
+	}
+	r->luaUs += us;
+	++r->luaCalls;
+	if (us > r->longestLuaUs) {
+		r->longestLuaUs = us;
+		// "@/path/to/server/data/scripts/x.lua" -> "data/scripts/x.lua"
+		std::string file = source ? source : "?";
+		if (!file.empty() && file[0] == '@') {
+			file.erase(0, 1);
+		}
+		const size_t data = file.rfind("/data/");
+		if (data != std::string::npos) {
+			file.erase(0, data + 1);
+		}
+		copyLabel(r->longestLua, sizeof(r->longestLua), file + ':' + std::to_string(line));
+	}
+}
+
+void dbQueryDone(const std::string& query, int64_t us, int64_t lockUs)
+{
+	Record* r = current;
+	if (!r) {
+		return;
+	}
+	r->dbUs += us;
+	r->dbLockUs += lockUs;
+	++r->dbQueries;
+	if (us > r->longestDbUs) {
+		r->longestDbUs = us;
+		std::string q = query.substr(0, 95);
+		std::replace(q.begin(), q.end(), '\n', ' ');
+		copyLabel(r->longestDb, sizeof(r->longestDb), q);
+	}
+}
+
+static std::string taskName(const Task* task)
+{
+	const char* mangled = task->getFuncType().name();
+#if defined(__GNUC__)
+	int status = 0;
+	char* demangled = abi::__cxa_demangle(mangled, nullptr, nullptr, &status);
+	std::string name = (status == 0 && demangled) ? demangled : mangled;
+	std::free(demangled);
+#else
+	std::string name = mangled; // MSVC: already readable
+#endif
+	if (name.size() > 160) {
+		name.resize(160);
+	}
+	return name;
+}
+
+static void logSlowTask(const Task* task, const Record& r, int64_t us)
+{
+	std::ostringstream ss;
+	ss << "[slow task] " << (us / 1000) << " ms";
+	if (r.luaCalls > 0) {
+		ss << " | lua " << (r.luaUs / 1000) << " ms in " << r.luaCalls << " call(s), longest " << (r.longestLuaUs / 1000)
+		   << " ms " << r.longestLua;
+	}
+	if (r.gcFreedBytes >= 1024) {
