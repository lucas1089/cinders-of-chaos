# Game loop stalls (server/README.md "Game loop stalls" and "Slow task log"). With 200 bots on the full map the game
# loop stood still for 250-650 ms every 20-25 s outside saves. Two engine parts:
#   * Slow task log, off by default (config.lua slowTaskLogMs = 0). With slowTaskLogMs = N the dispatcher times every
#     task (scheduler events run as dispatcher tasks too) and logs each one that took N ms or more, one console line:
#       [slow task] 265 ms | lua 265 ms in 1 call(s), longest 265 ms data/scripts/chaos/item_mods.lua:203
#         | lua gc freed 59981 KB | db 3 ms in 10 queries (waiting for the connection 0 ms), longest 1 ms: INSERT ...
#         | task std::_Bind<void (LuaEnvironment::*(LuaEnvironment*, unsigned int))(unsigned int)>
#     Lua: every outermost Lua call of the task (LuaScriptInterface::protectedCall: globalevents, creaturescripts,
#     revscripts, addEvent callbacks, events) with its time; the longest is named by file and the line where its
#     function starts. "lua gc freed": the Lua heap shrank by that much during one call, so the collector swept there.
#     Database: the queries the dispatcher ran itself (Database::executeQuery / storeQuery / commit / rollback on that
#     thread), their time, the part spent waiting for the connection (the async query thread holds the same connection)
#     and the longest query's first 95 characters (a COMMIT waits for the database's log flush). Task: the C++ function type of the task (demangled with GCC / Clang). Off, the cost is
#     one config read per task; on, about 1 us per Lua call. For finding stalls on a test or live server.
#   * Game.setSpawnIntervalZones(globalPercent, zones) for the dynamic respawn (data/scripts/chaos/respawn.lua, patch
#     0022): every map spawn gets globalPercent, a spawn whose centre lies in one of the zones ({x0, y0, x1, y1, z,
#     percent}, a later zone wins) that zone's percent; the same result as Game.setSpawnIntervalPercent(globalPercent)
#     and then one call per zone. Game.setSpawnIntervalPercent makes one pass over every map spawn per call (the full
#     map has about 50,000: 6-10 ms a pass), and respawn.lua made one call per busy zone every 20 s. Spawns keeps an
#     index of its spawns by 16x16 cell and floor (built at the first call) and touches only the spawns of the new zones
#     and of the last call's zones (every spawn when the global percent changed, or after a Game.setSpawnIntervalPercent
#     call). New src/chaoszones.h: the index, header only, tested by server/tools/chaoszones_test.cpp (CI); a spawn whose
#     percent does not change is not touched, so its pending check keeps its time.
# Apply in the server source root after 0001-0026: patch -p1 < 0027-game-loop-stalls.patch, then rebuild.
# src/CMakeLists.txt is not touched. The Lua side needs no new opcode or storage.
diff --git a/src/chaoszones.h b/src/chaoszones.h
new file mode 100644
index 0000000..14d1201
--- /dev/null
+++ b/src/chaoszones.h
@@ -0,0 +1,131 @@
+// Chaos (src-patches/0027): the dynamic respawn's zones applied without a pass over every map spawn.
+// Game.setSpawnIntervalZones (luascript.cpp) hands the busy zones of data/scripts/chaos/respawn.lua to Spawns, which keeps
+// an index of its spawns by 16x16 cell and floor and touches only the spawns in the new zones and those the last call
+// lowered. The full map has about 50,000 spawns: one pass over all of them took 6-10 ms, and the old calls made one
+// pass per zone every 20 s. Pure template code (no engine types), tested by server/tools/chaoszones_test.cpp.
+#ifndef FS_CHAOSZONES_H
+#define FS_CHAOSZONES_H
+
+#include <algorithm>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace ChaosZones {
+
+// a box on one floor (inclusive) and the respawn percent for the spawns whose centre lies in it
+struct Zone {
+	int32_t x0, y0, x1, y1, z;
+	uint16_t percent;
+};
+
+inline uint16_t clampPercent(int64_t percent)
+{
+	return static_cast<uint16_t>(std::max<int64_t>(10, std::min<int64_t>(percent, 1000)));
+}
+
+// S: getCenterPos() with x, y, z members and setIntervalPercent(uint16_t), which does nothing when the percent is the same
+template <typename S>
+class Index
+{
+	public:
+		static constexpr int32_t CELL = 16;
+
+		bool built() const {
+			return isBuilt;
+		}
+
+		template <typename Range>
+		void build(Range& spawns) {
+			cells.clear();
+			all.clear();
+			lowered.clear();
+			for (S& spawn : spawns) {
+				const auto& c = spawn.getCenterPos();
+				cells[key(c.x / CELL, c.y / CELL, c.z)].push_back(&spawn);
+				all.push_back(&spawn);
+			}
+			isBuilt = true;
+			dirty = true;
+		}
+
+		// the next apply() sets every spawn again (another script set percents directly)
+		void invalidate() {
+			dirty = true;
+		}
+
+		// every spawn gets globalPercent, a spawn whose centre lies in a zone that zone's percent (a later zone wins
+		// where two overlap). The same result as setting every spawn to globalPercent and then each zone in turn, but
+		// only the spawns of the new zones and of the last call's zones are touched (all of them when the global
+		// percent changed). Returns how many spawns are in a zone.
+		size_t apply(uint16_t globalPercent, const std::vector<Zone>& zones) {
+			globalPercent = clampPercent(globalPercent);
+			if (dirty || globalPercent != lastGlobal) {
+				for (S* spawn : all) {
+					spawn->setIntervalPercent(globalPercent);
+				}
+				lowered.clear();
+				lastGlobal = globalPercent;
+				dirty = false;
+			}
+
+			std::unordered_map<S*, uint16_t> wanted;
+			std::vector<S*> order;
+			for (const Zone& zone : zones) {
+				if (zone.x1 < zone.x0 || zone.y1 < zone.y0) {
+					continue;
+				}
+				const uint16_t percent = clampPercent(zone.percent);
+				const int32_t cx0 = std::max<int32_t>(0, zone.x0) / CELL, cx1 = std::max<int32_t>(0, zone.x1) / CELL;
+				const int32_t cy0 = std::max<int32_t>(0, zone.y0) / CELL, cy1 = std::max<int32_t>(0, zone.y1) / CELL;
+				for (int32_t cx = cx0; cx <= cx1; ++cx) {
+					for (int32_t cy = cy0; cy <= cy1; ++cy) {
+						auto it = cells.find(key(cx, cy, zone.z));
+						if (it == cells.end()) {
+							continue;
+						}
+						for (S* spawn : it->second) {
+							const auto& c = spawn->getCenterPos();
+							if (c.x < zone.x0 || c.x > zone.x1 || c.y < zone.y0 || c.y > zone.y1) {
+								continue;
+							}
+							auto ins = wanted.emplace(spawn, percent);
+							if (ins.second) {
+								order.push_back(spawn);
+							} else {
+								ins.first->second = percent;
+							}
+						}
+					}
+				}
+			}
+
+			for (S* spawn : lowered) {
+				if (wanted.find(spawn) == wanted.end()) {
+					spawn->setIntervalPercent(lastGlobal);
+				}
+			}
+			for (S* spawn : order) {
+				spawn->setIntervalPercent(wanted[spawn]);
+			}
+			lowered = std::move(order);
+			return lowered.size();
+		}
+
+	private:
+		static uint64_t key(int64_t cx, int64_t cy, int64_t z) {
+			return (static_cast<uint64_t>(cx & 0xFFFFF) << 28) | (static_cast<uint64_t>(cy & 0xFFFFF) << 8)
+				| static_cast<uint64_t>(z & 0xFF);
+		}
+
+		std::unordered_map<uint64_t, std::vector<S*>> cells;
+		std::vector<S*> all;
+		std::vector<S*> lowered; // spawns a zone of the last call covered
+		uint16_t lastGlobal = 100;
+		bool isBuilt = false;
+		bool dirty = true;
+};
+
+} // namespace ChaosZones
+
+#endif
