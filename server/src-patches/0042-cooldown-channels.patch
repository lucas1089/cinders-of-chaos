+CooldownChannel_t Player::effectiveChannel(CooldownChannel_t channel)
+{
+	if (channel >= COOLDOWN_CHANNEL_COUNT || !g_config.getBoolean(ConfigManager::COOLDOWN_CHANNELS)) {
+		return COOLDOWN_CHANNEL_ACTION;
