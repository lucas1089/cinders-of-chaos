+int LuaScriptInterface::luaGameSetItemCooldownChannel(lua_State* L)
+{
+	// Game.setItemCooldownChannel(itemId, channel)   Chaos (src-patch 0042): a use of this item type waits for (and
+	// holds) that cooldown channel only (COOLDOWN_CHANNEL_POTION: data/scripts/chaos/cooldown_channels.lua);
+	// COOLDOWN_CHANNEL_AUTO: back to the default rule (a rune by its spell group, else ACTION)
+	uint16_t itemId = getNumber<uint16_t>(L, 1);
+	uint8_t channel = getNumber<uint8_t>(L, 2);
+	if (Item::items[itemId].id == 0 || (channel >= COOLDOWN_CHANNEL_COUNT && channel != COOLDOWN_CHANNEL_AUTO)) {
+		lua_pushboolean(L, false);
+		return 1;
+	}
+	Actions::setItemCooldownChannel(itemId, static_cast<CooldownChannel_t>(channel));
+	lua_pushboolean(L, true);
+	return 1;
+}
