+{
+	channel = effectiveChannel(channel);
+	if (channel == COOLDOWN_CHANNEL_ACTION) {
+		return canDoAction();
+	}
+	return channelNextAction[channel] <= OTSYS_TIME();
+}
+
+uint32_t Player::getNextActionTime(CooldownChannel_t channel) const
+{
+	channel = effectiveChannel(channel);
+	if (channel == COOLDOWN_CHANNEL_ACTION) {
+		return getNextActionTime();
+	}
+	return std::max<int64_t>(SCHEDULER_MINTICKS, channelNextAction[channel] - OTSYS_TIME());
+}
+
+void Player::setNextActionTask(SchedulerTask* task, bool resetIdleTime, CooldownChannel_t channel)
+{
+	channel = effectiveChannel(channel);
+	if (channel == COOLDOWN_CHANNEL_ACTION) {
+		setNextActionTask(task, resetIdleTime);
+		return;
+	}
+
+	uint32_t& event = channelTaskEvent[channel];
+	if (event != 0) {
+		g_scheduler.stopEvent(event);
+		event = 0;
+	}
+
+	if (task) {
+		event = g_scheduler.addEvent(task);
+		if (resetIdleTime) {
+			this->resetIdleTime();
+		}
+	}
+}
