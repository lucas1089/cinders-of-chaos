+// Chaos (src-patch 0042): item types with a cooldown channel of their own (Game.setItemCooldownChannel: the potions)
+static std::unordered_map<uint16_t, CooldownChannel_t> chaosItemChannels;
+
+void Actions::setItemCooldownChannel(uint16_t itemId, CooldownChannel_t channel)
+{
+	if (channel >= COOLDOWN_CHANNEL_COUNT) {
+		chaosItemChannels.erase(itemId);
+	} else {
+		chaosItemChannels[itemId] = channel;
+	}
+}
+
+// the channel a use of the item waits for: its own (Game.setItemCooldownChannel), else a rune by its spell group
+// (attack and special: ATTACK, healing: HEAL, support: SUPPORT), else ACTION (doors, levers, tools, food, ...)
+CooldownChannel_t Actions::getUseChannel(const Item* item)
+{
+	if (!item || !g_config.getBoolean(ConfigManager::COOLDOWN_CHANNELS)) {
+		return COOLDOWN_CHANNEL_ACTION;
+	}
+
+	auto it = chaosItemChannels.find(item->getID());
+	if (it != chaosItemChannels.end()) {
+		return it->second;
+	}
+
+	if (const RuneSpell* rune = dynamic_cast<const RuneSpell*>(getAction(item))) {
+		switch (rune->getGroup()) {
+			case SPELLGROUP_HEALING:
+				return COOLDOWN_CHANNEL_HEAL;
+			case SPELLGROUP_SUPPORT:
+				return COOLDOWN_CHANNEL_SUPPORT;
+			default:
+				return COOLDOWN_CHANNEL_ATTACK;
+		}
+	}
+	return COOLDOWN_CHANNEL_ACTION;
+}
+
+// how long a use holds its channel: the stock action delays for ACTION, the channel delays (at least 50 ms) else
+int64_t Actions::getUseDelay(CooldownChannel_t channel, bool useEx)
+{
+	switch (Player::effectiveChannel(channel)) {
+		case COOLDOWN_CHANNEL_MOVE:
+			return std::max<int64_t>(SCHEDULER_MINTICKS, g_config.getNumber(ConfigManager::MOVE_ITEM_DELAY));
+		case COOLDOWN_CHANNEL_ATTACK:
+		case COOLDOWN_CHANNEL_HEAL:
+		case COOLDOWN_CHANNEL_SUPPORT:
+			return std::max<int64_t>(SCHEDULER_MINTICKS, g_config.getNumber(ConfigManager::RUNE_CHANNEL_DELAY));
+		case COOLDOWN_CHANNEL_POTION:
+			return std::max<int64_t>(SCHEDULER_MINTICKS, g_config.getNumber(ConfigManager::POTION_CHANNEL_DELAY));
+		default:
+			return g_config.getNumber(useEx ? ConfigManager::EX_ACTIONS_DELAY_INTERVAL : ConfigManager::ACTIONS_DELAY_INTERVAL);
+	}
+}
