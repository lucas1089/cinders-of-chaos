# Monster display level (server/README.md "Monster levels in the name"). Owner, 2026-10-16: only the level-scaled
# monsters (a <level min max> in their XML) showed their level after the name ("Black Stag [777]"); stock monsters
# (Hellflayer, Ashfang Wyrm) showed none and their look text read "it is level 0". New Lua methods
# monster:setDisplayLevel(level) / monster:getDisplayLevel(): a level shown after the name and in the look text of a
# monster that has no level of its own. Display only: the engine's level bonuses (health, speed, damage), the skull
# colour, getMonsterLevel() and everything that reads it stay as they were. The creature packet and the look text use
# getDisplayLevel() (the monster's own level when it has one). Set at spawn by data/scripts/chaos/monster_levels.lua
# (before the placement, so the first creature packet carries it). A look at a monster with no level at all now reads
# "You see a rat." instead of "..., it is level 0.". Built against the chain 0001-0039.
# Applies after 0001-0039.
diff --git a/src/luascript.cpp b/src/luascript.cpp
index cbb7935..490c561 100644
--- a/src/luascript.cpp
+++ b/src/luascript.cpp
@@ -2705,6 +2705,8 @@ void LuaScriptInterface::registerFunctions()
 	registerMethod("Monster", "isIdle", LuaScriptInterface::luaMonsterIsIdle);
 	registerMethod("Monster", "setIdle", LuaScriptInterface::luaMonsterSetIdle);
 	registerMethod("Monster", "getMonsterLevel", LuaScriptInterface::luaMonsterGetLevel);
+	registerMethod("Monster", "setDisplayLevel", LuaScriptInterface::luaMonsterSetDisplayLevel);
+	registerMethod("Monster", "getDisplayLevel", LuaScriptInterface::luaMonsterGetDisplayLevel);
 	registerMethod("Monster", "isTarget", LuaScriptInterface::luaMonsterIsTarget);
 	registerMethod("Monster", "isOpponent", LuaScriptInterface::luaMonsterIsOpponent);
 	registerMethod("Monster", "isFriend", LuaScriptInterface::luaMonsterIsFriend);
@@ -14383,6 +14385,31 @@ int LuaScriptInterface::luaMonsterGetLevel(lua_State* L)
 	return 1;
 }
 
+int LuaScriptInterface::luaMonsterSetDisplayLevel(lua_State* L)
+{
+	// monster:setDisplayLevel(level) (Chaos: the level after the name of a monster without one; display only)
+	Monster* monster = getUserdata<Monster>(L, 1);
+	if (monster) {
+		monster->setDisplayLevel(getNumber<int32_t>(L, 2));
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaMonsterGetDisplayLevel(lua_State* L)
+{
+	// monster:getDisplayLevel() (its own level when it has one, else the display level, else 0)
+	const Monster* monster = getUserdata<const Monster>(L, 1);
+	if (monster) {
+		lua_pushnumber(L, monster->getDisplayLevel());
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
 int LuaScriptInterface::luaMonsterTypeMinLevel(lua_State* L) {
 	// get: monsterType:minLevel()
 	MonsterType* monsterType = getUserdata<MonsterType>(L, 1);
