 		}
 	}
 
-	// Chaos (patch 0069): packet compression for the official client (it has the inflate code of the engine it is built
-	// on, and sends the markers above); other clients keep plain packets. Off unless config.lua packetCompression = true.
-	if (chaosClient && g_config.getBoolean(ConfigManager::PACKET_COMPRESSION)) {
-		enablePacketCompression(g_config.getNumber(ConfigManager::PACKET_COMPRESSION_LEVEL),
-		                        static_cast<size_t>(std::max<int32_t>(0, g_config.getNumber(ConfigManager::PACKET_COMPRESSION_MIN))));
-	}
-
 	if (version < CLIENT_VERSION_MIN || version > CLIENT_VERSION_MAX) {
 		// Chaos (patch 0021): with the client guard on, another protocol is another client: the official-client message
 		if (ClientGuard::mode() != ClientGuard::Mode::Off) {
@@ -667,6 +660,15 @@
 			thisPtr->disconnectClient("Account name or password is not correct.");
 			return;
 		}
+		// Chaos (patch 0073, was in patch 0069 before the checks above): packet compression for the official client (it
+		// has the inflate code of the engine it is built on, and sends the markers read in onRecvFirstMessage); other
+		// clients keep plain packets. Off unless config.lua packetCompression = true. Only now, after the password check,
+		// so a connection that never logs in does not hold the ~130 KB of zlib state. The client needs no signal: it
+		// inflates every packet whose checksum word is 0.
+		if (thisPtr->chaosClient && g_config.getBoolean(ConfigManager::PACKET_COMPRESSION)) {
+			thisPtr->enablePacketCompression(g_config.getNumber(ConfigManager::PACKET_COMPRESSION_LEVEL),
+			                                 static_cast<size_t>(std::max<int32_t>(0, g_config.getNumber(ConfigManager::PACKET_COMPRESSION_MIN))));
+		}
 		thisPtr->login(name, accountId, operatingSystem);
