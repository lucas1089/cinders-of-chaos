# Chaos: packet compression hardening (server/README.md "Packet compression (O209)"), fixes in patch 0069:
# 1. Protocol::compressBody: when deflate() had advanced the stream but replaceBody() refused the block, the block never
#    reached the client and the stream was not reset, so every later packet inflated against the wrong history. Now the
#    deflater is dropped (same as the deflate error path) and the packet goes out plain.
# 2. ProtocolGame: enablePacketCompression ran before the version, ban, login-limit and password checks, so a connection
#    that never logged in got about 130 KB of zlib state. Now it runs in the callback of the password check, after
#    accountId is known non-zero. The client needs no signal (it inflates a packet whose checksum word is 0).
# Apply after 0001-0072: patch -p1 < 0073-compression-hardening.patch
--- a/src/protocol.cpp
+++ b/src/protocol.cpp
@@ -73,7 +73,13 @@
 		return false;
 	}
 	// a deflated body is sent even when it is not smaller: the client's stream must see every block the server's saw
-	return msg.replaceBody(out, outLength);
+	if (!msg.replaceBody(out, outLength)) {
+		// Chaos (patch 0073): deflate() already advanced the stream, but this block will not reach the client. Same as
+		// the error above: the stream is dead, this and every later packet stays plain (msg is untouched on failure).
+		deflater.reset();
+		return false;
+	}
+	return true;
 }
 
 void Protocol::onRecvMessage(NetworkMessage& msg)
--- a/src/protocolgame.cpp
+++ b/src/protocolgame.cpp
