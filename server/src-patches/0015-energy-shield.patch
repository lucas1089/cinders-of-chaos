+// Chaos (patch 0015): energy shield
+void Player::setEnergyShield(int32_t value)
+{
+	value = std::max<int32_t>(0, std::min<int32_t>(value, maxEnergyShield));
+	if (value != energyShield) {
+		energyShield = value;
+		sendEnergyShield();
+	}
+}
+
+void Player::setMaxEnergyShield(int32_t value)
+{
+	value = std::max<int32_t>(0, value);
+	if (value == maxEnergyShield) {
+		return;
+	}
+	maxEnergyShield = value;
+	energyShield = std::min<int32_t>(energyShield, maxEnergyShield);
+	sendEnergyShield(true);
+}
+
+void Player::rechargeEnergyShield(uint32_t interval)
+{
+	if (maxEnergyShield <= 0 || energyShield >= maxEnergyShield || energyShieldRecharge == 0 || getHealth() <= 0) {
+		return;
+	}
+	// recharge only for the part of this think that lies after the delay
+	const int64_t ready = lastEnergyShieldHit + g_config.getNumber(ConfigManager::ENERGY_SHIELD_RECHARGE_DELAY);
+	const int64_t now = OTSYS_TIME();
+	if (now <= ready) {
+		return;
+	}
+	const int64_t ms = std::min<int64_t>(interval, now - ready);
+	const int64_t gain = std::max<int64_t>(1, static_cast<int64_t>(maxEnergyShield) * energyShieldRecharge * ms / 1000000);
+	setEnergyShield(static_cast<int32_t>(std::min<int64_t>(maxEnergyShield, energyShield + gain)));
+}
+
+void Player::sendEnergyShield(bool force /* = false*/)
+{
+	const int32_t opcode = g_config.getNumber(ConfigManager::ENERGY_SHIELD_OPCODE);
+	if (!client || opcode <= 0 || opcode > 255 || operatingSystem < CLIENTOS_OTCLIENT_LINUX) {
+		return;
+	}
+	// at most one update per 200 ms; a skipped one goes out with the next think
+	const int64_t now = OTSYS_TIME();
+	if (!force && now - lastEnergyShieldSent < 200) {
+		energyShieldDirty = true;
+		return;
+	}
+	lastEnergyShieldSent = now;
+	energyShieldDirty = false;
+
+	NetworkMessage msg;
+	msg.addByte(0x32);
+	msg.addByte(static_cast<uint8_t>(opcode));
+	msg.addString(fmt::format("es:{:d}:{:d}", energyShield, maxEnergyShield));
+	client->writeToOutputBuffer(msg);
+}
