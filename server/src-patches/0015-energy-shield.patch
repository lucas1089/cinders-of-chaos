+// Chaos (patch 0015): the text messages and the animated number of a hit taken by an energy shield (light blue-violet)
+void Game::sendEnergyShieldDamage(const SpectatorVec& spectators, Creature* attacker, Player* targetPlayer, int32_t amount)
+{
+	static constexpr auto TEXTCOLOR_ENERGYSHIELD = static_cast<TextColor_t>(131);
+	const Position& targetPos = targetPlayer->getPosition();
+	Player* attackerPlayer = attacker ? attacker->getPlayer() : nullptr;
+
+	TextMessage message;
+	message.position = targetPos;
+	message.primary.value = amount;
+	message.primary.color = TEXTCOLOR_ENERGYSHIELD;
+
+	std::string spectatorMessage;
+	for (Creature* spectator : spectators) {
+		Player* tmpPlayer = spectator->getPlayer();
+		if (!tmpPlayer || tmpPlayer->getPosition().z != targetPos.z) {
+			continue;
+		}
+
+		if (tmpPlayer == attackerPlayer && attackerPlayer != targetPlayer) {
+			message.type = MESSAGE_DAMAGE_DEALT;
+			message.text = fmt::format("{:s} loses {:d} energy shield due to your attack.", targetPlayer->getNameDescription(), amount);
+			message.text[0] = std::toupper(message.text[0]);
+		} else if (tmpPlayer == targetPlayer) {
+			message.type = MESSAGE_DAMAGE_RECEIVED;
+			if (!attacker) {
+				message.text = fmt::format("You lose {:d} energy shield.", amount);
+			} else if (targetPlayer == attackerPlayer) {
+				message.text = fmt::format("You lose {:d} energy shield due to your own attack.", amount);
+			} else {
+				message.text = fmt::format("You lose {:d} energy shield due to an attack by {:s}.", amount, attacker->getNameDescription());
+			}
+		} else {
+			message.type = MESSAGE_DAMAGE_OTHERS;
+			if (spectatorMessage.empty()) {
+				if (!attacker || attacker == targetPlayer) {
+					spectatorMessage = fmt::format("{:s} loses {:d} energy shield.", targetPlayer->getNameDescription(), amount);
+				} else {
+					spectatorMessage = fmt::format("{:s} loses {:d} energy shield due to an attack by {:s}.", targetPlayer->getNameDescription(), amount, attacker->getNameDescription());
+				}
+				spectatorMessage[0] = std::toupper(spectatorMessage[0]);
+			}
+			message.text = spectatorMessage;
+		}
+		tmpPlayer->sendTextMessage(message);
+	}
+}
