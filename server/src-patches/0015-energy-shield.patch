+// Chaos (patch 0015): energy shield
+int LuaScriptInterface::luaPlayerGetEnergyShield(lua_State* L)
+{
+	// player:getEnergyShield()
+	const Player* player = getUserdata<const Player>(L, 1);
+	if (player) {
+		lua_pushnumber(L, player->getEnergyShield());
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerSetEnergyShield(lua_State* L)
+{
+	// player:setEnergyShield(value) -- clamped to 0 .. the maximum
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->setEnergyShield(getNumber<int32_t>(L, 2));
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
