--- a/src/player.cpp
+++ b/src/player.cpp
@@ -372,8 +372,36 @@
 		ret = ret * vocation->getAttackSpeed() / 2000;
 	}
 
-	ret = ret - (ret * getCharacterStat(CHARSTAT_DEXTERITY) / 100.0);
-	return ret;
+	// Chaos (patch 0011): attack speed cap. `base` is the interval without any bonus: the weapon type's own interval
+	// (2000 when it has none but the item carries a Chaos attack speed attribute) scaled by the vocation like above.
+	// Every bonus (the weapon's attribute: Chaos modifier + topaz gems; dexterity) together shortens it by at most
+	// maxPlayerAttackSpeedBonus %, and no player swings faster than minPlayerAttackInterval ms.
+	uint32_t base = ret;
+	if (weapon && weapon->getAttackSpeed() != 0) {
+		uint32_t typeSpeed = Item::items[weapon->getID()].attackSpeed;
+		base = (typeSpeed != 0 ? typeSpeed : 2000) * vocation->getAttackSpeed() / 2000;
+	}
+	int32_t dexterity = std::min<int32_t>(100, std::max<int32_t>(0, getCharacterStat(CHARSTAT_DEXTERITY)));
+	double interval = ret - (ret * dexterity / 100.0);
+	int32_t maxBonus = g_config.getNumber(ConfigManager::MAX_PLAYER_ATTACK_SPEED_BONUS);
+	if (maxBonus > 0 && maxBonus < 100) {
+		interval = std::max<double>(interval, base * (100 - maxBonus) / 100.0);
+	}
+	interval = std::max<double>(interval, std::max<int32_t>(0, g_config.getNumber(ConfigManager::MIN_PLAYER_ATTACK_INTERVAL)));
+	return static_cast<uint32_t>(interval);
+}
+
+// Chaos (patch 0011): life / mana leech heal at most once per minPlayerLeechInterval ms each, whatever deals the hits
+// (weapon swings, an off-hand, cleaves, procs, pets and minions hitting as their owner, multi-hit spells)
+bool Player::canLeech(bool mana) const
+{
+	int64_t interval = g_config.getNumber(ConfigManager::MIN_PLAYER_LEECH_INTERVAL);
+	return interval <= 0 || (OTSYS_TIME() - (mana ? lastManaLeech : lastLifeLeech)) >= interval;
+}
+
+void Player::setLeeched(bool mana)
+{
+	(mana ? lastManaLeech : lastLifeLeech) = OTSYS_TIME();
 }
 
