+std::string trim(const std::string& s)
+{
+	size_t b = 0, e = s.size();
+	while (b < e && std::isspace(static_cast<unsigned char>(s[b]))) {
+		++b;
+	}
+	while (e > b && std::isspace(static_cast<unsigned char>(s[e - 1]))) {
+		--e;
+	}
+	return s.substr(b, e - b);
+}
+
+// "a, b c" -> {"a", "b", "c"}
+std::vector<std::string> tokens(const std::string& s)
+{
+	std::vector<std::string> out;
+	std::string cur;
+	for (char c : s) {
+		if (c == ',' || c == ';' || std::isspace(static_cast<unsigned char>(c))) {
+			if (!cur.empty()) {
+				out.push_back(cur);
+				cur.clear();
+			}
+		} else {
+			cur += c;
+		}
+	}
+	if (!cur.empty()) {
+		out.push_back(cur);
+	}
+	return out;
+}
+
+bool fromHex(const std::string& hex, std::string& out)
+{
+	if (hex.size() % 2 != 0) {
+		return false;
+	}
+	out.clear();
+	for (size_t i = 0; i < hex.size(); i += 2) {
+		int v = 0;
+		for (size_t j = 0; j < 2; ++j) {
+			char c = static_cast<char>(std::tolower(static_cast<unsigned char>(hex[i + j])));
+			v <<= 4;
+			if (c >= '0' && c <= '9') {
+				v |= c - '0';
+			} else if (c >= 'a' && c <= 'f') {
+				v |= c - 'a' + 10;
+			} else {
+				return false;
+			}
+		}
+		out.push_back(static_cast<char>(v));
+	}
+	return true;
+}
+
+std::string toHex(const std::string& bytes)
+{
+	static const char digits[] = "0123456789abcdef";
+	std::string out;
+	out.reserve(bytes.size() * 2);
+	for (unsigned char c : bytes) {
+		out.push_back(digits[c >> 4]);
+		out.push_back(digits[c & 15]);
+	}
+	return out;
+}
+
+std::string fileStamp(const std::string& path)
+{
+	std::error_code ec;
+	auto t = std::filesystem::last_write_time(path, ec);
+	if (ec) {
+		return "missing";
+	}
+	auto size = std::filesystem::file_size(path, ec);
+	return std::to_string(t.time_since_epoch().count()) + "/" + std::to_string(ec ? 0 : size);
+}
+
+bool readFile(const std::string& path, std::string& out)
+{
+	std::ifstream in(path, std::ios::binary);
+	if (!in) {
+		return false;
+	}
+	std::ostringstream ss;
+	ss << in.rdbuf();
+	out = ss.str();
+	return true;
+}
+
+// ------------------------------------------------------------------------------------------------ keys
+struct Keys {
+	std::string signature;
+	std::vector<std::string> keys; // raw 32-byte keys
+	std::string devKey;            // raw dev key, to tell a dev-key answer apart in the log
+	bool devRefused = false;       // the dev key was configured but clientGuardAllowDevKey is false
+	std::vector<std::string> problems;
+	std::string source;
+};
+Keys keyCache;
+
+const Keys& keys()
+{
+	const std::string& configured = g_config.getString(ConfigManager::CLIENT_GUARD_KEY);
+	const std::string& keyFile = g_config.getString(ConfigManager::CLIENT_GUARD_KEY_FILE);
+	const char* env = std::getenv("CHAOS_CLIENT_KEY");
+	const std::string envValue = env ? env : "";
+	const bool allowDev = g_config.getBoolean(ConfigManager::CLIENT_GUARD_ALLOW_DEV_KEY);
+	const std::string signature = configured + "\n" + keyFile + "\n" + (keyFile.empty() ? "" : fileStamp(keyFile)) +
+	                              "\n" + envValue + "\n" + (allowDev ? "1" : "0");
+	if (signature == keyCache.signature && !keyCache.signature.empty()) {
+		return keyCache;
+	}
+
+	Keys k;
+	k.signature = signature;
+	fromHex(DEV_KEY_HEX, k.devKey);
+	// the first non-empty source wins: config.lua clientGuardKey, the file clientGuardKeyFile, the environment
+	std::string text;
+	if (!trim(configured).empty()) {
+		text = configured;
+		k.source = "config.lua clientGuardKey";
+	} else if (!keyFile.empty()) {
+		if (readFile(keyFile, text)) {
+			k.source = "file " + keyFile;
+		} else {
+			k.problems.push_back("clientGuardKeyFile " + keyFile + " cannot be read");
+		}
+	}
+	if (trim(text).empty() && !envValue.empty()) {
+		text = envValue;
+		k.source = "environment CHAOS_CLIENT_KEY";
+	}
+	for (const std::string& token : tokens(text)) {
+		std::string raw;
+		if (token.size() != 64 || !fromHex(token, raw)) {
+			k.problems.push_back("a key is not 64 hex digits (" + std::to_string(token.size()) + " characters)");
+			continue;
+		}
+		if (raw == k.devKey && !allowDev) {
+			k.devRefused = true;
+			continue;
+		}
+		k.keys.push_back(raw);
+	}
+	if (k.keys.empty() && allowDev) {
+		k.keys.push_back(k.devKey); // test servers: the development key when nothing else is configured
+		k.source = k.source.empty() ? "development key (clientGuardAllowDevKey)" : k.source + " + development key";
+	}
+	keyCache = std::move(k);
+	return keyCache;
+}
+
+// ------------------------------------------------------------------------------------------------ builds
+struct Builds {
+	std::string signature;
+	std::set<uint16_t> list;    // clientGuardBuilds; empty = any build
+	int32_t floor = 0;          // min_package of the updater manifest (clientGuardManifest), 0 = none
+	std::string problem;
+};
+Builds buildCache;
+
+int32_t manifestFloor(const std::string& text)
+{
+	// the manifest is an envelope whose payload is JSON inside a JSON string: "min_package": N appears as
+	// \"min_package\": N there. Take the first number after the key.
+	size_t pos = text.find("min_package");
+	if (pos == std::string::npos) {
+		return -1;
+	}
+	pos += 11;
+	size_t limit = std::min(text.size(), pos + 16);
+	while (pos < limit && !std::isdigit(static_cast<unsigned char>(text[pos]))) {
+		if (text[pos] != '"' && text[pos] != '\\' && text[pos] != ':' && !std::isspace(static_cast<unsigned char>(text[pos]))) {
+			return -1;
+		}
+		++pos;
+	}
+	int32_t value = 0;
+	bool any = false;
+	while (pos < text.size() && std::isdigit(static_cast<unsigned char>(text[pos])) && value < 100000) {
+		value = value * 10 + (text[pos] - '0');
+		any = true;
+		++pos;
+	}
+	return any ? value : -1;
+}
+
+const Builds& builds()
+{
+	const std::string& list = g_config.getString(ConfigManager::CLIENT_GUARD_BUILDS);
+	const std::string& manifest = g_config.getString(ConfigManager::CLIENT_GUARD_MANIFEST);
+	const std::string signature = list + "\n" + manifest + "\n" + (manifest.empty() ? "" : fileStamp(manifest));
+	if (signature == buildCache.signature && !buildCache.signature.empty()) {
+		return buildCache;
+	}
+	Builds b;
+	b.signature = signature;
+	for (const std::string& token : tokens(list)) {
+		char* end = nullptr;
+		long v = std::strtol(token.c_str(), &end, 10);
+		if (end && *end == '\0' && v >= 0 && v <= 0xFFFF) {
+			b.list.insert(static_cast<uint16_t>(v));
+		} else {
+			b.problem = "clientGuardBuilds: \"" + token + "\" is not a build number";
+		}
+	}
+	if (!manifest.empty()) {
+		std::string text;
+		if (!readFile(manifest, text)) {
+			b.problem = "clientGuardManifest " + manifest + " cannot be read (no min_package floor)";
+		} else {
+			int32_t floor = manifestFloor(text);
+			if (floor < 0) {
+				b.problem = "clientGuardManifest " + manifest + " has no min_package";
+			} else {
+				b.floor = floor;
+			}
+		}
+	}
+	buildCache = std::move(b);
+	return buildCache;
+}
+
+std::string buildList(const Builds& b)
+{
+	std::string out;
+	for (uint16_t v : b.list) {
+		out += (out.empty() ? "" : ",") + std::to_string(v);
+	}
+	return out.empty() ? "any" : out;
+}
+
+void appendU16(std::string& s, size_t v)
+{
+	s.push_back(static_cast<char>(v & 0xFF));
+	s.push_back(static_cast<char>((v >> 8) & 0xFF));
+}
+
+} // namespace
+
+Mode mode()
+{
+	std::string m = asLowerCaseString(trim(g_config.getString(ConfigManager::CLIENT_GUARD_MODE)));
+	if (m.empty() || m == "off" || m == "false" || m == "disabled") {
+		return Mode::Off;
+	}
+	if (m == "log" || m == "log-only" || m == "logonly") {
+		return Mode::Log;
+	}
+	return Mode::Enforce; // "enforce", and anything unknown: a typo must not open the server
+}
+
+const char* modeName(Mode mode)
+{
+	switch (mode) {
+		case Mode::Off: return "off";
+		case Mode::Log: return "log";
+		default: return "enforce";
+	}
+}
+
+std::string gateReason(uint32_t clientId)
+{
+	if (!isOfficialClientId(clientId)) {
+		return fmt::format("not the official client (client version field {:d})", clientId);
+	}
+	const uint16_t build = buildOf(clientId);
+	std::lock_guard<std::mutex> guard(cacheLock);
+	const Builds& b = builds();
+	if (!b.list.empty() && b.list.find(build) == b.list.end()) {
+		return fmt::format("client build {:d} is not accepted (clientGuardBuilds {:s})", build, buildList(b));
+	}
+	if (b.floor > 0 && build < b.floor) {
+		return fmt::format("client build {:d} is below min_package {:d} of the update manifest", build, b.floor);
+	}
+	return "";
+}
+
+bool isStaffIp(uint32_t ip)
+{
+	const std::string text = g_config.getString(ConfigManager::CLIENT_GUARD_STAFF_IPS);
+	if (text.empty() || ip == 0) {
+		return false;
+	}
+	const std::string address = convertIPToString(ip);
+	for (const std::string& token : tokens(text)) {
+		if (token == address) {
+			return true;
+		}
+	}
+	return false;
+}
+
+std::string refusalMessage()
+{
+	const std::string url = trim(g_config.getString(ConfigManager::CLIENT_GUARD_DOWNLOAD_URL));
+	if (url.empty()) {
+		return "Please use the official Cinders of Chaos client.";
+	}
+	return "Please use the official Cinders of Chaos client: " + url;
+}
+
+uint32_t timeoutSeconds()
+{
+	int32_t v = g_config.getNumber(ConfigManager::CLIENT_GUARD_TIMEOUT);
+	return static_cast<uint32_t>(std::max<int32_t>(2, std::min<int32_t>(120, v)));
+}
+
+std::string makeNonce()
+{
+	CryptoPP::AutoSeededRandomPool rng;
+	std::string nonce(NONCE_BYTES, '\0');
+	rng.GenerateBlock(reinterpret_cast<CryptoPP::byte*>(&nonce[0]), nonce.size());
+	return nonce;
+}
+
+std::string challengePayload(const std::string& nonce)
+{
+	return "cg1:" + toHex(nonce);
+}
+
+std::string mac(const std::string& key, const std::string& nonce, const std::string& account,
+                const std::string& character, uint16_t build)
+{
+	std::string data = nonce;
+	appendU16(data, account.size());
+	data += account;
+	appendU16(data, character.size());
+	data += character;
+	appendU16(data, build);
+	CryptoPP::HMAC<CryptoPP::SHA256> hmac(reinterpret_cast<const CryptoPP::byte*>(key.data()), key.size());
+	std::string out(CryptoPP::HMAC<CryptoPP::SHA256>::DIGESTSIZE, '\0');
+	hmac.CalculateDigest(reinterpret_cast<CryptoPP::byte*>(&out[0]), reinterpret_cast<const CryptoPP::byte*>(data.data()),
+	                     data.size());
+	return out;
+}
+
+const char* answerText(Answer answer)
+{
+	switch (answer) {
+		case Answer::Ok: return "ok";
+		case Answer::Malformed: return "malformed answer";
+		case Answer::WrongBuild: return "answer for another build";
+		case Answer::DevKey: return "answer made with the DEVELOPMENT key (client built without CHAOS_CLIENT_KEY)";
+		case Answer::NoKey: return "no usable key configured on the server (clientGuardKey)";
+		default: return "wrong answer (another key, or not our client)";
+	}
+}
+
+Answer checkAnswer(const std::string& payload, const std::string& nonce, const std::string& account,
+                   const std::string& character, uint16_t build)
+{
+	// "cg1:<build>:<64 hex>"
+	if (payload.size() < 4 + 1 + 1 + 64 || payload.compare(0, 4, "cg1:") != 0) {
+		return Answer::Malformed;
+	}
+	const size_t colon = payload.find(':', 4);
+	if (colon == std::string::npos || colon == 4 || colon > 9 || payload.size() - colon - 1 != 64) {
+		return Answer::Malformed;
+	}
+	const std::string buildText = payload.substr(4, colon - 4);
+	for (char c : buildText) {
+		if (!std::isdigit(static_cast<unsigned char>(c))) {
+			return Answer::Malformed;
+		}
+	}
+	std::string answer;
+	if (!fromHex(payload.substr(colon + 1), answer)) {
+		return Answer::Malformed;
+	}
+	if (std::stoul(buildText) != build) {
+		return Answer::WrongBuild;
+	}
+
+	std::lock_guard<std::mutex> guard(cacheLock);
+	const Keys& k = keys();
+	for (const std::string& key : k.keys) {
+		const std::string expected = mac(key, nonce, account, character, build);
+		if (CryptoPP::VerifyBufsEqual(reinterpret_cast<const CryptoPP::byte*>(expected.data()),
+		                              reinterpret_cast<const CryptoPP::byte*>(answer.data()), expected.size())) {
+			return Answer::Ok;
+		}
+	}
+	const std::string dev = mac(k.devKey, nonce, account, character, build);
+	if (CryptoPP::VerifyBufsEqual(reinterpret_cast<const CryptoPP::byte*>(dev.data()),
+	                              reinterpret_cast<const CryptoPP::byte*>(answer.data()), dev.size())) {
+		return Answer::DevKey;
+	}
+	return k.keys.empty() ? Answer::NoKey : Answer::Wrong;
+}
+
+void log(const std::string& event, uint32_t ip, const std::string& account, const std::string& character,
+         uint32_t clientId, const std::string& detail)
+{
+	char stamp[32] = {};
+	const time_t now = time(nullptr);
+	struct tm tmv;
+#ifdef _WIN32
+	localtime_s(&tmv, &now);
+#else
+	localtime_r(&now, &tmv);
+#endif
+	std::strftime(stamp, sizeof(stamp), "%Y-%m-%d %H:%M:%S", &tmv);
+	std::string id = isOfficialClientId(clientId) ? fmt::format("build {:d}", buildOf(clientId))
+	                                              : fmt::format("client version {:d}", clientId);
+	const std::string line = fmt::format("[ClientGuard] {:s} {:s} ip={:s} account={:s} character={:s} {:s}: {:s}", stamp,
+	                                     event, ip ? convertIPToString(ip) : "-", account.empty() ? "-" : account,
+	                                     character.empty() ? "-" : character, id, detail);
+	std::lock_guard<std::mutex> guard(logLock);
+	std::cout << line << std::endl;
+	const std::string path = g_config.getString(ConfigManager::CLIENT_GUARD_LOG_FILE);
+	if (path.empty()) {
+		return;
+	}
+	std::error_code ec;
+	const std::filesystem::path parent = std::filesystem::path(path).parent_path();
+	if (!parent.empty()) {
+		std::filesystem::create_directories(parent, ec);
+	}
+	std::ofstream out(path, std::ios::app);
+	if (out) {
+		out << line << '\n';
+	}
+}
+
+void startupReport()
+{
+	const Mode m = mode();
+	std::lock_guard<std::mutex> guard(cacheLock);
+	const Keys& k = keys();
+	const Builds& b = builds();
+	std::cout << ">> Client guard: " << modeName(m);
+	if (m == Mode::Off) {
+		std::cout << " (any client may log in; clientGuardMode = \"enforce\" turns it on)" << std::endl;
+		return;
+	}
+	std::cout << ", " << k.keys.size() << " key(s)" << (k.source.empty() ? "" : " from " + k.source) << ", builds "
+	          << buildList(b) << (b.floor > 0 ? fmt::format(", min_package {:d}", b.floor) : "") << ", answer within "
+	          << timeoutSeconds() << " s" << std::endl;
+	for (const std::string& p : k.problems) {
+		std::cout << "[Warning - ClientGuard] " << p << std::endl;
+	}
+	if (!b.problem.empty()) {
+		std::cout << "[Warning - ClientGuard] " << b.problem << std::endl;
+	}
+	if (k.devRefused) {
+		std::cout << "[Warning - ClientGuard] the DEVELOPMENT key is configured and refused (clientGuardAllowDevKey = false)"
+		          << std::endl;
+	}
+	if (k.keys.empty()) {
+		std::cout << "[Error - ClientGuard] no usable key: "
+		          << (m == Mode::Enforce ? "every player will be kicked at the handshake" : "every handshake will be logged as failed")
+		          << ". Set clientGuardKey (config.lua), clientGuardKeyFile or the environment variable CHAOS_CLIENT_KEY."
+		          << std::endl;
+	}
+	// self-test: RFC 4231 test case 2 through the same HMAC call
+	CryptoPP::HMAC<CryptoPP::SHA256> h(reinterpret_cast<const CryptoPP::byte*>("Jefe"), 4);
+	std::string out(32, '\0');
+	const std::string msg = "what do ya want for nothing?";
+	h.CalculateDigest(reinterpret_cast<CryptoPP::byte*>(&out[0]), reinterpret_cast<const CryptoPP::byte*>(msg.data()), msg.size());
+	if (toHex(out) != "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843") {
+		std::cout << "[Error - ClientGuard] HMAC-SHA256 self-test failed" << std::endl;
+	}
+}
+
