+	Player* player = getUserdata<Player>(L, 1);
+	if (!player || !player->client) {
+		lua_pushnil(L);
+		return 1;
+	}
+	pushBoolean(L, player->client->clientGuardFail(getString(L, 2)));
+	return 1;
+}
