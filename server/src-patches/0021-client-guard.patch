+		if (answer != ClientGuard::Answer::Ok) {
+			clientGuardFail(ClientGuard::answerText(answer));
+			return;
+		}
+		if (guardEvent != 0) {
+			g_scheduler.stopEvent(guardEvent);
+			guardEvent = 0;
