+// Chaos (patch 0021): the client guard of the player's connection (src/clientguard.h, data/scripts/chaos/clientguard.lua)
+int LuaScriptInterface::luaPlayerGetClientGuard(lua_State* L)
+{
+	// player:getClientGuard() -> {mode = "off" | "log" | "enforce", state = "none" | "pending" | "verified" | "bypass" |
+	//                             "logged" | "failed", official = bool, build = n} or nil without a connection
+	Player* player = getUserdata<Player>(L, 1);
+	if (!player || !player->client) {
+		lua_pushnil(L);
+		return 1;
+	}
+	static const char* const states[] = {"none", "pending", "verified", "bypass", "logged", "failed"};
+	const uint32_t clientId = player->client->getGuardClientId();
+	lua_createtable(L, 0, 4);
+	setField(L, "mode", ClientGuard::modeName(ClientGuard::mode()));
+	setField(L, "state", states[static_cast<uint8_t>(player->client->getGuardState())]);
+	pushBoolean(L, ClientGuard::isOfficialClientId(clientId));
+	lua_setfield(L, -2, "official");
+	setField(L, "build", ClientGuard::isOfficialClientId(clientId) ? ClientGuard::buildOf(clientId) : 0);
+	return 1;
+}
