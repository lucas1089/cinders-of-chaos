 void ProtocolGame::writeToOutputBuffer(const NetworkMessage& msg)
 {
+	if (msg.isOverflow()) {
+		// a message that did not fit is incomplete: sending it would make the client misread everything after it
+		logOverflow(msg, player ? "player " + player->getName() : "connection " + convertIPToString(getIP()));
+		return;
+	}
+
 	auto out = getOutputBuffer(msg.getLength());
 	out->append(msg);
 }
