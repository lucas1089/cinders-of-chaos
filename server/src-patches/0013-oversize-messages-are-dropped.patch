+void Protocol::send(OutputMessage_ptr msg) const
+{
+	if (msg->isOverflow()) {
+		logOverflow(*msg, "connection " + convertIPToString(getIP()));
+		return;
+	}
+
+	if (auto connection = getConnection()) {
+		connection->send(msg);
+	}
+}
+
+void Protocol::logOverflow(const NetworkMessage& msg, const std::string& receiver)
+{
+	const uint8_t* body = msg.getBuffer() + NetworkMessage::INITIAL_BUFFER_POSITION;
+	std::ostringstream ss;
+	ss << "[Warning - Protocol] network message too big, not sent: opcode 0x" << std::hex << std::setfill('0');
+	if (msg.getLength() > 0) {
+		ss << std::setw(2) << static_cast<int>(body[0]);
+		if (body[0] == 0x32 && msg.getLength() > 1) {
+			ss << " (extended opcode " << std::dec << static_cast<int>(body[1]) << ")";
+		}
+	} else {
+		ss << "??";
+	}
+	ss << std::dec << ", " << msg.getLength() << " bytes written before it overflowed, to " << receiver;
+	std::cout << ss.str() << std::endl;
+}
