+bool Spawn::canSpawnNearPlayers(const Position& pos)
+{
+	// Chaos (patch 0041). The spawn places the monster forced (Map::placeCreature with forceLogin): on its spot even
+	// over a creature or a blocking item. The stock rule hid that behind findPlayer; with a player in view the spot
+	// is checked here instead: a ground, no creature (a ghost too), no blocking item, no protection zone.
+	const Tile* tile = g_game.map.getTile(pos);
+	if (!tile || !tile->getGround() || tile->getCreatureCount() != 0) {
+		return false;
+	}
+	if (tile->hasFlag(TILESTATE_PROTECTIONZONE) || tile->hasFlag(TILESTATE_BLOCKSOLID)) {
+		return false;
+	}
+
+	// and not next to a player: every player the monsters see stays at least spawnMinPlayerDistance sqm away
+	// (Chebyshev, same floor; 2 = never on an adjacent tile, 0 or 1 = only the tile itself is checked, above)
+	int32_t distance = std::min<int32_t>(g_config.getNumber(ConfigManager::SPAWN_MIN_PLAYER_DISTANCE), 7);
+	if (distance <= 1) {
+		return true;
+	}
+	SpectatorVec spectators;
+	g_game.map.getSpectators(spectators, pos, false, true, distance - 1, distance - 1, distance - 1, distance - 1);
+	for (Creature* spectator : spectators) {
+		if (!spectator->getPlayer()->hasFlag(PlayerFlag_IgnoredByMonsters)) {
+			return false;
+		}
+	}
+	return true;
+}
