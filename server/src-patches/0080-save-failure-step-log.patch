# Player save failure says where (server/README.md "A save that fails for one character"). IOLoginData::savePlayer
# returned false at 17 places, and only the SQL ones print a line of their own. The owner's live log had one tester
# character that failed every incremental save ("Could not save player Tester Ach.", at shutdown "Error while saving
# player") with no SQL error line: the first query, SELECT `save` FROM `players` WHERE `id` = guid, found no row (the
# character had been deleted while it was online), which returns false without a word. Now each failing step logs one
# line, once per character and step (at most 64 lines per run): "[Error - IOLoginData::savePlayer] NAME (guid N): failed
# at: STEP." Nothing else changes: the same transaction, the same results. Applies after 0001-0079.
diff --git a/src/iologindata.cpp b/src/iologindata.cpp
--- a/src/iologindata.cpp
+++ b/src/iologindata.cpp
@@ -11,6 +11,8 @@
 
 #include <fmt/format.h>
 
+#include <set>
+
 extern ConfigManager g_config;
 extern Game g_game;
 
@@ -708,6 +710,25 @@
 	return query_insert.execute();
 }
 
+namespace {
+
+// Chaos (patch 0080): a failed player save said only "Could not save player X" and, when the failure was not a SQL
+// error (those print their own line), nothing else. Which step failed is logged once per character and step, so the
+// log of a live server tells (server/README.md "Tester bots", "A save that fails for one character"). At most 64
+// different lines per run. Always returns false.
+bool chaosSaveFailed(const Player* player, const char* step)
+{
+	static std::set<std::string> seen;
+	const std::string key = std::to_string(player->getGUID()) + '|' + step;
+	if (seen.size() < 64 && seen.insert(key).second) {
+		std::cout << "[Error - IOLoginData::savePlayer] " << player->getName() << " (guid " << player->getGUID()
+			<< "): failed at: " << step << '.' << std::endl;
+	}
+	return false;
+}
+
+}
