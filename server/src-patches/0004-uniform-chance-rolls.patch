# Uniform chance rolls. The base engine rolled the critical hit chance (single-target combat), the life and mana leech
# chances (single-target and area combat) and the monster-set spawn chance with normal_random(1, 100) <= chance:
# normal_random is a bell curve around 50 (sd 25, values outside 1..100 fall on 50/51), so a 10% chance fired ~3.0%
# of the time, 20% ~9.0%, 30% ~18.7% and 50% exactly 50%. They now use uniform_random (as the area critical hit
# already did), so a chance means what it says. The Chaos chance values were rescaled to about two thirds to keep the
# old effective rates at typical totals (server/README.md "Critical and leech chances").
# The rarity roll (Item::applyRarityEffects, Monster::dropLoot) gives a critical / mana / life chance of
# (2 * roll + 1) / 3 (1..6 -> 1,1,2,3,3,4); the paired amount keeps the full roll.
# Apply in the server source root after 0001-0003: patch -p1 < 0004-uniform-chance-rolls.patch, then rebuild.
--- a/src/combat.cpp
+++ b/src/combat.cpp
@@ -884,7 +884,7 @@
 			if (!damage.critical && damage.primary.type != COMBAT_HEALING && damage.origin != ORIGIN_CONDITION) {
 				uint16_t chance = casterPlayer->getSpecialSkill(SPECIALSKILL_CRITICALHITCHANCE);
 				uint16_t skill = casterPlayer->getSpecialSkill(SPECIALSKILL_CRITICALHITAMOUNT);
-				if (chance > 0 && skill > 0 && normal_random(1, 100) <= chance) {
+				if (chance > 0 && skill > 0 && uniform_random(1, 100) <= chance) {
 					damage.primary.value += std::round(damage.primary.value * (skill / 100.));
 					damage.secondary.value += std::round(damage.secondary.value * (skill / 100.));
 					damage.critical = true;
@@ -924,7 +924,7 @@
