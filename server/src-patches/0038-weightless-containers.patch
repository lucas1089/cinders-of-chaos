-		return topParent->queryAdd(INDEX_WHEREEVER, *item, count, flags | FLAG_CHILDISOWNER, actor);
+		// Chaos (src-patch 0038): an item put into a weightless container never counts against the holder's capacity
+		uint32_t ownerFlags = flags | FLAG_CHILDISOWNER;
+		if (insideWeightless()) {
+			ownerFlags |= FLAG_NOLIMIT;
+		}
+		return topParent->queryAdd(INDEX_WHEREEVER, *item, count, ownerFlags, actor);
 	} else {
 		return RETURNVALUE_NOERROR;
 	}
