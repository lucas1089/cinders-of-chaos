@@ -140,9 +146,44 @@ void Container::updateItemWeight(int32_t diff)
 
 uint32_t Container::getWeight() const
 {
+	if (isWeightless()) {
+		return Item::getWeight(); // Chaos (src-patch 0038)
+	}
 	return Item::getWeight() + totalWeight;
 }
 
+// Chaos (src-patch 0038): weightless container types
+static std::unordered_set<uint16_t>& chaosWeightlessTypes()
+{
+	static std::unordered_set<uint16_t> types;
+	return types;
+}
+
+void Container::setWeightlessType(uint16_t itemId, bool on)
+{
+	if (on) {
+		chaosWeightlessTypes().insert(itemId);
+	} else {
+		chaosWeightlessTypes().erase(itemId);
+	}
+}
+
+bool Container::isWeightlessType(uint16_t itemId)
+{
+	const auto& types = chaosWeightlessTypes();
+	return !types.empty() && types.find(itemId) != types.end();
+}
+
+bool Container::insideWeightless() const
+{
+	for (Container* c = const_cast<Container*>(this); c; c = c->getParentContainer()) {
+		if (c->isWeightless()) {
+			return true;
+		}
+	}
+	return false;
+}
