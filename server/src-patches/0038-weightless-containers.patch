+int LuaScriptInterface::luaGameSetWeightlessContainer(lua_State* L)
+{
+	// Game.setWeightlessContainer(itemId[, on = true])   Chaos (src-patch 0038): a container type whose contents weigh
+	// nothing for its holder (the store's Loot Bag, data/scripts/chaos/pouches.lua)
+	uint16_t itemId = getNumber<uint16_t>(L, 1);
+	const ItemType& it = Item::items[itemId];
+	if (it.id == 0 || !it.isContainer()) {
+		lua_pushboolean(L, false);
+		return 1;
+	}
+	Container::setWeightlessType(itemId, getBoolean(L, 2, true));
+	lua_pushboolean(L, true);
+	return 1;
+}
