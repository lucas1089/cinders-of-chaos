 				uint16_t skill = casterPlayer->getSpecialSkill(SPECIALSKILL_LIFELEECHAMOUNT);
-				if (chance > 0 && skill > 0 && casterPlayer->canLeech(false) && uniform_random(1, 100) <= chance) {
+				int32_t leechValue = std::round(totalDamage * (skill / 100.)); // Chaos (patch 0048): no damage dealt, nothing to leech
+				if (chance > 0 && skill > 0 && leechValue > 0 && casterPlayer->canLeech(false) && uniform_random(1, 100) <= chance) {
 					casterPlayer->setLeeched(false);
-					leechCombat.primary.value = std::round(totalDamage * (skill / 100.));
