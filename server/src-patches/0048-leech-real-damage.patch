# Leech from real damage only (server/README.md "Leech from real damage"). Life and mana leech (single target and area)
# only count a hit that dealt damage to a target that can be attacked:
#   * Single target (Combat::doTargetCombat): no leech from a target that is not attackable (healthChange is reported as
#     done for it by Game::combatChangeHealth), and the leech value is rounded before the checks: a value of 0 (zero
#     damage, or a tiny hit that rounds to 0) neither heals nor takes the 900 ms leech window (patch 0011).
#   * Area (Combat::doAreaCombat): a target that took 0 damage or cannot be attacked is not counted in totalTargets /
#     maxDamageFound, so it does not dilute or inflate the area leech (the divisor is never 0, see calcLeechValue).
#   * Area: the leech window is only taken when the leech is above 0.
# Apply in the server source root after 0001-0047: patch -p1 < 0048-leech-real-damage.patch, then rebuild.
--- a/src/combat.cpp
+++ b/src/combat.cpp
@@ -914,7 +914,7 @@
 
 		// Chaos: no engine crit effect; onHealthChange gets `critical` and scripts/chaos/combat_fx.lua shows it
 
-		if (!damage.leeched && damage.primary.type != COMBAT_HEALING && casterPlayer && target != caster && damage.origin != ORIGIN_CONDITION) {
+		if (!damage.leeched && damage.primary.type != COMBAT_HEALING && casterPlayer && target != caster && damage.origin != ORIGIN_CONDITION && target->isAttackable()) { // Chaos (patch 0048): not from a target that cannot be attacked
 			CombatDamage leechCombat;
 			leechCombat.origin = ORIGIN_NONE;
 			leechCombat.leeched = true;
@@ -924,9 +924,10 @@
