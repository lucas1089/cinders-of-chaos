 extern Weapons* g_weapons;
 extern Scripts* g_scripts;
 
+// Chaos (src-patch 0045): hit effects and missiles swapped from Lua. Empty by default: the stock effects.
+namespace {
+struct ChaosFxOverride {
+	uint16_t effect; // 0 = no effect
+	int8_t dx;
+	int8_t dy;
+};
+// key: kind << 16 | key; kind 0 = a physical hit on a race, 1 = a direct hit of a combat type, 2 = a condition tick
+std::map<uint32_t, ChaosFxOverride> chaosHitOverrides;
+std::map<uint8_t, ChaosFxOverride> chaosMissileOverrides;
+
+const ChaosFxOverride* chaosHitOverride(uint8_t kind, uint16_t key)
+{
+	auto it = chaosHitOverrides.find((static_cast<uint32_t>(kind) << 16) | key);
+	return it != chaosHitOverrides.end() ? &it->second : nullptr;
+}
+
+Position chaosShifted(const Position& pos, int8_t dx, int8_t dy)
+{
+	return Position(static_cast<uint16_t>(pos.x + dx), static_cast<uint16_t>(pos.y + dy), pos.z);
+}
+}
+
+void Game::setHitEffectOverride(uint8_t kind, uint16_t key, int32_t effect, int8_t dx, int8_t dy)
+{
+	uint32_t k = (static_cast<uint32_t>(kind) << 16) | key;
+	if (effect < 0) {
+		chaosHitOverrides.erase(k);
+	} else {
+		chaosHitOverrides[k] = {static_cast<uint16_t>(effect), dx, dy};
+	}
+}
+
+void Game::setMissileOverride(uint8_t stock, uint8_t missile, int8_t dx, int8_t dy)
+{
+	if (missile == 0) {
+		chaosMissileOverrides.erase(stock);
+	} else {
+		chaosMissileOverrides[stock] = {missile, dx, dy};
+	}
+}
+
+void Game::clearEffectOverrides()
+{
+	chaosHitOverrides.clear();
+	chaosMissileOverrides.clear();
+}
+
+// the hit effect of one damage part: a condition tick by its combat type, a physical hit by the target's race, any
+// other hit by its combat type; without an override the stock effect (combatGetTypeInfo)
+void Game::addHitEffect(const SpectatorVec& spectators, const Creature* target, const Position& pos,
+                        CombatType_t combatType, CombatOrigin origin, uint8_t stock)
+{
+	const ChaosFxOverride* o = nullptr;
+	if (origin == ORIGIN_CONDITION) {
+		o = chaosHitOverride(2, combatType);
+	} else if (combatType == COMBAT_PHYSICALDAMAGE) {
+		o = chaosHitOverride(0, target->getRace());
+	} else {
+		o = chaosHitOverride(1, combatType);
+	}
+	if (o) {
+		if (o->effect != 0) {
+			addMagicEffect(spectators, chaosShifted(pos, o->dx, o->dy), o->effect);
+		}
+		return;
+	}
+	if (stock != CONST_ME_NONE) {
+		addMagicEffect(spectators, pos, stock);
+	}
+}
