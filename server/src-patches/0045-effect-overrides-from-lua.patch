+int LuaScriptInterface::luaGameSetHitEffect(lua_State* L)
+{
+	// Game.setHitEffect(kind, key, effect[, dx = 0[, dy = 0]])  Chaos (src-patch 0045)
+	// kind 0: a physical hit on a creature of race `key`; 1: a direct hit of combat type `key`; 2: a condition tick of
+	// combat type `key`. effect: the magic effect sent instead (at the tile + dx, dy), 0 none, nil or -1 the stock one.
+	uint8_t kind = getNumber<uint8_t>(L, 1);
+	uint16_t key = getNumber<uint16_t>(L, 2);
+	if (kind > 2) {
+		pushBoolean(L, false);
+		return 1;
+	}
+	int32_t effect = isNumber(L, 3) ? getNumber<int32_t>(L, 3) : -1;
+	if (effect > 0xFFFF) {
+		pushBoolean(L, false);
+		return 1;
+	}
+	Game::setHitEffectOverride(kind, key, effect, getNumber<int8_t>(L, 4, 0), getNumber<int8_t>(L, 5, 0));
+	pushBoolean(L, true);
+	return 1;
+}
+
+int LuaScriptInterface::luaGameSetMissileEffect(lua_State* L)
+{
+	// Game.setMissileEffect(stock, missile[, dx = 0[, dy = 0]])  Chaos (src-patch 0045)
+	// every distance effect `stock` is sent as `missile` (from and to shifted by dx, dy); missile 0 or nil: stock
+	uint8_t stock = getNumber<uint8_t>(L, 1);
+	uint8_t missile = isNumber(L, 2) ? getNumber<uint8_t>(L, 2) : 0;
+	Game::setMissileOverride(stock, missile, getNumber<int8_t>(L, 3, 0), getNumber<int8_t>(L, 4, 0));
+	pushBoolean(L, true);
+	return 1;
+}
+
+int LuaScriptInterface::luaGameClearEffectOverrides(lua_State* L)
+{
+	// Game.clearEffectOverrides()  Chaos (src-patch 0045): back to the stock hit effects and missiles
+	Game::clearEffectOverrides();
+	pushBoolean(L, true);
+	return 1;
+}
