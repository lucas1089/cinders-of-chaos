 	string[PROXY_PROTOCOL_TRUSTED] = getGlobalString(L, "proxyProtocolTrusted", "");
+	// Chaos (patch 0046): the RSA login key(s), PKCS#1 PEM files, comma separated (the first is the current key, the
+	// others are still accepted during a rotation); read at startup only. Default: key.pem in the server folder.
+	string[RSA_KEY_FILE] = getGlobalString(L, "rsaKeyFile", "key.pem");
