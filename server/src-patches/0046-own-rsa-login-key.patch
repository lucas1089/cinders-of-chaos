+
+// Chaos (patch 0046): our own login key, several during a rotation (server/README.md "Login encryption (RSA, XTEA)")
+void RSA::addPEM(const std::string& filename)
+{
+	const auto previous = keys;
+	const auto restore = [&]() {
+		keys = previous;
+		if (!keys.empty()) {
+			pk = keys.front();
+		}
+	};
+	try {
+		loadPEM(filename);
+	} catch (...) {
+		restore();
+		throw;
+	}
+	const CryptoPP::RSA::PrivateKey added = pk;
+	restore();
+	if (added.GetModulus().ByteCount() != 128) {
+		throw std::runtime_error("RSA key " + filename + " is not 1024 bits (the 10.98 login block is 128 bytes).");
+	}
+	keys.push_back(added);
+	pk = keys.front();
+}
+
+bool RSA::tryDecrypt(char* msg) const
+{
+	for (const auto& key : keys) {
+		try {
+			CryptoPP::Integer m{reinterpret_cast<uint8_t*>(msg), 128};
+			if (m >= key.GetModulus()) {
+				continue;
+			}
+			auto c = key.CalculateInverse(prng, m);
+			uint8_t out[128];
+			c.Encode(out, 128);
+			if (out[0] == 0) {
+				std::copy(out, out + 128, reinterpret_cast<uint8_t*>(msg));
+				return true;
+			}
+		} catch (const CryptoPP::Exception& e) {
+			fmt::print(fg(fmt::color::crimson) | fmt::emphasis::bold, e.what(), "\n");
+		}
+	}
+	return false;
+}
+
+std::string RSA::fingerprint(size_t i) const
+{
+	if (i >= keys.size()) {
+		return "";
+	}
+	std::string decimal = CryptoPP::IntToString(keys[i].GetModulus(), 10);
+	std::string digest;
+	CryptoPP::SHA256 sha;
+	CryptoPP::StringSource ss(decimal, true,
+		new CryptoPP::HashFilter(sha, new CryptoPP::HexEncoder(new CryptoPP::StringSink(digest), false)));
+	return digest.substr(0, 16);
+}
+
+bool RSA::isPublicDefault(size_t i) const
+{
+	// the open-server key every stock server and client ship: its private key is public, so anyone can read logins
+	static const CryptoPP::Integer publicDefault(
+		"1091201329673994292788609605089955415282375029027981291234687579372662914925764463307396960011106039"
+		"0723088861007265581882535850342905759282762943641310856602909362821263595383668656267584972062078627"
+		"9431090218017681061521755056710823876476444260558147179707119674283982419152118103759076030616683978"
+		"566631413.");
+	return i < keys.size() && keys[i].GetModulus() == publicDefault;
 }
