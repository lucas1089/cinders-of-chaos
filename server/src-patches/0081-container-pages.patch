 			}
 			OpenContainer& openContainer = it.second;
 			const Container* container = openContainer.container;
-			uint32_t capacity = std::max<uint32_t>(1, container->capacity());
+			uint32_t capacity = std::max<uint32_t>(1, container->pageSize());
 			uint32_t size = container->size();
 			if (openContainer.index > 0 && openContainer.index >= size) {
 				// the page the window showed is gone: the last page that has items
@@ -1162,14 +1162,14 @@ void Player::sendAddContainerItem(const Container* container, const Item* item)
 		uint16_t slot = openContainer.index;
 		if (container->getID() == ITEM_BROWSEFIELD) {
 			uint16_t containerSize = container->size() - 1;
-			uint16_t pageEnd = openContainer.index + container->capacity() - 1;
+			uint16_t pageEnd = openContainer.index + container->pageSize() - 1;
 			if (containerSize > pageEnd) {
 				slot = pageEnd;
 				item = container->getItemByIndex(pageEnd);
 			} else {
 				slot = containerSize;
 			}
-		} else if (openContainer.index >= container->capacity()) {
+		} else if (openContainer.index >= container->pageSize()) {
 			item = container->getItemByIndex(openContainer.index);
 		}
 
@@ -1199,7 +1199,7 @@ void Player::sendUpdateContainerItem(const Container* container, uint16_t slot,
 			continue;
 		}
 
-		uint16_t pageEnd = openContainer.index + container->capacity();
+		uint16_t pageEnd = openContainer.index + container->pageSize();
 		if (slot >= pageEnd) {
 			continue;
 		}
@@ -1226,11 +1226,11 @@ void Player::sendRemoveContainerItem(const Container* container, uint16_t slot)
 
 		uint16_t& firstIndex = openContainer.index;
 		if (firstIndex > 0 && firstIndex >= container->size() - 1) {
-			firstIndex -= container->capacity();
+			firstIndex -= container->pageSize();
 			sendContainer(it.first, container, false, firstIndex);
 		}
 
-		client->sendRemoveContainerItem(it.first, std::max<uint16_t>(slot, firstIndex), container->getItemByIndex(container->capacity() + firstIndex));
+		client->sendRemoveContainerItem(it.first, std::max<uint16_t>(slot, firstIndex), container->getItemByIndex(container->pageSize() + firstIndex));
 	}
 }
 
