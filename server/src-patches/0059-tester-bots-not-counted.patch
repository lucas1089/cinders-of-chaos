# Tester bots are never counted online (server/README.md "Tester bots"). The owner runs test bots on the live server
# (server/tools/testers.py, chaos-ctl.sh testers); they must never inflate a count a player, a server list or the
# website sees. A tester is a character with the player storage 7102900 = 1 (CHAOS_TESTER_STORAGE, the same key as
# Chaos.storage.tester in chaos_constants.lua; written only by testers.py setup).
#   * the status protocol: <players online> of the XML status and the 0x20 players info count only the other
#     players; the 0x21 online list leaves the testers out; 0x22 says a tester is offline
#   * the players record (server_config players_record, the "record" global event and its broadcast): only the
#     counted players can beat it
#   * players_online (the website's online list and counts): a tester is never inserted (login, ghost mode off)
#   * the waiting list: a tester never waits and is not counted against maxPlayers, so it never takes a real
#     player's place
# New header src/chaostesters.h (pure functions; tests in server/tools/chaostesters_test.cpp, CI).
# Applies after 0001-0058.
diff --git a/src/chaostesters.h b/src/chaostesters.h
new file mode 100644
--- /dev/null
+++ b/src/chaostesters.h
@@ -0,0 +1,53 @@
+// Chaos (patch 0059): tester bots are never counted as players online. A tester is a character with the player
+// storage CHAOS_TESTER_STORAGE = 1 (written only by server/tools/testers.py setup; the same key as
+// Chaos.storage.tester in data/scripts/chaos/chaos_constants.lua, server/README.md "Tester bots"). The status
+// protocol (players online, the online list, a name's online status), the players record and its "record" event,
+// the players_online table and the waiting list count only the other players. Pure functions, no engine types, so
+// server/tools/chaostesters_test.cpp tests them alone.
+
+#ifndef FS_CHAOSTESTERS_H
+#define FS_CHAOSTESTERS_H
+
+#include <cstddef>
+#include <cstdint>
+
+static constexpr uint32_t CHAOS_TESTER_STORAGE = 7102900;
+static constexpr int32_t CHAOS_TESTER_VALUE = 1;
+
+// a storage lookup (found, value) -> is this a tester
+inline bool chaosIsTesterStorage(bool found, int32_t value)
+{
+	return found && value == CHAOS_TESTER_VALUE;
+}
+
+// the players of a map (id -> player pointer) that are not testers; isTester(player) decides
+template <typename Map, typename IsTester>
+std::size_t chaosCountedPlayers(const Map& players, IsTester isTester)
+{
+	std::size_t n = 0;
+	for (const auto& it : players) {
+		if (it.second && !isTester(it.second)) {
+			++n;
+		}
+	}
+	return n;
+}
+
+// fn(player) for every player of the map that is not a tester (the status protocol's online list)
+template <typename Map, typename IsTester, typename Fn>
+void chaosForEachCounted(const Map& players, IsTester isTester, Fn fn)
+{
+	for (const auto& it : players) {
+		if (it.second && !isTester(it.second)) {
+			fn(it.second);
+		}
+	}
+}
+
+// a new players record: only the counted players can beat it
+inline bool chaosIsNewRecord(std::size_t counted, uint32_t record)
+{
+	return counted > record;
+}
+
+#endif
