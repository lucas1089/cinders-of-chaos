+// Chaos (src-patch 0023, server/README.md "Infinite arrows and quivers"): a quiver (items.xml weaponType "quiver") is
+// worn in the shield hand. A bow or crossbow (a two-handed distance weapon) and a quiver may share the hands; nothing
+// else goes in the shield hand with a launcher, and a quiver goes only next to a launcher or an empty weapon hand.
+// The ammunition slot is a second ring slot: it takes rings only (classicEquipmentSlots = false; with classic slots a
+// quiver is refused next to a launcher like any other second item).
+static bool chaosIsQuiver(const Item* item)
+{
+	return item && item->getWeaponType() == WEAPON_QUIVER;
+}
+
+static bool chaosIsLauncher(const Item* item)
+{
+	return item && item->getWeaponType() == WEAPON_DISTANCE && (item->getSlotPosition() & SLOTP_TWO_HAND);
+}
+
+// Chaos 0023: one might ring at a time over both ring slots. The might rings (the normal and the worn ids) carry the
+// items.xml key "chaosMightRing" (server/tools/patch_base_archery.py). `item` may go into a ring slot unless it is a
+// might ring and `other` (what the other ring slot holds) is another might ring.
+static bool chaosIsMightRing(const Item* item)
+{
+	return item && Item::items[item->getID()].chaosMightRing;
+}
+
+static ReturnValue chaosRingSlot(const Item* item, const Item* other)
+{
+	if (other && other != item && chaosIsMightRing(item) && chaosIsMightRing(other)) {
+		return RETURNVALUE_ONLYONEMIGHTRING;
+	}
+	return RETURNVALUE_NOERROR;
+}
