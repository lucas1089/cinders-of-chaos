# The "XP gain rate" of the Skills window shows the rate the server applies (O774; server/README.md "XP gain rate display").
# Seen in a client 2026-11-27: the line read 100% while the Chaos Pact (+10% experience) was active. The base engine
# sent a fixed 100 as the base XP gain rate of the stats packet (ProtocolGame::AddPlayerStats) and had no
# Player:setBaseXpGain, so xp_rate_display.lua (which guards the call) never changed it.
#   * a new Player field baseXpGain (uint16, 100 by default), sent as the base XP gain rate;
#   * Lua: player:getBaseXpGain() and player:setBaseXpGain(percent): 1..65535, resends the stats only when it changed;
#   * voucher, low level bonus, store boost and stamina stay as before (0, 0, 0, 100): the scripts put the whole rate in
#     the base value (xp_rate_display_core.lua).
# Apply in the server source root after 0001-0095: patch -p1 < 0096-base-xp-gain.patch, then rebuild.
diff --git a/src/luascript.cpp b/src/luascript.cpp
--- a/src/luascript.cpp
+++ b/src/luascript.cpp
@@ -2633,6 +2633,8 @@
 	registerMethod("Player", "setGroup", LuaScriptInterface::luaPlayerSetGroup);
 
 	registerMethod("Player", "getStamina", LuaScriptInterface::luaPlayerGetStamina);
+	registerMethod("Player", "getBaseXpGain", LuaScriptInterface::luaPlayerGetBaseXpGain); // Chaos (patch 0096)
+	registerMethod("Player", "setBaseXpGain", LuaScriptInterface::luaPlayerSetBaseXpGain);
 	registerMethod("Player", "setStamina", LuaScriptInterface::luaPlayerSetStamina);
 
 	registerMethod("Player", "getSoul", LuaScriptInterface::luaPlayerGetSoul);
@@ -10158,6 +10160,41 @@
 	return 1;
 }
 
+int LuaScriptInterface::luaPlayerGetBaseXpGain(lua_State* L)
+{
+	// player:getBaseXpGain() -- Chaos (patch 0096)
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		lua_pushnumber(L, player->getBaseXpGain());
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerSetBaseXpGain(lua_State* L)
+{
+	// player:setBaseXpGain(percent) -- Chaos (patch 0096): 1..65535, resends the stats when it changed
+	Player* player = getUserdata<Player>(L, 1);
+	if (!player) {
+		lua_pushnil(L);
+		return 1;
+	}
+	double value = getNumber<double>(L, 2, 100);
+	if (!(value >= 1)) {
+		value = 1;
+	} else if (value > 65535) {
+		value = 65535;
+	}
+	const uint16_t gain = static_cast<uint16_t>(value);
+	if (gain != player->getBaseXpGain()) {
+		player->setBaseXpGain(gain);
+		player->sendStats();
+	}
+	pushBoolean(L, true);
+	return 1;
+}
