# Cheaper map description (O213; server/README.md "Cheaper map description (O213)").
# A map description (login, teleport, floor change; a row or a column on every step) is written by
# ProtocolGame::GetMapDescription -> GetFloorDescription, which asked Map::getTile for every tile of the rectangle: one walk
# down the quad tree (12 pointer hops, QTreeNode::getLeafStatic) per tile, although 64 neighbouring tiles (an 8x8 leaf) share
# one leaf and one Floor. A full description is 18 x 14 tiles on up to 8 floors: about 2000 walks, mostly into memory that
# is not in the cache on a big map.
# Now:
#   * src/chaosmapdesc.h (new, header only, no engine types; server/tools/chaosmapdesc_test.cpp and
#     server/tools/mapdesc_bench.cpp build it alone): ChaosMapDesc::describeFloor, the same loop, order and skip counter,
#     with the Floor resolved once per 8x8 block (four slots keyed by block): an 18 x 14 floor needs 9 walks instead of 252.
#     Coordinates are narrowed to uint16_t / uint8_t first, as getTile's parameters did.
#   * map.h: Map::getFloorAt, getTile without the last index.
#   * protocolgame.cpp: GetFloorDescription calls describeFloor.
# The bytes are identical (the test compares a copy of the stock loop on many synthetic maps, edges of the 16 bit
# coordinates, floors that do not exist, runs of more than 254 empty tiles). Not changed on purpose: the known creature list
# (its eviction order after 1300 entries follows the unordered_set iteration order, so a different container could change
# which creature is dropped and the bytes) and NetworkMessage (patch 0032 already removed its 90 KB zeroing).
--- a/src/map.h
+++ b/src/map.h
@@ -182,6 +182,16 @@
 		  * \returns A pointer to that tile.
 		  */
 		Tile* getTile(uint16_t x, uint16_t y, uint8_t z) const;
+		// Chaos (patch 0072): the Floor (8x8 tiles) that holds the tile, or nullptr: getTile minus the last index, so a
+		// map description resolves it once per 8x8 block (src/chaosmapdesc.h)
+		const Floor* getFloorAt(uint16_t x, uint16_t y, uint8_t z) const {
+			if (z >= MAP_MAX_LAYERS) {
+				return nullptr;
+			}
+
+			const QTreeLeafNode* leaf = QTreeNode::getLeafStatic<const QTreeLeafNode*, const QTreeNode*>(&root, x, y);
+			return leaf ? leaf->getFloor(z) : nullptr;
+		}
 		Tile* getTile(const Position& pos) const {
 			return getTile(pos.x, pos.y, pos.z);
 		}
