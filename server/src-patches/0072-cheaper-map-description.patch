+
+#ifndef FS_CHAOSMAPDESC_H
+#define FS_CHAOSMAPDESC_H
+
+// Cheaper map description (patch 0072, server/README.md "Cheaper map description (O213)"). Header only, no engine
+// types: server/tools/chaosmapdesc_test.cpp and server/tools/mapdesc_bench.cpp build it alone.
+//   ProtocolGame::GetFloorDescription asked Map::getTile for every tile of the rectangle: one walk down the quad tree
+//   (12 pointer hops, each a likely cache miss on a big map) per tile, although 64 neighbouring tiles (an 8x8 leaf,
+//   FLOOR_SIZE 8) share one leaf and one Floor. A full description is 18 x 14 tiles on up to 8 floors, about 2000 walks;
+//   a step is a row or column of 14 to 18 tiles on every floor.
+//   describeFloor keeps the loop, the order and the skip counter exactly as they were and resolves the Floor once per
+//   8x8 block (a four slot cache keyed by x >> 3, y >> 3): an 18 x 14 floor
+//   needs 9 to 12 walks instead of 252. The tile coordinates are narrowed to
+//   16 bits and the floor to 8 bits first, as the stock call getTile(uint16_t, uint16_t, uint8_t) did, so a rectangle
+//   past the map edge behaves the same. The bytes written are identical.
+
+#include <cstdint>
+
+namespace ChaosMapDesc {
+
+// floorAt(uint16_t x, uint16_t y, uint8_t z) -> const FloorT* (nullptr when there is no leaf or no floor, or z is out of
+//   range: what Map::getTile checks before it reads the tile); FloorT::tiles[8][8] is indexed [x & 7][y & 7].
+// emitTile(tile)       writes one tile (ProtocolGame::GetTileDescription).
+// msg.addByte(uint8_t) writes a byte.
+// skip is the run of empty tiles not yet written (-1: none), shared by the floors of one description.
+template<typename FloorT, typename Msg, typename FloorAt, typename EmitTile>
+inline void describeFloor(Msg& msg, int32_t x, int32_t y, int32_t z, int32_t width, int32_t height, int32_t offset,
+                          int32_t& skip, FloorAt&& floorAt, EmitTile&& emitTile)
+{
+	const uint8_t fz = static_cast<uint8_t>(z);
+	// four slots, picked by the low bits of the block row: a column of up to 25 tiles spans at most four consecutive
+	// block rows, so the next column (same block column, the loop runs down y first) finds all of them again
+	const FloorT* slotFloor[4] = {};
+	uint32_t slotX[4] = {0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu}; // no real block key reaches 2^13
+	uint32_t slotY[4] = {};
+
+	for (int32_t nx = 0; nx < width; nx++) {
+		for (int32_t ny = 0; ny < height; ny++) {
+			const uint16_t tx = static_cast<uint16_t>(x + nx + offset);
+			const uint16_t ty = static_cast<uint16_t>(y + ny + offset);
+			const uint32_t bx = static_cast<uint32_t>(tx) >> 3;
+			const uint32_t by = static_cast<uint32_t>(ty) >> 3;
+			const uint32_t slot = by & 3;
+			if (slotX[slot] != bx || slotY[slot] != by) {
+				slotX[slot] = bx;
+				slotY[slot] = by;
+				slotFloor[slot] = floorAt(tx, ty, fz);
+			}
+			const FloorT* floor = slotFloor[slot];
+
+			auto* tile = floor ? floor->tiles[tx & 7][ty & 7] : nullptr;
+			if (tile) {
+				if (skip >= 0) {
+					msg.addByte(skip);
+					msg.addByte(0xFF);
+				}
+
+				skip = 0;
+				emitTile(tile);
+			} else if (skip == 0xFE) {
+				msg.addByte(0xFF);
+				msg.addByte(0xFF);
+				skip = -1;
+			} else {
+				++skip;
+			}
+		}
+	}
+}
+
+} // namespace ChaosMapDesc
+
+#endif // FS_CHAOSMAPDESC_H
