+// Chaos (patch 0049): global absorb ceiling. The share of a hit that equipment and the absorb storages together can
+// take away is at most this many percent per combat type. THE ONE PLACE TO CHANGE IT (server/README.md "Absorb ceiling").
+static constexpr int32_t CHAOS_ABSORB_CEILING_PERCENT = 75;
+
+// Chaos (patch 0049): the percent that scripts/customs/rarity/rarity_onCombat_absorbs.lua will take off after blockHit
+// (the sum of the two absorb storages of the type: gear rarity roll 9775xx and the passive tree / Paragon 9775xx)
+static int32_t chaosStorageAbsorbPercent(const Player* player, CombatType_t combatType)
+{
+	uint32_t keys[2];
+	switch (combatType) {
+		case COMBAT_FIREDAMAGE: keys[0] = 977544; keys[1] = 977562; break;
+		case COMBAT_PHYSICALDAMAGE: keys[0] = 977545; keys[1] = 977563; break;
+		case COMBAT_ENERGYDAMAGE: keys[0] = 977546; keys[1] = 977564; break;
+		case COMBAT_EARTHDAMAGE: keys[0] = 977547; keys[1] = 977565; break;
+		case COMBAT_DROWNDAMAGE: keys[0] = 977548; keys[1] = 977566; break;
+		case COMBAT_ICEDAMAGE: keys[0] = 977549; keys[1] = 977567; break;
+		case COMBAT_HOLYDAMAGE: keys[0] = 977550; keys[1] = 977568; break;
+		case COMBAT_DEATHDAMAGE: keys[0] = 977551; keys[1] = 977569; break;
+		case COMBAT_WATERDAMAGE: keys[0] = 977552; keys[1] = 977570; break;
+		case COMBAT_ARCANEDAMAGE: keys[0] = 977553; keys[1] = 977571; break;
+		case COMBAT_LIFEDRAIN: keys[0] = 977572; keys[1] = 977573; break;
+		case COMBAT_MANADRAIN: keys[0] = 977574; keys[1] = 977575; break;
+		default: return 0;
+	}
+	int32_t total = 0;
+	for (uint32_t key : keys) {
+		int32_t value;
+		if (player->getStorageValue(key, value) && value > 0) {
+			total += value;
+		}
+	}
+	return std::min<int32_t>(total, 100);
+}
