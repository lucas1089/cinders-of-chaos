+// Chaos (patch 0047): failed-login limits per IP and per account (server/README.md "Failed-login limits").
+// Header only and free of engine types, so server/tools/loginlimit_test.cpp builds it alone.
+
+#ifndef FS_LOGINLIMIT_H_CHAOS
+#define FS_LOGINLIMIT_H_CHAOS
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace LoginLimit {
+
+// 0 in maxPerIp / maxPerAccount turns that limit off
+struct Settings
+{
+	uint32_t maxPerIp = 20;       // failed logins from one IP within windowSec
+	uint32_t maxPerAccount = 50;  // failed logins on one account name (from any IP) within windowSec
+	uint32_t windowSec = 600;
+	uint32_t blockSec = 900;
+};
+
+struct Entry
+{
+	int64_t windowStart = 0;
+	int64_t blockedUntil = 0;
+	uint32_t count = 0;
+};
+
+class Limiter
+{
+	public:
+		static constexpr size_t MAX_ENTRIES = 100000; // per map; expired entries are swept when it is reached
+		static constexpr size_t MAX_NAME = 64;
+
+		// the account name as the database compares it (case-insensitive), bounded
+		static std::string key(const std::string& account) {
+			std::string k = account.substr(0, MAX_NAME);
+			std::transform(k.begin(), k.end(), k.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+			return k;
+		}
+
+		// seconds left of a block of this IP or account (0: the login may go on)
+		uint32_t blockedFor(uint32_t ip, const std::string& account, int64_t now, const Settings& s) {
+			std::lock_guard<std::mutex> guard(lock);
+			int64_t until = 0;
+			if (s.maxPerIp != 0) {
+				auto it = ips.find(ip);
+				if (it != ips.end()) {
+					until = std::max(until, it->second.blockedUntil);
+				}
+			}
+			if (s.maxPerAccount != 0) {
+				auto it = accounts.find(key(account));
+				if (it != accounts.end()) {
+					until = std::max(until, it->second.blockedUntil);
+				}
+			}
+			return until > now ? static_cast<uint32_t>(until - now) : 0;
+		}
+
+		// the result of one password check. Returns a non-empty note when this failure started a block (for the log).
+		// A success clears the account's count, never the IP's: an attacker's own good account cannot reset it.
+		std::string record(uint32_t ip, const std::string& account, bool ok, int64_t now, const Settings& s) {
+			std::lock_guard<std::mutex> guard(lock);
+			if (ok) {
+				accounts.erase(key(account));
+				return "";
+			}
+			std::string note;
+			if (s.maxPerIp != 0 && bump(ips, ip, now, s, s.maxPerIp)) {
+				note = "ip";
+			}
+			if (s.maxPerAccount != 0 && bump(accounts, key(account), now, s, s.maxPerAccount)) {
+				note += note.empty() ? "account" : "+account";
+			}
+			return note;
+		}
+
+		size_t size() const { return ips.size() + accounts.size(); }
+
+	private:
+		template <typename Map, typename Key>
+		bool bump(Map& map, const Key& k, int64_t now, const Settings& s, uint32_t max) {
+			if (map.size() >= MAX_ENTRIES) {
+				sweep(map, now, s);
+			}
+			if (map.size() >= MAX_ENTRIES && map.find(k) == map.end()) {
+				return false; // under a flood of new keys the map stays bounded; the IP limit still holds
+			}
+			Entry& e = map[k];
+			if (e.blockedUntil > now) {
+				return false;
+			}
+			if (now - e.windowStart >= static_cast<int64_t>(s.windowSec)) {
+				e.windowStart = now;
+				e.count = 0;
+			}
+			if (++e.count >= max) {
+				e.blockedUntil = now + s.blockSec;
+				e.count = 0;
+				e.windowStart = e.blockedUntil;
+				return true;
+			}
+			return false;
+		}
+
+		template <typename Map>
+		static void sweep(Map& map, int64_t now, const Settings& s) {
+			for (auto it = map.begin(); it != map.end();) {
+				const Entry& e = it->second;
+				if (e.blockedUntil <= now && now - e.windowStart >= static_cast<int64_t>(s.windowSec)) {
+					it = map.erase(it);
+				} else {
+					++it;
+				}
+			}
+		}
+
+		std::mutex lock;
+		std::unordered_map<uint32_t, Entry> ips;
+		std::unordered_map<std::string, Entry> accounts;
+};
+
+inline Limiter& global()
+{
+	static Limiter limiter;
+	return limiter;
+}
+
+inline std::string refusal(uint32_t seconds)
+{
+	const uint32_t minutes = (seconds + 59) / 60;
+	return "Too many failed logins. Please wait " + std::to_string(minutes) + (minutes == 1 ? " minute" : " minutes") +
+	       " and try again.\nForgot your password? Reset it on the website.";
+}
+
+} // namespace LoginLimit
+
+#endif
