# Player attack speed bonus (server/README.md "Attack speed cap", "Passive tree: attack speed"): a percent that does not come
# from the weapon, shortening the swing interval like dexterity points do.
#  1. Player::attackSpeedBonus (0 .. 100, not saved: the scripts set it again on login), Player:getAttackSpeedBonus() /
#     Player:setAttackSpeedBonus(percent) in Lua. data/scripts/chaos/passivetree_effects.lua writes the passive tree's
#     "attackSpeed" stat plus the Chaos attack speed modifiers of gloves, rings and amulets (data/lib/chaos_item_mods.lua
#     M.playerBonus).
#  2. Player::getAttackSpeed adds it to the dexterity points before the 0011 rules, so every attack speed bonus together
#     (weapon attribute, dexterity, this one) still shortens the interval by at most maxPlayerAttackSpeedBonus % and no
#     swing is faster than minPlayerAttackInterval ms. Lua mirror: ChaosItemMods.effectiveInterval (bonus argument).
# Apply in the server source root after 0001-0077: patch -p1 < 0078-player-attack-speed-bonus.patch, then rebuild.
--- a/src/luascript.cpp
+++ b/src/luascript.cpp
@@ -2720,6 +2720,8 @@
 	registerMethod("Player", "setCharacterStat", LuaScriptInterface::luaPlayerSetCharacterStat);
 	registerMethod("Player", "addCharacterStat", LuaScriptInterface::luaPlayerAddCharacterStat);
 	registerMethod("Player", "getCharacterStat", LuaScriptInterface::luaPlayerGetCharacterStat);
+	registerMethod("Player", "getAttackSpeedBonus", LuaScriptInterface::luaPlayerGetAttackSpeedBonus); // Chaos (patch 0078)
+	registerMethod("Player", "setAttackSpeedBonus", LuaScriptInterface::luaPlayerSetAttackSpeedBonus);
 	// Monster
 	registerClass("Monster", "Creature", LuaScriptInterface::luaMonsterCreate);
 	registerMethod("Player", "addAura", LuaScriptInterface::luaPlayerAddAura);
@@ -11470,6 +11472,30 @@
 	}
 	return 1;
 }
+// Chaos (patch 0078): player:getAttackSpeedBonus() / player:setAttackSpeedBonus(percent), 0 .. 100
+int LuaScriptInterface::luaPlayerGetAttackSpeedBonus(lua_State* L)
+{
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		lua_pushnumber(L, player->getAttackSpeedBonus());
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerSetAttackSpeedBonus(lua_State* L)
+{
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->setAttackSpeedBonus(static_cast<int16_t>(std::min<int32_t>(100, std::max<int32_t>(0, getNumber<int32_t>(L, 2)))));
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
