 		void setNextActionTask(SchedulerTask* task, bool resetIdleTime = true);
 		void setNextActionTask(SchedulerTask* task, bool resetIdleTime, CooldownChannel_t channel); // Chaos (0042)
 		void setNextAttackTask(SchedulerTask* task); // Chaos (0042): the auto attack's own queued check
+		// Chaos (0066): milliseconds until the next auto attack swing is allowed (0 or less: ready now)
+		int64_t getAttackReadyIn() const {
+			return lastAttack == 0 ? 0 : static_cast<int64_t>(getAttackSpeed()) - (OTSYS_TIME() - static_cast<int64_t>(lastAttack));
+		}
 
 		void death(Creature* lastHitCreature) override;
