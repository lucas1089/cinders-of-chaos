+int LuaScriptInterface::luaGameSetCastTarget(lua_State* L)
+{
+	// Game.setCastTarget(name)  Chaos (src-patch 0064): the player whose game messages go to the cast port (castPort,
+	// server/README.md "Live spectator"); nil or "" clears it. A new name drops the spectators of the old one. Returns
+	// true when the cast port is open (false: castPort is 0 or could not be opened; the name is kept all the same).
+	std::string name = isString(L, 1) ? getString(L, 1) : "";
+	if (name.size() > 64) {
+		name.clear();
+	}
+	ChaosCastServer::get().setTarget(name);
+	pushBoolean(L, ChaosCastServer::get().running());
+	return 1;
+}
+
+int LuaScriptInterface::luaGameGetCastTarget(lua_State* L)
+{
+	// Game.getCastTarget()  Chaos (src-patch 0064): name (nil when none), spectators connected, port open
+	const ChaosCastServer& cast = ChaosCastServer::get();
+	if (cast.getTarget().empty()) {
+		lua_pushnil(L);
+	} else {
+		pushString(L, cast.getTarget());
+	}
+	lua_pushnumber(L, cast.spectators());
+	pushBoolean(L, cast.running());
+	return 3;
+}
