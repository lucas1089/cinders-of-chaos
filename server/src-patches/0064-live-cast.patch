+// Chaos (patch 0064): see protocolgame.h. The hello frame, then what a login sends of the game view: the aware range
+// (our client), the map, the player's stats, the world light and the player's light.
+void ProtocolGame::writeCastView(std::vector<std::string>& frames)
+{
+	if (!player || castCapture) {
+		return;
+	}
+	uint8_t flags = 0;
+	if (chaosItemAttributes) {
+		flags |= ChaosCast::HELLO_ITEM_ATTRIBUTES;
+	}
+	if (chaosImpactText) {
+		flags |= ChaosCast::HELLO_IMPACT_TEXT;
+	}
+	frames.push_back(ChaosCast::helloFrame(player->getID(), otclientV8, flags, static_cast<uint8_t>(awareRange.width),
+	                                       static_cast<uint8_t>(awareRange.height), player->getName()));
+	// the spectator knows no creature yet; the player's client gets the ones it already knows in full again, which
+	// it takes as an update
+	knownCreatureSet.clear();
+	castCapture = &frames;
+	sendAwareRange();
+	sendMapDescription(player->getPosition());
+	sendStats();
+	sendWorldLight(g_game.getWorldLightInfo());
+	sendCreatureLight(player);
+	castCapture = nullptr;
+}
