@@ -0,0 +1,63 @@
+// Chaos (patch 0064): the cast port (server/README.md "Live spectator", phase 2). A small TCP server on 127.0.0.1
+// (config.lua castPort, 0 = off) with its own thread. Lua names the watched player (Game.setCastTarget); every game
+// message the engine sends that player and src/chaoscast.h keeps goes, as a frame, to each spectator connected to the
+// port. A new spectator first gets the hello frame and the player's view as a login sends it (built on the dispatcher,
+// ProtocolGame::writeCastView), then the live messages. The game thread never waits for a spectator: a spectator with
+// more than castQueueKb waiting is dropped, and so is everyone when the target changes or logs out (the relay
+// connects again and gets a fresh view). At most castMaxSpectators at once.
+
+#ifndef FS_CHAOSCASTSERVER_H
+#define FS_CHAOSCASTSERVER_H
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+class ChaosCastServer
+{
+	public:
+		static ChaosCastServer& get();
+
+		// main loader: listens on 127.0.0.1:port with its own thread (false and a console line when it cannot)
+		bool start(uint16_t port, uint32_t maxSpectators, size_t maxQueueBytes);
+		// shutdown: closes every connection and joins the thread
+		void stop();
+		bool running() const {
+			return isRunning.load(std::memory_order_relaxed);
+		}
+
+		// dispatcher thread
+		void setTarget(const std::string& name); // "" clears it; a new name drops the spectators of the old one
+		const std::string& getTarget() const {
+			return targetName;
+		}
+		uint32_t spectators() const {
+			return live.load(std::memory_order_relaxed);
+		}
+		// cheap check for ProtocolGame::writeToOutputBuffer: is this player's output mirrored now?
+		bool watching(uint32_t playerId) const {
+			return targetId != 0 && playerId == targetId && live.load(std::memory_order_relaxed) > 0;
+		}
+		void mirror(const uint8_t* body, size_t len);
+		void targetGone(uint32_t playerId); // the target's connection is released (logout, lost, replaced)
+
+	private:
+		ChaosCastServer();
+		~ChaosCastServer();
+		ChaosCastServer(const ChaosCastServer&) = delete;
+		ChaosCastServer& operator=(const ChaosCastServer&) = delete;
+
+		void snapshotFor(uint64_t spectatorId); // dispatcher thread
+		void dropAll();
+
+		struct Impl;
+		std::unique_ptr<Impl> impl;
+		std::atomic<bool> isRunning{false};
+		std::atomic<uint32_t> live{0};
+		std::string targetName;   // dispatcher thread
+		uint32_t targetId = 0;    // dispatcher thread: the creature id of the target once a view was sent
+};
+
+#endif
diff --git a/src/chaoscastserver.cpp b/src/chaoscastserver.cpp
new file mode 100644
--- /dev/null
+++ b/src/chaoscastserver.cpp
@@ -0,0 +1,305 @@
+// Chaos (patch 0064): the cast port; see chaoscastserver.h and chaoscast.h.
+
+#include "otpch.h"
+
+#include "chaoscastserver.h"
+
+#include "chaoscast.h"
+#include "game.h"
+#include "player.h"
+#include "protocolgame.h"
+#include "tasks.h"
+
+#include <deque>
+#include <map>
+#include <thread>
+#include <vector>
+
+extern Game g_game;
+
+namespace {
+
+struct Spectator
+{
+	explicit Spectator(boost::asio::io_service& io, uint64_t id) : id(id), socket(io) {}
+
+	uint64_t id;
+	boost::asio::ip::tcp::socket socket;
+	std::deque<std::shared_ptr<const std::string>> queue;
+	size_t queued = 0;
+	bool writing = false;
+	bool ready = false;
+	bool closed = false;
+	uint8_t readByte = 0;
+};
+
+using Spectator_ptr = std::shared_ptr<Spectator>;
+
+} // namespace
+
+struct ChaosCastServer::Impl
+{
+	boost::asio::io_service io;
+	std::unique_ptr<boost::asio::io_service::work> work;
+	boost::asio::ip::tcp::acceptor acceptor{io};
+	std::thread thread;
+	std::map<uint64_t, Spectator_ptr> spectators; // io thread only
+	uint64_t nextId = 1;                           // io thread only
+	std::atomic<size_t> posted{0};                 // bytes handed to the io thread and not yet queued
+	uint32_t maxSpectators = 3;
+	size_t maxQueue = 1024 * 1024;
+
+	// io thread
+	void close(ChaosCastServer& owner, const Spectator_ptr& s) {
+		if (s->closed) {
+			return;
+		}
+		s->closed = true;
+		boost::system::error_code ec;
+		s->socket.shutdown(boost::asio::ip::tcp::socket::shutdown_both, ec);
+		s->socket.close(ec);
+		s->queue.clear();
+		s->queued = 0;
+		if (spectators.erase(s->id) != 0) {
+			owner.live.fetch_sub(1, std::memory_order_relaxed);
+		}
+	}
+
+	void closeAll(ChaosCastServer& owner) {
+		std::vector<Spectator_ptr> all;
+		for (auto& it : spectators) {
+			all.push_back(it.second);
+		}
+		for (auto& s : all) {
+			close(owner, s);
+		}
+	}
+
+	void write(ChaosCastServer& owner, const Spectator_ptr& s) {
+		if (s->closed || s->writing || s->queue.empty()) {
+			return;
+		}
+		s->writing = true;
+		auto frame = s->queue.front();
+		boost::asio::async_write(s->socket, boost::asio::buffer(*frame),
+		                         [this, &owner, s, frame](const boost::system::error_code& ec, size_t) {
+			s->writing = false;
+			if (ec || s->closed) {
+				close(owner, s);
+				return;
+			}
+			s->queue.pop_front();
+			s->queued -= std::min(s->queued, frame->size());
+			write(owner, s);
+		});
+	}
+
+	void enqueue(ChaosCastServer& owner, const Spectator_ptr& s, const std::shared_ptr<const std::string>& frame) {
+		if (s->closed) {
+			return;
+		}
+		if (s->queued + frame->size() > maxQueue) {
+			// too slow to follow the game: dropped (the relay connects again and gets a fresh view)
+			std::cout << "[Cast] a spectator fell " << (s->queued / 1024) << " KiB behind: dropped" << std::endl;
+			close(owner, s);
+			return;
+		}
+		s->queue.push_back(frame);
+		s->queued += frame->size();
+		write(owner, s);
+	}
+
+	// a spectator never sends anything; a read ends when it closes the connection
+	void readUntilClosed(ChaosCastServer& owner, const Spectator_ptr& s) {
+		s->socket.async_read_some(boost::asio::buffer(&s->readByte, 1),
+		                          [this, &owner, s](const boost::system::error_code& ec, size_t) {
+			if (ec || s->closed) {
+				close(owner, s);
+				return;
+			}
+			readUntilClosed(owner, s);
+		});
+	}
+
+	void accept(ChaosCastServer& owner) {
+		auto s = std::make_shared<Spectator>(io, nextId++);
+		acceptor.async_accept(s->socket, [this, &owner, s](const boost::system::error_code& ec) {
+			if (ec) {
+				if (ec != boost::asio::error::operation_aborted) {
+					accept(owner);
+				}
+				return;
+			}
+			if (spectators.size() >= maxSpectators) {
+				boost::system::error_code ignored;
+				s->socket.close(ignored);
+			} else {
+				boost::system::error_code ignored;
+				s->socket.set_option(boost::asio::ip::tcp::no_delay(true), ignored);
+				spectators[s->id] = s;
+				owner.live.fetch_add(1, std::memory_order_relaxed);
+				readUntilClosed(owner, s);
+				const uint64_t id = s->id;
+				g_dispatcher.addTask(createTask([&owner, id]() { owner.snapshotFor(id); }));
+			}
+			accept(owner);
+		});
+	}
+};
+
+ChaosCastServer& ChaosCastServer::get()
+{
+	static ChaosCastServer instance;
+	return instance;
+}
+
+ChaosCastServer::ChaosCastServer() : impl(new Impl) {}
+
+ChaosCastServer::~ChaosCastServer()
+{
+	stop();
+}
+
+bool ChaosCastServer::start(uint16_t port, uint32_t maxSpectators, size_t maxQueueBytes)
+{
+	if (isRunning.load()) {
+		return true;
+	}
+	impl->maxSpectators = maxSpectators;
+	impl->maxQueue = maxQueueBytes;
+	try {
+		const boost::asio::ip::tcp::endpoint at(boost::asio::ip::address_v4::loopback(), port);
+		impl->acceptor.open(at.protocol());
+		impl->acceptor.set_option(boost::asio::ip::tcp::acceptor::reuse_address(true));
+		impl->acceptor.bind(at);
+		impl->acceptor.listen(4);
+	} catch (const boost::system::system_error& e) {
+		std::cout << "> ERROR: the cast port 127.0.0.1:" << port << " cannot be opened (" << e.what()
+		          << "): the live cast is off" << std::endl;
+		boost::system::error_code ignored;
+		impl->acceptor.close(ignored);
+		return false;
+	}
+	impl->work.reset(new boost::asio::io_service::work(impl->io));
+	impl->accept(*this);
+	impl->thread = std::thread([this]() {
+		try {
+			impl->io.run();
+		} catch (const std::exception& e) {
+			std::cout << "[Cast] stopped: " << e.what() << std::endl;
+		}
+	});
+	isRunning = true;
+	std::cout << ">> Cast port 127.0.0.1:" << port << " (live spectator, at most " << maxSpectators << ")" << std::endl;
+	return true;
+}
+
+void ChaosCastServer::stop()
+{
+	if (!isRunning.exchange(false)) {
+		return;
+	}
+	impl->io.post([this]() {
+		boost::system::error_code ignored;
+		impl->acceptor.close(ignored);
+		impl->closeAll(*this);
+	});
+	impl->work.reset(); // run() ends once the closes above have finished every pending operation
+	if (impl->thread.joinable()) {
+		impl->thread.join();
+	}
+	live = 0;
+}
+
+void ChaosCastServer::dropAll()
+{
+	if (!isRunning.load()) {
+		return;
+	}
+	impl->io.post([this]() { impl->closeAll(*this); });
+}
+
+void ChaosCastServer::setTarget(const std::string& name)
+{
+	if (name == targetName) {
+		return;
+	}
+	targetName = name;
+	targetId = 0;
+	dropAll();
+}
+
+void ChaosCastServer::targetGone(uint32_t playerId)
+{
+	if (targetId == 0 || playerId != targetId) {
+		return;
+	}
+	targetId = 0;
+	dropAll();
+}
+
+void ChaosCastServer::mirror(const uint8_t* body, size_t len)
+{
+	if (!isRunning.load(std::memory_order_relaxed) || !ChaosCast::keepMessage(body, len)) {
+		return;
+	}
+	auto frame = std::make_shared<std::string>();
+	if (!ChaosCast::appendFrame(*frame, body, len)) {
+		// a message too big for a frame: the spectators would miss it, so they start again
+		targetId = 0;
+		dropAll();
+		return;
+	}
+	const size_t size = frame->size();
+	if (impl->posted.load(std::memory_order_relaxed) + size > impl->maxQueue) {
+		// the cast thread does not keep up at all: everyone starts again
+		targetId = 0;
+		dropAll();
+		return;
+	}
+	impl->posted += size;
+	std::shared_ptr<const std::string> shared = frame;
+	impl->io.post([this, shared, size]() {
+		impl->posted -= size;
+		std::vector<Spectator_ptr> ready;
+		for (auto& it : impl->spectators) {
+			if (it.second->ready) {
+				ready.push_back(it.second);
+			}
+		}
+		for (auto& s : ready) {
+			impl->enqueue(*this, s, shared);
+		}
+	});
+}
+
+void ChaosCastServer::snapshotFor(uint64_t spectatorId)
+{
+	std::vector<std::string> frames;
+	Player* player = targetName.empty() ? nullptr : g_game.getPlayerByName(targetName);
+	if (player && !player->isRemoved() && player->writeCastView(frames)) {
+		targetId = player->getID();
+	}
+	if (frames.empty()) {
+		// no target, or it is not online with a client: the relay tries again
+		impl->io.post([this, spectatorId]() {
+			auto it = impl->spectators.find(spectatorId);
+			if (it != impl->spectators.end()) {
+				impl->close(*this, it->second);
+			}
+		});
+		return;
+	}
+	auto shared = std::make_shared<std::vector<std::string>>(std::move(frames));
+	impl->io.post([this, spectatorId, shared]() {
+		auto it = impl->spectators.find(spectatorId);
+		if (it == impl->spectators.end()) {
+			return;
+		}
+		Spectator_ptr s = it->second;
+		for (auto& f : *shared) {
+			impl->enqueue(*this, s, std::make_shared<const std::string>(std::move(f)));
+		}
+		s->ready = !s->closed;
+	});
+}
