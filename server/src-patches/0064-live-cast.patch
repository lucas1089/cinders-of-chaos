new file mode 100644
--- /dev/null
+++ b/src/chaoscast.h
@@ -0,0 +1,168 @@
+// Chaos (patch 0064): the live cast of one player for the admin app (server/README.md "Live spectator", phase 2).
+// The engine mirrors the game messages it sends to the watched player to the spectators of a local socket
+// (castPort, 127.0.0.1 only, src/chaoscastserver.cpp); server/tools/cast_relay.py reads them there. This header holds
+// the pure parts, no engine types, so server/tools/chaoscast_test.cpp tests them alone:
+//   * keepMessage: which messages go to a spectator. A list of what the game view needs (map, tiles, creatures,
+//     moves, effects, missiles, animated text, health, light, the player's stats, public speech on screen and the
+//     damage / heal / experience numbers); everything else stays private: private and channel messages, the channel
+//     list, VIP, modal windows, store, market, trade, containers, inventory, outfit window, extended opcodes, pings.
+//     The first byte of a message is its opcode; a message that starts with a listed opcode holds only map and
+//     creature data (the moves of the player add map slices after their first opcode).
+//   * frames: a frame is u16 length (little endian) + one message body as the client would read it, no checksum and
+//     no encryption. A spectator connection starts with the hello frame (opcode 0x00, below), then the view of the
+//     player as a login sends it, then the live messages.
+
+#ifndef FS_CHAOSCAST_H
+#define FS_CHAOSCAST_H
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace ChaosCast {
+
+static constexpr uint8_t HELLO_OPCODE = 0x00; // never a server message
+static constexpr uint8_t HELLO_VERSION = 1;
+static constexpr size_t MAX_FRAME_BODY = 0xFFFF;
+
+// flags of the hello frame: how this player's client reads items and text messages
+static constexpr uint8_t HELLO_ITEM_ATTRIBUTES = 1; // u16 count + (u16 key, u64 value) after every item
+static constexpr uint8_t HELLO_IMPACT_TEXT = 2;     // u16 percent, u8 type, u32 creature id in damage text messages
+
+// speech kept: what everyone near the player sees over the speaker's head
+inline bool publicTalkType(uint8_t type)
+{
+	return type == 1 || type == 3 || type == 36 || type == 37; // say, yell, monster say, monster yell
+}
+
+// text messages kept: the numbers over the creatures (damage, heal, experience), which carry their tile
+inline bool publicTextType(uint8_t type)
+{
+	return type >= 23 && type <= 29; // MESSAGE_DAMAGE_DEALT .. MESSAGE_EXPERIENCE_OTHERS
+}
+
+// 0xAA creature speech on the map: u32 statement, string name, u16 level, u8 type, position, string text, nothing
+// after. A channel or private message has another layout (channel id or no position) and is refused here even with a
+// kept type.
+inline bool publicTalk(const uint8_t* body, size_t len)
+{
+	size_t p = 1 + 4;
+	if (len < p + 2) {
+		return false;
+	}
+	const size_t name = body[p] | (body[p + 1] << 8);
+	p += 2 + name + 2; // name, level
+	if (p + 1 > len || !publicTalkType(body[p])) {
+		return false;
+	}
+	p += 1 + 5; // type, position
+	if (p + 2 > len) {
+		return false;
+	}
+	const size_t text = body[p] | (body[p + 1] << 8);
+	return p + 2 + text == len;
+}
+
+// the messages a spectator gets (body: one message, its first byte the opcode)
+inline bool keepMessage(const uint8_t* body, size_t len)
+{
+	if (!body || len == 0) {
+		return false;
+	}
+	switch (body[0]) {
+		case 0x42: // aware range (the size of the map the client keeps)
+		case 0x4B: // one floor of the map
+		case 0x64: // the map around the player
+		case 0x65: case 0x66: case 0x67: case 0x68: // map slices after a step (north, east, south, west)
+		case 0x69: // one tile
+		case 0x6A: case 0x6B: case 0x6C: // add, change, remove a thing on a tile
+		case 0x6D: // a creature moves
+		case 0x82: // world light
+		case 0x83: // magic effect
+		case 0x84: // animated text
+		case 0x85: // missile
+		case 0x8C: // creature health
+		case 0x8D: // creature light
+		case 0x8E: // creature outfit
+		case 0x8F: // creature speed
+		case 0x90: // skull
+		case 0x91: // party shield
+		case 0x92: // walk-through
+		case 0x93: // square
+		case 0x95: // creature type
+		case 0xA0: // the player's stats
+		case 0xBE: case 0xBF: // floor change up / down
+			return true;
+		case 0xAA:
+			return publicTalk(body, len);
+		case 0xB4:
+			return len >= 2 && publicTextType(body[1]);
+		default:
+			return false;
+	}
+}
+
+// a frame: u16 length + body; false (nothing added) when the body does not fit a frame
+inline bool appendFrame(std::string& out, const uint8_t* body, size_t len)
+{
+	if (!body || len == 0 || len > MAX_FRAME_BODY) {
+		return false;
+	}
+	out.push_back(static_cast<char>(len & 0xFF));
+	out.push_back(static_cast<char>((len >> 8) & 0xFF));
+	out.append(reinterpret_cast<const char*>(body), len);
+	return true;
+}
+
+// the hello frame: opcode 0x00, "CAST", u8 version, u32 player id, u16 client version marker (0 for a plain 10.98
+// client; non-zero: floors come as 0x4B messages and outfits carry wings, aura and shader), u8 flags, u8 aware width,
+// u8 aware height, string name (u16 length + bytes)
+inline std::string helloFrame(uint32_t playerId, uint16_t clientMarker, uint8_t flags, uint8_t awareWidth,
+                              uint8_t awareHeight, const std::string& name)
+{
+	std::string body;
+	body.push_back(static_cast<char>(HELLO_OPCODE));
+	body.append("CAST");
+	body.push_back(static_cast<char>(HELLO_VERSION));
+	for (int i = 0; i < 4; ++i) {
+		body.push_back(static_cast<char>((playerId >> (8 * i)) & 0xFF));
+	}
+	body.push_back(static_cast<char>(clientMarker & 0xFF));
+	body.push_back(static_cast<char>((clientMarker >> 8) & 0xFF));
+	body.push_back(static_cast<char>(flags));
+	body.push_back(static_cast<char>(awareWidth));
+	body.push_back(static_cast<char>(awareHeight));
+	const size_t n = name.size() > 64 ? 64 : name.size();
+	body.push_back(static_cast<char>(n & 0xFF));
+	body.push_back(static_cast<char>((n >> 8) & 0xFF));
+	body.append(name, 0, n);
+	std::string frame;
+	appendFrame(frame, reinterpret_cast<const uint8_t*>(body.data()), body.size());
+	return frame;
+}
+
+// the most spectators at once and the bytes a spectator may have waiting, from config.lua, kept in sane bounds
+inline uint32_t clampSpectators(int64_t value)
+{
+	return value < 1 ? 1 : (value > 8 ? 8 : static_cast<uint32_t>(value));
+}
+
+inline size_t clampQueueBytes(int64_t kib)
+{
+	if (kib < 256) {
+		kib = 256;
+	} else if (kib > 16384) {
+		kib = 16384;
+	}
+	return static_cast<size_t>(kib) * 1024;
+}
+
+// a usable port: 1..65535 (0 or anything else: the cast is off)
+inline bool portOn(int64_t port)
+{
+	return port >= 1 && port <= 65535;
+}
+
+} // namespace ChaosCast
+
+#endif
