# Wide spell ids (server/README.md "Wide spell ids", client/BASE.md "Wide spell ids"). Every spell id is one byte: Spell::spellId
# was uint8_t (spellid in spells.xml was read as a number and cut to 8 bits) and the 0xA4 spell cooldown packet carried
# it as one byte, so the 255 ids were all used (server/tests/spell_ids_test.lua) and a spellid of 258 was spell 2 for the
# engine. Now Spell::spellId, Spell::getId / setId and spell:id() are 16 bits (a Lua cooldown condition already held a
# u32 sub id), and the packet is gated: a client sets bit 6 of the capability byte it sends after its markers in the login
# packet (the same byte that carries bit 7 of 0051; every build of our client sets bit 6), and sendFeatures answers with
# feature 152 (GameChaosExtendedSpellIds) only when config.lua has chaosWideSpellIds = true (default false, so nothing
# changes on the wire until the owner turns it on). With the feature the 0xA4 packet is: 0xA4, u16 spell id, u32 time. Without
# it: 0xA4, u8 spell id, u32 time, as before; an id above 255 then sends no packet (stock sent its low byte and put the
# cooldown icon on another spell). The client reads the u16 through the feature it already has (client/BASE.md), so no
# client patch is needed. Not widened on purpose: the 0xA5 group cooldown (group ids are 1..4), the known spells list of
# the 0x9F packet (a fixed list of 0..254 that no Chaos code reads) and the spell group conditions. The live cast
# (0064) forwards no 0xA4, so its hello flags are unchanged. Config key: configKeys.WIDE_SPELL_IDS (tools/patch_wide_spell_ids.py
# writes the default into config.lua). Guard: tools/patch_wide_spell_ids_test.py (CI). Applies after 0001-0078.
diff --git a/src/configmanager.cpp b/src/configmanager.cpp
--- a/src/configmanager.cpp
+++ b/src/configmanager.cpp
@@ -279,6 +279,10 @@
 	integer[MOVE_ITEM_DELAY] = getGlobalNumber(L, "moveItemDelay", 50);
 	integer[RUNE_CHANNEL_DELAY] = getGlobalNumber(L, "runeChannelDelay", 1000);
 	integer[POTION_CHANNEL_DELAY] = getGlobalNumber(L, "potionChannelDelay", 1000);
+	// Chaos (patch 0079): wide spell ids (server/README.md "Wide spell ids"). true: a client that asks for it (login
+	// capability bit 6) gets feature 152 and reads the spell id of the 0xA4 cooldown packet as a u16, so spell ids
+	// above 255 work. false (default): the one-byte id of the 10.98 packet; a spell id above 255 sends no cooldown icon
+	boolean[WIDE_SPELL_IDS] = getGlobalBoolean(L, "chaosWideSpellIds", false);
 	integer[MAX_MESSAGEBUFFER] = getGlobalNumber(L, "maxMessageBuffer", 4);
 	integer[KICK_AFTER_MINUTES] = getGlobalNumber(L, "kickIdlePlayerAfterMinutes", 15);
 	integer[PROTECTION_LEVEL] = getGlobalNumber(L, "protectionLevel", 1);
