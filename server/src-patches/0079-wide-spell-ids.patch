-void ProtocolGame::sendSpellCooldown(uint8_t spellId, uint32_t time)
+void ProtocolGame::sendSpellCooldown(uint32_t spellId, uint32_t time)
 {
+	// Chaos (patch 0079): a client that was announced feature 152 reads the id as a u16; every other client reads one
+	// byte; an id that does not fit has no icon (stock cut it to its low byte and showed the cooldown on another spell)
+	if (spellId > (chaosWideSpellIds ? 0xFFFFu : 0xFFu)) {
+		return;
+	}
 	NetworkMessage msg;
 	msg.addByte(0xA4);
-	msg.addByte(spellId);
+	if (chaosWideSpellIds) {
+		msg.add<uint16_t>(static_cast<uint16_t>(spellId));
+	} else {
+		msg.addByte(static_cast<uint8_t>(spellId));
+	}
 	msg.add<uint32_t>(time);
 	writeToOutputBuffer(msg);
 }
