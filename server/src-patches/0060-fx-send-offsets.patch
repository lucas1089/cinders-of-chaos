# Send offsets of the in-place effect art for every effect the engine sends (server/README.md "Purchased effect
# packs (pair 36)", "Send offsets of the in-place art"). 23 effect ids redrawn in place with 3x3 / 4x4 / 2x3 / 3x2
# art keep their bottom-right tile on the tile they are sent to, so they sat up-left of the target. The Lua guard of
# Position:sendMagicEffect already centred the Lua sends; the engine's own sends (combat COMBAT_PARAM_EFFECT areas and
# targets, monster areaEffect / shootEffect impacts, condition and creature poffs, teleports) stayed up-left.
#   * ProtocolGame::sendMagicEffect, the one place every effect packet goes through, sends a listed id at the target
#     tile + (dx, dy): x and y kept on the map (Map::getWidth / getHeight, new), same floor. A viewer that sees the
#     target but not that tile gets the effect at the target tile, as before; one that sees only that tile gets it
#     there. The spectators stay the engine's (around the target).
#   * Game.setFxSendOffsets(offsets)  replaces the table: {[id] = {dx, dy}}, the generated ChaosFxSendOffset of
#     data/lib/chaos_fx_send_offsets.lua (one source of truth, client/tools/sprites/gen_fx_send_offsets.py). Returns
#     the ids stored. Game.getFxSendOffset(id) -> dx, dy or nil.
#   * fx_send_offset_core.lua hands the table over at load (chaos_constants.lua, every scripts load); once the engine
#     took it, the Lua guard stops shifting, so no effect is shifted twice. Without this patch Game.setFxSendOffsets
#     is missing and the Lua guard shifts the Lua sends as before. Empty table (no Lua call): every effect at its tile.
# New header src/chaosfxoffsets.h (pure; tests in server/tools/chaosfxoffsets_test.cpp, CI).
# Applies after 0001-0059 (0060-0069 are reserved).
diff --git a/src/chaosfxoffsets.h b/src/chaosfxoffsets.h
new file mode 100644
--- /dev/null
+++ b/src/chaosfxoffsets.h
@@ -0,0 +1,91 @@
+// Chaos (patch 0060): send offsets of the effects redrawn in place with art bigger than a tile (pair 36,
+// server/README.md "Purchased effect packs (pair 36)"). The client draws an effect with its bottom-right tile on the
+// tile it is sent to, and the in-place art kept that tile on the target, so a 3x3 or 4x4 art sat up and left of it.
+// The table (effect id -> dx, dy) is data/lib/chaos_fx_send_offsets.lua (generated by
+// client/tools/sprites/gen_fx_send_offsets.py); Lua hands it over with Game.setFxSendOffsets(ChaosFxSendOffset)
+// (fx_send_offset_core.lua) and ProtocolGame::sendMagicEffect sends each listed id at the target tile + (dx, dy),
+// for every effect packet (engine, monster, combat and Lua sends alike). Pure functions, no engine types, so
+// server/tools/chaosfxoffsets_test.cpp tests them alone.
+
+#ifndef FS_CHAOSFXOFFSETS_H
+#define FS_CHAOSFXOFFSETS_H
+
+#include <cstdint>
+#include <unordered_map>
+
+// the largest offset accepted on an axis (the biggest art is 4x4: 2 tiles; a tile view reaches 8 to the side)
+static constexpr int32_t CHAOS_FX_MAX_OFFSET = 7;
+
+struct ChaosFxOffset {
+	int8_t dx;
+	int8_t dy;
+};
+
+class ChaosFxSendOffsets
+{
+	public:
+		void clear() {
+			offsets.clear();
+		}
+		// false (nothing stored) for effect 0, an offset of 0, 0 or one beyond CHAOS_FX_MAX_OFFSET
+		bool set(uint32_t effect, int32_t dx, int32_t dy) {
+			if (effect == 0 || effect > 0xFFFF || (dx == 0 && dy == 0) || dx < -CHAOS_FX_MAX_OFFSET ||
+			    dx > CHAOS_FX_MAX_OFFSET || dy < -CHAOS_FX_MAX_OFFSET || dy > CHAOS_FX_MAX_OFFSET) {
+				return false;
+			}
+			offsets[static_cast<uint16_t>(effect)] = {static_cast<int8_t>(dx), static_cast<int8_t>(dy)};
+			return true;
+		}
+		// the offset of `effect`, nullptr when it is sent at its tile
+		const ChaosFxOffset* get(uint16_t effect) const {
+			if (offsets.empty()) {
+				return nullptr;
+			}
+			auto it = offsets.find(effect);
+			return it != offsets.end() ? &it->second : nullptr;
+		}
+		size_t size() const {
+			return offsets.size();
+		}
+
+	private:
+		std::unordered_map<uint16_t, ChaosFxOffset> offsets;
+};
+
+// the one table of the server (empty until Lua sets it: every effect at its tile, as without the patch)
+inline ChaosFxSendOffsets& chaosFxSendOffsets()
+{
+	static ChaosFxSendOffsets table;
+	return table;
+}
+
+// one coordinate + offset, kept on the map: 0 .. size - 1 (size 0: map size unknown, 0 .. 65535)
+inline uint16_t chaosFxShiftAxis(uint16_t v, int32_t d, uint32_t size)
+{
+	int32_t max = (size > 0 && size <= 0x10000) ? static_cast<int32_t>(size) - 1 : 0xFFFF;
+	int32_t r = static_cast<int32_t>(v) + d;
+	if (r < 0) {
+		r = 0;
+	} else if (r > max) {
+		r = max;
+	}
+	return static_cast<uint16_t>(r);
+}
+
+// where one viewer gets the effect: at the centring tile when it sees it, else at the target tile when it sees that
+// (a viewer at the edge of the view still gets the effect, uncentred as before), else not at all
+enum ChaosFxSendAt : uint8_t {
+	CHAOS_FX_SEND_NONE = 0,
+	CHAOS_FX_SEND_TARGET = 1,
+	CHAOS_FX_SEND_SHIFTED = 2,
+};
+
+inline ChaosFxSendAt chaosFxSendAt(bool seesTarget, bool seesShifted)
+{
+	if (seesShifted) {
+		return CHAOS_FX_SEND_SHIFTED;
+	}
+	return seesTarget ? CHAOS_FX_SEND_TARGET : CHAOS_FX_SEND_NONE;
+}
+
+#endif
