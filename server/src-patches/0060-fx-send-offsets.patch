+int LuaScriptInterface::luaGameSetFxSendOffsets(lua_State* L)
+{
+	// Game.setFxSendOffsets(offsets)  Chaos (src-patch 0060): offsets = {[effect id] = {dx, dy}, ...}, the table
+	// ChaosFxSendOffset of data/lib/chaos_fx_send_offsets.lua. Replaces the engine's table: every effect packet of a
+	// listed id is sent at the target tile + (dx, dy). nil or {} clears it. Returns the number of ids stored.
+	ChaosFxSendOffsets& offsets = chaosFxSendOffsets();
+	offsets.clear();
+	if (isTable(L, 1)) {
+		lua_pushnil(L);
+		while (lua_next(L, 1) != 0) {
+			// key at -2, value at -1
+			if (isNumber(L, -2) && isTable(L, -1)) {
+				lua_rawgeti(L, -1, 1);
+				lua_rawgeti(L, -2, 2);
+				const double id = lua_tonumber(L, -4), dx = lua_tonumber(L, -2), dy = lua_tonumber(L, -1);
+				// set() refuses id 0, 0, 0 and offsets past CHAOS_FX_MAX_OFFSET; these bounds keep the casts defined
+				if (isNumber(L, -2) && isNumber(L, -1) && id >= 1 && id <= 0xFFFF && dx >= -0x7F && dx <= 0x7F &&
+				    dy >= -0x7F && dy <= 0x7F) {
+					offsets.set(static_cast<uint32_t>(id), static_cast<int32_t>(dx), static_cast<int32_t>(dy));
+				}
+				lua_pop(L, 2);
+			}
+			lua_pop(L, 1);
+		}
+	}
+	lua_pushnumber(L, offsets.size());
+	return 1;
+}
+
+int LuaScriptInterface::luaGameGetFxSendOffset(lua_State* L)
+{
+	// Game.getFxSendOffset(effect)  Chaos (src-patch 0060): dx, dy the engine sends `effect` at, nil when at its tile
+	const ChaosFxOffset* o = chaosFxSendOffsets().get(getNumber<uint16_t>(L, 1));
+	if (!o) {
+		lua_pushnil(L);
+		return 1;
+	}
+	lua_pushnumber(L, o->dx);
+	lua_pushnumber(L, o->dy);
+	return 2;
+}
