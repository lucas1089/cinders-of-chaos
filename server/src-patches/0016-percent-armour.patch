+// Chaos (patch 0016): the share of a physical hit that this much armour takes (0 .. armorPercentMax / 100)
+double Creature::armorPercentReduction(int32_t armor)
+{
+	const int32_t k = std::max<int32_t>(1, g_config.getNumber(ConfigManager::ARMOR_PERCENT_CONSTANT));
+	const int32_t cap = std::max<int32_t>(0, std::min<int32_t>(100, g_config.getNumber(ConfigManager::ARMOR_PERCENT_MAX)));
+	if (armor <= 0) {
+		return 0.;
+	}
+	return std::min<double>(cap / 100., static_cast<double>(armor) / (armor + k));
+}
