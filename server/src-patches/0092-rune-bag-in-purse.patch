+int LuaScriptInterface::luaGameSetRuneBagContainer(lua_State* L)
+{
+	// Game.setRuneBagContainer(itemId)   Chaos (src-patch 0092, O509): the container type of the store's Rune Bag
+	// (data/scripts/chaos/pouches.lua). A player's search, count and removal by item type then also look into the Rune Bag
+	// that lies in the purse. 0 switches it off. The function's presence is the capability the Lua tests for.
+	uint16_t itemId = getNumber<uint16_t>(L, 1);
+	if (itemId != 0) {
+		const ItemType& it = Item::items[itemId];
