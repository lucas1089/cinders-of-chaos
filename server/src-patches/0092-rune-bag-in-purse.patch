diff --git a/src/chaosrunebag.h b/src/chaosrunebag.h
new file mode 100644
--- /dev/null
+++ b/src/chaosrunebag.h
@@ -0,0 +1,59 @@
+// Chaos (src-patch 0092, O509; server/README.md "Using a rune from the bag"): the Rune Bag in the purse.
+// The purse is the player's store inbox, outside inventory slots 1-10, so every walk by item type (the hotkey lookup,
+// the count and removal by type) never saw a rune in the Rune Bag that lies in it. This header is the one rule: the
+// items directly inside a container of the Rune Bag type that lies directly in the store inbox. Nothing else in the
+// purse is visited: not a plain item, not another bag, not a Loot Bag, not a pouch of another kind.
+// The Rune Bag's item id comes from Lua (Game.setRuneBagContainer, data/scripts/chaos/pouches.lua), 0 = off.
+// Pure and header-only (templates over any inbox / container / item with the engine's member names), so
+// server/tools/chaosrunebag_test.cpp runs it on fakes.
+#ifndef CHAOS_RUNEBAG_H
+#define CHAOS_RUNEBAG_H
+
+#include <cstdint>
+
+namespace ChaosRuneBag {
+
+inline uint16_t& bagType()
+{
+	static uint16_t id = 0;
+	return id;
+}
+
+inline void setBagType(uint16_t itemId)
+{
+	bagType() = itemId;
+}
+
+// Calls fn(item) for every item directly inside a Rune Bag lying directly in `inbox` (the store inbox), in the order of
+// the inbox, then of the bag. fn returns true to stop. Returns true when fn stopped the walk. A null inbox or no bag
+// type set visits nothing.
+template <class Inbox, class Fn>
+bool forEachItem(const Inbox* inbox, Fn&& fn)
+{
+	const uint16_t type = bagType();
+	if (inbox == nullptr || type == 0) {
+		return false;
+	}
+
+	for (auto* entry : inbox->getItemList()) {
+		if (entry == nullptr || entry->getID() != type) {
+			continue;
+		}
+
+		auto* bag = entry->getContainer();
+		if (bag == nullptr) {
+			continue;
+		}
+
+		for (auto* item : bag->getItemList()) {
+			if (item != nullptr && fn(item)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+} // namespace ChaosRuneBag
+
+#endif
