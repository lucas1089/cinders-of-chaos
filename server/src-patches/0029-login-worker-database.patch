-bool IOLoginData::loginserverAuthentication(const std::string& name, const std::string& password, Account& account)
+// Chaos (patch 0029): the login worker's own database connection, one per worker thread, opened at its first login
+// and closed when the thread ends. The worker no longer waits for the dispatcher's queries and transactions on the
+// engine's shared connection. The same Database class, so the same reconnect and retry rules. When it cannot connect,
+// the login uses the shared connection and the next try comes 30 s later.
+static Database& loginDatabase()
 {
-	Database& db = Database::getInstance();
+	thread_local std::unique_ptr<Database> own;
+	thread_local int64_t nextTry = 0;
+	if (!own) {
+		const int64_t now = OTSYS_TIME();
+		if (now >= nextTry) {
+			auto db = std::make_unique<Database>();
+			if (db->connect()) {
+				own = std::move(db);
+			} else {
+				nextTry = now + 30000;
+				std::cout << "[Warning - login worker] no database connection of its own, using the shared one" << std::endl;
+			}
+		}
+	}
+	return own ? *own : Database::getInstance();
+}
 
