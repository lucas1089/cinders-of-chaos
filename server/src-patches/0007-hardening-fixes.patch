+bool parseGlobalEventTime(const std::string& value, const std::string& name, int32_t& hour, int64_t& nextExecution)
+{
+	// vectorAtoi throws on an empty or non-numeric part ("", "12:", "noon"), which aborted the server at load
+	std::vector<int32_t> params;
+	try {
+		params = vectorAtoi(explodeString(value, ":"));
+	} catch (const std::exception&) {
+		params.clear();
+	}
+
+	if (params.empty() || params.size() > 3) {
+		std::cout << "[Error - GlobalEvent::configureEvent] Invalid time \"" << value << "\" for globalevent with name: " << name << std::endl;
+		return false;
+	}
+
+	hour = params[0];
+	if (hour < 0 || hour > 23) {
+		std::cout << "[Error - GlobalEvent::configureEvent] Invalid hour \"" << value << "\" for globalevent with name: " << name << std::endl;
+		return false;
+	}
+
+	int32_t min = params.size() > 1 ? params[1] : 0;
+	if (min < 0 || min > 59) {
+		std::cout << "[Error - GlobalEvent::configureEvent] Invalid minute \"" << value << "\" for globalevent with name: " << name << std::endl;
+		return false;
+	}
+
+	int32_t sec = params.size() > 2 ? params[2] : 0;
+	if (sec < 0 || sec > 59) {
+		std::cout << "[Error - GlobalEvent::configureEvent] Invalid second \"" << value << "\" for globalevent with name: " << name << std::endl;
+		return false;
+	}
+
+	time_t current_time = time(nullptr);
+	tm* timeinfo = localtime(&current_time);
+	if (!timeinfo) {
+		std::cout << "[Error - GlobalEvent::configureEvent] Cannot read the local time for globalevent with name: " << name << std::endl;
+		return false;
+	}
+
+	timeinfo->tm_hour = hour;
+	timeinfo->tm_min = min;
+	timeinfo->tm_sec = sec;
+
+	time_t difference = static_cast<time_t>(difftime(mktime(timeinfo), current_time));
+	if (difference < 0) {
+		difference += 86400;
+	}
+
+	nextExecution = current_time + difference;
+	return true;
+}
