@@ -0,0 +1,882 @@
+// Chaos (patch 0031): the login reads off the game loop, the pure parts (no engine types), tested by
+// server/tools/chaosprefetch_test.cpp (CI). server/README.md "Login reads off the game loop".
+//   * classify(): what an SQL statement does to the database: a read that may be prefetched (a plain SELECT of tables
+//     of this database, no function whose result depends on when or where it runs), a write and the table it writes,
+//     a transaction boundary, or something that cannot be told apart (any write anywhere).
+//   * makeTemplate() / expand(): the SELECTs one login ran, with the player id, the account id and the quoted
+//     character name taken out, so the login worker can run them for the next player.
+//   * Dependencies: which tables a write to a table changes as well (foreign keys ON DELETE / ON UPDATE CASCADE, SET
+//     NULL, SET DEFAULT; triggers), read from information_schema at startup.
+//   * WriteClock: a counter per table, raised after a write is committed. A prefetched result is only used while every
+//     table it read still has the counter it had before the read.
+//   * Templates: the SELECTs logins run, kept while logins keep running them.
+#ifndef FS_CHAOSPREFETCH_H
+#define FS_CHAOSPREFETCH_H
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace ChaosPrefetch {
+
+struct Token {
+	enum Type { Word, Ident, String, Number, Symbol };
+	Type type;
+	std::string text; // Word: lower case; Ident: without the backticks; others: as written
+	size_t begin, end; // [begin, end) in the statement
+};
+
+// false when the statement cannot be read safely: a comment (MySQL runs /*! ... */), an unterminated quote, a NUL or
+// the template marker byte. With maxTokens it stops after that many tokens (complete is then false).
+inline bool tokenize(const std::string& sql, std::vector<Token>& out, size_t maxTokens = static_cast<size_t>(-1),
+                     bool* complete = nullptr)
+{
+	out.clear();
+	if (complete) {
+		*complete = true;
+	}
+	const size_t n = sql.size();
+	size_t i = 0;
+	auto isWordChar = [](unsigned char c) {
+		return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '$' || c >= 0x80;
+	};
+	while (i < n) {
+		if (out.size() >= maxTokens) {
+			if (complete) {
+				*complete = false;
+			}
+			return true;
+		}
+		const unsigned char c = static_cast<unsigned char>(sql[i]);
+		if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v') {
+			++i;
+			continue;
+		}
+		if (c == 0 || c == 1) {
+			return false;
+		}
+		if (c == '#' || (c == '-' && i + 1 < n && sql[i + 1] == '-') || (c == '/' && i + 1 < n && sql[i + 1] == '*')) {
+			return false;
+		}
+		const size_t start = i;
+		if (c == '\'' || c == '"') {
+			++i;
+			bool closed = false;
+			while (i < n) {
+				if (sql[i] == '\\') {
+					i += 2;
+					continue;
+				}
+				if (sql[i] == static_cast<char>(c)) {
+					if (i + 1 < n && sql[i + 1] == static_cast<char>(c)) {
+						i += 2;
+						continue;
+					}
+					++i;
+					closed = true;
+					break;
+				}
+				++i;
+			}
+			if (!closed) {
+				return false;
+			}
+			out.push_back({Token::String, sql.substr(start, i - start), start, i});
+			continue;
+		}
+		if (c == '`') {
+			++i;
+			std::string name;
+			bool closed = false;
+			while (i < n) {
+				if (sql[i] == '`') {
+					if (i + 1 < n && sql[i + 1] == '`') {
+						name.push_back('`');
+						i += 2;
+						continue;
+					}
+					++i;
+					closed = true;
+					break;
+				}
+				name.push_back(sql[i++]);
+			}
+			if (!closed) {
+				return false;
+			}
+			out.push_back({Token::Ident, name, start, i});
+			continue;
+		}
+		if (isWordChar(c)) {
+			bool digits = true;
+			while (i < n && isWordChar(static_cast<unsigned char>(sql[i]))) {
+				if (sql[i] < '0' || sql[i] > '9') {
+					digits = false;
+				}
+				++i;
+			}
+			std::string text = sql.substr(start, i - start);
+			if (!digits) {
+				std::transform(text.begin(), text.end(), text.begin(), [](unsigned char ch) {
+					return static_cast<char>(ch >= 'A' && ch <= 'Z' ? ch - 'A' + 'a' : ch);
+				});
+			}
+			out.push_back({digits ? Token::Number : Token::Word, text, start, i});
+			continue;
+		}
+		++i;
+		out.push_back({Token::Symbol, std::string(1, static_cast<char>(c)), start, i});
+	}
+	return true;
+}
+
+// table names are compared in lower case: two names that differ only in case count as one table (more invalidation,
+// never less)
+inline std::string lower(std::string s)
+{
+	std::transform(s.begin(), s.end(), s.begin(), [](unsigned char ch) {
+		return static_cast<char>(ch >= 'A' && ch <= 'Z' ? ch - 'A' + 'a' : ch);
+	});
+	return s;
+}
+
+enum class Event { Insert, Update, Delete };
+
+struct Statement {
+	enum Kind {
+		None,     // changes no table (SHOW, SET NAMES, SAVEPOINT, ...)
+		Read,     // a SELECT
+		Write,    // writes `writes` (each with its event)
+		Begin,
+		Commit,
+		Rollback,
+		Unknown,  // may write anything
+	};
+	Kind kind = Unknown;
+	bool cacheable = false;                           // Read only: may be run early on another connection
+	std::vector<std::string> tables;                  // Read: the tables it reads (cacheable only)
+	std::vector<std::string> calls;                   // Read: the names written as calls, name( (cacheable only)
+	std::vector<std::pair<std::string, Event>> writes; // Write
+};
+
+inline bool isWord(const std::vector<Token>& t, size_t i, const char* w)
+{
+	return i < t.size() && t[i].type == Token::Word && t[i].text == w;
+}
+
+inline bool isSymbol(const std::vector<Token>& t, size_t i, char s)
+{
+	return i < t.size() && t[i].type == Token::Symbol && t[i].text[0] == s;
+}
+
+// words that end a table reference (so they are no alias)
+inline bool isClauseWord(const std::string& w)
+{
+	static const std::set<std::string> words = {
+		"where", "join", "inner", "left", "right", "outer", "cross", "natural", "straight_join", "on", "using",
+		"group", "order", "having", "limit", "union", "window", "procedure", "into", "for", "lock", "use",
+		"ignore", "force", "set", "values", "value", "select", "partition", "except", "intersect", "returning",
+	};
+	return words.count(w) != 0;
+}
+
+// a table name at t[i] (`name` or name; `db`.`name` sets qualified); i moves past it
+inline bool readTableName(const std::vector<Token>& t, size_t& i, std::string& name, bool& qualified)
+{
+	auto isName = [&](size_t k) {
+		return k < t.size() && (t[k].type == Token::Ident || (t[k].type == Token::Word && !isClauseWord(t[k].text)));
+	};
+	if (!isName(i)) {
+		return false;
+	}
+	name = lower(t[i].text);
+	qualified = false;
+	++i;
+	if (isSymbol(t, i, '.') && isName(i + 1)) {
+		name = lower(t[i + 1].text);
+		qualified = true;
+		i += 2;
+	}
+	return true;
+}
+
+// functions and words whose value depends on when, where or by whom the statement runs, or that have side effects
+inline bool isVolatileWord(const std::string& w)
+{
+	static const std::set<std::string> words = {
+		"now", "sysdate", "curdate", "curtime", "current_date", "current_time", "current_timestamp", "localtime",
+		"localtimestamp", "unix_timestamp", "utc_date", "utc_time", "utc_timestamp", "rand", "uuid", "uuid_short",
+		"last_insert_id", "found_rows", "row_count", "connection_id", "sleep", "get_lock", "release_lock",
+		"release_all_locks", "is_free_lock", "is_used_lock", "benchmark", "database", "schema", "user", "current_user",
+		"session_user", "system_user", "current_role", "version", "load_file", "master_pos_wait", "master_gtid_wait",
+		"nextval", "lastval", "setval", "into", "lock", "share", "procedure", "sql_calc_found_rows",
+		"information_schema", "performance_schema", "mysql", "sys",
+	};
+	return words.count(w) != 0;
+}
+
+inline void classifyRead(const std::vector<Token>& t, Statement& st)
+{
+	st.kind = Statement::Read;
+	st.cacheable = false;
+	std::set<std::string> tables;
+	for (size_t i = 0; i < t.size(); ++i) {
+		const Token& tok = t[i];
+		if (tok.type == Token::Symbol && ((tok.text[0] == ';' && i + 1 != t.size()) || tok.text[0] == '@' || tok.text[0] == '?')) {
+			return; // more than one statement, user variables, placeholders
+		}
+		if (tok.type != Token::Word) {
+			continue;
+		}
+		if (isVolatileWord(tok.text)) {
+			return;
+		}
+		if (isSymbol(t, i + 1, '(')) {
+			st.calls.push_back(tok.text); // a stored function of the database may write: Dependencies::callsFunction
+		}
+		if (tok.text == "for" && isWord(t, i + 1, "update")) {
+			return;
+		}
+		if (tok.text != "from" && tok.text != "join") {
+			continue;
+		}
+		// a table reference list: name [AS] [alias] [, name [AS] [alias] ...]; a derived table "(SELECT ...)" is
+		// skipped here (its own FROM is read when the loop gets there)
+		size_t k = i + 1;
+		while (true) {
+			if (isSymbol(t, k, '(')) {
+				break;
+			}
+			std::string name;
+			bool qualified = false;
+			if (!readTableName(t, k, name, qualified) || qualified) {
+				return; // FROM a number (SUBSTRING(x FROM 2)), another database's table: not prefetched
+			}
+			tables.insert(name);
+			if (isWord(t, k, "as")) {
+				++k;
+			}
+			if (k < t.size() && (t[k].type == Token::Ident || (t[k].type == Token::Word && !isClauseWord(t[k].text)))) {
+				++k; // alias
+			}
+			if (tok.text == "from" && isSymbol(t, k, ',')) {
+				++k;
+				continue;
+			}
+			break;
+		}
+	}
+	if (tables.empty()) {
+		return;
+	}
+	st.cacheable = true;
+	st.tables.assign(tables.begin(), tables.end());
+}
+
+// complete: t holds the whole statement (a read is then checked for prefetching); otherwise only its first tokens,
+// which is enough to tell what a write writes
+inline Statement classifyTokens(const std::vector<Token>& t, bool complete)
+{
+	Statement st;
+	size_t i = 0;
+	while (isSymbol(t, i, '(')) {
+		++i; // "(SELECT ...) UNION (SELECT ...)"
+	}
+	if (i >= t.size()) {
+		st.kind = Statement::None;
+		return st;
+	}
+	if (t[i].type != Token::Word) {
+		st.kind = Statement::Unknown;
+		return st;
+	}
+	const std::string& w = t[i].text;
+	auto skipWords = [&](size_t k, std::initializer_list<const char*> words) {
+		bool moved = true;
+		while (moved) {
+			moved = false;
+			for (const char* word : words) {
+				if (isWord(t, k, word)) {
+					++k;
+					moved = true;
+				}
+			}
+		}
+		return k;
+	};
+	if (w == "select") {
+		if (complete) {
+			classifyRead(t, st);
+		} else {
+			st.kind = Statement::Read;
+		}
+		return st;
+	}
+	if (w == "show" || w == "describe" || w == "desc" || w == "explain" || w == "savepoint" || w == "release" ||
+	    w == "help" || w == "do") {
+		st.kind = (w == "do") ? Statement::Unknown : Statement::None;
+		return st;
+	}
+	if (w == "begin" || (w == "start" && isWord(t, i + 1, "transaction"))) {
+		st.kind = Statement::Begin;
+		return st;
+	}
+	if (w == "commit") {
+		st.kind = Statement::Commit;
+		return st;
+	}
+	if (w == "rollback") {
+		// ROLLBACK TO SAVEPOINT keeps the transaction going
+		st.kind = isWord(t, i + 1, "to") ? Statement::None : Statement::Rollback;
+		return st;
+	}
+	if (w == "set") {
+		// SET autocommit = 0 starts a transaction that the next COMMIT ends; SET autocommit = 1 commits
+		for (size_t k = i + 1; k < t.size(); ++k) {
+			if (t[k].type == Token::Word && t[k].text == "autocommit") {
+				size_t v = k + 1;
+				if (isSymbol(t, v, '=')) {
+					++v;
+				}
+				if (v < t.size() && (t[v].text == "0" || t[v].text == "off" || t[v].text == "false")) {
+					st.kind = Statement::Begin;
+				} else {
+					st.kind = Statement::Commit;
+				}
+				return st;
+			}
+		}
+		st.kind = Statement::None;
+		return st;
+	}
+	// the client library sends one statement per call (no CLIENT_MULTI_STATEMENTS), so what follows the head of a
+	// write cannot write another table (triggers and foreign keys: Dependencies)
+	std::string name;
+	bool qualified = false;
+	if (w == "insert" || w == "replace") {
+		size_t k = skipWords(i + 1, {"low_priority", "delayed", "high_priority", "ignore", "into"});
+		if (!readTableName(t, k, name, qualified)) {
+			st.kind = Statement::Unknown;
+			return st;
+		}
+		st.kind = Statement::Write;
+		st.writes.emplace_back(name, Event::Insert);
+		st.writes.emplace_back(name, Event::Update); // ON DUPLICATE KEY UPDATE (the tail is not read)
+		if (w == "replace") {
+			st.writes.emplace_back(name, Event::Delete);
+		}
+		return st;
+	}
+	if (w == "update") {
+		size_t k = skipWords(i + 1, {"low_priority", "ignore"});
+		if (!readTableName(t, k, name, qualified)) {
+			st.kind = Statement::Unknown;
+			return st;
+		}
+		if (isWord(t, k, "as")) {
+			++k;
+		}
+		if (k < t.size() && !isWord(t, k, "set") &&
+		    (t[k].type == Token::Ident || (t[k].type == Token::Word && !isClauseWord(t[k].text)))) {
+			++k; // alias
+		}
+		if (!isWord(t, k, "set")) {
+			st.kind = Statement::Unknown; // UPDATE a JOIN b / UPDATE a, b: more than one table
+			return st;
+		}
+		st.kind = Statement::Write;
+		st.writes.emplace_back(name, Event::Update);
+		return st;
+	}
+	if (w == "delete") {
+		size_t k = skipWords(i + 1, {"low_priority", "quick", "ignore"});
+		if (!isWord(t, k, "from")) {
+			st.kind = Statement::Unknown; // DELETE a FROM a JOIN b
+			return st;
+		}
+		++k;
+		if (!readTableName(t, k, name, qualified)) {
+			st.kind = Statement::Unknown;
+			return st;
+		}
+		if (k >= t.size() ? !complete : !(isWord(t, k, "where") || isWord(t, k, "order") || isWord(t, k, "limit") ||
+		                                  isWord(t, k, "returning") || isSymbol(t, k, ';'))) {
+			st.kind = Statement::Unknown; // DELETE FROM a, b USING ... / an alias with a join
+			return st;
+		}
+		st.kind = Statement::Write;
+		st.writes.emplace_back(name, Event::Delete);
+		return st;
+	}
+	if (w == "truncate") {
+		size_t k = skipWords(i + 1, {"table"});
+		if (!readTableName(t, k, name, qualified)) {
+			st.kind = Statement::Unknown;
+			return st;
+		}
+		st.kind = Statement::Write;
+		st.writes.emplace_back(name, Event::Delete);
+		return st;
+	}
+	st.kind = Statement::Unknown; // CREATE, ALTER, DROP, RENAME, CALL, LOCK TABLES, LOAD DATA, ...
+	return st;
+}
+
+inline Statement classify(const std::string& sql)
+{
+	std::vector<Token> t;
+	if (!tokenize(sql, t)) {
+		return Statement();
+	}
+	return classifyTokens(t, true);
+}
+
+// for the write clock: only the head of the statement is read (a player save's INSERT can be long)
+inline Statement classifyHead(const std::string& sql)
+{
+	std::vector<Token> t;
+	bool complete = true;
+	if (!tokenize(sql, t, 24, &complete)) {
+		return Statement();
+	}
+	return classifyTokens(t, complete);
+}
+
+// --- templates of the login's SELECTs ---
+
+// markers: "\x01G" player id, "\x01A" account id, "\x01N" the quoted character name (tokenize() refuses the byte 1,
+// so a statement never contains one by itself)
+inline bool makeTemplate(const std::string& sql, uint32_t playerId, uint32_t accountId, const std::string& nameLiteral,
+                         std::string& out)
+{
+	if (playerId == 0 || accountId == 0 || playerId == accountId) {
+		return false; // the same number for both: which one a query meant cannot be told
+	}
+	std::vector<Token> t;
+	if (!tokenize(sql, t)) {
+		return false;
+	}
+	const std::string pid = std::to_string(playerId);
+	const std::string aid = std::to_string(accountId);
+	out.clear();
+	size_t copied = 0;
+	for (size_t i = 0; i < t.size(); ++i) {
+		const char* marker = nullptr;
+		if (t[i].type == Token::Number && !isSymbol(t, i + 1, '.') && !(i > 0 && isSymbol(t, i - 1, '.'))) {
+			if (t[i].text == pid) {
+				marker = "\x01" "G";
+			} else if (t[i].text == aid) {
+				marker = "\x01" "A";
+			}
+		} else if (t[i].type == Token::String && !nameLiteral.empty() && t[i].text == nameLiteral) {
+			marker = "\x01" "N";
+		}
+		if (marker) {
+			out.append(sql, copied, t[i].begin - copied);
+			out.append(marker);
+			copied = t[i].end;
+		}
+	}
+	out.append(sql, copied, std::string::npos);
+	return true;
+}
+
+inline std::string expand(const std::string& tmpl, uint32_t playerId, uint32_t accountId, const std::string& nameLiteral)
+{
+	std::string out;
+	out.reserve(tmpl.size() + 16);
+	for (size_t i = 0; i < tmpl.size(); ++i) {
+		if (tmpl[i] == '\x01' && i + 1 < tmpl.size()) {
+			const char m = tmpl[++i];
+			if (m == 'G') {
+				out.append(std::to_string(playerId));
+			} else if (m == 'A') {
+				out.append(std::to_string(accountId));
+			} else if (m == 'N') {
+				out.append(nameLiteral);
+			}
+			continue;
+		}
+		out.push_back(tmpl[i]);
+	}
+	return out;
+}
+
+// --- which tables a write changes ---
+
+class Dependencies
+{
+	public:
+		enum class Rule { None, Cascade, SetNull };
+
+		static Rule rule(std::string r)
+		{
+			r = lower(r);
+			if (r == "cascade") {
+				return Rule::Cascade;
+			}
+			if (r == "set null" || r == "set default") {
+				return Rule::SetNull;
+			}
+			return Rule::None; // RESTRICT, NO ACTION
+		}
+
+		// a foreign key of `child` to `parent`
+		void addForeignKey(const std::string& child, const std::string& parent, const std::string& updateRule,
+		                   const std::string& deleteRule)
+		{
+			ForeignKey fk;
+			fk.child = lower(child);
+			fk.onUpdate = rule(updateRule);
+			fk.onDelete = rule(deleteRule);
+			if (fk.onUpdate != Rule::None || fk.onDelete != Rule::None) {
+				foreignKeys[lower(parent)].push_back(fk);
+			}
+		}
+
+		// a trigger on `table` for INSERT / UPDATE / DELETE; the tables its body writes are read from the body, and
+		// a body that cannot be read counts as a write to every table
+		void addTrigger(const std::string& table, const std::string& event, const std::string& body)
+		{
+			const Event ev = parseEvent(event);
+			std::vector<std::pair<std::string, Event>>& targets = triggers[key(lower(table), ev)];
+			std::vector<Token> t;
+			if (!tokenize(body, t)) {
+				everything.insert(key(lower(table), ev));
+				return;
+			}
+			for (size_t i = 0; i < t.size(); ++i) {
+				if (t[i].type != Token::Word) {
+					continue;
+				}
+				const std::string& w = t[i].text;
+				std::string name;
+				bool qualified = false;
+				size_t k = i + 1;
+				if (w == "insert" || w == "replace") {
+					while (isWord(t, k, "low_priority") || isWord(t, k, "delayed") || isWord(t, k, "high_priority") ||
+					       isWord(t, k, "ignore") || isWord(t, k, "into")) {
+						++k;
+					}
+					if (readTableName(t, k, name, qualified)) {
+						targets.emplace_back(name, Event::Insert);
+						if (w == "replace") {
+							targets.emplace_back(name, Event::Delete);
+						}
+						targets.emplace_back(name, Event::Update); // ON DUPLICATE KEY UPDATE
+					} else {
+						everything.insert(key(lower(table), ev));
+					}
+				} else if (w == "update") {
+					while (isWord(t, k, "low_priority") || isWord(t, k, "ignore")) {
+						++k;
+					}
+					if (readTableName(t, k, name, qualified)) {
+						targets.emplace_back(name, Event::Update);
+						if (!isWord(t, k, "set") && !isWord(t, k + 1, "set") && !isWord(t, k + 2, "set")) {
+							everything.insert(key(lower(table), ev)); // more than one table
+						}
+					} else {
+						everything.insert(key(lower(table), ev));
+					}
+				} else if (w == "delete") {
+					while (isWord(t, k, "low_priority") || isWord(t, k, "quick") || isWord(t, k, "ignore")) {
+						++k;
+					}
+					if (isWord(t, k, "from") && (++k, readTableName(t, k, name, qualified))) {
+						targets.emplace_back(name, Event::Delete);
+					} else {
+						everything.insert(key(lower(table), ev));
+					}
+				} else if (w == "call" || w == "truncate" || w == "drop" || w == "alter" || w == "create" ||
+				           w == "rename" || w == "load" || w == "execute" || w == "prepare") {
+					everything.insert(key(lower(table), ev));
+				}
+			}
+		}
+
+		// a stored function of the database (information_schema.ROUTINES): a SELECT that calls one may write, so it is
+		// never run early
+		void addFunction(const std::string& name)
+		{
+			functions.insert(lower(name));
+		}
+
+		bool callsFunction(const Statement& st) const
+		{
+			for (const std::string& c : st.calls) {
+				if (functions.count(c)) {
+					return true;
+				}
+			}
+			return false;
+		}
+
+		// every table the writes change, `all` when they may change any table
+		void affected(const std::vector<std::pair<std::string, Event>>& writes, std::set<std::string>& tables, bool& all) const
+		{
+			std::set<std::string> seen;
+			std::vector<std::pair<std::string, Event>> work(writes.begin(), writes.end());
+			while (!work.empty()) {
+				const auto item = work.back();
+				work.pop_back();
+				const std::string table = lower(item.first);
+				if (!seen.insert(key(table, item.second)).second) {
+					continue;
+				}
+				tables.insert(table);
+				if (everything.count(key(table, item.second))) {
+					all = true;
+				}
+				auto trig = triggers.find(key(table, item.second));
+				if (trig != triggers.end()) {
+					work.insert(work.end(), trig->second.begin(), trig->second.end());
+				}
+				if (item.second == Event::Insert) {
+					continue;
+				}
+				auto fks = foreignKeys.find(table);
+				if (fks == foreignKeys.end()) {
+					continue;
+				}
+				for (const ForeignKey& fk : fks->second) {
+					const Rule r = (item.second == Event::Delete) ? fk.onDelete : fk.onUpdate;
+					if (r == Rule::Cascade) {
+						work.emplace_back(fk.child, item.second);
+					} else if (r == Rule::SetNull) {
+						work.emplace_back(fk.child, Event::Update);
+					}
+				}
+			}
+		}
+
+	private:
+		struct ForeignKey {
+			std::string child;
+			Rule onUpdate = Rule::None;
+			Rule onDelete = Rule::None;
+		};
+
+		static Event parseEvent(const std::string& e)
+		{
+			const std::string l = lower(e);
+			if (l == "insert") {
+				return Event::Insert;
+			}
+			if (l == "update") {
+				return Event::Update;
+			}
+			return Event::Delete;
+		}
+
+		static std::string key(const std::string& table, Event e)
+		{
+			return table + (e == Event::Insert ? "\x01" "i" : e == Event::Update ? "\x01" "u" : "\x01" "d");
+		}
+
+		std::map<std::string, std::vector<ForeignKey>> foreignKeys; // parent -> its children
+		std::map<std::string, std::vector<std::pair<std::string, Event>>> triggers;
+		std::set<std::string> everything;
+		std::set<std::string> functions;
+};
+
+// --- write clock ---
+
+struct Snapshot {
+	uint64_t epoch = 0;
+	std::vector<uint64_t> counters; // in the order of the tables given to snapshot()
+};
+
+class WriteClock
+{
+	public:
+		// after the write is committed (autocommit: when the statement returned; in a transaction: at the COMMIT)
+		void bump(const std::set<std::string>& tables, bool all)
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			if (all) {
+				++epoch;
+			}
+			for (const std::string& t : tables) {
+				++counters[t];
+			}
+		}
+
+		// before the early read
+		Snapshot snapshot(const std::vector<std::string>& tables) const
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			Snapshot s;
+			s.epoch = epoch;
+			s.counters.reserve(tables.size());
+			for (const std::string& t : tables) {
+				auto it = counters.find(t);
+				s.counters.push_back(it == counters.end() ? 0 : it->second);
+			}
+			return s;
+		}
+
+		// when the result would be used: no write committed to any of the tables since the snapshot
+		bool unchanged(const std::vector<std::string>& tables, const Snapshot& s) const
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			if (epoch != s.epoch || s.counters.size() != tables.size()) {
+				return false;
+			}
+			for (size_t i = 0; i < tables.size(); ++i) {
+				auto it = counters.find(tables[i]);
+				if ((it == counters.end() ? 0 : it->second) != s.counters[i]) {
+					return false;
+				}
+			}
+			return true;
+		}
+
+	private:
+		mutable std::mutex lock;
+		uint64_t epoch = 0;
+		std::unordered_map<std::string, uint64_t> counters;
+};
+
+// per connection: the tables written inside the open transaction, raised at its end
+struct TxnState {
+	bool active = false;
+	bool all = false;
+	std::set<std::string> tables;
+};
+
+// what a statement that has run means for the clock; deps may be null (before startup read them: every write counts
+// as a write to every table)
+inline void statementDone(WriteClock& clock, const Dependencies* deps, TxnState& txn, const std::string& sql)
+{
+	const Statement st = classifyHead(sql);
+	auto flush = [&]() {
+		if (txn.all || !txn.tables.empty()) {
+			clock.bump(txn.tables, txn.all);
+		}
+		txn = TxnState();
+	};
+	switch (st.kind) {
+		case Statement::None:
+		case Statement::Read:
+			return;
+		case Statement::Begin:
+			flush(); // BEGIN commits an open transaction
+			txn.active = true;
+			return;
+		case Statement::Commit:
+		case Statement::Rollback:
+			flush();
+			return;
+		case Statement::Write: {
+			std::set<std::string> tables;
+			bool all = (deps == nullptr);
+			if (deps) {
+				deps->affected(st.writes, tables, all);
+			}
+			if (txn.active) {
+				txn.tables.insert(tables.begin(), tables.end());
+				txn.all = txn.all || all;
+			} else {
+				clock.bump(tables, all);
+			}
+			return;
+		}
+		case Statement::Unknown:
+		default:
+			// DDL commits an open transaction; anything else unknown may write anything
+			if (txn.active) {
+				txn.all = true;
+				flush();
+			}
+			clock.bump({}, true);
+			return;
+	}
+}
+
+// --- the templates logins ran ---
+
+class Templates
+{
+	public:
+		struct Entry {
+			std::string text;
+			std::vector<std::string> tables;
+			uint32_t seen = 0;   // logins that ran it
+			uint32_t unseen = 0; // prefetches since a login last ran it
+		};
+
+		static constexpr size_t MAX_TEMPLATES = 512;
+		static constexpr size_t MAX_PER_LOGIN = 256;
+		// dropped after this many prefetches that no login used: soon when only one login ever ran it (a time or
+		// a day in the text), later when it was run often (a query of one class or of a rare state)
+		static constexpr uint32_t DROP_NEW = 2;
+		static constexpr uint32_t DROP_KNOWN = 50;
+
+		void learn(const std::string& text, const std::vector<std::string>& tables)
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			auto it = entries.find(text);
+			if (it != entries.end()) {
+				++it->second.seen;
+				it->second.unseen = 0;
+				return;
+			}
+			if (entries.size() >= MAX_TEMPLATES) {
+				return;
+			}
+			Entry e;
+			e.text = text;
+			e.tables = tables;
+			e.seen = 1;
+			entries.emplace(text, std::move(e));
+		}
+
+		// the templates to run for one login, the most used first; counts the prefetch and drops the ones no login
+		// ran for too long
+		std::vector<Entry> take(size_t max = MAX_PER_LOGIN)
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			std::vector<Entry> out;
+			for (auto it = entries.begin(); it != entries.end();) {
+				Entry& e = it->second;
+				if (e.unseen >= (e.seen >= 2 ? DROP_KNOWN : DROP_NEW)) {
+					it = entries.erase(it);
+					continue;
+				}
+				out.push_back(e);
+				++it;
+			}
+			std::sort(out.begin(), out.end(), [](const Entry& a, const Entry& b) {
+				return a.seen != b.seen ? a.seen > b.seen : a.text < b.text;
+			});
+			if (out.size() > max) {
+				out.resize(max);
+			}
+			for (const Entry& e : out) {
+				++entries[e.text].unseen;
+			}
+			return out;
+		}
+
+		size_t size() const
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			return entries.size();
+		}
+
+	private:
+		mutable std::mutex lock;
+		std::map<std::string, Entry> entries;
+};
