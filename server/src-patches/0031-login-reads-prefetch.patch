diff --git a/src/loginprefetch.cpp b/src/loginprefetch.cpp
new file mode 100644
index 0000000..c3c082c
--- /dev/null
+++ b/src/loginprefetch.cpp
@@ -0,0 +1,258 @@
+// Chaos (patch 0031): the login reads off the game loop. See loginprefetch.h and server/README.md "Login reads off
+// the game loop".
+
+#include "otpch.h"
+
+#include "loginprefetch.h"
+
+#include "configmanager.h"
+#include "database.h"
+#include "tasks.h"
+#include "tools.h"
+
+#include <fmt/format.h>
+
+extern ConfigManager g_config;
+
+namespace LoginPrefetch {
+
+struct Entry {
+	std::vector<std::string> tables;
+	ChaosPrefetch::Snapshot snapshot; // taken before the read
+	std::shared_ptr<const DBRows> rows;
+};
+
+struct Batch {
+	uint32_t playerId = 0;
+	int64_t createdMs = 0;
+	std::unordered_map<std::string, Entry> entries; // by the exact statement text
+};
+
+namespace {
+
+// a batch older than this is not used (the dispatcher was that far behind; the reads are redone on the game loop)
+constexpr int64_t MAX_AGE_MS = 5000;
+// one result set of a login read; a larger one is read on the game loop
+constexpr size_t MAX_ROWS_BYTES = 256 * 1024;
+
+std::atomic<bool> enabled{false};
+ChaosPrefetch::WriteClock writeClock;
+ChaosPrefetch::Templates templates;
+std::shared_ptr<const ChaosPrefetch::Dependencies> dependencies; // std::atomic_load / atomic_store
+
+// thread_local: a login worker that falls back to the shared connection calls storeQuery on it too
+thread_local std::shared_ptr<Batch> currentBatch; // set on the dispatcher
+
+struct LoginContext {
+	bool active = false;
+	uint32_t playerId = 0;
+	uint32_t accountId = 0;
+	std::string nameLiteral;
+	Batch* batch = nullptr;
+};
+thread_local LoginContext login; // set on the dispatcher
+
+const std::string& column(const DBRows& rows, const DBRows::Row& row, const std::string& name)
+{
+	static const std::string none;
+	auto it = rows.names.find(name);
+	return it == rows.names.end() ? none : row.values[it->second];
+}
+
+// the foreign keys and triggers of the game database; nullptr when information_schema cannot be read
+std::shared_ptr<const ChaosPrefetch::Dependencies> readDependencies(Database& db)
+{
+	auto deps = std::make_shared<ChaosPrefetch::Dependencies>();
+	std::shared_ptr<DBRows> rows;
+	if (!db.storeRows("SELECT `TABLE_NAME`, `REFERENCED_TABLE_NAME`, `UPDATE_RULE`, `DELETE_RULE` FROM "
+	                  "`information_schema`.`REFERENTIAL_CONSTRAINTS` WHERE `CONSTRAINT_SCHEMA` = DATABASE()",
+	                  4 * 1024 * 1024, rows)) {
+		return nullptr;
+	}
+	for (const DBRows::Row& row : rows->rows) {
+		deps->addForeignKey(column(*rows, row, "TABLE_NAME"), column(*rows, row, "REFERENCED_TABLE_NAME"),
+		                    column(*rows, row, "UPDATE_RULE"), column(*rows, row, "DELETE_RULE"));
+	}
+	if (!db.storeRows("SELECT `EVENT_OBJECT_TABLE`, `EVENT_MANIPULATION`, `ACTION_STATEMENT` FROM "
+	                  "`information_schema`.`TRIGGERS` WHERE `TRIGGER_SCHEMA` = DATABASE()",
+	                  4 * 1024 * 1024, rows)) {
+		return nullptr;
+	}
+	for (const DBRows::Row& row : rows->rows) {
+		deps->addTrigger(column(*rows, row, "EVENT_OBJECT_TABLE"), column(*rows, row, "EVENT_MANIPULATION"),
+		                 column(*rows, row, "ACTION_STATEMENT"));
+	}
+	if (!db.storeRows("SELECT `ROUTINE_NAME` FROM `information_schema`.`ROUTINES` WHERE `ROUTINE_SCHEMA` = DATABASE() "
+	                  "AND `ROUTINE_TYPE` = 'FUNCTION'", 1024 * 1024, rows)) {
+		return nullptr;
+	}
+	for (const DBRows::Row& row : rows->rows) {
+		deps->addFunction(column(*rows, row, "ROUTINE_NAME"));
+	}
+	return deps;
+}
+
+bool isSchemaChange(const std::string& query)
+{
+	std::vector<ChaosPrefetch::Token> t;
+	if (!ChaosPrefetch::tokenize(query, t, 1) || t.empty() || t[0].type != ChaosPrefetch::Token::Word) {
+		return false;
+	}
+	const std::string& w = t[0].text;
+	return w == "create" || w == "alter" || w == "drop" || w == "rename";
+}
+
+} // namespace
+
+void init(Database& db)
+{
+	if (!g_config.getBoolean(ConfigManager::LOGIN_PREFETCH)) {
+		std::cout << ">> Login reads: on the game loop (loginPrefetch = false)" << std::endl;
+		return;
+	}
+	auto deps = readDependencies(db);
+	if (!deps) {
+		std::cout << "[Warning - LoginPrefetch] cannot read the foreign keys and triggers of the database "
+		             "(information_schema): login reads stay on the game loop" << std::endl;
+		return;
+	}
+	std::atomic_store(&dependencies, deps);
+	enabled = true;
+	std::cout << ">> Login reads: run on the login worker (loginPrefetch)" << std::endl;
+}
+
+void statementDone(Database& self, ChaosPrefetch::TxnState& txn, const std::string& query)
+{
+	if (!enabled) {
+		return;
+	}
+	if (isSchemaChange(query)) {
+		// a table created or altered now may bring a foreign key or a trigger: read them again before the clock moves
+		// (statementDone then raises every table), so no read taken after it misses a cascade
+		if (auto deps = readDependencies(self)) {
+			std::atomic_store(&dependencies, deps);
+		}
+	}
+	auto deps = std::atomic_load(&dependencies);
+	ChaosPrefetch::statementDone(writeClock, deps.get(), txn, query);
+}
+
+void transactionEnd(ChaosPrefetch::TxnState& txn)
+{
+	if (!enabled) {
+		return;
+	}
+	if (txn.all || !txn.tables.empty()) {
+		writeClock.bump(txn.tables, txn.all);
+	}
+	txn = ChaosPrefetch::TxnState();
+}
+
+std::shared_ptr<Batch> fetch(Database& db, uint32_t accountId, const std::string& characterName)
+{
+	if (!enabled || accountId == 0 || &db == &Database::getInstance()) {
+		return nullptr; // off, or the worker has no connection of its own: the game loop's connection stays free
+	}
+	std::vector<ChaosPrefetch::Templates::Entry> list = templates.take();
+	if (list.empty()) {
+		return nullptr;
+	}
+	const std::string nameLiteral = db.escapeString(characterName);
+	std::shared_ptr<DBRows> idRows;
+	if (!db.storeRows(fmt::format("SELECT `id` FROM `players` WHERE `name` = {:s} AND `account_id` = {:d}", nameLiteral,
+	                              accountId), 1024, idRows) || idRows->rows.empty()) {
+		return nullptr;
+	}
+	const uint32_t playerId = static_cast<uint32_t>(std::strtoul(idRows->rows[0].values[0].c_str(), nullptr, 10));
+	if (playerId == 0) {
+		return nullptr;
+	}
+
+	auto batch = std::make_shared<Batch>();
+	batch->playerId = playerId;
+	batch->createdMs = OTSYS_TIME();
+	for (const ChaosPrefetch::Templates::Entry& t : list) {
+		std::string query = ChaosPrefetch::expand(t.text, playerId, accountId, nameLiteral);
+		if (batch->entries.count(query)) {
+			continue;
+		}
+		Entry entry;
+		entry.tables = t.tables;
+		entry.snapshot = writeClock.snapshot(entry.tables); // before the read: a write after it makes the entry stale
+		std::shared_ptr<DBRows> rows;
+		if (!db.storeRows(query, MAX_ROWS_BYTES, rows)) {
+			continue; // an error or too large: read on the game loop as before
+		}
+		entry.rows = std::move(rows);
+		batch->entries.emplace(std::move(query), std::move(entry));
+	}
+	return batch;
+}
+
+BatchScope::BatchScope(std::shared_ptr<Batch> batch)
+{
+	currentBatch = std::move(batch);
+}
+
+BatchScope::~BatchScope()
+{
+	currentBatch.reset();
+}
+
+LoginScope::LoginScope(uint32_t playerId, uint32_t accountId, const std::string& name)
+{
+	if (!enabled) {
+		return;
+	}
+	login.active = true;
+	login.playerId = playerId;
+	login.accountId = accountId;
+	login.nameLiteral = Database::getInstance().escapeString(name);
+	login.batch = nullptr;
+	if (currentBatch && currentBatch->playerId == playerId && OTSYS_TIME() - currentBatch->createdMs <= MAX_AGE_MS) {
+		login.batch = currentBatch.get();
+	}
+}
+
+LoginScope::~LoginScope()
+{
+	login = LoginContext();
+}
+
+bool inLogin()
+{
+	return login.active;
+}
+
+bool serve(const std::string& query, DBResult_ptr& out)
+{
+	if (!login.active) {
+		return false;
+	}
+	const ChaosPrefetch::Statement st = ChaosPrefetch::classify(query);
+	if (!st.cacheable) {
+		return false;
+	}
+	auto deps = std::atomic_load(&dependencies);
+	if (!deps || deps->callsFunction(st)) {
+		return false;
+	}
+	std::string text;
+	if (ChaosPrefetch::makeTemplate(query, login.playerId, login.accountId, login.nameLiteral, text)) {
+		templates.learn(text, st.tables);
+	}
+	if (!login.batch) {
+		return false;
+	}
+	auto it = login.batch->entries.find(query);
+	if (it == login.batch->entries.end() || !writeClock.unchanged(it->second.tables, it->second.snapshot)) {
+		return false;
+	}
+	out = it->second.rows->rows.empty() ? nullptr : std::make_shared<DBResult>(it->second.rows);
+	if (TaskTiming::current) {
+		++TaskTiming::current->dbPrefetched;
+	}
+	return true;
+}
+
+} // namespace LoginPrefetch
diff --git a/src/loginprefetch.h b/src/loginprefetch.h
new file mode 100644
index 0000000..dd6abfa
--- /dev/null
+++ b/src/loginprefetch.h
@@ -0,0 +1,62 @@
+// Chaos (patch 0031): the login reads off the game loop. server/README.md "Login reads off the game loop".
+// The login scripts (onLogin of every Chaos system and of the base) read 60-80 rows sets per login with
+// db.storeQuery on the game loop. The login worker (patch 0014, its own connection since 0029) now runs those SELECTs
+// right after the password check, and while the login scripts run, db.storeQuery answers a statement with exactly the
+// same text from those rows, as long as no write was committed to a table it reads since the early read. Anything
+// else (a different text, a table written meanwhile, a write, a query outside the login scripts) goes to the database
+// as before. Which SELECTs to run is learnt from the logins themselves (chaosprefetch.h Templates), so no script
+// changes. config.lua loginPrefetch = true (read at startup).
+#ifndef FS_LOGINPREFETCH_H
+#define FS_LOGINPREFETCH_H
+
+#include "chaosprefetch.h"
+
+class Database;
+class DBResult;
+struct DBRows;
+using DBResult_ptr = std::shared_ptr<DBResult>;
+
+namespace LoginPrefetch {
+
+struct Batch;
+
+// startup, after the database connection: reads loginPrefetch and the foreign keys and triggers of the database
+void init(Database& db);
+
+// every connection, after each statement (called with the connection's lock held)
+void statementDone(Database& self, ChaosPrefetch::TxnState& txn, const std::string& query);
+// the end of a DBTransaction (COMMIT / ROLLBACK through the client library)
+void transactionEnd(ChaosPrefetch::TxnState& txn);
+
+// login worker thread, after a successful game login check: runs the learnt SELECTs for this character on the
+// worker's own connection (nothing when the worker uses the shared connection)
+std::shared_ptr<Batch> fetch(Database& db, uint32_t accountId, const std::string& characterName);
+
+// dispatcher: the rows of the login whose answer task runs now (around the login callback)
+class BatchScope
+{
+	public:
+		explicit BatchScope(std::shared_ptr<Batch> batch);
+		~BatchScope();
+		BatchScope(const BatchScope&) = delete;
+		BatchScope& operator=(const BatchScope&) = delete;
+};
+
+// dispatcher: around the onLogin scripts of one player; learns their SELECTs and answers them from the batch
+class LoginScope
+{
+	public:
+		LoginScope(uint32_t playerId, uint32_t accountId, const std::string& name);
+		~LoginScope();
+		LoginScope(const LoginScope&) = delete;
+		LoginScope& operator=(const LoginScope&) = delete;
+};
+
+bool inLogin();
+// Database::storeQuery on the main connection while inLogin(): true when answered from the batch (out may be
+// nullptr: an empty result, as storeQuery gives it)
+bool serve(const std::string& query, DBResult_ptr& out);
+
+} // namespace LoginPrefetch
+
+#endif
