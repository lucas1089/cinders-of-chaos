+bool Database::storeRows(const std::string& query, size_t maxBytes, std::shared_ptr<DBRows>& out)
+{
+	out.reset();
+	std::lock_guard<std::recursive_mutex> guard(databaseLock);
+	if (mysql_real_query(handle, query.c_str(), query.length()) != 0) {
+		return false;
+	}
+	MYSQL_RES* res = mysql_store_result(handle);
+	if (!res) {
+		return false;
+	}
+	auto rows = std::make_shared<DBRows>();
+	const unsigned int count = mysql_num_fields(res);
+	MYSQL_FIELD* fields = mysql_fetch_fields(res);
+	for (unsigned int i = 0; i < count; ++i) {
+		rows->names[fields[i].name] = i;
+	}
+	size_t bytes = 0;
+	bool tooLarge = false;
+	while (MYSQL_ROW r = mysql_fetch_row(res)) {
+		const unsigned long* lengths = mysql_fetch_lengths(res);
+		DBRows::Row row;
+		row.values.resize(count);
+		row.lengths.assign(lengths, lengths + count);
+		row.fields.assign(count, nullptr);
+		for (unsigned int i = 0; i < count; ++i) {
+			if (r[i]) {
+				row.values[i].assign(r[i], lengths[i]);
+				row.fields[i] = r[i]; // not NULL; pointed into values below
+				bytes += lengths[i];
+			}
+		}
+		if (bytes > maxBytes) {
+			tooLarge = true;
+			break;
+		}
+		rows->rows.push_back(std::move(row));
+	}
+	mysql_free_result(res);
+	if (tooLarge) {
+		return false;
+	}
+	// the field pointers last: the strings no longer move
+	for (DBRows::Row& row : rows->rows) {
+		for (unsigned int i = 0; i < count; ++i) {
+			if (row.fields[i]) {
+				row.fields[i] = &row.values[i][0];
+			}
+		}
+	}
+	out = std::move(rows);
+	return true;
+}
