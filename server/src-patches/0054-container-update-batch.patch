+// Chaos (patch 0054): held container updates. A batch that a script left open (an error between begin and end) ends
+// by itself at the next update after CONTAINER_BATCH_MAX_MS, so the windows never stay frozen.
+static constexpr int64_t CONTAINER_BATCH_MAX_MS = 2000;
+
+void Player::beginContainerBatch()
+{
+	if (containerBatchDepth == 0) {
+		containerBatchSince = OTSYS_TIME();
+	}
+	if (containerBatchDepth < std::numeric_limits<uint16_t>::max()) {
+		++containerBatchDepth;
+	}
+}
+
+void Player::endContainerBatch()
+{
+	if (containerBatchDepth == 0) {
+		return;
+	}
+	if (--containerBatchDepth == 0) {
+		flushContainerBatch();
+	}
+}
+
+void Player::flushContainerBatch()
+{
+	containerBatchDepth = 0;
+	std::bitset<256> dirty = containerBatchDirty;
+	containerBatchDirty.reset();
+	bool stats = containerBatchStats;
+	containerBatchStats = false;
+	if (client && dirty.any()) {
+		for (auto& it : openContainers) {
+			if (!dirty.test(it.first)) {
+				continue;
+			}
+			OpenContainer& openContainer = it.second;
+			const Container* container = openContainer.container;
+			uint32_t capacity = std::max<uint32_t>(1, container->capacity());
+			uint32_t size = container->size();
+			if (openContainer.index > 0 && openContainer.index >= size) {
+				// the page the window showed is gone: the last page that has items
+				openContainer.index = size == 0 ? 0 : static_cast<uint16_t>(((size - 1) / capacity) * capacity);
+			}
+			client->sendContainer(it.first, container, container->hasParent(), openContainer.index);
+		}
+	}
+	if (stats) {
+		sendStats();
+	}
+}
+
+bool Player::holdContainerUpdate(const Container* container)
+{
+	if (containerBatchDepth == 0) {
+		return false;
+	}
+	if (OTSYS_TIME() - containerBatchSince > CONTAINER_BATCH_MAX_MS) {
+		flushContainerBatch();
+		return false;
+	}
+	for (const auto& it : openContainers) {
+		if (it.second.container == container) {
+			containerBatchDirty.set(it.first);
+		}
+	}
+	return true;
+}
+
+bool Player::holdStats()
+{
+	if (containerBatchDepth == 0) {
+		return false;
+	}
+	if (OTSYS_TIME() - containerBatchSince > CONTAINER_BATCH_MAX_MS) {
+		flushContainerBatch();
+		return false;
+	}
+	containerBatchStats = true;
+	return true;
+}
