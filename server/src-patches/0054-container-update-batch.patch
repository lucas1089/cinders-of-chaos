+// Chaos (patch 0054): container updates held while a script moves many items (Player.h beginContainerBatch)
+int LuaScriptInterface::luaPlayerBeginContainerBatch(lua_State* L)
+{
+	// player:beginContainerBatch()
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->beginContainerBatch();
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int LuaScriptInterface::luaPlayerEndContainerBatch(lua_State* L)
+{
+	// player:endContainerBatch()
+	Player* player = getUserdata<Player>(L, 1);
+	if (player) {
+		player->endContainerBatch();
+		pushBoolean(L, true);
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
