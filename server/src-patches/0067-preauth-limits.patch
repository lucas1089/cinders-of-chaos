+// Chaos (patch 0067): the pre-auth limits of config.lua (src/chaospreauth.h). False: refuse the connection. A counted
+// connection gives its count back when it closes or when its game login goes through (Connection::endPreAuth).
+static bool preAuthAdmit(const Connection_ptr& connection, uint32_t ip)
+{
+	PreAuth::Settings s;
+	s.maxPerIp = static_cast<uint32_t>(std::max<int64_t>(0, g_config.getNumber(ConfigManager::PRE_AUTH_MAX_PER_IP)));
+	s.maxTotal = static_cast<uint32_t>(std::max<int64_t>(0, g_config.getNumber(ConfigManager::PRE_AUTH_MAX_TOTAL)));
+	s.deadlineSec = static_cast<uint32_t>(std::max<int64_t>(0, g_config.getNumber(ConfigManager::PRE_AUTH_DEADLINE)));
+	s.rateMax = static_cast<uint32_t>(std::max<int64_t>(0, g_config.getNumber(ConfigManager::PRE_AUTH_RATE_MAX)));
+	s.rateWindowSec = static_cast<uint32_t>(std::max<int64_t>(1, g_config.getNumber(ConfigManager::PRE_AUTH_RATE_WINDOW)));
+	s.cooldownSec = static_cast<uint32_t>(std::max<int64_t>(1, g_config.getNumber(ConfigManager::PRE_AUTH_COOLDOWN)));
+	s.exemptLoopback = g_config.getBoolean(ConfigManager::PRE_AUTH_EXEMPT_LOOPBACK);
+
+	const int64_t now = time(nullptr);
+	const PreAuth::Verdict verdict = PreAuth::global().admit(ip, now, s);
+	if (PreAuth::refused(verdict)) {
+		uint32_t suppressed = 0;
+		if (PreAuth::global().shouldLog(verdict, now, suppressed)) {
+			std::cout << "[Pre-auth limit] " << PreAuth::name(verdict) << ": " << convertIPToString(ip);
+			if (suppressed != 0) {
+				std::cout << " (" << suppressed << " more refused since the last line)";
+			}
+			std::cout << std::endl;
+		}
+		return false;
+	}
+	if (verdict == PreAuth::Verdict::Admitted) {
+		connection->startPreAuth(ip, s.deadlineSec);
+	}
+	return true;
+}
