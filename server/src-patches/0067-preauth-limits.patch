+// Chaos (patch 0067): limits on connections that have not logged in yet (server/README.md "Pre-auth connection limits").
+// Header only and free of engine types, so server/tools/chaospreauth_test.cpp builds it alone.
+// An IP address is the engine's own uint32_t (network byte order); time is whole seconds.
+
+#ifndef FS_CHAOSPREAUTH_H_CHAOS
+#define FS_CHAOSPREAUTH_H_CHAOS
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+namespace PreAuth {
+
+// 0 in maxPerIp / maxTotal / rateMax turns that limit off; deadlineSec 0 turns the login deadline off
+struct Settings
+{
+	uint32_t maxPerIp = 5;          // connections of one IP that have not finished their login
+	uint32_t maxTotal = 200;        // the same over all IPs
+	uint32_t deadlineSec = 15;      // a connection still not logged in after this long is closed
+	uint32_t rateMax = 10;          // new connections of one IP within rateWindowSec
+	uint32_t rateWindowSec = 10;
+	uint32_t cooldownSec = 30;      // an IP over rateMax is refused for this long
+	bool exemptLoopback = true;     // 127.0.0.0/8: the admin tools, the watchdog and the health check
+};
+
+enum class Verdict
+{
+	Admitted, // counted: the caller must call release() exactly once when the connection closes or logs in
+	Exempt,   // not counted: nothing to release
+	PerIp,
+	Total,
+	Rate,
+	Full,     // the table of IPs is full of live entries (a flood from 100,000 addresses): refused
+};
+
+inline bool refused(Verdict v) { return v != Verdict::Admitted && v != Verdict::Exempt; }
+
+inline bool isLoopback(uint32_t ip)
+{
+	return reinterpret_cast<const uint8_t*>(&ip)[0] == 127; // network byte order: the first byte is in memory first
+}
+
+class Limiter
+{
+	public:
+		static constexpr size_t MAX_ENTRIES = 100000; // IPs kept; expired ones are swept when it is reached
+		static constexpr int64_t LOG_EVERY = 10;      // seconds between two log lines of one kind
+
+		Verdict admit(uint32_t ip, int64_t now, const Settings& s) {
+			if (s.exemptLoopback && isLoopback(ip)) {
+				return Verdict::Exempt;
+			}
+			std::lock_guard<std::mutex> guard(lock);
+			if (s.maxPerIp == 0 && s.maxTotal == 0 && s.rateMax == 0) {
+				return Verdict::Exempt;
+			}
+			if (ips.size() >= MAX_ENTRIES && ips.find(ip) == ips.end()) {
+				sweep(now, s);
+				if (ips.size() >= MAX_ENTRIES) {
+					return Verdict::Full;
+				}
+			}
+			Entry& e = ips[ip];
+			if (s.rateMax != 0) {
+				if (e.blockedUntil > now) {
+					return Verdict::Rate;
+				}
+				if (now - e.windowStart >= static_cast<int64_t>(s.rateWindowSec)) {
+					e.windowStart = now;
+					e.count = 0;
+				}
+				if (++e.count > s.rateMax) {
+					e.blockedUntil = now + s.cooldownSec;
+					e.count = 0;
+					e.windowStart = e.blockedUntil;
+					return Verdict::Rate;
+				}
+			}
+			if (s.maxPerIp != 0 && e.active >= s.maxPerIp) {
+				return Verdict::PerIp;
+			}
+			if (s.maxTotal != 0 && totalActive >= s.maxTotal) {
+				return Verdict::Total;
+			}
+			++e.active;
+			++totalActive;
+			return Verdict::Admitted;
+		}
+
+		// an admitted connection closed or logged in (the caller makes sure it is called once per Admitted)
+		void release(uint32_t ip) {
+			std::lock_guard<std::mutex> guard(lock);
+			auto it = ips.find(ip);
+			if (it != ips.end() && it->second.active > 0) {
+				--it->second.active;
+			}
+			if (totalActive > 0) {
+				--totalActive;
+			}
+		}
+
+		// true when a refusal of this kind may be logged now; suppressed gets the refusals left out since the last line
+		bool shouldLog(Verdict v, int64_t now, uint32_t& suppressed) {
+			std::lock_guard<std::mutex> guard(lock);
+			Log& l = logs[static_cast<size_t>(v)];
+			if (!l.any || now - l.last >= LOG_EVERY) {
+				suppressed = l.suppressed;
+				l.suppressed = 0;
+				l.last = now;
+				l.any = true;
+				return true;
+			}
+			++l.suppressed;
+			return false;
+		}
+
+		size_t total() {
+			std::lock_guard<std::mutex> guard(lock);
+			return totalActive;
+		}
+		size_t active(uint32_t ip) {
+			std::lock_guard<std::mutex> guard(lock);
+			auto it = ips.find(ip);
+			return it == ips.end() ? 0 : it->second.active;
+		}
+		size_t entries() {
+			std::lock_guard<std::mutex> guard(lock);
+			return ips.size();
+		}
+
+	private:
+		struct Entry
+		{
+			int64_t windowStart = 0;
+			int64_t blockedUntil = 0;
+			uint32_t count = 0;
+			uint32_t active = 0;
+		};
+		struct Log
+		{
+			int64_t last = 0;
+			uint32_t suppressed = 0;
+			bool any = false;
+		};
+
+		void sweep(int64_t now, const Settings& s) {
+			for (auto it = ips.begin(); it != ips.end();) {
+				const Entry& e = it->second;
+				if (e.active == 0 && e.blockedUntil <= now && now - e.windowStart >= static_cast<int64_t>(s.rateWindowSec)) {
+					it = ips.erase(it);
+				} else {
+					++it;
+				}
+			}
+		}
+
+		std::mutex lock;
+		std::unordered_map<uint32_t, Entry> ips;
+		size_t totalActive = 0;
+		Log logs[8];
+};
+
+inline Limiter& global()
+{
+	static Limiter limiter;
+	return limiter;
+}
+
+inline const char* name(Verdict v)
+{
+	switch (v) {
+		case Verdict::PerIp: return "too many unfinished logins from one IP";
+		case Verdict::Total: return "too many unfinished logins in all";
+		case Verdict::Rate: return "too many new connections from one IP, refused for a while";
+		case Verdict::Full: return "table of IPs full";
+		default: return "";
+	}
+}
+
+} // namespace PreAuth
+
+#endif
