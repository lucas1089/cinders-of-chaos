+// Chaos (patch 0069): raw deflate of server-to-client game packets (server/README.md "Packet compression (O209)").
+//
+// The client engine already inflates: when the u32 where the checksum goes is 0, the XTEA-decrypted body is a raw
+// deflate stream that continues the stream of the earlier flagged packets (inflateInit2 -15, Z_SYNC_FLUSH, the four
+// bytes 00 00 FF FF added back by the client). So the server keeps ONE z_stream per connection, ends every packet
+// with Z_SYNC_FLUSH and cuts those four bytes. Nothing is compressed in the other direction: the server never
+// inflates anything a client sent.
+#ifndef FS_CHAOSPACKETCOMPRESS_H_CHAOS
+#define FS_CHAOSPACKETCOMPRESS_H_CHAOS
+
+#include <zlib.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace ChaosPacketCompress {
+
+// smaller bodies are never worth a deflate call (the config value cannot go below this)
+static constexpr size_t MIN_BODY = 16;
+// larger bodies stay plain: deflate may add a few bytes to data it cannot shrink, and the length word has 16 bits
+// (NetworkMessage::MAX_PROTOCOL_BODY_LENGTH is 65522)
+static constexpr size_t MAX_BODY = 60000;
+// 2^14 byte window, memLevel 7: 64 KB + 64 KB of zlib state per connection (the client inflates with 2^15, so any
+// smaller window decodes). Measured against 2^15 / memLevel 8 in tools/packet_compress_bench.py: under 1% apart.
+static constexpr int WINDOW_BITS = 14;
+static constexpr int MEM_LEVEL = 7;
+
+class Deflater
+{
+	public:
+		Deflater() { std::memset(&stream, 0, sizeof(stream)); }
+		~Deflater() {
+			if (ready) {
+				deflateEnd(&stream);
+			}
+		}
+
+		Deflater(const Deflater&) = delete;
+		Deflater& operator=(const Deflater&) = delete;
+
+		bool init(int level) {
+			if (level < 1 || level > 9) {
+				level = 3;
+			}
+			ready = deflateInit2(&stream, level, Z_DEFLATED, -WINDOW_BITS, MEM_LEVEL, Z_DEFAULT_STRATEGY) == Z_OK;
+			return ready;
+		}
+
+		// Deflates one packet body and ends it with a sync flush. out points into this object and stays valid until
+		// the next call. False: the stream is broken and must not be used again.
+		bool compress(const uint8_t* in, size_t length, const uint8_t*& out, size_t& outLength) {
+			if (!ready) {
+				return false;
+			}
+			const uLong bound = deflateBound(&stream, static_cast<uLong>(length)) + 16;
+			if (buffer.size() < bound) {
+				buffer.resize(bound);
+			}
+			stream.next_in = const_cast<Bytef*>(in);
+			stream.avail_in = static_cast<uInt>(length);
+			stream.next_out = buffer.data();
+			stream.avail_out = static_cast<uInt>(buffer.size());
+			if (deflate(&stream, Z_SYNC_FLUSH) != Z_OK || stream.avail_in != 0 || stream.avail_out == 0) {
+				return false;
+			}
+			size_t produced = buffer.size() - stream.avail_out;
+			// the sync flush ends with an empty stored block: 00 00 FF FF. The client appends it again.
+			if (produced < 5 || buffer[produced - 4] != 0x00 || buffer[produced - 3] != 0x00 ||
+			        buffer[produced - 2] != 0xFF || buffer[produced - 1] != 0xFF) {
+				return false;
+			}
+			produced -= 4;
+			out = buffer.data();
+			outLength = produced;
+			return true;
+		}
+
+	private:
+		z_stream stream;
+		bool ready = false;
+		std::vector<uint8_t> buffer;
+};
+
+} // namespace ChaosPacketCompress
+
+#endif
