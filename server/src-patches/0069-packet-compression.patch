+bool Protocol::compressBody(OutputMessage& msg) const
+{
+	const size_t length = msg.getLength();
+	if (length < compressMin || length > ChaosPacketCompress::MAX_BODY) {
+		return false;
+	}
+
+	const uint8_t* out = nullptr;
+	size_t outLength = 0;
+	if (!deflater->compress(msg.getOutputBuffer(), length, out, outLength)) {
+		// the stream is unusable now: this and every later packet stays plain (the client only inflates the flagged ones)
+		deflater.reset();
+		return false;
+	}
+	// a deflated body is sent even when it is not smaller: the client's stream must see every block the server's saw
+	return msg.replaceBody(out, outLength);
+}
