+// Chaos (patch 0051): the impact type of a health change: critical (combat.cpp sets `critical`), else a condition tick
+// (the origin before the onHealthChange re-entry cleared it), else normal
+static uint8_t chaosImpactType(const CombatDamage& damage)
+{
+	if (damage.critical) {
+		return CHAOS_IMPACT_CRITICAL;
+	}
+	const CombatOrigin origin = damage.origin != ORIGIN_NONE ? damage.origin : damage.firstOrigin;
+	return origin == ORIGIN_CONDITION ? CHAOS_IMPACT_CONDITION : CHAOS_IMPACT_NORMAL;
+}
