+// Chaos (patch 0051): TextMessage::percent: value as a share of maximum, x100, rounded up (a hit of 1 on 100000 health
+// is 1, not 0), capped at the u16 range
+inline uint16_t chaosImpactPercent(int64_t value, int64_t maximum)
+{
+	if (value <= 0) {
+		return 0;
+	}
+	maximum = std::max<int64_t>(maximum, 1);
+	const int64_t percent = (value * 10000 + maximum - 1) / maximum;
+	return static_cast<uint16_t>(std::min<int64_t>(percent, std::numeric_limits<uint16_t>::max()));
+}
