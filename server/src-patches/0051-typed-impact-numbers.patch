+// Chaos (patch 0051): the type of an impact number (TextMessage::typeId). Same numbers in the client module
+// game_damagescatter (scatterlogic.lua TYPE) and in data/scripts/chaos/chaos_constants.lua (Chaos.impactType).
+enum ChaosImpactType : uint8_t {
+	CHAOS_IMPACT_NORMAL = 0,
+	CHAOS_IMPACT_CRITICAL = 1, // CombatDamage::critical (combat.cpp rolls it)
+	CHAOS_IMPACT_CONDITION = 2, // damage over time: a condition tick (origin ORIGIN_CONDITION)
+	CHAOS_IMPACT_MANA_DRAIN = 3, // mana lost: the mana shield or a mana drain
+	CHAOS_IMPACT_MANA_GAIN = 4, // mana restored
+	CHAOS_IMPACT_ENERGY_SHIELD = 5, // taken by the energy shield (patch 0015)
 };
 
+// Chaos (patch 0051): the bit of our client's login capability byte that asks for GameChaosImpactText
+static constexpr uint8_t CHAOS_CAPABILITY_IMPACT_TEXT = 1 << 7;
