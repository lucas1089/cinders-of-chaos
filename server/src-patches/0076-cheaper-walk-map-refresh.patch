+#ifndef FS_CHAOSSTRIP_H
+#define FS_CHAOSSTRIP_H
+
+// Cheaper walk map refresh (patch 0076, server/README.md "Cheaper walk map refresh (O225)"). Header only, no engine
+// types: server/tools/chaosstrip_test.cpp and server/tools/strip_bench.cpp build it alone.
+//   A monster that walks (Monster::useCacheMap) keeps a 33 x 25 grid of "can I step here" answers (Creature::
+//   localMapCache). Every step Creature::onCreatureMove shifts the grid and fills the new edge: a column of 25 or a row
+//   of 33 tiles, each fetched with Map::getTile, which walks the quad tree from the root (12 pointer hops, a likely cache
+//   miss each) although neighbouring tiles of an 8x8 block share one leaf and one Floor. Creature::updateMapCache (first
+//   think, a teleport, a floor change) fetches all 825 tiles that way.
+//   TileReader::at gives the same tile as Map::getTile(uint16_t, uint16_t, uint8_t) (the arguments are narrowed the same
+//   way) and keeps the Floor of the last 8x8 block in two words, so a column or a row walks the tree once per block (4 to 5
+//   times) instead of once per tile. The reader lives on the stack of one refresh: nothing is kept between calls, so a tile
+//   or a floor added later is always seen, and nothing is allocated.
+
+#include <cstdint>
+
+namespace ChaosStrip {
+
+// floorAt(uint16_t x, uint16_t y, uint8_t z) -> const FloorT* (nullptr when there is no leaf or no floor, or z is out of
+//   range: what Map::getTile checks before it reads the tile); FloorT::tiles[8][8] is indexed [x & 7][y & 7] and holds TileT*.
+template<typename FloorT, typename TileT, typename FloorAt>
+class TileReader
+{
+	public:
+		explicit TileReader(FloorAt& floorAt) : floorAt(floorAt) {}
+
+		// Map::getTile(x, y, z) for ints, as the stock call narrowed them
+		TileT* at(int32_t x, int32_t y, int32_t z)
+		{
+			const uint16_t tx = static_cast<uint16_t>(x);
+			const uint16_t ty = static_cast<uint16_t>(y);
+			const uint8_t tz = static_cast<uint8_t>(z);
+			const uint64_t key = (static_cast<uint64_t>(tx) >> 3) | (static_cast<uint64_t>(ty >> 3) << 13) | (static_cast<uint64_t>(tz) << 26);
+			if (key != cachedKey) {
+				cachedKey = key;
+				cachedFloor = floorAt(tx, ty, tz);
+			}
+			return cachedFloor ? cachedFloor->tiles[tx & 7][ty & 7] : nullptr;
+		}
+
+	private:
+		FloorAt& floorAt;
+		uint64_t cachedKey = ~0ull; // no real key has all 34 bits set
+		const FloorT* cachedFloor = nullptr;
+};
+
+template<typename FloorT, typename TileT, typename FloorAt>
+inline TileReader<FloorT, TileT, FloorAt> makeReader(FloorAt& floorAt)
+{
+	return TileReader<FloorT, TileT, FloorAt>(floorAt);
+}
+
+} // namespace ChaosStrip
+
+#endif
