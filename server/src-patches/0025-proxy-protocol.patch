+// Chaos (patch 0025): the PROXY header of a trusted gateway, read in steps (8 bytes, then what ProxyProtocol::parse asks
+// for) so that not one byte of the client's own data is taken; then the protocol starts as for a direct connection
+void Connection::readProxyHeader()
+{
+	std::lock_guard<std::recursive_mutex> lockClass(connectionLock);
+	try {
+		readTimer.expires_from_now(std::chrono::seconds(ProxyProtocol::HEADER_TIMEOUT));
+		readTimer.async_wait(std::bind(&Connection::handleTimeout, std::weak_ptr<Connection>(shared_from_this()), std::placeholders::_1));
+
+		boost::asio::async_read(socket, boost::asio::buffer(msg.getBuffer(), ProxyProtocol::FIRST_READ),
+		                        std::bind(&Connection::onProxyRead, shared_from_this(), std::placeholders::_1,
+		                                  ProxyProtocol::FIRST_READ));
+	} catch (boost::system::system_error& e) {
+		std::cout << "[Network error - Connection::readProxyHeader] " << e.what() << std::endl;
+		close(FORCE_CLOSE);
+	}
+}
+
+void Connection::onProxyRead(const boost::system::error_code& error, size_t have)
+{
+	std::lock_guard<std::recursive_mutex> lockClass(connectionLock);
+	readTimer.cancel();
+
+	if (error) {
+		close(FORCE_CLOSE);
+		return;
+	} else if (closed) {
+		return;
+	}
+
+	ProxyProtocol::Header header;
+	switch (ProxyProtocol::parse(msg.getBuffer(), have, header)) {
+		case ProxyProtocol::Parse::NeedMore: {
+			if (header.need <= have || header.need > ProxyProtocol::MAX_HEADER) {
+				close(FORCE_CLOSE);
+				return;
+			}
+			try {
+				readTimer.expires_from_now(std::chrono::seconds(ProxyProtocol::HEADER_TIMEOUT));
+				readTimer.async_wait(std::bind(&Connection::handleTimeout, std::weak_ptr<Connection>(shared_from_this()),
+				                               std::placeholders::_1));
+				boost::asio::async_read(socket, boost::asio::buffer(msg.getBuffer() + have, header.need - have),
+				                        std::bind(&Connection::onProxyRead, shared_from_this(), std::placeholders::_1,
+				                                  header.need));
+			} catch (boost::system::system_error& e) {
+				std::cout << "[Network error - Connection::onProxyRead] " << e.what() << std::endl;
+				close(FORCE_CLOSE);
+			}
+			return;
+		}
+
+		case ProxyProtocol::Parse::Invalid:
+			ProxyProtocol::logRefused("no valid PROXY header from a trusted gateway, closed", getIP(), header.error);
+			close(FORCE_CLOSE);
+			return;
+
+		case ProxyProtocol::Parse::Ok:
+			if (!header.local) {
+				proxiedIP = header.ip;
+			}
+			service_port->onConnectionReady(shared_from_this());
+			return;
+	}
+}
