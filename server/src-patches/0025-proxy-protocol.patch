+// Cinders of Chaos engine patch 0025 (server/src-patches/0025-proxy-protocol.patch): the PROXY protocol from trusted
+// gateways. Part of the engine, under its GPL-2.0 License (LICENSE in the server source root).
+//
+// Players connect to TCP proxies ("gateways", server/deploy/gateway/) that forward 7171 and 7172 to this server and put
+// a PROXY protocol header (v2, or the v1 text line) in front of the client's bytes. A connection from an address in
+// proxyProtocolTrusted must start with such a header; its source address becomes the connection's IP (Connection::getIP:
+// bans, the connection rate limit, the status query limit, player:getIp(), the client guard staff IPs, logs).
+// Nobody else may send one: from any other address the header is refused, never believed.
+// config.lua (server/README.md "Gateways and the PROXY protocol"):
+//   proxyProtocolTrusted = "1.2.3.4,5.6.7.8"   gateway addresses, a.b.c.d or a.b.c.d/nn; empty: off (as before)
+//   proxyProtocolRequired = false              true: only gateways (and 127.0.0.0/8) may connect at all
+
+#ifndef FS_PROXYPROTOCOL_H_5B0E2C7D9A3F4E61B8D1C2A3F4E5D6C7
+#define FS_PROXYPROTOCOL_H_5B0E2C7D9A3F4E61B8D1C2A3F4E5D6C7
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace ProxyProtocol {
+
+// bytes read first: enough to tell v1 ("PROXY ") from v2 (12 byte signature) without reading past the shortest header
+// ("PROXY UNKNOWN\r\n", 15 bytes)
+constexpr size_t FIRST_READ = 8;
+constexpr size_t V2_HEADER = 16;
+// the longest v2 address block accepted (addresses 36 bytes for IPv6, the rest TLVs); a gateway sends 12 or 36
+constexpr size_t V2_MAX_PAYLOAD = 512;
+// the longest v1 line, CRLF included (the specification's limit)
+constexpr size_t V1_MAX = 107;
+constexpr size_t MAX_HEADER = V2_HEADER + V2_MAX_PAYLOAD;
+// seconds a gateway connection has to deliver its header (the gateway sends it at once)
+constexpr int32_t HEADER_TIMEOUT = 5;
+
+enum class Parse : uint8_t {
+	NeedMore, // read until `need` bytes in total, then parse again
+	Ok,
+	Invalid,
+};
+
+struct Header {
+	size_t need = FIRST_READ; // NeedMore: total bytes needed; Ok: the header's length
+	bool local = false;        // LOCAL command / UNKNOWN / UNSPEC: keep the real peer address (a gateway health check)
+	uint32_t ip = 0;           // the client's IPv4 address in network byte order, as Connection::getIP
+	uint16_t port = 0;
+	const char* error = "";
+};
+
+// Pure: parses the first `size` bytes of a connection. Never asks for more than MAX_HEADER bytes.
+Parse parse(const uint8_t* data, size_t size, Header& out);
+
+// Does a first packet header (its two length bytes) look like the start of a PROXY header ("\r\n" or "PR")?
+// No real first packet is that long (2573 / 21072 bytes); the login, game and status packets are a few hundred at most.
+bool looksLikeHeader(const uint8_t* lengthBytes);
+
+// a.b.c.d (or a.b.c.d/nn) -> network byte order; false when it is not one
+bool parseIPv4(const std::string& text, uint32_t& ip, uint32_t& prefix);
+
+enum class Peer : uint8_t {
+	Direct,  // as before: the protocol starts at once
+	Gateway, // a trusted gateway: read the PROXY header first
+	Refused, // proxyProtocolRequired and not a gateway or loopback
+};
+
+// what to do with a new connection from `peerIP` (network byte order), from config.lua (re-read after /reload config)
+Peer classify(uint32_t peerIP);
+bool isTrusted(uint32_t peerIP);
+bool isLoopback(uint32_t ip);
+
+// console lines, at most one per kind every 10 s (with the number left out), so a flood cannot fill the log
+void logRefused(const char* what, uint32_t ip, const std::string& detail = std::string());
+
+// at startup: off / the trusted gateways and whether direct connections are refused; bad entries
+void startupReport();
+
+} // namespace ProxyProtocol
+
+#endif
