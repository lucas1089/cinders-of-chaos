 	registerMethod("Player", "getClientGuard", LuaScriptInterface::luaPlayerGetClientGuard); // Chaos (patch 0021)
 	registerMethod("Player", "clientGuardFail", LuaScriptInterface::luaPlayerClientGuardFail);
+	registerMethod("Player", "refuseLogin", LuaScriptInterface::luaPlayerRefuseLogin); // Chaos (patch 0039)
 
 	registerMethod("Player", "getGuildWarList", LuaScriptInterface::luaPlayerGetGuildWarList);
 	registerMethod("Player", "setGuildWarList", LuaScriptInterface::luaPlayerSetGuildWarList);
@@ -9777,6 +9779,27 @@
 	return 1;
 }
 
+// Chaos (patch 0039): the login error box with a reason. A script that refuses a login (onLogin returns false) could
+// only drop the connection: the client said "connection lost" and the reason was only in the server log. The message
+// goes out at once (Protocol::send, like the client guard's refusal), not through the output buffer: the buffer, with
+// the login packets, is dropped when the kick closes the connection right after. The client shows it as a login error.
+int LuaScriptInterface::luaPlayerRefuseLogin(lua_State* L)
+{
+	// player:refuseLogin(message): sends the login error box; the caller then returns false from onLogin (the engine
+	// kicks the player). Returns true when sent (nil without a connection).
+	Player* player = getUserdata<Player>(L, 1);
+	if (!player || !player->client) {
+		lua_pushnil(L);
+		return 1;
+	}
+	auto output = OutputMessagePool::getOutputMessage();
+	output->addByte(0x14);
+	output->addString(getString(L, 2));
+	player->client->send(output);
+	pushBoolean(L, true);
+	return 1;
+}
