		<element icePercent="5" />
		<element holyPercent="-15" />
		<element deathPercent="40" />
	</elements>
	<immunities>
		<immunity paralyze="1" />
		<immunity invisible="1" />
		<immunity outfit="1" />
		<immunity drunk="1" />
		<immunity lifedrain="1" />
	</immunities>
	<voices interval="5000" chance="10">
		<voice sentence="Your colours taste of fear." yell="1" />
		<voice sentence="I have eaten the banners of a hundred guilds." yell="1" />
		<voice sentence="SWEAR YOUR OATHS. I WILL CHEW THEM." yell="1" />
	</voices>
</monster>
