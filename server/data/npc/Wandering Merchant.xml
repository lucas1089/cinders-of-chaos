<!-- The Wandering Merchant (server/data/scripts/chaos/worldevents.lua): resident since O399, always in a town area, moved
     every 3 hours by the clock. His goods and prices: invasion_config.lua worldEvents.merchant.items; one of each per
     character and stop (perStop), said when the trade window opens (V35). -->
<npc name="Wandering Merchant" script="wandering_merchant.lua" walkinterval="0" floorchange="0">
	<health now="100" max="100" />
	<look type="129" head="114" body="94" legs="113" feet="76" addons="3" />
	<parameters>
		<parameter key="message_greet" value="Ah, |PLAYERNAME|! Fresh from the broken roads. Ask for a {trade}, I do not stay long." />
		<parameter key="message_farewell" value="May the shards spare you, |PLAYERNAME|." />
		<parameter key="message_walkaway" value="Your loss, wanderer." />
		<parameter key="message_sendtrade" value="Orbs and oddities, found where the world bleeds. One of each per customer, and be quick." />
	</parameters>
</npc>
