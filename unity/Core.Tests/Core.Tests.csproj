<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console tests of the engine-free core of the Unity prototype (unity/Client/Assets/Chaos/Core).
       "dotnet run -c Release" runs the unit tests; the probe and live commands: see Probe.cs, LiveProbe.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Client/Assets/Chaos/Core/**/*.cs" />
    <!-- the live check's own logic (Core.LiveCheck, unity/README.md "Live check (O433)"), tested here; its Program.cs is not linked -->
    <Compile Include="../Core.LiveCheck/OtbDat.cs;../Core.LiveCheck/LiveOps.cs;../Core.LiveCheck/LiveRun.cs;../Core.LiveCheck/LiveClient.cs;../Core.LiveCheck/LiveScenarios.cs;../Core.LiveCheck/LiveScenarios2.cs;../Core.LiveCheck/LiveScenarios3.cs;../Core.LiveCheck/LiveScenarios4.cs;../Core.LiveCheck/LiveScenarios5.cs;../Core.LiveCheck/LiveScenarios6.cs;../Core.LiveCheck/LiveScenarios7.cs;../Core.LiveCheck/LiveScenarios8.cs;../Core.LiveCheck/LiveScenarios9.cs;../Core.LiveCheck/LiveScenarios10.cs;../Core.LiveCheck/LiveScenarios11.cs;../Core.LiveCheck/LiveScenarios12.cs" />
  </ItemGroup>
</Project>
